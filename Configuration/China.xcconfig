// China.xcconfig - Settings for China App Store distribution
//
// China build is a stricter AppStore variant: sandboxed, no AI Agent, no Voice
// Agent, no VPN (including no packet-tunnel extension and no VPN widgets).
// Distinct bundle identifier so it can ship as a separate app in the China
// storefront and install side-by-side with the regular build.

// Sandbox ENABLED for China App Store
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES

// Disable the Xcode 16 user-script sandbox so the existing Strip Joe build
// phase can remove joe.framework from the China bundle (joe is GPL-licensed
// and should not ship). The sandbox blocks rm inside BUILT_PRODUCTS_DIR.
// (The app sandbox above is unaffected — that runs at app launch.)
ENABLE_USER_SCRIPT_SANDBOXING = NO

// China-specific entitlements (no networkextension packet-tunnel-provider)
CODE_SIGN_ENTITLEMENTS = rootshell/Entitlements/China.entitlements

// Distinct bundle identifier so the China build can ship under its own App
// Store listing. Product name stays "rootshell" (via $(TARGET_NAME) at target
// level) so the user-facing app name matches other regions.
PRODUCT_BUNDLE_IDENTIFIER = $(ROOTSHELL_ORG_IDENTIFIER).rootshell.cn
ROOTSHELL_APP_GROUP = $(ROOTSHELL_DEFAULT_APP_GROUP).cn

// Source exclusions
//
//   - rootshell-helper.app: private helper app, AppStore-excluded
//   - UpdateManager.swift: Sparkle integration, Standalone-only
//   - AIAgent tree: every Swift file under rootshell/Features/AIAgent/ (including Voice/).
//     Path glob plus a filename-pattern fallback. Individual AIAgent files also
//     have file-level #if !CHINA_BUILD guards as a belt-and-suspenders measure
//     in case Xcode's path globbing doesn't match fileSystemSynchronizedGroups.
//   - Core/VPN: main-app VPN manager layer.
//   - *VPN*.swift: catches VPN settings views, VPN app intents, and VPN widget
//     files in the widget extension (though the widget target also sets its own
//     exclusions for these).
//   - AIAgentSettingsView.swift: the one AI Agent settings view that lives under
//     Settings/ rather than AIAgent/.
EXCLUDED_SOURCE_FILE_NAMES = rootshell-helper.app UpdateManager.swift rootshell/Features/AIAgent/**/*.swift rootshell/Features/VPN/*.swift *VPN*.swift AIAgentSettingsView.swift

// Swift conditional compilation flags
//   - CHINA_BUILD: gates cross-reference sites in mixed files
//   - APPSTORE: China is a superset of AppStore restrictions, so any #if APPSTORE
//     paths apply here too
//   - DISABLE_MFI_LIGHTNING: aligned with the pinned YubiKit fork release;
//     restoring Lightning also requires a new package release and Info.plist update
OTHER_SWIFT_FLAGS = $(inherited) -D CHINA_BUILD -D APPSTORE -D DISABLE_MFI_LIGHTNING
