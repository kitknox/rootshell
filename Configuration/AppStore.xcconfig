// AppStore.xcconfig - Settings for App Store distribution

// Sandbox ENABLED for App Store
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES

// App Store entitlements (platform-specific)
// iOS/iPadOS/visionOS: includes NFC for YubiKey PIV
// Mac Catalyst: excludes NFC (not supported on macOS)
CODE_SIGN_ENTITLEMENTS = rootshell/Entitlements/AppStore$(ROOTSHELL_APP_ENTITLEMENTS_SUFFIX).entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = rootshell/Entitlements/AppStore-MacCatalyst.entitlements

// Exclude the bundled rootshell-helper app for App Store builds.
// Also exclude UpdateManager.swift (Sparkle integration - Standalone only)
EXCLUDED_SOURCE_FILE_NAMES = rootshell-helper.app UpdateManager.swift rootshellvpn.app

// Swift conditional compilation flag
// Keep aligned with the pinned YubiKit fork release. Restoring Lightning requires
// a new package release plus UISupportedExternalAccessoryProtocols in Info.plist.
OTHER_SWIFT_FLAGS = $(inherited) -D APPSTORE -D DISABLE_MFI_LIGHTNING

// Carbon is linked on Mac Catalyst for the TIS (Text Input Sources) entry
// points used by Mod-Tap input-source switching. The Carbon umbrella header
// is broken on the current SDK so we forward-declare the C entry points in
// InputSourceCarbonShim.swift instead of importing Carbon.HIToolbox.
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -framework Carbon
