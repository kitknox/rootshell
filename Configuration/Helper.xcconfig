// Native macOS background helper embedded only by the Standalone Catalyst app.
#include "Identity.xcconfig"
CODE_SIGN_ENTITLEMENTS = rootshell-helper/rootshell-helper.entitlements
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=macosx*] = Apple Development
CODE_SIGN_STYLE = Automatic
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
INFOPLIST_FILE = rootshell-helper/Sources/Info.plist
MACOSX_DEPLOYMENT_TARGET = 15.0
PRODUCT_BUNDLE_IDENTIFIER = $(ROOTSHELL_ORG_IDENTIFIER).rootshell-helper
PRODUCT_NAME = $(TARGET_NAME)
PROVISIONING_PROFILE_SPECIFIER =
REGISTER_APP_GROUPS = YES
SDKROOT = macosx
SKIP_INSTALL = YES
SUPPORTED_PLATFORMS = macosx
SUPPORTS_MACCATALYST = NO
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_OBJC_BRIDGING_HEADER = rootshell-helper/Sources/rootshell-helper-Bridging-Header.h
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 5.0
