// Identity.xcconfig - Apple Developer team and identifier namespace.
//
// Every bundle identifier, app group, and keychain access group in the
// project derives from the two variables at the top of this file, so a
// contributor building under their own paid Apple Developer account can
// redirect all of them at once via the optional include at the bottom.
//
// Kept separate from Base.xcconfig so the macOS-only helper targets can pick
// up the identifiers without also inheriting the iOS app's compiler, linker,
// and device-family settings.

// Development Team.
ROOTSHELL_DEVELOPMENT_TEAM = D97ZME3ET2
DEVELOPMENT_TEAM = $(ROOTSHELL_DEVELOPMENT_TEAM)

// Reverse-DNS namespace every bundle identifier is built from.
ROOTSHELL_ORG_IDENTIFIER = com.kk2

// The app group the VPN, widget, tunnel, and helper targets sign against.
// Deliberately not region-specific: those targets use this group even in a
// China build, which is how they were before these values became variables.
// The app and the push service use ROOTSHELL_APP_GROUP instead, which
// Base.xcconfig derives from this one and China.xcconfig suffixes with ".cn".
// Do not collapse the two without first checking that the ".cn" group is
// enabled on the App IDs of the targets listed above.
ROOTSHELL_DEFAULT_APP_GROUP = group.$(ROOTSHELL_ORG_IDENTIFIER).ghostty

// Keychain access group. The suffix is spelled separately because
// .entitlements files must compose it with Apple's $(AppIdentifierPrefix),
// while Swift and Info.plist need the team-prefixed form.
ROOTSHELL_KEYCHAIN_GROUP_SUFFIX = $(ROOTSHELL_ORG_IDENTIFIER).ghostty-ios
ROOTSHELL_KEYCHAIN_ACCESS_GROUP = $(ROOTSHELL_DEVELOPMENT_TEAM).$(ROOTSHELL_KEYCHAIN_GROUP_SUFFIX)

// CloudKit container. A literal default rather than something derived from
// ROOTSHELL_ORG_IDENTIFIER: changing it repoints the shipping container, which
// is a user-data migration, not a same-behavior rename. An override replaces
// it wholesale instead of composing with it.
ROOTSHELL_ICLOUD_CONTAINER = iCloud.rootshell

// Selects which App Store entitlements file gets signed. Empty (default)
// signs the real one, including com.apple.developer.networking.multicast --
// the one capability here that Apple grants by request rather than by
// checkbox. A contributor without that grant sets this to "-dev" to sign
// AppStore-dev.entitlements instead -- a gitignored copy that
// scripts/setup-dev-signing.sh derives by dropping that one capability -- so
// the App Store configuration still signs. It costs croc's LAN peer
// discovery and nothing else; clearing the override restores it.
ROOTSHELL_APP_ENTITLEMENTS_SUFFIX =

// Personal Apple Developer team, org identifier, and iCloud container for a
// contributor building under their own paid account instead of upstream's.
// Untracked (see .gitignore), like Secrets.xcconfig alongside it. Set only the
// ROOTSHELL_* variables above there: settings assigned later in Base.xcconfig
// (CODE_SIGN_STYLE, PRODUCT_BUNDLE_IDENTIFIER) would win over an override here.
// Generated by scripts/setup-dev-signing.sh; see docs/contributor-signing.md.
#include? "DeveloperSettings.xcconfig"
