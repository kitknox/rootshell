            "state" : "translated",
            "value" : "~/.promptrc.toml sovrascrive il tema selezionato di seguito. Rimuovilo per utilizzare i temi delle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml は以下で選択したテーマを上書きします。設定のテーマを使用するには削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml이 아래에서 선택한 테마를 재정의합니다. 설정 테마를 사용하려면 제거하세요."
