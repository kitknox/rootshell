        }
      }
    },
    "Pick a Ghostty config file (config or config.ghostty) and rootshell will read the settings it supports — fonts, theme, cursor, palette, keybinds — into your existing settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ملف config لـ Ghostty (config أو config.ghostty) وسيقوم rootshell بقراءة الإعدادات المدعومة، الخطوط والسمة والمؤشر واللوحة والاختصارات، ودمجها مع إعداداتك الحالية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un fitxer de config de Ghostty (config o config.ghostty) i rootshell llegirà els ajustos compatibles — tipografies, tema, cursor, paleta, dreceres — als teus ajustos actuals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte konfigurační soubor Ghostty (config nebo config.ghostty) a rootshell načte podporovaná nastavení — písma, motiv, kurzor, paletu, zkratky — do vašich stávajících nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en Ghostty config-fil (config eller config.ghostty), så læser rootshell de understøttede indstillinger — skrifttyper, tema, markør, palet, genveje — ind i dine eksisterende indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Ghostty-Konfigurationsdatei (config oder config.ghostty) aus, und rootshell übernimmt die unterstützten Einstellungen — Schriften, Design, Cursor, Palette, Tastenkürzel — in deine vorhandenen Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo de configuración de Ghostty (config o config.ghostty) y rootshell leerá los ajustes compatibles (fuentes, tema, cursor, paleta, atajos) en tus ajustes actuales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse Ghostty config -tiedosto (config tai config.ghostty), niin rootshell lukee tukemansa asetukset — fontit, teeman, kohdistimen, paletin, pikanäppäimet — olemassa oleviin asetuksiisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fichier de configuration Ghostty (config ou config.ghostty) et rootshell lira les réglages pris en charge (polices, thème, curseur, palette, raccourcis) dans vos réglages existants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר קובץ config של Ghostty (config או config.ghostty) ו-rootshell יקרא את ההגדרות הנתמכות — גופנים, ערכת נושא, סמן, פלטה, קיצורים — אל ההגדרות הקיימות שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz egy Ghostty config fájlt (config vagy config.ghostty), és a rootshell beolvassa a támogatott beállításokat — betűtípusok, téma, kurzor, paletta, gyorsbillentyűk — a meglévő beállításaidba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un file di configurazione Ghostty (config o config.ghostty) e rootshell leggerà le impostazioni supportate (font, tema, cursore, tavolozza, scorciatoie) nelle tue impostazioni esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty の設定ファイル (config または config.ghostty) を選択すると、rootshell が対応する設定 — フォント、テーマ、カーソル、パレット、キーバインド — を既存の設定に読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty 설정 파일 (config 또는 config.ghostty)을 선택하면 rootshell이 지원하는 설정 — 글꼴, 테마, 커서, 팔레트, 키 바인딩 — 을 기존 설정에 읽어옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en Ghostty-config-fil (config eller config.ghostty), så leser rootshell inn de støttede innstillingene — skrifter, tema, markør, palett, hurtigtaster — i de eksisterende innstillingene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een Ghostty-configuratiebestand (config of config.ghostty) en rootshell leest de ondersteunde instellingen — lettertypen, thema, cursor, palet, sneltoetsen — in je bestaande instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz plik konfiguracyjny Ghostty (config lub config.ghostty), a rootshell wczyta obsługiwane ustawienia — czcionki, motyw, kursor, paletę, skróty — do Twoich istniejących ustawień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um arquivo de configuração do Ghostty (config ou config.ghostty) e o rootshell lerá os ajustes compatíveis (fontes, tema, cursor, paleta, atalhos) nos seus ajustes atuais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe um ficheiro de config do Ghostty (config ou config.ghostty) e o rootshell lerá as definições suportadas — tipos de letra, tema, cursor, paleta, atalhos — para as tuas definições existentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege un fișier de configurare Ghostty (config sau config.ghostty) și rootshell va citi setările acceptate — fonturi, temă, cursor, paletă, scurtături — în setările tale existente."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite datoteko config za Ghostty (config ali config.ghostty) in rootshell bo prebral podprte nastavitve — pisave, temo, kazalec, paleto, bližnjice — v vaše obstoječe nastavitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en Ghostty-konfigurationsfil (config eller config.ghostty), så läser rootshell in de inställningar som stöds — teckensnitt, tema, markör, palett, kortkommandon — till dina befintliga inställningar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть файл config для Ghostty (config або config.ghostty), і rootshell зчитає підтримувані налаштування — шрифти, тему, курсор, палітру, скорочення — у ваші наявні налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một tệp cấu hình Ghostty (config hoặc config.ghostty) và rootshell sẽ đọc các cài đặt mà nó hỗ trợ — phông chữ, giao diện, con trỏ, bảng màu, phím tắt — vào cài đặt hiện có của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个 Ghostty 配置文件 (config 或 config.ghostty),rootshell 将把它支持的设置 — 字体、主题、光标、调色板、键绑定 — 读入你现有的设置中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個 Ghostty 設定檔 (config 或 config.ghostty),rootshell 會將它支援的設定 — 字型、主題、游標、調色盤、按鍵綁定 — 讀入您現有的設定中。"
          }
        }
      }
    },
