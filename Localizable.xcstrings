        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver Enregistrer le mot de passe supprime le mot de passe enregistré lorsque vous enregistrez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כיבוי האפשרות שמור סיסמה מסיר את הסיסמה השמורה בעת השמירה."
