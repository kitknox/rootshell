    "Contains a line break or control character, so the login shell will be used." : {
      "comment" : "Local shell warning: illegal characters",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي على فاصل أسطر أو حرف تحكم، لذا ستُستخدم صدفة تسجيل الدخول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conté un salt de línia o un caràcter de control, així que s'utilitzarà el shell d'inici de sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsahuje konec řádku nebo řídicí znak, proto bude použit přihlašovací shell."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeholder et linjeskift eller et kontroltegn, så login-shellen bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält einen Zeilenumbruch oder ein Steuerzeichen, daher wird die Login-Shell verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene un salto de línea o un carácter de control, por lo que se usará la shell de inicio de sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältää rivinvaihdon tai ohjausmerkin, joten käytetään kirjautumiskomentotulkkia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contient un saut de ligne ou un caractère de contrôle : le shell de connexion sera utilisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכיל מעבר שורה או תו בקרה, ולכן תשמש מעטפת הכניסה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortörést vagy vezérlőkaraktert tartalmaz, ezért a bejelentkezési shell lesz használva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene un'interruzione di riga o un carattere di controllo, quindi verrà usata la shell di login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改行または制御文字が含まれているため、ログインシェルが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄바꿈 또는 제어 문자가 포함되어 있어 로그인 셸이 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inneholder et linjeskift eller kontrolltegn, så påloggingsskallet brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevat een regeleinde of stuurteken, dus de login-shell wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawiera znak nowego wiersza lub znak sterujący, więc zostanie użyta powłoka logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contém uma quebra de linha ou caractere de controle, portanto o shell de login será usado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contém uma quebra de linha ou carácter de controlo, por isso será usada a shell de login."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conține un salt de linie sau un caracter de control, așa că se va folosi shell-ul de autentificare."
