    "Syncing will stop. Your local data will be preserved, but changes will no longer sync across devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتوقف المزامنة. ستُحفظ بياناتك المحلية، لكن التغييرات لن تتم مزامنتها عبر الأجهزة بعد الآن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronització s'aturarà. Les vostres dades locals es conservaran, però els canvis ja no se sincronitzaran entre dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace se zastaví. Vaše lokální data budou zachována, ale změny se již nebudou synchronizovat napříč zařízeními."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen stopper. Dine lokale data bevares, men ændringer synkroniseres ikke længere på tværs af enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung wird beendet. Ihre lokalen Daten bleiben erhalten, aber Änderungen werden nicht mehr zwischen Geräten synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización se detendrá. Sus datos locales se conservarán, pero los cambios ya no se sincronizarán entre dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi lopetetaan. Paikalliset tietosi säilyvät, mutta muutokset eivät enää synkronoidu laitteiden välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation sera arrêtée. Vos données locales seront conservées, mais les modifications ne seront plus synchronisées entre les appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסנכרון ייפסק. הנתונים המקומיים שלך יישמרו, אך שינויים לא יסונכרנו עוד בין מכשירים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szinkronizálás leáll. A helyi adatok megmaradnak, de a módosítások többé nem szinkronizálódnak az eszközök között."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione verrà interrotta. I dati locali verranno conservati, ma le modifiche non saranno più sincronizzate tra i dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期が停止します。ローカルデータは保持されますが、デバイス間での変更の同期は行われなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 중지됩니다. 로컬 데이터는 보존되지만 변경 사항이 더 이상 기기 간에 동기화되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen stoppes. Dine lokale data bevares, men endringer synkroniseres ikke lenger på tvers av enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie wordt gestopt. Uw lokale gegevens blijven bewaard, maar wijzigingen worden niet meer gesynchroniseerd tussen apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja zostanie zatrzymana. Lokalne dane zostaną zachowane, ale zmiany nie będą już synchronizowane między urządzeniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização será interrompida. Seus dados locais serão preservados, mas as alterações não serão mais sincronizadas entre dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização será interrompida. Os seus dados locais serão preservados, mas as alterações deixarão de ser sincronizadas entre dispositivos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea se va opri. Datele locale vor fi păstrate, dar modificările nu se vor mai sincroniza între dispozitive."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinhronizacija se bo ustavila. Vaši lokalni podatki bodo ohranjeni, vendar se spremembe ne bodo več sinhronizirale med napravami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkning kommer att stoppas. Din lokala data bevaras, men ändringar synkas inte längre mellan enheter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію буде зупинено. Ваші локальні дані збережуться, але зміни більше не синхронізуватимуться між пристроями."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ sẽ dừng lại. Dữ liệu cục bộ của bạn sẽ được giữ nguyên, nhưng các thay đổi sẽ không còn được đồng bộ giữa các thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步将停止。您的本地数据将被保留，但更改将不再跨设备同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步將停止。您的本機資料將被保留，但變更將不再跨裝置同步。"
          }
        }
      }
    },
