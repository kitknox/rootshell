          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une clé existe déjà dans %@, elle sera définitivement remplacée. La clé privée sera transférée du stockage logiciel vers votre YubiKey."
          }
