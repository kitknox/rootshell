    "Supports mosh-server (local echo), tsshd (QUIC/KCP with NAT traversal), and Multipath TCP for seamless WiFi/cellular handover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم mosh-server (الصدى المحلي)، وtsshd (QUIC/KCP مع اجتياز NAT)، وMultipath TCP للتبديل السلس بين WiFi والبيانات الخلوية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible amb mosh-server (eco local), tsshd (QUIC/KCP amb travessa de NAT) i Multipath TCP per a una transició fluida entre Wi-Fi i cel·lular."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporuje mosh-server (lokální echo), tsshd (QUIC/KCP s průchodem NAT) a Multipath TCP pro plynulý přechod mezi WiFi a mobilními daty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøtter mosh-server (lokalt ekko), tsshd (QUIC/KCP med NAT-traversering) og Multipath TCP til problemfrit WiFi/mobil-skift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützt mosh-server (lokales Echo), tsshd (QUIC/KCP mit NAT-Traversal) und Multipath TCP für nahtloses WLAN-/Mobilfunk-Umschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con mosh-server (eco local), tsshd (QUIC/KCP con NAT traversal) y Multipath TCP para transición fluida entre WiFi y datos móviles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukee mosh-server-palvelinta (paikallinen kaiku), tsshd:tä (QUIC/KCP NAT-läpäisyllä) sekä Multipath TCP:tä saumattomaan WiFi/mobiili-siirtymään."
          }
        },
        "fr" : {
