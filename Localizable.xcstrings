          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt als TERM verzonden. Leeg neemt de instelling over van Instellingen > Terminal > Terminaltype."
          }
        },
        "pl" : {
          "stringUnit" : {
