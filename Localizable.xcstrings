    "Fast flicker of individual rays. Turn off for calm, slow drift only" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وميض سريع للأشعة الفردية. أوقفه للحصول على انجراف بطيء وهادئ فقط"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parpelleig ràpid de cada raig. Desactiveu-ho per a una deriva lenta i tranquil·la només"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlé blikání jednotlivých paprsků. Vypněte pro klidný, pomalý posun bez blikání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtig flimren af enkelte stråler. Slå fra for kun rolig, langsom drift"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelles Flackern einzelner Strahlen. Ausschalten für ruhiges, langsames Driften"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parpadeo rápido de rayos individuales. Desactívalo para un movimiento lento y tranquilo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäisten säteiden nopea välkyntä. Poista käytöstä, jos haluat vain rauhallista, hidasta liikettä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scintillement rapide des rayons individuels. Désactivez pour un simple flottement lent et apaisant"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבהוב מהיר של קרניים בודדות. כבה לתנועה רגועה ואיטית בלבד"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyes sugarak gyors villódzása. Kapcsolja ki a nyugodt, lassú sodródáshoz"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfarfallio rapido dei singoli raggi. Disattiva per un movimento lento e tranquillo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個々の光線が速く明滅します。落ち着いたゆっくりとした揺らぎだけにするにはオフにします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개별 광선이 빠르게 깜박입니다. 차분하고 느린 흐름만 원하면 끄세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rask flimring av enkeltstråler. Slå av for rolig, langsom drift alene"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snel flikkeren van afzonderlijke stralen. Schakel uit voor alleen rustige, langzame beweging"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkie migotanie pojedynczych promieni. Wyłącz, aby uzyskać spokojny, powolny dryf"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tremulação rápida de raios individuais. Desligue para um movimento calmo e lento apenas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tremeluzir rápido dos raios individuais. Desligue para apenas uma deriva lenta e calma"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pâlpâire rapidă a razelor individuale. Dezactivați pentru o deplasare calmă și lentă"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitro utripanje posameznih žarkov. Izključite za miren, počasen lebd brez utripanja"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbt flimmer i enskilda strålar. Stäng av för enbart lugn, långsam drift"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидке мерехтіння окремих променів. Вимкніть для спокійного, повільного дрейфу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp nháy nhanh của từng tia sáng. Tắt để chỉ trôi chậm, êm dịu"
