    "The list stays hidden until revealed, so opening this screen during a screen share never exposes it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى القائمة مخفية حتى يتم إظهارها، لذا فإن فتح هذه الشاشة أثناء مشاركة الشاشة لا يكشفها أبداً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llista es manté oculta fins que la mostreu, de manera que obrir aquesta pantalla mentre compartiu la pantalla no l'exposa mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam zůstává skrytý, dokud jej neodhalíte, takže otevření této obrazovky během sdílení obrazovky jej nikdy neprozradí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen forbliver skjult, indtil du viser den, så den aldrig bliver afsløret, hvis du åbner denne skærm under en skærmdeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste bleibt ausgeblendet, bis sie eingeblendet wird – das Öffnen dieses Bildschirms während einer Bildschirmfreigabe legt sie also nie offen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista permanece oculta hasta que la muestras, de modo que abrir esta pantalla mientras compartes pantalla nunca la deja a la vista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettelo pysyy piilossa, kunnes paljastat sen, joten tämän näkymän avaaminen näytön jakamisen aikana ei paljasta sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste reste masquée jusqu'à ce que vous l'affichiez, de sorte que l'ouverture de cet écran pendant un partage d'écran ne l'expose jamais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשימה נשארת מוסתרת עד שחושפים אותה, כך שפתיחת מסך זה במהלך שיתוף מסך לעולם אינה חושפת אותה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista rejtve marad, amíg fel nem fedi, így képernyőmegosztás közben ennek a képernyőnek a megnyitása sem árulja el a tartalmát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'elenco resta nascosto finché non lo mostri, così aprire questa schermata durante una condivisione dello schermo non lo espone mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストは表示するまで隠されたままなので、画面共有中にこの画面を開いても内容が見られることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록은 표시하기 전까지 숨겨져 있으므로, 화면 공유 중에 이 화면을 열어도 노출되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen forblir skjult til du viser den, slik at den aldri blir eksponert om du åpner dette skjermbildet under en skjermdeling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lijst blijft verborgen totdat u deze toont, zodat het openen van dit scherm tijdens schermdelen de lijst nooit prijsgeeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
