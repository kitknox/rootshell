          }
        }
      }
    },
    "Sent as terminal input when you tap the button." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسل كمدخل للطرفية عند الضغط على الزر."
