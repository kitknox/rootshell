    "Reuse a custom provider from an existing opkssh key. Tap to load it into the form below, then edit if needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد استخدام مزود مخصص من مفتاح opkssh موجود. اضغط لتحميله في النموذج أدناه، ثم عدّله إذا لزم الأمر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilitza un proveïdor personalitzat d’una clau opkssh existent. Toca per carregar-lo al formulari de sota i edita’l si cal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu použijte vlastního poskytovatele z existujícího klíče opkssh. Klepnutím jej načtete do formuláře níže a podle potřeby upravíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genbrug en brugerdefineret udbyder fra en eksisterende opkssh-nøgle. Tryk for at indlæse den i formularen nedenfor, og rediger om nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einen benutzerdefinierten Anbieter aus einem vorhandenen opkssh-Schlüssel wieder. Tippe, um ihn in das Formular unten zu laden, und bearbeite ihn bei Bedarf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutiliza un proveedor personalizado de una clave opkssh existente. Toca para cargarlo en el formulario de abajo y edítalo si es necesario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä uudelleen mukautettua palveluntarjoajaa olemassa olevasta opkssh-avaimesta. Lataa se alla olevaan lomakkeeseen napauttamalla ja muokkaa tarvittaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réutilisez un fournisseur personnalisé d’une clé opkssh existante. Touchez pour le charger dans le formulaire ci-dessous, puis modifiez-le si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמשו שוב בספק מותאם אישית ממפתח opkssh קיים. הקישו כדי לטעון אותו לטופס שלמטה, וערכו אותו במידת הצורך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használjon újra egy egyéni szolgáltatót egy meglévő opkssh-kulcsból. Koppintson a betöltéséhez az alábbi űrlapba, majd szükség esetén szerkessze."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riutilizza un provider personalizzato da una chiave opkssh esistente. Tocca per caricarlo nel modulo sottostante, quindi modificalo se necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の opkssh キーからカスタムプロバイダを再利用します。タップして下のフォームに読み込み、必要に応じて編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 opkssh 키에서 사용자 지정 제공자를 재사용합니다. 탭하여 아래 양식에 불러온 다음 필요하면 편집하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenbruk en egendefinert leverandør fra en eksisterende opkssh-nøkkel. Trykk for å laste den inn i skjemaet nedenfor, og rediger om nødvendig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hergebruik een aangepaste provider van een bestaande opkssh-sleutel. Tik om deze in het onderstaande formulier te laden en bewerk indien nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj ponownie niestandardowego dostawcy z istniejącego klucza opkssh. Dotknij, aby załadować go do poniższego formularza, a następnie w razie potrzeby edytuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilize um provedor personalizado de uma chave opkssh existente. Toque para carregá-lo no formulário abaixo e edite se necessário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilize um fornecedor personalizado de uma chave opkssh existente. Toque para carregá-lo no formulário abaixo e edite se necessário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizează un furnizor personalizat dintr-o cheie opkssh existentă. Atinge pentru a-l încărca în formularul de mai jos, apoi editează-l dacă este necesar."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovno uporabite ponudnika po meri iz obstoječega ključa opkssh. Tapnite, da ga naložite v spodnji obrazec, in ga po potrebi uredite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återanvänd en anpassad leverantör från en befintlig opkssh-nyckel. Tryck för att läsa in den i formuläret nedan och redigera vid behov."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно використайте власного провайдера з наявного ключа opkssh. Торкніться, щоб завантажити його у форму нижче, і за потреби відредагуйте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tái sử dụng nhà cung cấp tùy chỉnh từ khóa opkssh hiện có. Chạm để tải vào biểu mẫu bên dưới, sau đó chỉnh sửa nếu cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重用现有 opkssh 密钥中的自定义提供商。点按可将其载入下方表单，然后按需编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
