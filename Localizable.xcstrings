    "Typed input is queued while tssh is offline and delivered after reconnect." : {
      "comment" : "tssh keep pending input enabled footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم وضع الإدخال المكتوب في قائمة الانتظار أثناء عدم اتصال tssh، ويُرسل بعد إعادة الاتصال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrada escrita es posa en cua mentre tssh està desconnectat i s'envia després de reconnectar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadaný vstup je při odpojení tssh zařazen do fronty a doručen po opětovném připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtastet input sættes i kø, mens tssh er offline, og leveres efter genoprettet forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingegebener Text wird in die Warteschlange gestellt, während tssh offline ist, und nach erneutem Verbinden gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada escrita se pone en cola mientras tssh está desconectado y se envía tras la reconexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoitettu syöte asetetaan jonoon tssh:n ollessa offline-tilassa ja toimitetaan uudelleenyhdistämisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La saisie est mise en file d'attente lorsque tssh est hors ligne, puis envoyée après la reconnexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלט שהוקלד מתווסף לתור בזמן ש-tssh במצב לא מקוון ונשלח לאחר ההתחברות מחדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beírt szöveg sorba kerül, amíg a tssh offline, és újracsatlakozás után kerül elküldésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'input digitato viene messo in coda mentre tssh è offline e inviato dopo la riconnessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tsshがオフラインの間に入力された文字はキューに保持され、再接続後に送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tssh가 오프라인인 동안 입력한 내용은 대기열에 보관되며 재연결 후 전송됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inndata som skrives mens tssh er frakoblet, settes i kø og sendes etter at tilkoblingen er gjenopprettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getypte invoer wordt in de wachtrij geplaatst terwijl tssh offline is en verzonden na opnieuw verbinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisywany tekst jest kolejkowany, gdy tssh jest offline, i wysyłany po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada digitada é enfileirada enquanto o tssh está offline e enviada após a reconexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada introduzida é colocada em fila enquanto o tssh está offline e enviada após a religação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intrarea tastată este pusă în coadă cât timp tssh este offline și trimisă după reconectare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vneseni vnos je v čakalni vrsti, ko tssh ni povezan, in dostavljen po ponovni vzpostavitvi povezave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inmatad text köas medan tssh är frånkopplad och skickas efter återanslutning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введений текст ставиться у чергу, поки tssh офлайн, і надсилається після перепідключення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu vào được nhập sẽ được xếp hàng trong khi tssh ngoại tuyến và được gửi sau khi kết nối lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tssh 离线期间输入的内容将排入队列，并在重新连接后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tssh 離線期間輸入的內容將排入佇列，並在重新連線後傳送。"
          }
        }
      }
    },
    "Typed input while tssh is offline is discarded by default to avoid replaying stale commands." : {
      "comment" : "tssh keep pending input disabled footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تجاهل الإدخال المكتوب أثناء عدم اتصال tssh افتراضيًا لتجنّب إعادة تشغيل أوامر قديمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per defecte, l'entrada escrita mentre tssh està desconnectat es descarta per evitar reproduir ordres obsoletes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vstup zadaný v době, kdy je tssh offline, je ve výchozím nastavení zahozen, aby se zabránilo opětovnému spouštění zastaralých příkazů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input, der indtastes, mens tssh er offline, kasseres som standard for at undgå at gentage forældede kommandoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingaben, während tssh offline ist, werden standardmäßig verworfen, um veraltete Befehle nicht erneut auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada escrita mientras tssh está desconectado se descarta de forma predeterminada para evitar reejecutar comandos obsoletos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tssh:n ollessa offline-tilassa kirjoitettu syöte hylätään oletuksena, jotta vanhentuneita komentoja ei suoriteta uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La saisie effectuée pendant que tssh est hors ligne est ignorée par défaut afin d'éviter de rejouer des commandes obsolètes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלט שהוקלד בזמן ש-tssh במצב לא מקוון מבוטל כברירת מחדל כדי למנוע הפעלה חוזרת של פקודות ישנות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tssh offline állapotában beírt szöveg alapértelmezetten elvetésre kerül, hogy elkerülhető legyen az elavult parancsok újrafuttatása."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'input digitato mentre tssh è offline viene ignorato per impostazione predefinita per evitare di rieseguire comandi obsoleti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tsshがオフライン中に入力された文字は、古いコマンドの再実行を防ぐためにデフォルトで破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tssh가 오프라인일 때 입력된 내용은 오래된 명령을 다시 실행하지 않도록 기본적으로 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inndata som skrives mens tssh er frakoblet, forkastes som standard for å unngå å sende utdaterte kommandoer på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invoer die wordt getypt terwijl tssh offline is, wordt standaard genegeerd om verouderde opdrachten niet opnieuw uit te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisywany tekst w czasie, gdy tssh jest offline, jest domyślnie odrzucany, aby uniknąć ponownego wykonania nieaktualnych poleceń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada digitada enquanto o tssh está offline é descartada por padrão para evitar reexecutar comandos desatualizados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada introduzida enquanto o tssh está offline é descartada por predefinição para evitar reexecutar comandos desatualizados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intrarea tastată cât timp tssh este offline este ignorată implicit pentru a evita reluarea comenzilor învechite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnos, vnesen, ko je tssh brez povezave, je privzeto zavržen, da se prepreči ponovno izvajanje zastarelih ukazov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inmatad text medan tssh är frånkopplad ignoreras som standard för att undvika att gamla kommandon körs igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введений текст, поки tssh офлайн, відкидається за замовчуванням, щоб уникнути повторного запуску застарілих команд."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu vào được nhập trong khi tssh ngoại tuyến sẽ bị bỏ qua theo mặc định để tránh chạy lại các lệnh cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认情况下，tssh 离线时输入的内容将被丢弃，以避免重新执行过时的命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，tssh 離線時輸入的內容將被捨棄，以避免重新執行過時的命令。"
          }
        }
      }
    },
