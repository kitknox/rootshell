        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul MCP permite instrumentelor AI precum Claude Code, Codex și Gemini CLI să execute comenzi SSH și să acceseze resurse cloud. Conexiunile noi necesită aprobarea dvs."
