    "Configure SSH access to scan AP radios for band information. Requires SSH access to your UniFi devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإعداد وصول SSH لفحص أجهزة راديو AP للحصول على معلومات النطاق. يتطلب وصول SSH إلى أجهزة UniFi الخاصة بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configureu l'accés SSH per escanejar els ràdios dels AP i obtenir informació de banda. Requereix accés SSH als vostres dispositius UniFi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte přístup SSH pro skenování rádiových modulů AP a získání informací o pásmech. Vyžaduje přístup SSH k vašim zařízením UniFi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurer SSH-adgang for at scanne AP-radioer for båndinformation. Kræver SSH-adgang til dine UniFi-enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
