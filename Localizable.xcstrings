          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam ostane skrit, dokler ga ne razkrijete, zato odpiranje tega zaslona med skupno rabo zaslona nikoli ne razkrije njegove vsebine."
