    "Run commands locally on your iOS device. Supported commands include ls, cd, pwd, cat, grep, curl, and more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الأوامر محلياً على جهاز iOS الخاص بك. تشمل الأوامر المدعومة ls وcd وpwd وcat وgrep وcurl وغيرها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
