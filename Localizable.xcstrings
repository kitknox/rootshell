    "Trust a certificate authority once and hosts presenting a matching, CA-signed certificate connect without a host-key prompt — even when their keys rotate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وثِّق بهيئة إصدار شهادات مرة واحدة، فيتصل المضيفون الذين يقدّمون شهادة مطابقة موقّعة من الـ CA دون طلب مفتاح المضيف — حتى عند تدوير مفاتيحهم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confia en una autoritat de certificació un sol cop i els amfitrions que presentin un certificat coincident signat per la CA es connectaran sense sol·licitud de clau d'amfitrió — fins i tot quan les seves claus es renovin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Důvěřujte certifikační autoritě jednou a hostitelé předkládající odpovídající certifikát podepsaný CA se připojí bez výzvy ke klíči hostitele — i když se jejich klíče změní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betro en certifikatudsteder én gang, og værter, der viser et matchende, CA-signeret certifikat, opretter forbindelse uden en værtsnøgleprompt — også når deres nøgler roteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stufen Sie eine Zertifizierungsstelle einmal als vertrauenswürdig ein, und Hosts, die ein passendes, CA-signiertes Zertifikat vorweisen, verbinden sich ohne Host-Schlüssel-Abfrage — selbst wenn ihre Schlüssel rotieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confía una vez en una autoridad de certificación y los hosts que presenten un certificado coincidente firmado por la CA se conectarán sin solicitar la clave de host — incluso cuando sus claves roten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luota varmentajaan kerran, niin vastaavan, CA:n allekirjoittaman varmenteen esittävät isännät yhdistävät ilman isäntäavaimen kyselyä — silloinkin kun niiden avaimet vaihtuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvez une autorité de certification une seule fois et les hôtes présentant un certificat correspondant signé par la CA se connectent sans demande de clé d'hôte — même lorsque leurs clés changent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תן אמון ברשות אישורים פעם אחת, ומארחים שמציגים אישור תואם חתום על ידי CA יתחברו ללא בקשת מפתח מארח — גם כאשר המפתחות שלהם מתחלפים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bízzon meg egyszer egy tanúsítványkiadóban, és az egyező, CA által aláírt tanúsítványt bemutató gazdagépek gazdagépkulcs-kérés nélkül csatlakoznak — még akkor is, ha a kulcsaik váltakoznak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi attendibile un'autorità di certificazione una sola volta e gli host che presentano un certificato corrispondente firmato dalla CA si connettono senza richiesta di chiave host — anche quando le loro chiavi cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証局を一度信頼すれば、一致するCA署名済み証明書を提示するホストは、鍵がローテーションされても、ホストキーの確認なしに接続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증 기관을 한 번 신뢰하면 일치하는 CA 서명 인증서를 제시하는 호스트는 키가 교체되더라도 호스트 키 확인 없이 연결됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarer en sertifiseringsinstans én gang, så kobler verter som viser et samsvarende, CA-signert sertifikat til uten vertsnøkkelforespørsel — selv når nøklene deres roteres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrouw een certificaatautoriteit één keer en hosts die een overeenkomend, door de CA ondertekend certificaat tonen maken verbinding zonder hostsleutelprompt — zelfs wanneer hun sleutels roteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaufaj urzędowi certyfikacji raz, a hosty przedstawiające pasujący certyfikat podpisany przez CA łączą się bez monitu o klucz hosta — nawet gdy ich klucze są rotowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie em uma autoridade certificadora uma vez e os hosts que apresentarem um certificado correspondente assinado por ela se conectam sem solicitar a chave de host — mesmo quando suas chaves forem rotacionadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie numa autoridade de certificação uma vez e os anfitriões que apresentem um certificado correspondente, assinado pela CA, ligam-se sem pedido de chave de anfitrião — mesmo quando as suas chaves são alternadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aveți încredere o singură dată într-o autoritate de certificare, iar gazdele care prezintă un certificat corespunzător, semnat de CA, se conectează fără solicitarea cheii de gazdă — chiar și atunci când cheile lor se schimbă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkrat zaupajte overitelju potrdil in gostitelji, ki predložijo ustrezno, s CA podpisano potrdilo, se povežejo brez poziva za gostiteljski ključ — tudi ko se njihovi ključi zamenjajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lita på en certifikatutfärdare en gång så ansluter värdar som visar ett matchande, CA-signerat certifikat utan att fråga om värdnyckel — även när deras nycklar roterar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один раз довіртеся центру сертифікації — і хости, що надають відповідний підписаний CA сертифікат, підключатимуться без запиту ключа хоста — навіть коли їхні ключі змінюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin cậy một tổ chức chứng thực một lần và các máy chủ xuất trình chứng chỉ phù hợp do CA ký sẽ kết nối mà không cần lời nhắc khóa máy chủ — kể cả khi khóa của chúng thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需信任证书颁发机构一次，出示匹配的、由该 CA 签名证书的主机即可无需主机密钥提示直接连接——即便其密钥轮换也无影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需信任憑證授權單位一次，出示相符且由 CA 簽署之憑證的主機即可連線，無需主機金鑰提示——即使其金鑰輪替也一樣。"
          }
        }
      }
    },
