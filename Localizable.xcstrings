    "Sets the initial panning mode for new Screen Sharing sessions. You can change it for the current session from the Screen Sharing menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد وضع التحريك الأولي لجلسات مشاركة الشاشة الجديدة. يمكنك تغييره للجلسة الحالية من قائمة مشاركة الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estableix el mode de desplaçament inicial per a les noves sessions de Compartir pantalla. Pots canviar-lo per a la sessió actual des del menú de Compartir pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavuje počáteční režim posouvání pro nové relace sdílení obrazovky. Pro aktuální relaci ho můžete změnit v nabídce Sdílení obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiver den indledende panoreringstilstand for nye Skærmdeling-sessioner. Du kan ændre den for den aktuelle session i Skærmdeling-menuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt den anfänglichen Schwenkmodus für neue Bildschirmfreigabe-Sitzungen fest. Sie können ihn für die aktuelle Sitzung im Bildschirmfreigabe-Menü ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece el modo de desplazamiento inicial para las nuevas sesiones de Compartir pantalla. Puedes cambiarlo para la sesión actual desde el menú de Compartir pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määrittää uusien näytön jakamisen istuntojen alkuperäisen panorointitilan. Voit vaihtaa sen nykyisessä istunnossa Näytön jakaminen -valikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit le mode panoramique initial des nouvelles sessions de partage d'écran. Vous pouvez le changer pour la session en cours depuis le menu Partage d'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובע את מצב ההזזה ההתחלתי להפעלות חדשות של שיתוף מסך. ניתן לשנות אותו עבור ההפעלה הנוכחית מתפריט שיתוף המסך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja az új képernyőmegosztási munkamenetek kezdeti pásztázási módját. Az aktuális munkamenethez a Képernyőmegosztás menüben módosítható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la modalità di panoramica iniziale per le nuove sessioni di Condivisione schermo. Puoi cambiarla per la sessione corrente dal menu Condivisione schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい画面共有セッションの初期パンモードを設定します。現在のセッションでは画面共有メニューから変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 화면 공유 세션의 초기 패닝 모드를 설정합니다. 현재 세션에서는 화면 공유 메뉴에서 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angir startpanoreringsmodus for nye Skjermdeling-økter. Du kan endre den for den aktive økten fra Skjermdeling-menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt de aanvankelijke verschuivingsmodus voor nieuwe Schermdelen-sessies. Je kunt deze voor de huidige sessie wijzigen via het Schermdelen-menu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia początkowy tryb przesuwania dla nowych sesji udostępniania ekranu. Możesz go zmienić dla bieżącej sesji w menu Udostępniania ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o modo de deslocamento inicial para novas sessões de Compartilhamento de Tela. Você pode alterá-lo para a sessão atual no menu de Compartilhamento de Tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o modo de deslocamento inicial para as novas sessões de Partilha de Ecrã. Pode alterá-lo para a sessão atual no menu de Partilha de Ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilește modul inițial de panoramare pentru sesiunile noi de partajare a ecranului. Îl puteți schimba pentru sesiunea curentă din meniul Partajare ecran."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavi začetni način premikanja za nove seje skupne rabe zaslona. Za trenutno sejo ga lahko spremenite v meniju Skupna raba zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger det inledande panoreringsläget för nya Skärmdelning-sessioner. Du kan ändra det för den aktuella sessionen i Skärmdelning-menyn."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлює початковий режим панорамування для нових сеансів спільного доступу до екрана. Ви можете змінити його для поточного сеансу в меню спільного доступу до екрана."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt chế độ di chuyển ban đầu cho các phiên Chia sẻ màn hình mới. Bạn có thể thay đổi cho phiên hiện tại từ menu Chia sẻ màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置新屏幕共享会话的初始平移模式。您可以在屏幕共享菜单中为当前会话更改它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定新螢幕共享工作階段的初始平移模式。您可以在螢幕共享選單中為目前的工作階段更改。"
          }
        }
      }
    },
