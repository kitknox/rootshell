    "Custom padding active. Reset to restore the platform default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حشو مخصص مُفعَّل. أعد التعيين لاستعادة الإعداد الافتراضي للنظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaiat intern personalitzat actiu. Restableix per restaurar el valor per defecte de la plataforma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní vnitřní okraj je aktivní. Obnovením vrátíte výchozí hodnotu platformy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpasset udfyldning er aktiv. Nulstil for at gendanne platformens standard."
