    "Transient prompt replaces the full prompt with ❯ after running a command. Right prompt moves the clock to the right side of the info bar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموجه المؤقت يستبدل موجه الأوامر الكامل بالرمز ❯ بعد تنفيذ أمر. الموجه الأيمن ينقل الساعة إلى الجانب الأيمن من شريط المعلومات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indicador transitori substitueix l’indicador complet per ❯ després d’executar una ordre. L’indicador dret mou el rellotge al costat dret de la barra d’informació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přechodný prompt nahradí po spuštění příkazu celý prompt znakem ❯. Pravý prompt přesune hodiny na pravou stranu informačního panelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midlertidig prompt erstatter den fulde prompt med ❯ efter en kommando er kørt. Højre prompt flytter uret til højre side af infobjælken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der flüchtige Prompt ersetzt den vollständigen Prompt nach einem Befehl durch ❯. Der rechte Prompt verschiebt die Uhr auf die rechte Seite der Infoleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El indicador transitorio reemplaza el indicador completo por ❯ tras ejecutar un comando. El indicador derecho mueve el reloj al lado derecho de la barra de información."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katoava kehote korvaa täyden kehotteen ❯-merkillä komennon suorittamisen jälkeen. Oikea kehote siirtää kellon infopalkin oikealle puolelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’invite transitoire remplace l’invite complète par ❯ après l’exécution d’une commande. L’invite à droite déplace l’horloge vers le côté droit de la barre d’infos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שורת פקודה זמנית מחליפה את שורת הפקודה המלאה בסימן ❯ לאחר הרצת פקודה. שורת פקודה ימנית מעבירה את השעון לצד ימין של סרגל המידע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az átmeneti prompt parancs futtatása után a teljes promptot ❯ jelre cseréli. A jobb oldali prompt az órát az infósáv jobb oldalára helyezi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prompt transitorio sostituisce il prompt completo con ❯ dopo l’esecuzione di un comando. Il prompt a destra sposta l’orologio sul lato destro della barra informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時プロンプトはコマンド実行後にフルプロンプトを ❯ に置き換えます。右プロンプトは時計をインフォバーの右側に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 프롬프트는 명령 실행 후 전체 프롬프트를 ❯ 로 대체합니다. 오른쪽 프롬프트는 시계를 정보 표시줄의 오른쪽으로 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midlertidig prompt erstatter den fullstendige prompten med ❯ etter at en kommando er kjørt. Høyre prompt flytter klokken til høyre side av infolinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vluchtige prompt vervangt de volledige prompt door ❯ na het uitvoeren van een opdracht. De rechter prompt verplaatst de klok naar de rechterkant van de infobalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejściowy prompt zastępuje pełny prompt znakiem ❯ po wykonaniu polecenia. Prawy prompt przenosi zegar na prawą stronę paska informacyjnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prompt transitório substitui o prompt completo por ❯ após executar um comando. O prompt à direita move o relógio para o lado direito da barra de informações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prompt transitório substitui o prompt completo por ❯ após executar um comando. O prompt à direita move o relógio para o lado direito da barra de informação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promptul tranzitoriu înlocuiește promptul complet cu ❯ după executarea unei comenzi. Promptul la dreapta mută ceasul în partea dreaptă a barei de informații."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prehodni poziv po izvedbi ukaza nadomesti celoten poziv z znakom ❯. Desni poziv premakne uro na desno stran informacijske vrstice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillfällig prompt ersätter den fullständiga prompten med ❯ efter att ett kommando körts. Höger prompt flyttar klockan till höger sida av infofältet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тимчасовий запит замінює повний запит на ❯ після виконання команди. Правий запит переміщує годинник на праву сторону інформаційної панелі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu nhắc tạm thời thay thế dấu nhắc đầy đủ bằng ❯ sau khi chạy lệnh. Dấu nhắc bên phải di chuyển đồng hồ sang bên phải thanh thông tin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瞬态提示符在运行命令后将完整提示符替换为 ❯。右侧提示符将时钟移至信息栏的右侧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瞬態提示符在執行指令後將完整提示符替換為 ❯。右側提示符將時鐘移至資訊列的右側。"
          }
        }
      }
    },
