    "Modern elliptic-curve key. Fast, compact, and supported by OpenSSH 6.5+ (2014) and every current SSH server." : {
      "comment" : "SSH key generation: Ed25519 footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح حديث على المنحنى الناقص. سريع ومدمج ومدعوم من OpenSSH 6.5+ (2014) وجميع خوادم SSH الحالية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clau moderna de corba el·líptica. Ràpida, compacta i compatible amb OpenSSH 6.5+ (2014) i tots els servidors SSH actuals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderní klíč eliptické křivky. Rychlý, kompaktní a podporovaný OpenSSH 6.5+ (2014) i všemi současnými SSH servery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderne elliptisk-kurve-nøgle. Hurtig, kompakt og understøttet af OpenSSH 6.5+ (2014) og enhver aktuel SSH-server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderner Elliptische-Kurven-Schlüssel. Schnell, kompakt und unterstützt von OpenSSH 6.5+ (2014) und jedem aktuellen SSH-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clave moderna de curva elíptica. Rápida, compacta y compatible con OpenSSH 6.5+ (2014) y todos los servidores SSH actuales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderni elliptisen käyrän avain. Nopea, kompakti ja tuettu OpenSSH 6.5+:ssa (2014) ja kaikissa nykyisissä SSH-palvelimissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé moderne à courbe elliptique. Rapide, compacte et prise en charge par OpenSSH 6.5+ (2014) et tous les serveurs SSH actuels."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתח עקומה אליפטית מודרני. מהיר, קומפקטי ונתמך על ידי OpenSSH 6.5+ (2014) וכל שרת SSH עדכני."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern elliptikus görbe alapú kulcs. Gyors, kompakt és támogatott az OpenSSH 6.5+ (2014) és minden jelenlegi SSH-kiszolgáló által."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiave moderna a curva ellittica. Veloce, compatta e supportata da OpenSSH 6.5+ (2014) e da ogni server SSH attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現代的な楕円曲線鍵。高速かつコンパクトで、OpenSSH 6.5+ (2014) およびすべての最新SSHサーバーでサポートされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 타원 곡선 키. 빠르고 작으며 OpenSSH 6.5+ (2014)와 모든 최신 SSH 서버에서 지원합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderne ellipsekurvenøkkel. Rask, kompakt og støttet av OpenSSH 6.5+ (2014) og alle nåværende SSH-servere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderne elliptische-curve-sleutel. Snel, compact en ondersteund door OpenSSH 6.5+ (2014) en elke huidige SSH-server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowoczesny klucz krzywej eliptycznej. Szybki, kompaktowy i obsługiwany przez OpenSSH 6.5+ (2014) oraz każdy obecny serwer SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave moderna de curva elíptica. Rápida, compacta e compatível com OpenSSH 6.5+ (2014) e todos os servidores SSH atuais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave moderna de curva elíptica. Rápida, compacta e compatível com OpenSSH 6.5+ (2014) e todos os servidores SSH atuais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheie modernă cu curbă eliptică. Rapidă, compactă și acceptată de OpenSSH 6.5+ (2014) și de orice server SSH actual."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodoben ključ z eliptično krivuljo. Hiter, kompakten in podprt v OpenSSH 6.5+ (2014) ter vsakem trenutnem strežniku SSH."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern nyckel med elliptisk kurva. Snabb, kompakt och stöds av OpenSSH 6.5+ (2014) och alla nuvarande SSH-servrar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сучасний ключ еліптичної кривої. Швидкий, компактний і підтримується OpenSSH 6.5+ (2014) та всіма сучасними SSH-серверами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa đường cong elliptic hiện đại. Nhanh, gọn và được hỗ trợ bởi OpenSSH 6.5+ (2014) cùng mọi máy chủ SSH hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现代椭圆曲线密钥。快速、紧凑,OpenSSH 6.5+ (2014) 及当前所有 SSH 服务器均支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
