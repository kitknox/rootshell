    "VPN tunneling is currently only available on iOS and iPadOS. Settings configured here will apply when this profile is used on those devices." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفق VPN متاح حالياً فقط على iOS وiPadOS. ستُطبّق الإعدادات المهيأة هنا عند استخدام هذا الملف الشخصي على تلك الأجهزة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel VPN actualment només està disponible a iOS i iPadOS. La configuració establerta aquí s'aplicarà quan aquest perfil s'utilitzi en aquests dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelování VPN je aktuálně dostupné pouze na iOS a iPadOS. Nastavení nakonfigurovaná zde se uplatní při použití tohoto profilu na těchto zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-tunneling er i øjeblikket kun tilgængelig på iOS og iPadOS. Indstillinger konfigureret her vil gælde, når denne profil bruges på disse enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-Tunneling ist derzeit nur auf iOS und iPadOS verfügbar. Die hier konfigurierten Einstellungen gelten, wenn dieses Profil auf diesen Geräten verwendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel VPN actualmente solo está disponible en iOS e iPadOS. Los ajustes configurados aquí se aplicarán cuando este perfil se use en esos dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-tunnelointi on tällä hetkellä saatavilla vain iOS- ja iPadOS-laitteilla. Tässä määritetyt asetukset otetaan käyttöön, kun profiilia käytetään kyseisillä laitteilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tunneling VPN n'est actuellement disponible que sur iOS et iPadOS. Les paramètres configurés ici s'appliqueront lorsque ce profil sera utilisé sur ces appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנהור VPN זמין כרגע רק ב-iOS ו-iPadOS. הגדרות שנקבעו כאן יחולו כאשר פרופיל זה ישמש במכשירים אלה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN-alagútkezelés jelenleg csak iOS és iPadOS rendszeren érhető el. Az itt beállított beállítások akkor lépnek életbe, amikor ezt a profilt ezeken az eszközökön használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tunneling VPN è attualmente disponibile solo su iOS e iPadOS. Le impostazioni configurate qui verranno applicate quando questo profilo verrà utilizzato su quei dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNトンネリングは現在iOSとiPadOSでのみ利用可能です。ここで設定した内容は、このプロファイルをそれらのデバイスで使用する際に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 터널링은 현재 iOS 및 iPadOS에서만 사용할 수 있습니다. 여기에서 설정한 내용은 해당 기기에서 이 프로필을 사용할 때 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-tunnelering er for øyeblikket kun tilgjengelig på iOS og iPadOS. Innstillinger konfigurert her vil gjelde når denne profilen brukes på disse enhetene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-tunneling is momenteel alleen beschikbaar op iOS en iPadOS. Instellingen die hier zijn geconfigureerd, worden toegepast wanneer dit profiel op die apparaten wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelowanie VPN jest obecnie dostępne tylko na iOS i iPadOS. Ustawienia skonfigurowane tutaj będą stosowane, gdy ten profil zostanie użyty na tych urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tunelamento VPN está disponível atualmente apenas no iOS e iPadOS. As configurações definidas aqui serão aplicadas quando este perfil for usado nesses dispositivos."
          }
