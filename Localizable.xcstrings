        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbolleiste sichtbar lassen, wenn die Bildschirmtastatur ausgeblendet wird. Tippe auf das Terminal, um die Tastatur wieder einzublenden."
