    "Sync your SSH connection history, known hosts, and connection profiles across your devices using iCloud." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زامن سجل اتصالات SSH والمضيفين المعروفين وملفات الاتصال عبر أجهزتك باستخدام iCloud."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronitzeu l'historial de connexions SSH, els hosts coneguts i els perfils de connexió entre els vostres dispositius mitjançant iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizujte historii SSH připojení, známé hostitele a profily připojení napříč zařízeními pomocí iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniser din SSH-forbindelseshistorik, kendte værter og forbindelsesprofiler på tværs af dine enheder via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisieren Sie Ihren SSH-Verbindungsverlauf, bekannte Hosts und Verbindungsprofile über iCloud zwischen Ihren Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronice su historial de conexiones SSH, hosts conocidos y perfiles de conexión en todos sus dispositivos mediante iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronoi SSH-yhteyshistoriasi, tunnetut palvelimet ja yhteysprofiilit laitteidesi välillä iCloudin avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez votre historique de connexions SSH, vos hôtes connus et vos profils de connexion entre vos appareils via iCloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרן את היסטוריית חיבורי SSH, מארחים מוכרים ופרופילי חיבור בין המכשירים שלך באמצעות iCloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szinkronizálja SSH kapcsolati előzményeit, ismert gazdagépeit és kapcsolati profiljait eszközei között az iCloud segítségével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza la cronologia delle connessioni SSH, gli host conosciuti e i profili di connessione tra i Suoi dispositivi tramite iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudを使用して、SSH接続履歴、既知のホスト、および接続プロファイルをデバイス間で同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud를 사용하여 SSH 연결 기록, 알려진 호스트 및 연결 프로파일을 기기 간에 동기화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniser SSH-tilkoblingshistorikk, kjente verter og tilkoblingsprofiler på tvers av enhetene dine med iCloud."
          }
        },
