    "Software keys are stored encrypted in the Keychain and can be included in backups or synced with iCloud." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن المفاتيح البرمجية مشفّرة في سلسلة المفاتيح ويمكن تضمينها في النسخ الاحتياطية أو مزامنتها مع iCloud."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus de programari s'emmagatzemen xifrades a Keychain i es poden incloure a les còpies de seguretat o sincronitzar amb iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softwarové klíče jsou uloženy šifrovaně v Klíčence a lze je zahrnout do záloh nebo synchronizovat přes iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softwarenøgler gemmes krypteret i Keychain og kan inkluderes i sikkerhedskopier eller synkroniseres med iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software-Schlüssel werden verschlüsselt im Schlüsselbund gespeichert und können in Backups aufgenommen oder mit iCloud synchronisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de software se almacenan cifradas en el llavero y se pueden incluir en copias de seguridad o sincronizar con iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjelmistoavaimet tallennetaan salattuina Keychainiin, ja ne voidaan sisällyttää varmuuskopioihin tai synkronoida iCloudin kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés logicielles sont stockées chiffrées dans le trousseau et peuvent être incluses dans les sauvegardes ou synchronisées avec iCloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות תוכנה מאוחסנים מוצפנים ב-Keychain וניתן לכלול אותם בגיבויים או לסנכרן אותם עם iCloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szoftverkulcsok titkosítva tárolódnak a Keychain-ben, és szerepelhetnek a biztonsági másolatokban, illetve szinkronizálhatók az iCloud-dal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi software sono archiviate cifrate nel Portachiavi e possono essere incluse nei backup o sincronizzate con iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトウェアキーはキーチェーンに暗号化して保存され、バックアップに含めたり、iCloudで同期したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소프트웨어 키는 키체인에 암호화되어 저장되며 백업에 포함하거나 iCloud로 동기화할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programvarenøkler lagres kryptert i nøkkelringen og kan inkluderes i sikkerhetskopier eller synkroniseres med iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softwaresleutels worden versleuteld opgeslagen in de Sleutelhanger en kunnen worden opgenomen in back-ups of gesynchroniseerd met iCloud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze programowe są przechowywane w zaszyfrowanej formie w Keychain i mogą być uwzględniane w kopiach zapasowych lub synchronizowane z iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de software são armazenadas criptografadas no Keychain e podem ser incluídas em backups ou sincronizadas com o iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de software são armazenadas encriptadas no Keychain e podem ser incluídas em cópias de segurança ou sincronizadas com o iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheile software sunt stocate criptat în Keychain și pot fi incluse în backup-uri sau sincronizate cu iCloud."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programski ključi so šifrirano shranjeni v Keychain in jih je mogoče vključiti v varnostne kopije ali sinhronizirati z iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjukvarunycklar lagras krypterade i nyckelringen och kan inkluderas i säkerhetskopior eller synkroniseras med iCloud."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програмні ключі зберігаються в зашифрованому вигляді в Keychain, і їх можна включати до резервних копій або синхронізувати через iCloud."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa phần mềm được lưu trữ ở dạng mã hóa trong Keychain và có thể được đưa vào bản sao lưu hoặc đồng bộ với iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "软件密钥以加密形式存储在钥匙串中，可包含在备份中或通过 iCloud 同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軟體金鑰會以加密形式儲存於鑰匙圈中，並可納入備份或透過 iCloud 同步。"
          }
        }
      }
    },
