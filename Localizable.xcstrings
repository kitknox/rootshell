    "Include the OAuth access token in the certificate so the server can query the provider's userinfo endpoint. Leave off unless your server requires it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمِّن رمز وصول OAuth في الشهادة ليتمكن الخادم من الاستعلام عن نقطة userinfo لدى المزود. اتركه معطّلاً ما لم يتطلبه الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclou el testimoni d'accés d'OAuth al certificat perquè el servidor pugui consultar l'extrem userinfo del proveïdor. Deixa-ho desactivat tret que el servidor ho requereixi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrňte přístupový token OAuth do certifikátu, aby server mohl dotazovat koncový bod userinfo poskytovatele. Ponechte vypnuté, pokud to váš server nevyžaduje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkludér OAuth-adgangstokenet i certifikatet, så serveren kan forespørge udbyderens userinfo-endpoint. Lad det være slået fra, medmindre din server kræver det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den OAuth-Zugriffstoken in das Zertifikat aufnehmen, damit der Server den userinfo-Endpunkt des Anbieters abfragen kann. Lassen Sie es deaktiviert, sofern Ihr Server es nicht erfordert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye el token de acceso de OAuth en el certificado para que el servidor pueda consultar el endpoint userinfo del proveedor. Déjalo desactivado a menos que tu servidor lo requiera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisällytä OAuth-käyttötunnus varmenteeseen, jotta palvelin voi kysellä palveluntarjoajan userinfo-päätepistettä. Jätä pois käytöstä, ellei palvelimesi sitä vaadi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclure le jeton d'accès OAuth dans le certificat pour que le serveur puisse interroger le point de terminaison userinfo du fournisseur. Laissez désactivé sauf si votre serveur l'exige."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כלול את אסימון הגישה של OAuth בתעודה כדי שהשרת יוכל לתשאל את נקודת הקצה userinfo של הספק. השאר כבוי אלא אם השרת שלך דורש זאת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vegye fel az OAuth hozzáférési tokent a tanúsítványba, hogy a kiszolgáló lekérdezhesse a szolgáltató userinfo végpontját. Hagyja kikapcsolva, hacsak a kiszolgálója nem igényli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includi il token di accesso OAuth nel certificato in modo che il server possa interrogare l'endpoint userinfo del provider. Lascialo disattivato a meno che il server non lo richieda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがプロバイダの userinfo エンドポイントを照会できるように、OAuth アクセストークンを証明書に含めます。サーバーが必要としない限り、オフのままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 제공자의 userinfo 엔드포인트를 조회할 수 있도록 OAuth 액세스 토큰을 인증서에 포함합니다. 서버에서 필요하지 않으면 꺼 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkluder OAuth-tilgangstokenet i sertifikatet slik at serveren kan spørre leverandørens userinfo-endepunkt. La det være av med mindre serveren krever det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem het OAuth-toegangstoken op in het certificaat zodat de server het userinfo-eindpunt van de provider kan opvragen. Laat uit, tenzij je server dit vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz token dostępu OAuth do certyfikatu, aby serwer mógł odpytać punkt końcowy userinfo dostawcy. Pozostaw wyłączone, chyba że serwer tego wymaga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua o token de acesso do OAuth no certificado para que o servidor possa consultar o endpoint userinfo do provedor. Deixe desativado a menos que seu servidor exija."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua o token de acesso do OAuth no certificado para que o servidor possa consultar o endpoint userinfo do fornecedor. Deixe desativado a menos que o seu servidor o exija."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include tokenul de acces OAuth în certificat pentru ca serverul să poată interoga punctul final userinfo al furnizorului. Lasă dezactivat dacă serverul tău nu îl solicită."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V potrdilo vključite dostopni žeton OAuth, da lahko strežnik poizveduje po končni točki userinfo ponudnika. Pustite izklopljeno, razen če to zahteva vaš strežnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkludera OAuth-åtkomsttoken i certifikatet så att servern kan fråga leverantörens userinfo-slutpunkt. Lämna av om inte din server kräver det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте токен доступу OAuth до сертифіката, щоб сервер міг запитувати кінцеву точку userinfo провайдера. Залиште вимкненим, якщо сервер цього не вимагає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao gồm mã truy cập OAuth trong chứng chỉ để máy chủ có thể truy vấn điểm cuối userinfo của nhà cung cấp. Hãy để tắt trừ khi máy chủ của bạn yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在证书中包含 OAuth 访问令牌，以便服务器查询提供商的 userinfo 端点。除非服务器需要，否则请保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在憑證中包含 OAuth 存取權杖，以便伺服器查詢供應商的 userinfo 端點。除非伺服器需要，否則請保持關閉。"
          }
        }
      }
    },
