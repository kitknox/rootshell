    "Background tunnels maintain SSH port forwards without an active terminal session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحافظ الأنفاق في الخلفية على تحويلات منافذ SSH بدون جلسة طرفية نشطة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els túnels en segon pla mantenen les redireccions de ports SSH sense una sessió de terminal activa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunely na pozadí udržují SSH přesměrování portů bez aktivní terminálové relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baggrundstunneler opretholder SSH-portvideresendelser uden en aktiv terminalsession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund-Tunnel halten SSH-Portweiterleitungen ohne eine aktive Terminalsitzung aufrecht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los túneles en segundo plano mantienen reenvíos de puertos SSH sin una sesión de terminal activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustatunnelit ylläpitävät SSH-porttiohjauksia ilman aktiivista terminaali-istuntoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tunnels en arrière-plan maintiennent les redirections de ports SSH sans session de terminal active."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנהרות רקע שומרות על העברות פורטים של SSH ללא הפעלת מסוף פעילה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttéralagutak fenntartják az SSH portátirányításokat aktív terminálmunkamenet nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tunnel in background mantengono gli inoltri di porta SSH senza una sessione terminale attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドトンネルは、アクティブなターミナルセッションなしでSSHポートフォワードを維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 터널은 활성 터미널 세션 없이도 SSH 포트 포워딩을 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnstunneler opprettholder SSH-portvideresending uten en aktiv terminaløkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrondtunnels onderhouden SSH-poortdoorsturing zonder een actieve terminalsessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunele w tle utrzymują przekierowania portów SSH bez aktywnej sesji terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túneis em segundo plano mantêm encaminhamentos de porta SSH sem uma sessão de terminal ativa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os túneis em segundo plano mantêm reencaminhamentos de portas SSH sem uma sessão de terminal ativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelurile în fundal mențin redirecționările de porturi SSH fără o sesiune de terminal activă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuneli v ozadju vzdržujejo SSH posredovanja vrat brez aktivne terminalske seje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrundstunnlar upprätthåller SSH-portvidarebefordran utan en aktiv terminalsession."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фонові тунелі підтримують переспрямування портів SSH без активного сеансу термінала."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường hầm nền duy trì chuyển tiếp cổng SSH mà không cần phiên terminal đang hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台隧道在没有活跃终端会话的情况下维持 SSH 端口转发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景通道在沒有使用中終端機工作階段的情況下維持 SSH 連接埠轉送。"
          }
        }
      }
    },
    "Background tunnels maintain SSH port forwards without an active terminal session. Enable Location Diary (Auto mode) in Privacy settings to keep tunnels alive when the app is in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحافظ الأنفاق في الخلفية على إعادة توجيه منافذ SSH بدون جلسة طرفية نشطة. قم بتفعيل سجل المواقع (الوضع التلقائي) في إعدادات الخصوصية للحفاظ على الأنفاق نشطة عندما يكون التطبيق في الخلفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els túnels en segon pla mantenen les redireccions de ports SSH sense una sessió de terminal activa. Activa el Diari d'ubicació (mode Auto) als ajustos de Privadesa per mantenir els túnels actius quan l'app és en segon pla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunely na pozadí udržují přesměrování SSH portů bez aktivní terminálové relace. Povolte Deník polohy (automatický režim) v nastavení soukromí, aby tunely zůstaly aktivní, když je aplikace na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baggrundstunneler opretholder SSH-portviderestillinger uden en aktiv terminalsession. Aktivér Stedsdagbog (Autotilstand) i Anonymitetsindstillinger for at holde tunneler aktive, når appen er i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundtunnel halten SSH-Portweiterleitungen ohne aktive Terminalsitzung aufrecht. Aktiviere das Standorttagebuch (Automodus) in den Datenschutzeinstellungen, um Tunnel im Hintergrund aktiv zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los túneles en segundo plano mantienen los reenvíos de puertos SSH sin una sesión de terminal activa. Activa el Diario de ubicación (modo Auto) en los ajustes de Privacidad para mantener los túneles activos cuando la app está en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustalla toimivat tunnelit ylläpitävät SSH-porttiohjauksia ilman aktiivista pääteistuntoa. Ota Sijaintipäiväkirja (automaattitila) käyttöön Tietosuoja-asetuksissa pitääksesi tunnelit aktiivisina sovelluksen ollessa taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tunnels en arrière-plan maintiennent les redirections de ports SSH sans session de terminal active. Activez le Journal de localisation (mode Auto) dans les réglages de Confidentialité pour maintenir les tunnels actifs lorsque l'app est en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנהרות ברקע שומרות על העברות יציאות SSH ללא הפעלת מסוף פעילה. הפעל את יומן המיקומים (מצב אוטומטי) בהגדרות הפרטיות כדי לשמור על מנהרות פעילות כשהאפליקציה ברקע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttérben futó alagutak fenntartják az SSH-porttovábbításokat aktív terminál-munkamenet nélkül. Engedélyezze a Helyszínnaplót (Automatikus mód) az Adatvédelem beállításaiban, hogy az alagutak aktívak maradjanak, amikor az alkalmazás a háttérben van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tunnel in background mantengono gli inoltri di porta SSH senza una sessione terminale attiva. Attiva il Diario posizioni (modalità Auto) nelle impostazioni di Privacy per mantenere i tunnel attivi quando l'app è in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドトンネルは、アクティブなターミナルセッションなしでSSHポートフォワードを維持します。アプリがバックグラウンドにあるときにトンネルを維持するには、プライバシー設定で位置情報の日記（自動モード）を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 터널은 활성 터미널 세션 없이도 SSH 포트 포워드를 유지합니다. 앱이 백그라운드에 있을 때 터널을 유지하려면 개인정보 보호 설정에서 위치 기록(자동 모드)을 활성화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnstunneler opprettholder SSH-portvideresendinger uten en aktiv terminaløkt. Aktiver Stedsdagbok (Automodus) i Personverninnstillinger for å holde tunneler aktive når appen er i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrondtunnels onderhouden SSH-poortweiterleidingen zonder een actieve terminalsessie. Schakel Locatiedagboek (Automatische modus) in bij Privacy-instellingen om tunnels actief te houden wanneer de app op de achtergrond draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunele w tle utrzymują przekierowania portów SSH bez aktywnej sesji terminala. Włącz Dziennik lokalizacji (tryb automatyczny) w ustawieniach prywatności, aby tunele działały, gdy aplikacja jest w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os túneis em segundo plano mantêm redirecionamentos de porta SSH sem uma sessão de terminal ativa. Ative o Diário de Localização (modo Automático) nas configurações de Privacidade para manter os túneis ativos quando o app estiver em segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os túneis em segundo plano mantêm reencaminhamentos de porta SSH sem uma sessão de terminal ativa. Ative o Diário de Localização (modo Automático) nas definições de Privacidade para manter os túneis ativos quando a app estiver em segundo plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelurile din fundal mențin redirecționările de porturi SSH fără o sesiune de terminal activă. Activați Jurnalul de locații (modul Automat) în setările de Confidențialitate pentru a menține tunelurile active când aplicația este în fundal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuneli v ozadju ohranjajo posredovanje vrat SSH brez aktivne terminalske seje. Omogočite Dnevnik lokacije (samodejni način) v nastavitvah zasebnosti, da tuneli ostanejo aktivni, ko je aplikacija v ozadju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrundstunnlar upprätthåller SSH-portvidarebefordringar utan en aktiv terminalsession. Aktivera Platsdagbok (Autoläge) i Integritetsinställningar för att hålla tunnlar aktiva när appen är i bakgrunden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тунелі у фоновому режимі підтримують переспрямування портів SSH без активної термінальної сесії. Увімкніть Щоденник розташування (автоматичний режим) у налаштуваннях конфіденційності, щоб тунелі залишалися активними, коли застосунок у фоновому режимі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đường hầm nền duy trì chuyển tiếp cổng SSH mà không cần phiên terminal đang hoạt động. Bật Nhật ký vị trí (chế độ Tự động) trong cài đặt Quyền riêng tư để giữ các đường hầm hoạt động khi ứng dụng ở nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台隧道可在没有活跃终端会话的情况下维持 SSH 端口转发。请在隐私设置中启用位置日记（自动模式），以便在应用处于后台时保持隧道连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景通道可在沒有啟用終端機連線的情況下維持 SSH 連接埠轉送。請在隱私權設定中啟用「定位日記」（自動模式），以在 App 進入背景時維持通道連線。"
          }
        }
      }
    },
    "Background updates require Location Diary to be active. Without it, data only refreshes while the app is in the foreground." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب التحديثات في الخلفية تفعيل سجل الموقع. بدونه، لا يتم تحديث البيانات إلا أثناء استخدام التطبيق في المقدمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actualitzacions en segon pla requereixen que el diari d'ubicació estigui actiu. Sense ell, les dades només s'actualitzen mentre l'app és en primer pla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace na pozadí vyžadují aktivní Deník polohy. Bez něj se data obnovují pouze při aktivním používání aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baggrundsopdateringer kræver, at Lokationsdagbog er aktiv. Uden den opdateres data kun, mens appen er i forgrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundaktualisierungen erfordern, dass das Standorttagebuch aktiv ist. Ohne dieses werden die Daten nur aktualisiert, während die App im Vordergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones en segundo plano requieren que el diario de ubicación esté activo. Sin él, los datos solo se actualizan mientras la app está en primer plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustapäivitykset edellyttävät, että Sijaintipäiväkirja on käytössä. Ilman sitä tiedot päivittyvät vain, kun appi on etualalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour en arrière-plan nécessitent que le journal de localisation soit actif. Sans cela, les données ne se rafraîchissent que lorsque l'app est au premier plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכונים ברקע דורשים שיומן המיקום יהיה פעיל. בלעדיו, הנתונים מתעדכנים רק כשהאפליקציה בחזית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttérfrissítésekhez aktív Helynaplóra van szükség. Enélkül az adatok csak akkor frissülnek, amikor az alkalmazás az előtérben van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti in background richiedono che il diario di posizione sia attivo. Senza di esso, i dati si aggiornano solo quando l'app è in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド更新にはロケーションダイアリーを有効にする必要があります。無効の場合、アプリがフォアグラウンドにある間のみデータが更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 업데이트를 사용하려면 위치 다이어리가 활성화되어 있어야 합니다. 비활성화 시 앱이 포그라운드에 있을 때만 데이터가 새로고침됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnsoppdateringer krever at Stedsdagbok er aktiv. Uten den oppdateres data kun mens appen er i forgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrondupdates vereisen dat Locatiedagboek actief is. Zonder dit worden gegevens alleen vernieuwd terwijl de app op de voorgrond staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacje w tle wymagają aktywnego Dziennika lokalizacji. Bez niego dane odświeżają się tylko, gdy aplikacja jest na pierwszym planie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações em segundo plano exigem que o diário de localização esteja ativo. Sem ele, os dados só são atualizados enquanto o app está em primeiro plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações em segundo plano requerem que o diário de localização esteja ativo. Sem ele, os dados só são atualizados enquanto a app está em primeiro plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizările în fundal necesită ca jurnalul de localizare să fie activ. Fără acesta, datele se actualizează doar când aplicația este în prim-plan."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posodobitve v ozadju zahtevajo aktiven Dnevnik lokacije. Brez njega se podatki osvežijo le, ko je aplikacija v ospredju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrundsuppdateringar kräver att Platsdagbok är aktiv. Utan den uppdateras data bara medan appen är i förgrunden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення у фоновому режимі потребують активного Щоденника місцезнаходження. Без нього дані оновлюються лише коли програма активна на екрані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cập nhật nền yêu cầu Nhật ký vị trí phải được bật. Nếu không, dữ liệu chỉ được làm mới khi ứng dụng ở nền trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台更新需要启用位置日记。未启用时，数据仅在 App 处于前台时刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
