    "Glows cyan on dark themes, reads as ink wash on light themes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوهج بلون سماوي في السمات الداكنة، ويبدو كرسم حبري في السمات الفاتحة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilla de color cian en temes foscos i es veu com una aiguada de tinta en temes clars"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tmavých motivech září azurově, na světlých působí jako malba tuší"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser cyan på mørke temaer og fremstår som tuschtegning på lyse temaer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leuchtet auf dunklen Themes cyan, wirkt auf hellen Themes wie eine Tuschmalerei"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilla en cian en temas oscuros y parece una aguada de tinta en temas claros"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hehkuu syaanina tummissa teemoissa ja näyttää tussimaalaukselta vaaleissa teemoissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brille en cyan sur les thèmes sombres, évoque un lavis d'encre sur les thèmes clairs"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זוהר בציאן בערכות כהות, ונראה כרישום דיו בערכות בהירות"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sötét témákon ciánkéken világít, világos témákon tusrajznak tűnik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilla in ciano sui temi scuri e appare come un acquerello a inchiostro sui temi chiari"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダークテーマではシアンに光り、ライトテーマでは水墨画のように見えます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어두운 테마에서는 청록색으로 빛나고, 밝은 테마에서는 수묵화처럼 보입니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser cyan på mørke temaer og fremstår som tusjmaleri på lyse temaer"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gloeit cyaan bij donkere thema's, oogt als een inktwassing bij lichte thema's"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świeci na cyjanowo w ciemnych motywach, a w jasnych wygląda jak malunek tuszem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilha em ciano nos temas escuros e parece uma aguada de tinta nos temas claros"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilha em ciano nos temas escuros e parece uma aguada de tinta nos temas claros"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strălucește cian pe temele întunecate și apare ca un desen în tuș pe cele luminoase"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na temnih temah sveti cijan, na svetlih deluje kot slikanje s tušem"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser cyan i mörka teman och ser ut som en tuschlavering i ljusa teman"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Світиться блакитним на темних темах і виглядає як малюнок тушшю на світлих"
          }
        },
        "vi" : {
          "stringUnit" : {
