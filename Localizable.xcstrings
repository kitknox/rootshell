    "How long the command may run before it is stopped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يُسمح للأمر بالتشغيل خلالها قبل إيقافه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps màxim que l'ordre pot executar-se abans d'aturar-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho může příkaz běžet, než bude zastaven."
