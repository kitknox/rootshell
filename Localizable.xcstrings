    "Toggle off any key you don't want imported. Already-imported keys are matched by fingerprint." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ تفعيل أي مفتاح لا ترغب في استيراده. تُطابَق المفاتيح المستوردة مسبقاً عبر البصمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva les claus que no vulguis importar. Les claus ja importades s’identifiquen per l’empremta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypněte klíče, které nechcete importovat. Již importované klíče se rozpoznají podle otisku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå nøgler fra, som du ikke vil importere. Allerede importerede nøgler genkendes via fingeraftryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere alle Schlüssel, die du nicht importieren möchtest. Bereits importierte Schlüssel werden anhand des Fingerabdrucks erkannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva cualquier clave que no quieras importar. Las claves ya importadas se identifican por huella digital."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista käytöstä avaimet, joita et halua tuoda. Jo tuodut avaimet tunnistetaan sormenjäljen perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez les clés que vous ne souhaitez pas importer. Les clés déjà importées sont identifiées par leur empreinte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבה כל מפתח שאינך מעוניין לייבא. מפתחות שיובאו כבר מזוהים לפי טביעת אצבע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja ki azokat a kulcsokat, amelyeket nem szeretne importálni. A már importált kulcsokat ujjlenyomat alapján ismeri fel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva le chiavi che non vuoi importare. Le chiavi già importate vengono riconosciute tramite impronta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートしたくない鍵はオフにしてください。インポート済みの鍵はフィンガープリントで照合されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오고 싶지 않은 키는 꺼 두세요. 이미 가져온 키는 지문으로 식별됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av nøkler du ikke vil importere. Allerede importerte nøkler gjenkjennes via fingeravtrykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel sleutels uit die je niet wilt importeren. Reeds geïmporteerde sleutels worden herkend aan de vingerafdruk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz klucze, których nie chcesz importować. Już zaimportowane klucze są rozpoznawane po odcisku palca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative as chaves que você não quer importar. As chaves já importadas são identificadas pela impressão digital."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative as chaves que não quer importar. As chaves já importadas são identificadas pela impressão digital."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivează orice cheie pe care nu vrei să o imporți. Cheile deja importate sunt identificate după amprentă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izklopite ključe, ki jih ne želite uvoziti. Že uvoženi ključi so prepoznani po prstnem odtisu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av nycklar som du inte vill importera. Redan importerade nycklar matchas via fingeravtryck."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть ключі, які не хочете імпортувати. Уже імпортовані ключі визначаються за відбитком."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt bất kỳ khóa nào bạn không muốn nhập. Các khóa đã nhập được đối chiếu bằng dấu vân tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭你不想导入的密钥。已导入的密钥将通过指纹进行匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉你不想匯入的金鑰。已匯入的金鑰會透過指紋進行比對。"
          }
        }
      }
    },
