    "Safe operations (listing hosts/resources) auto-approve. Dangerous operations (executing commands) require explicit approval." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمليات الآمنة (عرض المضيفين/الموارد) تُوافق تلقائياً. العمليات الخطرة (تنفيذ الأوامر) تتطلب موافقة صريحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les operacions segures (llistar amfitrions/recursos) s'aproven automàticament. Les operacions perilloses (executar ordres) requereixen aprovació explícita."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpečné operace (výpis hostitelů/zdrojů) se schvalují automaticky. Nebezpečné operace (spouštění příkazů) vyžadují explicitní schválení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikre handlinger (visning af værter/ressourcer) godkendes automatisk. Farlige handlinger (udførelse af kommandoer) kræver eksplicit godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Vorgänge (Auflisten von Hosts/Ressourcen) werden automatisch genehmigt. Gefährliche Vorgänge (Ausführen von Befehlen) erfordern eine ausdrückliche Genehmigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las operaciones seguras (listar hosts/recursos) se aprueban automáticamente. Las operaciones peligrosas (ejecutar comandos) requieren aprobación explícita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvalliset toiminnot (isäntien/resurssien listaus) hyväksytään automaattisesti. Vaaralliset toiminnot (komentojen suoritus) vaativat nimenomaisen hyväksynnän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les opérations sûres (lister les hôtes/ressources) sont approuvées automatiquement. Les opérations dangereuses (exécuter des commandes) nécessitent une approbation explicite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולות בטוחות (הצגת מארחים/משאבים) מאושרות אוטומטית. פעולות מסוכנות (הפעלת פקודות) דורשות אישור מפורש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonságos műveletek (gazdagépek/erőforrások listázása) automatikusan jóváhagyásra kerülnek. A veszélyes műveletek (parancsok végrehajtása) kifejezett jóváhagyást igényelnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le operazioni sicure (elenco host/risorse) vengono approvate automaticamente. Le operazioni pericolose (esecuzione comandi) richiedono approvazione esplicita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な操作（ホスト/リソースの一覧表示）は自動承認されます。危険な操作（コマンドの実行）には明示的な承認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전한 작업(호스트/리소스 목록 조회)은 자동 승인됩니다. 위험한 작업(명령 실행)은 명시적 승인이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trygge operasjoner (listing av verter/ressurser) godkjennes automatisk. Farlige operasjoner (kjøring av kommandoer) krever eksplisitt godkjenning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veilige bewerkingen (hosts/bronnen weergeven) worden automatisch goedgekeurd. Gevaarlijke bewerkingen (opdrachten uitvoeren) vereisen expliciete goedkeuring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpieczne operacje (wyświetlanie hostów/zasobów) są automatycznie zatwierdzane. Niebezpieczne operacje (wykonywanie poleceń) wymagają jawnego zatwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operações seguras (listar hosts/recursos) são aprovadas automaticamente. Operações perigosas (executar comandos) exigem aprovação explícita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operações seguras (listar anfitriões/recursos) são aprovadas automaticamente. Operações perigosas (executar comandos) requerem aprovação explícita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operatiunile sigure (listare gazde/resurse) sunt aprobate automat. Operatiunile periculoase (executare comenzi) necesita aprobare explicita."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varne operacije (izpis gostiteljev/virov) se samodejno odobrijo. Nevarne operacije (izvajanje ukazov) zahtevajo izrecno odobritev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkra operationer (lista värdar/resurser) godkänns automatiskt. Farliga operationer (köra kommandon) kräver uttryckligt godkännande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безпечні операції (перегляд хостів/ресурсів) затверджуються автоматично. Небезпечні операції (виконання команд) потребують явного підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thao tác an toàn (liệt kê host/tài nguyên) được tự động phê duyệt. Các thao tác nguy hiểm (thực thi lệnh) yêu cầu phê duyệt rõ ràng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全操作（列出主机/资源）自动批准。危险操作（执行命令）需要明确批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
