    "Applies to sessions opened from now on. Existing tabs keep the shell they started with." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على الجلسات التي تُفتح من الآن فصاعدًا. تحتفظ علامات التبويب الحالية بالصدفة التي بدأت بها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'aplica a les sessions que s'obrin a partir d'ara. Les pestanyes existents conserven el shell amb què s'han iniciat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro relace otevřené od této chvíle. Stávající karty si ponechají shell, se kterým byly spuštěny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder for sessioner, der åbnes fra nu af. Eksisterende faner beholder den shell, de blev startet med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für ab jetzt geöffnete Sitzungen. Bestehende Tabs behalten die Shell, mit der sie gestartet wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a las sesiones que abras a partir de ahora. Las pestañas existentes conservan la shell con la que se iniciaron."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee tästä eteenpäin avattavia istuntoja. Olemassa olevat välilehdet säilyttävät komentotulkin, jolla ne käynnistettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique aux sessions ouvertes à partir de maintenant. Les onglets existants conservent le shell avec lequel ils ont démarré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל על הפעלות שייפתחו מעתה והלאה. לשוניות קיימות שומרות על המעטפת שאיתה הופעלו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mostantól megnyitott munkamenetekre vonatkozik. A meglévő lapok megtartják azt a shellt, amellyel elindultak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica alle sessioni aperte da ora in poi. Le schede esistenti mantengono la shell con cui sono state avviate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後開くセッションに適用されます。既存のタブは起動時のシェルをそのまま使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금부터 여는 세션에 적용됩니다. 기존 탭은 시작할 때 사용한 셸을 그대로 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder økter som åpnes fra nå av. Eksisterende faner beholder skallet de ble startet med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor sessies die vanaf nu worden geopend. Bestaande tabbladen behouden de shell waarmee ze zijn gestart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy sesji otwieranych od teraz. Istniejące karty zachowują powłokę, z którą zostały uruchomione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se às sessões abertas a partir de agora. As abas existentes mantêm o shell com o qual foram iniciadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se às sessões abertas a partir de agora. Os separadores existentes mantêm a shell com que foram iniciados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplică sesiunilor deschise de acum înainte. Filele existente păstrează shell-ul cu care au pornit."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velja za seje, odprte od zdaj naprej. Obstoječi zavihki ohranijo lupino, s katero so se zagnali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller sessioner som öppnas från och med nu. Befintliga flikar behåller skalet de startades med."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується до сеансів, відкритих відтепер. Наявні вкладки зберігають оболонку, з якою їх було запущено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng cho các phiên được mở từ giờ trở đi. Các tab hiện có vẫn giữ shell mà chúng đã khởi chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅对此后打开的会话生效。现有标签页仍使用启动时的 Shell。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅套用於此後開啟的工作階段。現有分頁仍使用啟動時的 Shell。"
          }
        }
      }
    },
