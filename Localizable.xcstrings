    "Sessions persist even when the app is backgrounded." : {
      "comment" : "Trzsz help: about line 3",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الجلسات نشطة حتى عند تشغيل التطبيق في الخلفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
