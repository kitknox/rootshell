        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszköztár láthatóan marad, ha a képernyő-billentyűzet bezárul. Koppints a terminálra a billentyűzet újbóli megjelenítéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
