    "Reattaching to the existing remote session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إعادة الإرفاق بالجلسة البعيدة الحالية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’està tornant a connectar amb la sessió remota existent."
