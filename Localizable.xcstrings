    "Note: Digital Signature slot (9c) always requires PIN for every signing operation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: فتحة التوقيع الرقمي (9c) تتطلب دائمًا رمز PIN لكل عملية توقيع."
          }
        },
        "ca" : {
          "stringUnit" : {
