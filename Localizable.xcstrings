    "Traffic to these CIDR ranges will bypass the VPN and use the direct network path. Use this for local network access or to exclude specific services." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتجاوز حركة المرور إلى نطاقات CIDR هذه شبكة VPN وتستخدم المسار المباشر للشبكة. استخدم هذا للوصول إلى الشبكة المحلية أو لاستثناء خدمات معينة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trànsit cap a aquests rangs CIDR evitarà la VPN i utilitzarà la ruta de xarxa directa. Utilitzeu-ho per a l'accés a la xarxa local o per excloure serveis específics."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provoz na tyto CIDR rozsahy obejde VPN a použije přímou síťovou cestu. Použijte pro přístup k místní síti nebo vyloučení konkrétních služeb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafik til disse CIDR-intervaller vil omgå VPN og bruge den direkte netværkssti. Brug dette til lokalt netværksadgang eller for at udelukke bestemte tjenester."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenverkehr zu diesen CIDR-Bereichen umgeht das VPN und nutzt den direkten Netzwerkpfad. Verwenden Sie dies für lokalen Netzwerkzugriff oder zum Ausschließen bestimmter Dienste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tráfico hacia estos rangos CIDR evitará la VPN y usará la ruta de red directa. Use esto para acceso a la red local o para excluir servicios específicos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikenne näihin CIDR-alueisiin ohittaa VPN:n ja käyttää suoraa verkkoyhteyttä. Käytä tätä paikallisverkon käyttöön tai tiettyjen palvelujen poissulkemiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trafic vers ces plages CIDR contournera le VPN et utilisera le chemin réseau direct. Utilisez ceci pour l'accès au réseau local ou pour exclure des services spécifiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תעבורה לטווחי CIDR אלה תעקוף את ה-VPN ותשתמש בנתיב הרשת הישיר. השתמש בזה לגישה לרשת מקומית או להחרגת שירותים ספציפיים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ezekre a CIDR-tartományokra irányuló forgalom megkerüli a VPN-t és a közvetlen hálózati útvonalat használja. Használja helyi hálózati hozzáféréshez vagy meghatározott szolgáltatások kizárásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traffico verso questi intervalli CIDR aggirerà la VPN e utilizzerà il percorso di rete diretto. Utilizzare questa opzione per l'accesso alla rete locale o per escludere servizi specifici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのCIDR範囲へのトラフィックはVPNをバイパスし、直接ネットワークパスを使用します。ローカルネットワークアクセスや特定のサービスの除外に使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 CIDR 범위로의 트래픽은 VPN을 우회하여 직접 네트워크 경로를 사용합니다. 로컬 네트워크 접근 또는 특정 서비스를 제외할 때 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafikk til disse CIDR-områdene vil omgå VPN-en og bruke den direkte nettverksstien. Bruk dette for lokal nettverkstilgang eller for å ekskludere bestemte tjenester."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkeer naar deze CIDR-bereiken omzeilt de VPN en gebruikt het directe netwerkpad. Gebruik dit voor lokale netwerktoegang of om specifieke diensten uit te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch do tych zakresów CIDR będzie omijał VPN i korzystał z bezpośredniej ścieżki sieciowej. Użyj tego dla dostępu do sieci lokalnej lub aby wykluczyć określone usługi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tráfego para esses intervalos CIDR contornará a VPN e usará o caminho de rede direto. Use isso para acesso à rede local ou para excluir serviços específicos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tráfego para estes intervalos CIDR irá contornar a VPN e usar o caminho de rede direto. Utilize isto para acesso à rede local ou para excluir serviços específicos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traficul către aceste intervale CIDR va ocoli VPN-ul și va folosi calea de rețea directă. Utilizați aceasta pentru acces la rețeaua locală sau pentru a exclude servicii specifice."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promet na te CIDR obsege bo obšel VPN in uporabil neposredno omrežno pot. To uporabite za dostop do lokalnega omrežja ali za izključitev določenih storitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafik till dessa CIDR-intervall kringgår VPN och använder den direkta nätverksvägen. Använd detta för åtkomst till lokalt nätverk eller för att utesluta specifika tjänster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трафік до цих діапазонів CIDR обходитиме VPN і використовуватиме прямий мережевий шлях. Використовуйте це для доступу до локальної мережі або виключення певних сервісів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu lượng đến các dải CIDR này sẽ bỏ qua VPN và sử dụng đường mạng trực tiếp. Dùng tùy chọn này để truy cập mạng cục bộ hoặc loại trừ các dịch vụ cụ thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发往这些 CIDR 范围的流量将绕过 VPN，使用直接网络路径。用于本地网络访问或排除特定服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送至這些 CIDR 範圍的流量將繞過 VPN，使用直接網路路徑。可用於區域網路存取或排除特定服務。"
          }
        }
      }
    },
