          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure o acesso SSH para analisar os rádios do AP e obter informações de banda. Requer acesso SSH aos seus dispositivos UniFi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurați accesul SSH pentru a scana radiourile AP și a obține informații despre benzi. Necesită acces SSH la dispozitivele UniFi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite dostop SSH za pregledovanje radiev AP in pridobivanje podatkov o frekvenčnih pasovih. Zahteva dostop SSH do vaših naprav UniFi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurera SSH-åtkomst för att skanna AP-radios efter bandinformation. Kräver SSH-åtkomst till dina UniFi-enheter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте SSH-доступ для сканування радіомодулів AP та отримання інформації про діапазони. Потрібен SSH-доступ до ваших пристроїв UniFi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấu hình quyền truy cập SSH để quét radio AP nhằm lấy thông tin băng tần. Yêu cầu quyền truy cập SSH vào các thiết bị UniFi của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置 SSH 访问权限以扫描 AP 射频模块获取频段信息。需要对您的 UniFi 设备具有 SSH 访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 SSH 存取權限以掃描 AP 射頻模組取得頻段資訊。需要對您的 UniFi 裝置具有 SSH 存取權限。"
          }
        }
      }
    },
