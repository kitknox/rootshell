    "Follow the system prompt to verify your identity." : {
      "comment" : "Passkey generation progress instruction",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتبع مطالبة النظام للتحقق من هويتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguiu la sol·licitud del sistema per verificar la vostra identitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověřte svou identitu podle výzvy systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg systemets anmodning for at bekræfte din identitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen Sie der Systemabfrage, um Ihre Identität zu bestätigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga la solicitud del sistema para verificar su identidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista henkilöllisyytesi järjestelmän kehotteen mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez l'invite du système pour vérifier votre identité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עקוב אחר הבקשה של המערכת כדי לאמת את זהותך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kövesse a rendszer utasítását a személyazonossága igazolásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui la richiesta di sistema per verificare la tua identità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの指示に従って本人確認を行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 안내에 따라 본인 확인을 진행하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg systemforespørselen for å bekrefte identiteten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg de systeemmelding om uw identiteit te verifiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykonaj polecenie systemowe, aby potwierdzić swoją tożsamość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga a solicitação do sistema para verificar sua identidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga o pedido do sistema para verificar a sua identidade."
          }
