    "Voice Agent requires a Google API key. Add one in Settings > AI Agent > Google Gemini." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب المساعد الصوتي مفتاح Google API. أضف واحدًا في الإعدادات > AI Agent > Google Gemini."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent de veu requereix una clau de Google API. Afegiu-ne una a Configuració > AI Agent > Google Gemini."
          }
        },
        "cs" : {
