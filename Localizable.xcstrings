    "Use letters, digits, and . _ - only, up to 64 characters. Other names fall back to the global default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الأحرف والأرقام والرموز . _ - فقط، بحد أقصى 64 حرفًا. الأسماء الأخرى تعود إلى الافتراضي العام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu només lletres, xifres i els caràcters . _ -, fins a 64 caràcters. Els altres noms recorren al valor global per defecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte pouze písmena, číslice a znaky . _ -, maximálně 64 znaků. Ostatní názvy použijí globální výchozí hodnotu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug kun bogstaver, tal og tegnene . _ -, højst 64 tegn. Andre navne falder tilbage til den globale standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie nur Buchstaben, Ziffern und die Zeichen . _ -, maximal 64 Zeichen. Andere Namen greifen auf den globalen Standard zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo letras, dígitos y los caracteres . _ -, hasta 64 caracteres. Los demás nombres recurren al valor predeterminado global."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä vain kirjaimia, numeroita ja merkkejä . _ -, enintään 64 merkkiä. Muut nimet käyttävät yleistä oletusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez uniquement des lettres, des chiffres et les caractères . _ -, dans la limite de 64 caractères. Les autres noms utilisent la valeur par défaut globale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש באותיות, בספרות ובתווים . _ - בלבד, עד 64 תווים. שמות אחרים חוזרים לברירת המחדל הכללית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak betűket, számjegyeket, valamint a . _ - karaktereket használja, legfeljebb 64 karakter hosszan. A többi név a globális alapértelmezettre vált vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo lettere, cifre e i caratteri . _ -, fino a 64 caratteri. Gli altri nomi ricadono sul valore predefinito globale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英字、数字、および . _ - のみを使用し、64 文字以内にしてください。それ以外の名前はグローバルのデフォルトに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자, 숫자 및 . _ - 만 사용하고 최대 64자까지 입력하세요. 다른 이름은 전역 기본값으로 대체됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk bare bokstaver, sifre og tegnene . _ -, opptil 64 tegn. Andre navn faller tilbake til global standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik alleen letters, cijfers en de tekens . _ -, maximaal 64 tekens. Andere namen vallen terug op de globale standaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj wyłącznie liter, cyfr oraz znaków . _ -, maksymalnie 64 znaki. Inne nazwy zostaną zastąpione globalną wartością domyślną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use apenas letras, dígitos e . _ -, com até 64 caracteres. Outros nomes voltam ao padrão global."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize apenas letras, algarismos e . _ -, até 64 caracteres. Os outros nomes revertem para a predefinição global."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți doar litere, cifre și caracterele . _ -, maximum 64 de caractere. Celelalte nume revin la valoarea implicită globală."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabite samo črke, števke in znake . _ -, do 64 znakov. Druga imena se povrnejo na globalno privzeto vrednost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd endast bokstäver, siffror och tecknen . _ -, upp till 64 tecken. Andra namn återgår till global standard."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте лише літери, цифри та символи . _ -, до 64 символів. Інші назви повертаються до глобального типового значення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ dùng chữ cái, chữ số và . _ -, tối đa 64 ký tự. Các tên khác sẽ quay về mặc định toàn cục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅可使用字母、数字和 . _ - 这几个字符，最多 64 个字符。其他名称将回退到全局默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能使用字母、數字和 . _ - 等字元，最多 64 個字元。其他名稱將回復為全域預設值。"
          }
        }
      }
    },
