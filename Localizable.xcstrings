    "Selected categories include sensitive data (SSH keys, passwords, API keys). This data will be encrypted with your password." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتضمن الفئات المحددة بيانات حساسة (مفاتيح SSH، كلمات مرور، مفاتيح API). سيتم تشفير هذه البيانات بكلمة المرور الخاصة بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les categories seleccionades contenen dades sensibles (claus SSH, contrasenyes, claus API). Aquestes dades es xifraran amb la vostra contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané kategorie obsahují citlivá data (SSH klíče, hesla, API klíče). Tato data budou šifrována vaším heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgte kategorier indeholder følsomme data (SSH-nøgler, adgangskoder, API-nøgler). Disse data krypteres med din adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Kategorien enthalten sensible Daten (SSH-Schlüssel, Passwörter, API-Schlüssel). Diese Daten werden mit Ihrem Passwort verschlüsselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las categorías seleccionadas incluyen datos sensibles (claves SSH, contraseñas, claves API). Estos datos se cifrarán con tu contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitut kategoriat sisältävät arkaluonteisia tietoja (SSH-avaimet, salasanat, API-avaimet). Nämä tiedot salataan salasanallasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les catégories sélectionnées contiennent des données sensibles (clés SSH, mots de passe, clés API). Ces données seront chiffrées avec votre mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקטגוריות שנבחרו כוללות נתונים רגישים (מפתחות SSH, סיסמאות, מפתחות API). נתונים אלה יוצפנו באמצעות הסיסמה שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott kategóriák érzékeny adatokat tartalmaznak (SSH-kulcsok, jelszavak, API-kulcsok). Ezeket az adatokat az Ön jelszavával titkosítjuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le categorie selezionate includono dati sensibili (chiavi SSH, password, chiavi API). Questi dati verranno crittografati con la tua password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したカテゴリには機密データ（SSHキー、パスワード、APIキー）が含まれています。このデータはパスワードで暗号化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 카테고리에 민감한 데이터(SSH 키, 비밀번호, API 키)가 포함되어 있습니다. 이 데이터는 비밀번호로 암호화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgte kategorier inneholder sensitive data (SSH-nøkler, passord, API-nøkler). Disse dataene krypteres med passordet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geselecteerde categorieën bevatten gevoelige gegevens (SSH-sleutels, wachtwoorden, API-sleutels). Deze gegevens worden versleuteld met uw wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane kategorie zawierają wrażliwe dane (klucze SSH, hasła, klucze API). Dane te zostaną zaszyfrowane Twoim hasłem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As categorias selecionadas incluem dados sensíveis (chaves SSH, senhas, chaves API). Esses dados serão criptografados com sua senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As categorias selecionadas incluem dados sensíveis (chaves SSH, palavras-passe, chaves API). Estes dados serão encriptados com a sua palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categoriile selectate includ date sensibile (chei SSH, parole, chei API). Aceste date vor fi criptate cu parola dvs."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrane kategorije vsebujejo občutljive podatke (SSH-ključi, gesla, API-ključi). Ti podatki bodo šifrirani z vašim geslom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valda kategorier innehåller känsliga data (SSH-nycklar, lösenord, API-nycklar). Dessa data krypteras med ditt lösenord."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрані категорії містять конфіденційні дані (SSH-ключі, паролі, API-ключі). Ці дані будуть зашифровані вашим паролем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các danh mục đã chọn chứa dữ liệu nhạy cảm (khóa SSH, mật khẩu, khóa API). Dữ liệu này sẽ được mã hóa bằng mật khẩu của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选类别包含敏感数据（SSH 密钥、密码、API 密钥）。这些数据将使用您的密码进行加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選類別包含敏感資料（SSH 金鑰、密碼、API 金鑰）。此資料將使用您的密碼加密。"
          }
        }
      }
