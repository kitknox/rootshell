    "WiFi info requires location permission. Enable in Settings > Privacy > Location Services." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب معلومات WiFi إذن الموقع. قم بتفعيله من الإعدادات > الخصوصية > خدمات الموقع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La info del WiFi requereix permís d'ubicació. Activa'l a Ajustos > Privadesa > Serveis d'ubicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informace o Wi-Fi vyžadují oprávnění k poloze. Povolte v Nastavení > Soukromí > Polohové služby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi-info kræver placeringstilladelse. Aktivér under Indstillinger > Anonymitet > Lokalitetstjenester."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WLAN-Info erfordert die Standortberechtigung. Aktiviere sie unter Einstellungen > Datenschutz > Ortungsdienste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La info de WiFi requiere permiso de ubicación. Actívalo en Ajustes > Privacidad > Localización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi-tiedot vaativat sijaintiluvan. Ota käyttöön kohdassa Asetukset > Tietosuoja > Sijaintipalvelut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les infos WiFi nécessitent l'autorisation de localisation. Activez-la dans Réglages > Confidentialité > Service de localisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מידע WiFi דורש הרשאת מיקום. הפעל בהגדרות > פרטיות > שירותי מיקום."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Wi-Fi-adatokhoz helymeghatározási engedély szükséges. Engedélyezze a Beállítások > Adatvédelem > Helymeghatározás menüben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le info WiFi richiedono l'autorizzazione alla posizione. Abilitala in Impostazioni > Privacy > Servizi di localizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi情報には位置情報の許可が必要です。設定 > プライバシー > 位置情報サービスで有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi 정보를 사용하려면 위치 권한이 필요합니다. 설정 > 개인정보 보호 > 위치 서비스에서 활성화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi-info krever stedstillatelse. Aktiver under Innstillinger > Personvern > Stedstjenester."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wifi-info vereist locatietoestemming. Schakel in via Instellingen > Privacy > Locatievoorzieningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informacje o Wi-Fi wymagają uprawnień do lokalizacji. Włącz w Ustawienia > Prywatność > Usługi lokalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As informações de WiFi exigem permissão de localização. Ative em Ajustes > Privacidade > Serviços de Localização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As informações de WiFi requerem permissão de localização. Ative em Definições > Privacidade > Serviços de localização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informațiile WiFi necesită permisiunea de localizare. Activează din Setări > Confidențialitate > Servicii de localizare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatki o Wi-Fi zahtevajo dovoljenje za lokacijo. Omogočite v Nastavitve > Zasebnost > Lokacijske storitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi-info kräver platstillåtelse. Aktivera under Inställningar > Integritet > Platstjänster."
          }
