        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmožnosti"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioner"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливості"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khả năng"
          }
        },
        "zh-Hans" : {
