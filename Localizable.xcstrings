    "PIV keys use slots and require a 6-8 digit PIN." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم مفاتيح PIV فتحات وتتطلب رمز PIN من 6 إلى 8 أرقام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus PIV utilitzen ranures i requereixen un PIN de 6 a 8 dígits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV klíče používají sloty a vyžadují 6–8místný PIN."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV-nøgler bruger slots og kræver en 6-8-cifret PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV-Schlüssel verwenden Slots und erfordern eine 6- bis 8-stellige PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves PIV usan ranuras y requieren un PIN de 6 a 8 dígitos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV-avaimet käyttävät paikkoja ja vaativat 6–8-numeroisen PIN-koodin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés PIV utilisent des slots et nécessitent un PIN de 6 à 8 chiffres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות PIV משתמשים בחריצים ודורשים PIN בן 6-8 ספרות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A PIV kulcsok slotokat használnak, és 6-8 számjegyű PIN-t igényelnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi PIV utilizzano slot e richiedono un PIN di 6-8 cifre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIVキーはスロットを使用し、6〜8桁のPINが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV 키는 슬롯을 사용하며 6~8자리 PIN이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV-nøkler bruker spor og krever en 6–8-sifret PIN."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIV-sleutels gebruiken slots en vereisen een 6-8 cijferige PIN."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze PIV używają slotów i wymagają 6-8 cyfrowego PIN-u."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
