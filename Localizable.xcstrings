    "Bookmarked folders appear as symlinks in your home directory and support tilde expansion (~name)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر المجلدات المرجعية كروابط رمزية في مجلدك الرئيسي وتدعم التوسيع بعلامة التيلدا (~name)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les carpetes als marcadors apareixen com a enllaços simbòlics al directori d'inici i admeten l'expansió de titlla (~nom)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složky v záložkách se zobrazují jako symbolické odkazy ve vašem domovském adresáři a podporují expanzi tildy (~název)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogmærkede mapper vises som symlinks i din hjemmemappe og understøtter tilde-udvidelse (~navn)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner mit Lesezeichen erscheinen als Symlinks in Ihrem Home-Verzeichnis und unterstützen Tilde-Erweiterung (~name)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas marcadas aparecen como enlaces simbólicos en su directorio de inicio y admiten expansión con tilde (~nombre)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjanmerkkikansiot näkyvät symbolisina linkkeinä kotihakemistossasi ja tukevat tilde-laajennusta (~nimi)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers en favoris apparaissent comme des liens symboliques dans votre répertoire personnel et prennent en charge l'expansion du tilde (~nom)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיקיות מסומנות מופיעות כקישורים סמליים בתיקיית הבית שלך ותומכות בהרחבת טילדה (~name)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A könyvjelzőzött mappák szimbolikus hivatkozásként jelennek meg a saját könyvtárában, és támogatják a tilde-kibontást (~név)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle nei segnalibri vengono visualizzate come link simbolici nella directory home e supportano l'espansione con tilde (~nome)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブックマーク済みフォルダはホームディレクトリにシンボリックリンクとして表示され、チルダ展開（~名前）に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북마크된 폴더는 홈 디렉토리에 심볼릭 링크로 표시되며 틸드 확장(~이름)을 지원합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bokmerkede mapper vises som symbolske lenker i hjemmemappen din og støtter tilde-ekspansjon (~navn)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen met bladwijzer verschijnen als symlinks in uw thuismap en ondersteunen tilde-expansie (~naam)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldery z zakładkami pojawiają się jako dowiązania symboliczne w katalogu domowym i obsługują rozwijanie tyldy (~nazwa)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastas favoritas aparecem como symlinks no seu diretório home e suportam expansão com til (~nome)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pastas com marcador aparecem como symlinks no diretório home e suportam expansão com til (~nome)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosarele favorite apar ca linkuri simbolice în directorul personal și acceptă expandarea tildei (~nume)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mape z zaznamki se prikažejo kot simbolne povezave v vašem domačem imeniku in podpirajo razširitev s tildo (~ime)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bokmärkta mappar visas som symlänkar i din hemkatalog och stödjer tildeexpansion (~name)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теки в закладках відображаються як символічні посилання у вашій домашній теці та підтримують розгортання тильди (~name)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thư mục đã đánh dấu xuất hiện dưới dạng liên kết tượng trưng trong thư mục chính của bạn và hỗ trợ mở rộng dấu ngã (~name)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已收藏的文件夹将作为符号链接显示在主目录中，并支持波浪号展开（~名称）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加入書籤的資料夾將以符號連結的形式顯示在您的個人目錄中，並支援波浪號展開（~名稱）。"
          }
        }
      }
    },
