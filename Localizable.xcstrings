        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Coding-Agents erkennen“ in den Terminal-Einstellungen, um Agent-Benachrichtigungen zu ermöglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
