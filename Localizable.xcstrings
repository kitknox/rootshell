    "Match Client creates one client-sized virtual display." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ خيار «مطابقة العميل» شاشة افتراضية واحدة بحجم العميل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar al client crea una pantalla virtual de la mida del client."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podle klienta vytvoří jedno virtuální zobrazení o velikosti klienta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match klient opretter én virtuel skærm i klientens størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„An Client anpassen“ erstellt eine virtuelle Anzeige in Client-Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ajustar al cliente» crea una pantalla virtual del tamaño del cliente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaa asiakasta luo yhden asiakkaan kokoisen virtuaalinäytön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapter au client crée un écran virtuel unique à la taille du client."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה ללקוח יוצרת תצוגה וירטואלית אחת בגודל הלקוח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Klienshez igazítás egy kliens méretű virtuális kijelzőt hoz létre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adatta al client crea uno schermo virtuale delle dimensioni del client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クライアントに合わせる」は、クライアントのサイズに合わせた仮想ディスプレイを1つ作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라이언트에 맞춤은 클라이언트 크기의 가상 디스플레이 하나를 생성합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpass til klient oppretter én virtuell skjerm i klientens størrelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Client volgen maakt één virtueel scherm ter grootte van de client."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasuj do klienta tworzy jeden wirtualny ekran o rozmiarze klienta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar ao Cliente cria uma tela virtual do tamanho do cliente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar ao Cliente cria um ecrã virtual com o tamanho do cliente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Potrivire cu clientul” creează un singur ecran virtual de dimensiunea clientului."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujemanje z odjemalcem ustvari en navidezni zaslon v velikosti odjemalca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matcha klient skapar en virtuell skärm i klientens storlek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Під розмір клієнта» створює один віртуальний дисплей за розміром клієнта."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khớp máy khách tạo một màn hình ảo có kích thước bằng máy khách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“匹配客户端”会创建一个与客户端大小相同的虚拟显示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「符合用戶端」會建立一部與用戶端大小相同的虛擬顯示器。"
          }
        }
      }
    },
