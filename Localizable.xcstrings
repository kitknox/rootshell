    "Day/night theme can't be combined with color overrides — overrides will win." : {
      "comment" : "Migration warning: day/night vs overrides",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن دمج سمة النهار/الليل مع تجاوزات الألوان، التجاوزات هي التي ستُطبَّق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema dia/nit no es pot combinar amb sobreescriptures de color — les sobreescriptures prevaldran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motiv den/noc nelze kombinovat s přepsáními barev — přepsání mají přednost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag/nat-tema kan ikke kombineres med farvetilsidesættelser — tilsidesættelser vinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag/Nacht-Design lässt sich nicht mit Farbüberschreibungen kombinieren — Überschreibungen haben Vorrang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema día/noche no se puede combinar con anulaciones de color — las anulaciones prevalecerán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivä/yö-teemaa ei voi yhdistää värien ohituksiin — ohitukset voittavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème jour/nuit ne peut pas être combiné avec des remplacements de couleur — les remplacements l'emporteront."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשלב ערכת נושא יום/לילה עם דריסות צבע — הדריסות יגברו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nappali/éjjeli téma nem kombinálható színfelülbírálásokkal — a felülbírálások nyernek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tema giorno/notte non può essere combinato con sostituzioni di colore — le sostituzioni avranno la precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼/夜テーマは色のオーバーライドと併用できません — オーバーライドが優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주간/야간 테마는 색상 재정의와 함께 사용할 수 없습니다 — 재정의가 우선합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag/natt-tema kan ikke kombineres med fargeoverstyringer — overstyringer vinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag/nacht-thema kan niet worden gecombineerd met kleuroverschrijvingen — overschrijvingen winnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motywu dzień/noc nie można łączyć z nadpisaniami kolorów — wygrają nadpisania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tema dia/noite não pode ser combinado com substituições de cor — as substituições prevalecerão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tema dia/noite não pode ser combinado com substituições de cor — as substituições prevalecem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema zi/noapte nu poate fi combinată cu suprascrieri de culoare — suprascrierile câștigă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teme dan/noč ni mogoče združevati s preglasitvami barv — preglasitve bodo prevladale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag/natt-tema kan inte kombineras med färgöverstyrningar — överstyrningar vinner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
