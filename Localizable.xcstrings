    "(The escape character is only recognized at the start of a line.)" : {
      "comment" : "Footer for the SSH ~? escape help output",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(يُتعرَّف على حرف الهروب فقط في بداية السطر.)"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(El caràcter d'escapament només es reconeix a l'inici d'una línia.)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Únikový znak je rozpoznán pouze na začátku řádku.)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Escape-tegnet genkendes kun i starten af en linje.)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Das Escape-Zeichen wird nur am Zeilenanfang erkannt.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(El carácter de escape solo se reconoce al inicio de una línea.)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Escape-merkki tunnistetaan vain rivin alussa.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Le caractère d'échappement n'est reconnu qu'en début de ligne.)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(תו הבריחה מזוהה רק בתחילת שורה.)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Az escape karakter csak a sor elején ismerhető fel.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Il carattere di escape viene riconosciuto solo all'inizio di una riga.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(エスケープ文字は行頭でのみ認識されます。)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(이스케이프 문자는 줄의 시작 부분에서만 인식됩니다.)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Escape-tegnet gjenkjennes kun i starten av en linje.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Het escape-teken wordt alleen aan het begin van een regel herkend.)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Znak ucieczki jest rozpoznawany tylko na początku wiersza.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(O caractere de escape só é reconhecido no início de uma linha.)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(O caractere de escape só é reconhecido no início de uma linha.)"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Caracterul de escape este recunoscut doar la începutul unei linii.)"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Ubežni znak je prepoznan samo na začetku vrstice.)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Escape-tecknet känns endast igen i början av en rad.)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Символ виходу розпізнається лише на початку рядка.)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Ký tự escape chỉ được nhận dạng ở đầu dòng.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(转义字符仅在行首处被识别。)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(跳脫字元僅在行首處被識別。)"
          }
        }
      }
    },
