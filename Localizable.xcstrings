        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaj vidite"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad du ser"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що ви бачите"
          }
        },
        "vi" : {
          "stringUnit" : {
