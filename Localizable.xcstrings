    "Notify when a command is waiting for your input." : {
      "comment" : "Task notification policy detail: blocked only",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعار عندما ينتظر أمر إدخالك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica quan una ordre estigui esperant la teva entrada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornit, když příkaz čeká na váš vstup."
          }
        },
        "da" : {
