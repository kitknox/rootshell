    "Slide a terminal down from a screen edge with a global hotkey, from anywhere in macOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب طرفية من حافة الشاشة باستخدام مفتاح اختصار عام، من أي مكان في macOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes lliscar un terminal des d'una vora de la pantalla amb una drecera global, des de qualsevol lloc del macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysuňte terminál z okraje obrazovky globální klávesovou zkratkou odkudkoli v macOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub en terminal ned fra en skærmkant med en global genvejstast, hvor som helst i macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie mit einem globalen Hotkey von überall in macOS ein Terminal von einem Bildschirmrand heruntergleiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza un terminal desde un borde de la pantalla con una tecla rápida global, desde cualquier lugar de macOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liu'uta pääte alas näytön reunasta yleisellä pikanäppäimellä mistä tahansa macOS:ssä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un terminal depuis un bord de l'écran avec un raccourci global, où que vous soyez dans macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החליקו מסוף מקצה המסך באמצעות מקש קיצור גלובלי, מכל מקום ב-macOS."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csúsztasson le egy terminált a képernyő széléről egy globális gyorsbillentyűvel, bárhonnan a macOS-ben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai scorrere un terminale da un bordo dello schermo con un tasto rapido globale, da qualsiasi punto di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
