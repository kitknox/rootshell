    "Changes the home-screen icon. Updates here also apply to the animated icon in Settings and the Live Activity widget." : {
      "comment" : "Footer explaining what the app icon collection picker affects\nFooter explaining what the app icon picker affects",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر أيقونة الشاشة الرئيسية. تنطبق التحديثات هنا أيضًا على الأيقونة المتحركة في الإعدادات وعلى أداة النشاط المباشر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia la icona de la pantalla d'inici. Les modificacions aquí també s'apliquen a la icona animada dels Ajustaments i al widget d'Activitat en directe."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změní ikonu na domovské obrazovce. Úpravy se projeví také u animované ikony v Nastavení a ve widgetu živé aktivity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændrer symbolet på hjemmeskærmen. Ændringer her gælder også for det animerede symbol i Indstillinger og i widgetten til Live-aktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert das Symbol auf dem Home-Bildschirm. Änderungen gelten auch für das animierte Symbol in den Einstellungen und das Widget für Live-Aktivitäten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el icono de la pantalla de inicio. Los cambios también se aplican al icono animado en Ajustes y al widget de Actividad en Vivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtaa Koti-valikon kuvakkeen. Muutokset koskevat myös asetusten animoitua kuvaketta ja Live-toiminto-widgetiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie l'icône de l'écran d'accueil. Les modifications s'appliquent aussi à l'icône animée des Réglages et au widget Activité en direct."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משנה את סמל מסך הבית. העדכונים כאן חלים גם על הסמל המונפש בהגדרות ועל יישומון פעילות בשידור חי."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módosítja a kezdőképernyő ikonját. A módosítások a Beállítások animált ikonjára és az Élő tevékenység widgetre is érvényesek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia l'icona della schermata Home. Le modifiche valgono anche per l'icona animata in Impostazioni e per il widget Attività Live."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面のアイコンを変更します。ここでの変更は、設定画面のアニメーションアイコンおよびライブアクティビティのウィジェットにも反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면 아이콘을 변경합니다. 여기서 변경한 내용은 설정의 애니메이션 아이콘과 라이브 활동 위젯에도 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endrer symbolet på Hjem-skjermen. Endringer her gjelder også det animerte symbolet i Innstillinger og Live-aktivitet-widgeten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigt het symbool op het beginscherm. Wijzigingen gelden ook voor het geanimeerde symbool in Instellingen en de Live-activiteit-widget."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia ikonę na ekranie początkowym. Zmiany obejmują także animowaną ikonę w Ustawieniach oraz widżet Aktywności na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altera o ícone da Tela de Início. As atualizações também se aplicam ao ícone animado nos Ajustes e ao widget da Atividade ao Vivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altera o ícone do ecrã principal. As alterações aqui também se aplicam ao ícone animado nos Ajustes e ao widget de Atividade ao vivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbă pictograma ecranului principal. Modificările se aplică și pictogramei animate din Configurări și widgetului Activitate live."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremeni ikono na začetnem zaslonu. Spremembe veljajo tudi za animirano ikono v Nastavitvah in pripomoček Aktivnost v živo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändrar symbolen på hemskärmen. Ändringar här gäller även den animerade symbolen i Inställningar och widgeten för liveaktiviteter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінює значок на головному екрані. Зміни застосовуються також до анімованого значка в Параметрах і до віджета Live Activity."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi biểu tượng màn hình Chính. Các thay đổi cũng áp dụng cho biểu tượng động trong Cài đặt và widget Hoạt động trực tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改主屏幕图标。此处的更新也会应用到“设置”中的动态图标和“实时活动”小组件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改主畫面圖像。此處的更新也會套用至「設定」中的動態圖像和「即時動態」小工具。"
          }
        }
      }
    },
