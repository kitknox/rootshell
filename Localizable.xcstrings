    "Screen contents travel unencrypted. Use an SSH tunnel or an encrypting server on untrusted networks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل محتويات الشاشة دون تشفير. استخدم نفق SSH أو خادمًا مشفّرًا على الشبكات غير الموثوقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contingut de la pantalla viatja sense xifrar. Fes servir un túnel SSH o un servidor amb xifratge a les xarxes no fiables."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsah obrazovky se přenáší nešifrovaně. V nedůvěryhodných sítích použijte SSH tunel nebo šifrující server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmindholdet sendes ukrypteret. Brug en SSH-tunnel eller en krypterende server på netværk, du ikke har tillid til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildschirminhalte werden unverschlüsselt übertragen. Verwende in nicht vertrauenswürdigen Netzwerken einen SSH-Tunnel oder einen verschlüsselnden Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de la pantalla viaja sin cifrar. Usa un túnel SSH o un servidor con cifrado en redes no confiables."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytön sisältö kulkee salaamattomana. Käytä SSH-tunnelia tai salaavaa palvelinta epäluotettavissa verkoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de l'écran circule sans chiffrement. Utilisez un tunnel SSH ou un serveur chiffrant sur les réseaux non fiables."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכן המסך עובר ללא הצפנה. השתמש במנהרת SSH או בשרת מצפין ברשתות לא מהימנות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyő tartalma titkosítatlanul közlekedik. Nem megbízható hálózatokon használjon SSH-alagutat vagy titkosító kiszolgálót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto dello schermo viaggia non cifrato. Usa un tunnel SSH o un server con cifratura sulle reti non attendibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の内容は暗号化されずに送信されます。信頼できないネットワークでは SSH トンネルまたは暗号化サーバーを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 내용이 암호화되지 않은 채 전송됩니다. 신뢰할 수 없는 네트워크에서는 SSH 터널이나 암호화 서버를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjerminnholdet overføres ukryptert. Bruk en SSH-tunnel eller en krypterende server på nettverk du ikke stoler på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De scherminhoud wordt onversleuteld verzonden. Gebruik een SSH-tunnel of een versleutelende server op onvertrouwde netwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawartość ekranu jest przesyłana bez szyfrowania. W niezaufanych sieciach użyj tunelu SSH lub serwera szyfrującego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo da tela trafega sem criptografia. Use um túnel SSH ou um servidor com criptografia em redes não confiáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo do ecrã circula sem encriptação. Use um túnel SSH ou um servidor com encriptação em redes não fidedignas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conținutul ecranului circulă necriptat. Folosește un tunel SSH sau un server cu criptare în rețelele nesigure."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsebina zaslona potuje nešifrirano. V nezaupanja vrednih omrežjih uporabite tunel SSH ali strežnik s šifriranjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärminnehållet överförs okrypterat. Använd en SSH-tunnel eller en krypterande server på nätverk du inte litar på."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вміст екрана передається без шифрування. У ненадійних мережах використовуйте тунель SSH або сервер із шифруванням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung màn hình truyền đi không được mã hóa. Hãy dùng đường hầm SSH hoặc máy chủ mã hóa trên các mạng không tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕内容以未加密方式传输。在不受信任的网络上，请使用 SSH 隧道或支持加密的服务器。"
