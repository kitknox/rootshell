    "Too many requests. Please wait %lld seconds before retrying." : {
      "comment" : "AI Agent rate limit error with retry time",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبات كثيرة جدًا. يرجى الانتظار %lld ثانية قبل إعادة المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massa sol·licituds. Espereu %lld segons abans de tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho požadavků. Počkejte %lld sekund a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange anmodninger. Vent venligst %lld sekunder, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen. Bitte warten Sie %lld Sekunden, bevor Sie es erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes. Espere %lld segundos antes de reintentar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta pyyntöä. Odota %lld sekuntia ennen uudelleenyritystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de requêtes. Veuillez attendre %lld secondes avant de réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מדי בקשות. המתן %lld שניות לפני ניסיון חוזר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok kérés. Kérjük, várjon %lld másodpercet az újrapróbálkozás előtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste. Attendi %lld secondi prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストが多すぎます。%lld秒後に再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 너무 많습니다. %lld초 후에 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forespørsler. Vent %lld sekunder før du prøver igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel verzoeken. Wacht %lld seconden voordat u het opnieuw probeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele żądań. Poczekaj %lld sekund przed ponowną próbą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas requisições. Aguarde %lld segundos antes de tentar novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados pedidos. Aguarde %lld segundos antes de tentar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea multe cereri. Așteaptă %lld secunde înainte de a reîncerca."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveč zahtev. Počakajte %lld sekund, preden poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många förfrågningar. Vänta %lld sekunder innan du försöker igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забагато запитів. Зачекайте %lld секунд перед повторною спробою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều yêu cầu. Vui lòng đợi %lld giây trước khi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
