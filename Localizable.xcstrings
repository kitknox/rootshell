    "SSH private keys are synced separately using iCloud Keychain and are controlled per-key in SSH Keys settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مزامنة المفاتيح الخاصة لـ SSH بشكل منفصل عبر سلسلة مفاتيح iCloud ويتم التحكم بها لكل مفتاح في إعدادات مفاتيح SSH."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus privades SSH se sincronitzen per separat mitjançant iCloud Keychain i es controlen individualment a la configuració de claus SSH."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromé SSH klíče se synchronizují zvlášť pomocí Klíčenky iCloud a ovládají se pro každý klíč v nastavení SSH klíčů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private SSH-nøgler synkroniseres separat via iCloud-nøglering og styres pr. nøgle under SSH-nøgleindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private SSH-Schlüssel werden separat über den iCloud-Schlüsselbund synchronisiert und pro Schlüssel in den SSH-Schlüssel-Einstellungen gesteuert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves privadas SSH se sincronizan por separado mediante el llavero de iCloud y se controlan individualmente en los ajustes de claves SSH."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-yksityisavaimet synkronoidaan erikseen iCloud-avainnipun kautta, ja niitä hallitaan avainkohtaisesti SSH-avainasetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés privées SSH sont synchronisées séparément via le trousseau iCloud et sont gérées individuellement dans les réglages des clés SSH."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות SSH פרטיים מסונכרנים בנפרד באמצעות iCloud Keychain ומנוהלים לכל מפתח בהגדרות מפתחות SSH."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az SSH privát kulcsok külön szinkronizálódnak az iCloud kulcstárca segítségével, és kulcsonként vezérelhetők az SSH kulcsok beállításaiban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi private SSH vengono sincronizzate separatamente tramite il Portachiavi iCloud e sono controllate per singola chiave nelle impostazioni Chiavi SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH秘密鍵はiCloudキーチェーンを使用して個別に同期され、SSHキー設定でキーごとに制御されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 개인 키는 iCloud 키체인을 통해 별도로 동기화되며 SSH 키 설정에서 키별로 제어됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-privatnøkler synkroniseres separat via iCloud-nøkkelring og styres per nøkkel i SSH-nøkkelinnstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-privésleutels worden apart gesynchroniseerd via iCloud-sleutelhanger en worden per sleutel beheerd in de SSH-sleutelinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze prywatne SSH są synchronizowane osobno za pomocą iCloud Keychain i kontrolowane dla każdego klucza w ustawieniach kluczy SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves privadas SSH são sincronizadas separadamente usando o Keychain do iCloud e são controladas por chave nas configurações de Chaves SSH."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves privadas SSH são sincronizadas separadamente através do Porta-chaves iCloud e são controladas individualmente nas definições de Chaves SSH."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheile private SSH sunt sincronizate separat prin iCloud Keychain si sunt gestionate individual in setarile Chei SSH."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasebni SSH ključi se sinhronizirajo ločeno prek iCloud obeska ključev in se upravljajo posamično v nastavitvah SSH ključev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privata SSH-nycklar synkroniseras separat via iCloud-nyckelring och styrs per nyckel i SSH-nyckelinställningarna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватні SSH-ключі синхронізуються окремо через iCloud Keychain і керуються для кожного ключа в налаштуваннях SSH-ключів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa riêng tư SSH được đồng bộ riêng qua iCloud Keychain và được kiểm soát theo từng khóa trong cài đặt Khóa SSH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 私钥通过 iCloud 钥匙串单独同步，可在 SSH 密钥设置中按密钥控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 私密金鑰透過 iCloud 鑰匙圈單獨同步，可在 SSH 金鑰設定中逐一控制。"
          }
        }
      }
    },
