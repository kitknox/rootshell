            "value" : "Ten klucz został skonfigurowany na innym urządzeniu. Wybierz lokalny klucz powyżej lub połącz się — zostaniesz poproszony o wybranie klucza specyficznego dla urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta chave foi configurada em outro dispositivo. Selecione uma chave local acima, ou conecte — você será solicitado a escolher uma chave específica do dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta chave foi configurada noutro dispositivo. Selecione uma chave local acima, ou ligue-se — ser-lhe-á pedido que escolha uma chave específica do dispositivo."
