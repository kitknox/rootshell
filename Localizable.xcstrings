          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generering av den offentlige nøkkelen produserer en selvsignatur, så samme autentisering som du bruker for å signere med denne nøkkelen kreves (Face ID, passkode eller YubiKey-trykk/PIN)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het genereren van de publieke sleutel produceert een zelf-ondertekening, dus dezelfde authenticatie die u gebruikt om met deze sleutel te ondertekenen is vereist (Face ID, toegangscode of YubiKey-tik/PIN)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygenerowanie klucza publicznego tworzy autopodpis, więc wymagane będzie to samo uwierzytelnianie, którego używasz do podpisywania tym kluczem (Face ID, kod dostępu lub dotknięcie/PIN YubiKey)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerar a chave pública produz uma autoassinatura, então a mesma autenticação que você usa para assinar com esta chave será necessária (Face ID, código ou toque/PIN do YubiKey)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerar a chave pública produz uma auto-assinatura, pelo que será necessária a mesma autenticação que utiliza para assinar com esta chave (Face ID, código ou toque/PIN do YubiKey)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generarea cheii publice produce o auto-semnătură, deci va fi necesară aceeași autentificare pe care o folosești pentru a semna cu această cheie (Face ID, cod de acces sau atingere/PIN YubiKey)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
