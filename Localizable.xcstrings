        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beleži vsako kontrolno točko na poti ozadje → ospredje s časovnimi žigi in razlikami. Preklop sinhronega praznjenja izrisovalnika obnovi staro vedenje posodabljanja scene za A/B testiranje in je privzeto izklopljen."
          }
        },
        "sv" : {
          "stringUnit" : {
