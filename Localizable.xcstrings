          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura l'accesso SSH per scansionare le radio degli AP e ottenere informazioni sulle bande. Richiede l'accesso SSH ai dispositivi UniFi."
          }
        },
        "ja" : {
          "stringUnit" : {
