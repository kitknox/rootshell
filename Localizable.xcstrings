          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 어디서든 전역 단축키로 화면 가장자리에서 터미널을 슬라이드해 내립니다."
          }
        },
        "nb" : {
