          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones persisten incluso cuando la app está en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunnot säilyvät, vaikka sovellus siirtyisi taustalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions persistent même lorsque l'application est en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעלות נשמרות גם כאשר האפליקציה ברקע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkamenetek megmaradnak, még ha az alkalmazás a háttérbe kerül is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni persistono anche quando l'app è in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがバックグラウンドになってもセッションは維持されます。"
