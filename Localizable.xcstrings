    "Restore left swipe to Next Tab and right swipe to Previous Tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة التمرير لليسار إلى «علامة التبويب التالية» والتمرير لليمين إلى «علامة التبويب السابقة»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura el lliscament esquerre a Pestanya següent i el dret a Pestanya anterior."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovit přejetí vlevo na Další kartu a přejetí vpravo na Předchozí kartu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendan venstre stryg til Næste fane og højre stryg til Forrige fane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkes Wischen auf „Nächster Tab“ und rechtes Wischen auf „Vorheriger Tab“ zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar el deslizamiento izquierdo a Pestaña siguiente y el derecho a Pestaña anterior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauta vasen pyyhkäisy toimintoon Seuraava välilehti ja oikea pyyhkäisy toimintoon Edellinen välilehti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablir le balayage gauche sur Onglet suivant et le balayage droit sur Onglet précédent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שחזרו את ההחלקה שמאלה ללשונית הבאה ואת ההחלקה ימינה ללשונית הקודמת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balra húzás visszaállítása a Következő lapra és a jobbra húzás visszaállítása az Előző lapra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina lo scorrimento a sinistra su Scheda successiva e quello a destra su Scheda precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左スワイプを「次のタブ」、右スワイプを「前のタブ」に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 스와이프를 ‘다음 탭’으로, 오른쪽 스와이프를 ‘이전 탭’으로 복원합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbakestill venstre sveip til Neste fane og høyre sveip til Forrige fane."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links terugzetten op Volgende tab en veeg naar rechts op Vorige tab."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć gest w lewo do Następnej karty, a gest w prawo do Poprzedniej karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar o gesto para a esquerda como Próxima aba e o gesto para a direita como Aba anterior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar o deslize para a esquerda como Separador seguinte e o deslize para a direita como Separador anterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restabilește gestul stânga la Fila următoare și gestul dreapta la Fila anterioară."
