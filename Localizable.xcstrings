    "SSH servers typically allow only 6 key attempts. Some keys may not be tried." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسمح خوادم SSH عادةً بـ 6 محاولات مفاتيح فقط. قد لا يتم تجربة بعض المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els servidors SSH normalment permeten només 6 intents de clau. Algunes claus podrien no provar-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH servery obvykle povolují pouze 6 pokusů o klíč. Některé klíče nemusí být vyzkoušeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-servere tillader typisk kun 6 nøgleforsøg. Nogle nøgler bliver muligvis ikke afprøvet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-Server erlauben typischerweise nur 6 Schlüsselversuche. Einige Schlüssel werden möglicherweise nicht versucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores SSH normalmente permiten solo 6 intentos de clave. Es posible que algunas claves no se prueben."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-palvelimet sallivat tyypillisesti vain 6 avainkokeilu. Kaikkia avaimia ei ehkä kokeilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs SSH n'autorisent généralement que 6 tentatives de clé. Certaines clés pourraient ne pas être essayées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שרתי SSH בדרך כלל מאפשרים רק 6 ניסיונות מפתח. ייתכן שחלק מהמפתחות לא ינוסו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az SSH szerverek általában csak 6 kulcspróbálkozást engedélyeznek. Előfordulhat, hogy egyes kulcsok nem kerülnek kipróbálásra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server SSH in genere consentono solo 6 tentativi di chiave. Alcune chiavi potrebbero non essere provate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHサーバーは通常6回の鍵試行のみ許可します。一部のキーが試行されない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버는 일반적으로 6회의 키 시도만 허용합니다. 일부 키는 시도되지 않을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-servere tillater vanligvis bare 6 nøkkelforsøk. Noen nøkler blir kanskje ikke forsøkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-servers staan doorgaans slechts 6 sleutelpogingen toe. Sommige sleutels worden mogelijk niet geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwery SSH zazwyczaj zezwalają tylko na 6 prób uwierzytelnienia kluczem. Niektóre klucze mogą nie zostać wypróbowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidores SSH normalmente permitem apenas 6 tentativas de chave. Algumas chaves podem não ser tentadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores SSH normalmente permitem apenas 6 tentativas de chave. Algumas chaves podem não ser tentadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverele SSH permit de obicei doar 6 incercari de cheie. Este posibil ca unele chei sa nu fie incercate."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH strežniki običajno dovolijo le 6 poskusov s ključi. Nekateri ključi morda ne bodo preizkušeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-servrar tillåter vanligtvis bara 6 nyckelförsök. Vissa nycklar kanske inte testas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-сервери зазвичай дозволяють лише 6 спроб автентифікації ключем. Деякі ключі можуть не бути випробувані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các server SSH thường chỉ cho phép 6 lần thử khóa. Một số khóa có thể không được thử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器通常只允许 6 次密钥尝试。部分密钥可能不会被尝试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器通常只允許 6 次金鑰嘗試。部分金鑰可能不會被嘗試。"
          }
        }
      }
    },
