    "Invocations are routed through this region. Some Anthropic models require cross-region inference profiles, which the app handles automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُوجَّه الاستدعاءات عبر هذه المنطقة. تتطلب بعض نماذج Anthropic ملفات تعريف استدلال عبر المناطق، ويتولى التطبيق ذلك تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les invocacions es dirigeixen a través d'aquesta regió. Alguns models d'Anthropic necessiten perfils d'inferència entre regions, que l'app gestiona automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volání jsou směrována přes tuto oblast. Některé modely Anthropic vyžadují profily inference napříč oblastmi, o které se aplikace stará automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kald sendes via denne region. Nogle Anthropic-modeller kræver inferensprofiler på tværs af regioner, hvilket appen håndterer automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufrufe werden über diese Region geleitet. Einige Anthropic-Modelle erfordern regionsübergreifende Inferenzprofile, die die App automatisch verwaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las invocaciones se enrutan a través de esta región. Algunos modelos de Anthropic requieren perfiles de inferencia entre regiones, que la app gestiona automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutsut reititetään tämän alueen kautta. Jotkin Anthropicin mallit vaativat aluerajat ylittäviä päättelyprofiileja, jotka sovellus hoitaa automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels sont acheminés via cette région. Certains modèles Anthropic nécessitent des profils d'inférence inter-régions, que l'app gère automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההפעלות מנותבות דרך אזור זה. חלק ממודלי Anthropic דורשים פרופילי הסקה חוצי-אזורים, והאפליקציה מטפלת בכך אוטומטית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meghívások ezen a régión át irányulnak. Egyes Anthropic-modellek régiókon átnyúló következtetési profilokat igényelnek, amelyeket az alkalmazás automatikusan kezel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le invocazioni sono instradate attraverso questa regione. Alcuni modelli Anthropic richiedono profili di inferenza tra regioni, gestiti automaticamente dall'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼び出しはこのリージョン経由でルーティングされます。一部のAnthropicモデルはクロスリージョン推論プロファイルが必要ですが、アプリが自動的に処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호출은 이 리전을 통해 라우팅됩니다. 일부 Anthropic 모델은 리전 간 추론 프로필이 필요하며, 앱이 자동으로 처리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kall rutes gjennom denne regionen. Noen Anthropic-modeller krever inferensprofiler på tvers av regioner, noe appen håndterer automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanroepen worden via deze regio geleid. Sommige Anthropic-modellen vereisen inferentieprofielen voor meerdere regio's, die de app automatisch afhandelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wywołania są kierowane przez ten region. Niektóre modele Anthropic wymagają międzyregionalnych profili wnioskowania, którymi aplikacja zajmuje się automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As invocações são roteadas por esta região. Alguns modelos da Anthropic exigem perfis de inferência entre regiões, que o app gerencia automaticamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As invocações são encaminhadas por esta região. Alguns modelos da Anthropic exigem perfis de inferência entre regiões, que a aplicação trata automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invocările sunt direcționate prin această regiune. Unele modele Anthropic necesită profiluri de inferență între regiuni, gestionate automat de aplicație."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klici se usmerjajo prek te regije. Nekateri modeli Anthropic potrebujejo medregijske profile sklepanja, kar aplikacija obravnava samodejno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrop dirigeras via den här regionen. Vissa Anthropic-modeller kräver slutledningsprofiler för flera regioner, vilket appen hanterar automatiskt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виклики маршрутизуються через цей регіон. Деякі моделі Anthropic потребують міжрегіональних профілів виведення, які застосунок опрацьовує автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lệnh gọi được định tuyến qua khu vực này. Một số mô hình Anthropic yêu cầu hồ sơ suy luận liên khu vực, và ứng dụng sẽ tự xử lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调用通过此区域路由。部分 Anthropic 模型需要跨区域推理配置文件，应用会自动处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼叫會經由此區域路由。部分 Anthropic 模型需要跨區域推論設定檔，App 會自動處理。"
          }
        }
      }
    },
    "iOS suspends apps in the background, which stops SSH port forwards. Enable Auto Location to keep connections alive when you switch apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم iOS بتعليق التطبيقات في الخلفية، مما يوقف إعادة توجيه منافذ SSH. قم بتفعيل الموقع التلقائي للحفاظ على الاتصالات نشطة عند التبديل بين التطبيقات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspèn les apps en segon pla, la qual cosa atura les redireccions de ports SSH. Activa la ubicació automàtica per mantenir les connexions actives quan canvies d'app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pozastavuje aplikace na pozadí, což zastaví přesměrování SSH portů. Povolte automatickou polohu, aby připojení zůstala aktivní při přepínání aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspenderer apps i baggrunden, hvilket stopper SSH-portviderestillinger. Aktivér automatisk placering for at holde forbindelser aktive, når du skifter app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS setzt Apps im Hintergrund aus, wodurch SSH-Portweiterleitungen unterbrochen werden. Aktiviere den automatischen Standort, um Verbindungen beim App-Wechsel aufrechtzuerhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspende las apps en segundo plano, lo que detiene los reenvíos de puertos SSH. Activa la ubicación automática para mantener las conexiones activas cuando cambias de app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS keskeyttää sovellukset taustalla, mikä pysäyttää SSH-porttiohjaukset. Ota automaattinen sijainti käyttöön pitääksesi yhteydet aktiivisina, kun vaihdat sovellusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspend les apps en arrière-plan, ce qui interrompt les redirections de ports SSH. Activez la localisation automatique pour maintenir les connexions actives lorsque vous changez d'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS משהה אפליקציות ברקע, מה שמפסיק העברות יציאות SSH. הפעל מיקום אוטומטי כדי לשמור על חיבורים פעילים כשאתה מחליף אפליקציות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iOS felfüggeszti az alkalmazásokat a háttérben, ami leállítja az SSH-porttovábbításokat. Engedélyezze az automatikus helymegállapítást, hogy a kapcsolatok aktívak maradjanak alkalmazásváltáskor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS sospende le app in background, interrompendo gli inoltri di porta SSH. Attiva la posizione automatica per mantenere le connessioni attive quando cambi app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSはバックグラウンドのアプリを一時停止するため、SSHポートフォワードが停止します。アプリを切り替えても接続を維持するには、自動位置情報を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 백그라운드에서 앱을 일시 중지하여 SSH 포트 포워드가 중단됩니다. 앱을 전환할 때 연결을 유지하려면 자동 위치를 활성화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspenderer apper i bakgrunnen, noe som stopper SSH-portvideresendinger. Aktiver automatisk posisjon for å holde tilkoblinger aktive når du bytter app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS onderbreekt apps op de achtergrond, waardoor SSH-poortweiterleidingen stoppen. Schakel Automatische locatie in om verbindingen actief te houden wanneer je van app wisselt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS wstrzymuje aplikacje w tle, co zatrzymuje przekierowania portów SSH. Włącz automatyczną lokalizację, aby połączenia pozostawały aktywne po przełączeniu aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS suspende apps em segundo plano, o que interrompe redirecionamentos de porta SSH. Ative a Localização Automática para manter as conexões ativas ao alternar entre apps."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS suspende apps em segundo plano, o que interrompe reencaminhamentos de porta SSH. Ative a Localização Automática para manter as ligações ativas ao alternar entre apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suspendă aplicațiile în fundal, ceea ce oprește redirecționările de porturi SSH. Activați Localizarea automată pentru a menține conexiunile active când comutați între aplicații."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zaustavi aplikacije v ozadju, kar ustavi posredovanje vrat SSH. Omogočite samodejno lokacijo, da povezave ostanejo aktivne, ko preklapljate med aplikacijami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausar appar i bakgrunden, vilket stoppar SSH-portvidarebefordringar. Aktivera automatisk plats för att hålla anslutningar aktiva när du byter app."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS призупиняє застосунки у фоновому режимі, що зупиняє переспрямування портів SSH. Увімкніть автоматичне розташування, щоб з’єднання залишалися активними при перемиканні між застосунками."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS tạm ngưng ứng dụng ở nền, điều này dừng chuyển tiếp cổng SSH. Bật Vị trí tự động để giữ kết nối hoạt động khi bạn chuyển đổi ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会在后台挂起应用，导致 SSH 端口转发停止。启用自动定位可在切换应用时保持连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 會在背景暫停 App，導致 SSH 連接埠轉送中斷。啟用自動定位以在切換 App 時維持連線。"
          }
        }
      }
    },
