        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromý klíč je uložen u vašeho poskytovatele přístupových klíčů (iCloud Keychain nebo správce třetí strany jako 1Password) a synchronizuje se mezi vašimi zařízeními. rootshell jej nikdy nemůže exportovat."
