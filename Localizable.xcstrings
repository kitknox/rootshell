            "value" : "Připnuté položky se uchovávají bez ohledu na dobu uchovávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fastgjorte poster bevares uanset opbevaringsperioden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeheftete Einträge werden unabhängig vom Aufbewahrungszeitraum behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas fijadas se conservan independientemente del periodo de retención."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinnitetyt merkinnät säilytetään säilytysajasta riippumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées épinglées sont conservées quelle que soit la période de conservation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשומות מוצמדות נשמרות ללא קשר לתקופת השמירה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rögzített bejegyzések a megőrzési időszaktól függetlenül megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci fissate vengono mantenute indipendentemente dal periodo di conservazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めした項目は、保持期間に関係なく残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정된 항목은 보관 기간과 관계없이 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festede oppføringer beholdes uavhengig av oppbevaringsperioden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgezette items blijven bewaard, ongeacht de bewaarperiode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypięte wpisy są zachowywane niezależnie od okresu przechowywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As entradas fixadas são mantidas independentemente do período de retenção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As entradas fixadas são mantidas independentemente do período de retenção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intrările fixate sunt păstrate indiferent de perioada de reținere."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripeti vnosi se ohranijo ne glede na obdobje hrambe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fästa poster behålls oavsett lagringsperiod."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закріплені записи зберігаються незалежно від періоду зберігання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục đã ghim luôn được giữ lại bất kể thời gian lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已固定的条目会始终保留，不受保留期限的限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已釘選的項目會保留，不受保留期限影響。"
          }
        }
      }
    },
