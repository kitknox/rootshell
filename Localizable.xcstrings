    "Reminds you to return to the app or enable Location Diary after 60 seconds in the background with active SSH sessions" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكّرك بالعودة إلى التطبيق أو تفعيل يوميات الموقع بعد 60 ثانية في الخلفية مع جلسات SSH نشطة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Us recorda tornar a l'aplicació o activar el Diari d'ubicació després de 60 segons en segon pla amb sessions SSH actives"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomene vám návrat do aplikace nebo povolení deníku polohy po 60 sekundách na pozadí s aktivními SSH relacemi"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminder dig om at vende tilbage til appen eller aktivere Lokationsdagbog efter 60 sekunder i baggrunden med aktive SSH-sessioner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnert Sie daran, zur App zurückzukehren oder das Standorttagebuch zu aktivieren, wenn die App 60 Sekunden im Hintergrund ist und aktive SSH-Sitzungen vorhanden sind"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le recuerda volver a la aplicación o activar el Diario de ubicación después de 60 segundos en segundo plano con sesiones SSH activas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistuttaa palaamaan sovellukseen tai ottamaan sijaintipäiväkirjan käyttöön 60 sekunnin taustalla olon jälkeen aktiivisilla SSH-istunnoilla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous rappelle de revenir dans l'application ou d'activer le journal de localisation après 60 secondes en arrière-plan avec des sessions SSH actives"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מזכיר לך לחזור לאפליקציה או להפעיל יומן מיקום לאחר 60 שניות ברקע עם הפעלות SSH פעילות"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emlékezteti, hogy térjen vissza az alkalmazásba, vagy engedélyezze a Helynaplót, ha 60 másodpercig a háttérben van aktív SSH munkamenetekkel"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda di tornare all'app o attivare il Diario posizione dopo 60 secondi in background con sessioni SSH attive"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなSSHセッションがある状態でバックグラウンドに入って60秒後に、アプリに戻るか位置情報ダイアリーを有効にするようリマインドします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 SSH 세션이 있는 상태에서 백그라운드에 60초 후 앱으로 돌아오거나 위치 일기를 활성화하도록 알려줍니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminner deg om å gå tilbake til appen eller aktivere stedsdagbok etter 60 sekunder i bakgrunnen med aktive SSH-økter"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinnert u eraan om terug te keren naar de app of Locatiedagboek in te schakelen na 60 seconden op de achtergrond met actieve SSH-sessies"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomina o powrocie do aplikacji lub włączeniu Dziennika lokalizacji po 60 sekundach w tle z aktywnymi sesjami SSH"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembra você de retornar ao app ou ativar o Diário de Localização após 60 segundos em segundo plano com sessões SSH ativas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembra-o de voltar à aplicação ou ativar o Diário de Localização após 60 segundos em segundo plano com sessões SSH ativas"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
