    "Uses raw IP packets with correct source port. Requires sudo but supports multiple sessions." : {
      "comment" : "Hole-punch server method description: raw socket",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم حزم IP خام مع منفذ المصدر الصحيح. يتطلب sudo لكنه يدعم جلسات متعددة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa paquets IP raw amb el port d'origen correcte. Requereix sudo però suporta múltiples sessions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá raw IP pakety se správným zdrojovým portem. Vyžaduje sudo, ale podporuje více relací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger rå IP-pakker med korrekt kildeport. Kræver sudo, men understøtter flere sessioner."
          }
        },
