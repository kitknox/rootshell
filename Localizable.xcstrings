    "Closes the floating (non-pinned) sidebar after you pick a tab. The pinned sidebar always stays open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغلق الشريط الجانبي العائم (غير المثبّت) بعد اختيارك علامة تبويب. يبقى الشريط الجانبي المثبّت مفتوحًا دائمًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanca la barra lateral flotant (no fixada) després de seleccionar una pestanya. La barra lateral fixada sempre roman oberta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavře plovoucí (nepřipnutý) boční panel poté, co vyberete kartu. Připnutý boční panel zůstává vždy otevřený."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukker det flydende (ikke-fastgjorte) sidepanel, når du vælger en fane. Det fastgjorte sidepanel forbliver altid åbent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt die schwebende (nicht angeheftete) Seitenleiste, nachdem Sie einen Tab ausgewählt haben. Die angeheftete Seitenleiste bleibt immer geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la barra lateral flotante (no fijada) después de seleccionar una pestaña. La barra lateral fijada permanece siempre abierta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulkee kelluvan (kiinnittämättömän) sivupalkin, kun valitset välilehden. Kiinnitetty sivupalkki pysyy aina avoinna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferme la barre latérale flottante (non épinglée) après que vous sélectionnez un onglet. La barre latérale épinglée reste toujours ouverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סוגר את סרגל הצד הצף (שאינו מוצמד) לאחר שתבחר לשונית. סרגל הצד המוצמד נשאר תמיד פתוח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezárja a lebegő (nem rögzített) oldalsávot, miután kiválaszt egy lapot. A rögzített oldalsáv mindig nyitva marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiude la barra laterale fluttuante (non fissata) dopo aver selezionato una scheda. La barra laterale fissata rimane sempre aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを選択すると、フローティング（固定されていない）サイドバーを閉じます。固定されたサイドバーは常に開いたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 선택하면 떠 있는(고정되지 않은) 사이드바를 닫습니다. 고정된 사이드바는 항상 열려 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukker det flytende (ikke-festede) sidepanelet etter at du velger en fane. Det festede sidepanelet forblir alltid åpent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit de zwevende (niet-vastgezette) zijbalk nadat je een tabblad hebt gekozen. De vastgezette zijbalk blijft altijd geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamyka pływający (nieprzypięty) panel boczny po wybraniu karty. Przypięty panel boczny zawsze pozostaje otwarty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha a barra lateral flutuante (não fixada) depois que você seleciona uma aba. A barra lateral fixada permanece sempre aberta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha a barra lateral flutuante (não fixada) depois de selecionar um separador. A barra lateral fixada permanece sempre aberta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Închide bara laterală flotantă (nefixată) după ce selectați o filă. Bara laterală fixată rămâne întotdeauna deschisă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapre plavajočo (nepripeto) stransko vrstico, ko izberete zavihek. Pripeta stranska vrstica ostane vedno odprta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger det flytande (ej fästa) sidofältet när du väljer en flik. Det fästa sidofältet förblir alltid öppet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закриває плаваючу (незакріплену) бічну панель після вибору вкладки. Закріплена бічна панель завжди залишається відкритою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng thanh bên nổi (không được ghim) sau khi bạn chọn một thẻ. Thanh bên đã ghim luôn luôn mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您选择标签页后关闭浮动（未固定）侧边栏。固定的侧边栏始终保持打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您選擇分頁後關閉浮動（未固定）側邊欄。固定的側邊欄始終保持開啟。"
          }
        }
      }
    },
