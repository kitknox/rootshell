    "~/.promptrc.toml overrides the theme selected below. Remove it to use Settings themes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml يتجاوز السمة المحددة أدناه. قم بإزالته لاستخدام سمات الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml substitueix el tema seleccionat a continuació. Elimineu-lo per utilitzar els temes de Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml přepisuje níže vybrané téma. Odstraňte ho pro použití témat z Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml tilsidesætter det valgte tema nedenfor. Fjern det for at bruge temaer fra Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml überschreibt das unten ausgewählte Theme. Entfernen Sie es, um die Einstellungs-Themes zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml reemplaza el tema seleccionado a continuación. Elimínelo para usar los temas de Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml ohittaa alla valitun teeman. Poista se käyttääksesi Asetusten teemoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.promptrc.toml remplace le thème sélectionné ci-dessous. Supprimez-le pour utiliser les thèmes des Réglages."
