        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehåller en radbrytning eller ett kontrolltecken, så inloggningsskalet används."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Містить розрив рядка або керівний символ, тому буде використано оболонку входу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chứa ký tự xuống dòng hoặc ký tự điều khiển, nên shell đăng nhập sẽ được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
