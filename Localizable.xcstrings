        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisanie zastąpi ustawienia SSH tego profilu (klucze, przekierowania portów, przekazywanie agenta, opcje terminala) ustawieniami udostępniania ekranu. Nazwa hosta zostanie zachowana."
