    "Full Screen expands this Screen Sharing pane after the connection succeeds. Keyboard Toolbar controls the toolbar above the software keyboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوسّع «ملء الشاشة» جزء مشاركة الشاشة هذا بعد نجاح الاتصال. ويتحكم «شريط أدوات لوحة المفاتيح» في الشريط الظاهر فوق لوحة المفاتيح على الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantalla completa amplia aquesta subfinestra de Compartir pantalla quan la connexió s'estableix correctament. Barra d'eines del teclat controla la barra d'eines situada sobre el teclat en pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celá obrazovka roztáhne tento panel sdílení obrazovky po úspěšném připojení. Panel nástrojů klávesnice ovládá panel nástrojů nad softwarovou klávesnicí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuld skærm udvider denne skærmdelingsrude, når forbindelsen er oprettet. Tastaturværktøjslinje styrer værktøjslinjen over skærmtastaturet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollbild vergrößert diesen Bildschirmfreigabe-Bereich, nachdem die Verbindung hergestellt wurde. Tastatur-Symbolleiste steuert die Symbolleiste über der Bildschirmtastatur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Pantalla completa» amplía este panel de Compartir pantalla una vez establecida la conexión. «Barra de herramientas del teclado» controla la barra situada encima del teclado en pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koko näyttö laajentaa tämän näytön jakamisen ruudun, kun yhteys on muodostettu. Näppäimistön työkalupalkki hallitsee näppäimistön yläpuolella olevaa työkalupalkkia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plein écran agrandit ce volet Partage d'écran une fois la connexion établie. Barre d'outils du clavier contrôle la barre d'outils au-dessus du clavier à l'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסך מלא מרחיב את חלונית שיתוף המסך הזו לאחר שהחיבור מצליח. סרגל הכלים של המקלדת שולט בסרגל הכלים שמעל המקלדת שעל המסך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Teljes képernyő a kapcsolat létrejötte után kiterjeszti ezt a képernyőmegosztási panelt. A Billentyűzet eszköztár a szoftveres billentyűzet feletti eszköztárat vezérli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermo intero espande questo riquadro di condivisione schermo dopo che la connessione è riuscita. Barra strumenti tastiera controlla la barra sopra la tastiera software."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「フルスクリーン」は接続成功後にこの画面共有ペインを拡大します。「キーボードツールバー」はソフトウェアキーボードの上に表示されるツールバーを制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면은 연결에 성공한 후 이 화면 공유 창을 확대합니다. 키보드 도구 모음은 화면 키보드 위에 표시되는 도구 모음을 제어합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullskjerm utvider dette skjermdelingspanelet etter at tilkoblingen er opprettet. Tastaturverktøylinje styrer verktøylinjen over skjermtastaturet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig scherm vergroot dit Schermdelen-deelvenster nadat de verbinding tot stand is gekomen. Toetsenbordwerkbalk bepaalt de werkbalk boven het schermtoetsenbord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełny ekran rozszerza ten panel udostępniania ekranu po udanym połączeniu. Pasek narzędzi klawiatury steruje paskiem nad klawiaturą ekranową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Tela Cheia expande este painel de Compartilhamento de Tela após a conexão ser estabelecida. A Barra de Ferramentas do Teclado controla a barra acima do teclado virtual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecrã Inteiro expande este painel de Partilha de Ecrã após a ligação ser estabelecida. Barra de Ferramentas do Teclado controla a barra de ferramentas acima do teclado virtual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ecran complet” extinde acest panou de partajare ecran după reușita conexiunii. „Bara de instrumente a tastaturii” controlează bara de instrumente de deasupra tastaturii virtuale."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celoten zaslon razširi to podokno skupne rabe zaslona po uspešni povezavi. Orodna vrstica tipkovnice upravlja orodno vrstico nad zaslonsko tipkovnico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helskärm expanderar den här skärmdelningsrutan när anslutningen har lyckats. Tangentbordets verktygsfält styr verktygsfältet ovanför skärmtangentbordet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Повноекранний режим» розгортає цю область спільного доступу до екрана після успішного з'єднання. «Панель інструментів клавіатури» керує панеллю над екранною клавіатурою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn màn hình sẽ mở rộng khung Chia sẻ màn hình này sau khi kết nối thành công. Thanh công cụ bàn phím kiểm soát thanh công cụ phía trên bàn phím ảo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“全屏”会在连接成功后展开此屏幕共享窗格。“键盘工具栏”控制软件键盘上方的工具栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「全螢幕」會在連線成功後展開此螢幕共享窗格。「鍵盤工具列」用於控制螢幕鍵盤上方的工具列。"
          }
        }
      }
    },
