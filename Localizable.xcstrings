        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan està desactivat, utilitza exec per substituir el terminal per l'ordre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zakázáno, používá exec k nahrazení shellu příkazem."
