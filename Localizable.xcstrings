    "Add an AWS account under Settings → Connections → Cloud Providers, then return here to link it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف حساب AWS من الإعدادات ← الاتصالات ← مزودو الخدمات السحابية، ثم عُد هنا لربطه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu un compte d'AWS a Configuració → Connexions → Proveïdors de núvol i torneu aquí per enllaçar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte účet AWS v Nastavení → Připojení → Poskytovatelé cloudu a poté se sem vraťte, abyste jej propojili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en AWS-konto under Indstillinger → Forbindelser → Cloud-udbydere, og vend tilbage hertil for at tilknytte den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie unter Einstellungen → Verbindungen → Cloud-Anbieter ein AWS-Konto hinzu und kehren Sie dann hierher zurück, um es zu verknüpfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una cuenta de AWS en Ajustes → Conexiones → Proveedores de cloud y vuelve aquí para vincularla."
