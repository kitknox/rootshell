    "Event tap allows more exotic key combinations but requires Accessibility permission. If denied, the visor falls back to a Carbon hotkey automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح Event tap بتركيبات مفاتيح أكثر تنوعًا، ولكنه يتطلب إذن إمكانية الوصول. إذا رُفض، سيعود Visor تلقائيًا إلى اختصار Carbon."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap permet combinacions de tecles més especials, però requereix permís d'accessibilitat. Si es denega, Visor torna automàticament a una drecera Carbon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap umožňuje neobvyklejší klávesové kombinace, ale vyžaduje oprávnění Zpřístupnění. Pokud je zamítnuto, Visor automaticky přejde zpět na klávesovou zkratku Carbon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap tillader mere usædvanlige tastekombinationer, men kræver tilladelse til Tilgængelighed. Hvis den nægtes, falder Visor automatisk tilbage til en Carbon-genvejstast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event Tap erlaubt ausgefallenere Tastenkombinationen, erfordert aber die Bedienungshilfen-Berechtigung. Wird sie verweigert, fällt Visor automatisch auf einen Carbon-Hotkey zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap permite combinaciones de teclas más inusuales, pero requiere permiso de Accesibilidad. Si se deniega, Visor usa automáticamente una tecla rápida de Carbon como alternativa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap sallii erikoisemmat näppäinyhdistelmät, mutta vaatii Esteettömyys-luvan. Jos lupa evätään, Visor palaa automaattisesti Carbon-pikanäppäimeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap permet des combinaisons de touches plus inhabituelles, mais nécessite l'autorisation Accessibilité. En cas de refus, Visor se rabat automatiquement sur un raccourci Carbon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap מאפשר שילובי מקשים חריגים יותר, אך דורש הרשאת נגישות. אם ההרשאה נדחית, Visor יחזור אוטומטית למקש קיצור של Carbon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az event tap szokatlanabb billentyűkombinációkat is lehetővé tesz, de Kisegítő lehetőségek engedélyt igényel. Elutasítás esetén a Visor automatikusan visszavált Carbon gyorsbillentyűre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap consente combinazioni di tasti più insolite, ma richiede il permesso Accessibilità. Se negato, Visor ripiega automaticamente su un tasto rapido Carbon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tapを使うと、より特殊なキーの組み合わせを使えますが、アクセシビリティ権限が必要です。拒否された場合、Visorは自動的にCarbonホットキーへフォールバックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap은 더 특수한 키 조합을 허용하지만 손쉬운 사용 권한이 필요합니다. 거부되면 Visor는 자동으로 Carbon 단축키로 대체됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap tillater mer uvanlige tastekombinasjoner, men krever Tilgjengelighet-tillatelse. Hvis den nektes, faller Visor automatisk tilbake til en Carbon-hurtigtast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap maakt ongebruikelijkere toetscombinaties mogelijk, maar vereist toestemming voor Toegankelijkheid. Als die wordt geweigerd, valt Visor automatisch terug op een Carbon-sneltoets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap pozwala używać bardziej nietypowych kombinacji klawiszy, ale wymaga uprawnienia Dostępność. Jeśli zostanie odrzucone, Visor automatycznie wróci do skrótu Carbon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap permite combinações de teclas mais incomuns, mas exige permissão de Acessibilidade. Se negada, o Visor volta automaticamente para uma tecla de atalho Carbon."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap permite combinações de teclas mais invulgares, mas requer permissão de Acessibilidade. Se for negada, o Visor volta automaticamente para uma tecla de atalho Carbon."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap permite combinații de taste mai neobișnuite, dar necesită permisiunea Accesibilitate. Dacă este refuzată, Visor revine automat la o tastă rapidă Carbon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap omogoča bolj neobičajne kombinacije tipk, vendar zahteva dovoljenje za dostopnost. Če je zavrnjeno, se Visor samodejno vrne na bližnjico Carbon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap tillåter mer ovanliga tangentkombinationer, men kräver behörighet för Hjälpmedel. Om den nekas går Visor automatiskt tillbaka till en Carbon-snabbtangent."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap дає змогу використовувати незвичніші комбінації клавіш, але потребує дозволу Доступності. Якщо його відхилено, Visor автоматично повернеться до гарячої клавіші Carbon."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap cho phép các tổ hợp phím đặc biệt hơn nhưng cần quyền Trợ năng. Nếu bị từ chối, Visor sẽ tự động chuyển về phím tắt Carbon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap 允许使用更特殊的按键组合，但需要辅助功能权限。如果被拒绝，Visor 会自动退回到 Carbon 热键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event tap 允許使用更特殊的按鍵組合，但需要輔助使用權限。如果被拒絕，Visor 會自動退回 Carbon 熱鍵。"
          }
        }
      }
    },
