    "Are you sure you want to delete '%@'? The kubeconfig will be removed from your device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد أنك تريد حذف '%@'؟ سيتم إزالة kubeconfig من جهازك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esteu segur que voleu suprimir '%@'? El kubeconfig s'eliminarà del vostre dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete smazat „%@“? Kubeconfig bude odstraněn z vašeho zařízení."
          }
