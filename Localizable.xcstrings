        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es un nombre de terminfo válido. Usa solo letras, dígitos y los caracteres . _ + -"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei kelvollinen terminfo-nimi. Käytä vain kirjaimia, numeroita ja merkkejä . _ + -"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom terminfo non valide. Utilisez uniquement des lettres, des chiffres et les caractères . _ + -"
