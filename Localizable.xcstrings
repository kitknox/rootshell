    "No trusted host key for %@ yet. Connect once in a terminal session so its host key is verified and saved. The VPN won't start without it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد بعد مفتاح مضيف موثوق لـ %@. اتصل مرة واحدة في جلسة طرفية ليتم التحقق من مفتاح مضيفه وحفظه. لن يبدأ VPN بدونه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no hi ha cap clau d'amfitrió de confiança per a %@. Connecta't una vegada en una sessió de terminal perquè la seva clau d'amfitrió es verifiqui i es desi. El VPN no s'iniciarà sense ella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro %@ zatím není žádný důvěryhodný klíč hostitele. Připojte se jednou v terminálové relaci, aby byl jeho klíč hostitele ověřen a uložen. VPN se bez něj nespustí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er endnu ingen betroet værtsnøgle for %@. Opret forbindelse én gang i en terminalsession, så dens værtsnøgle bliver verificeret og gemt. VPN'en starter ikke uden den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein vertrauenswürdiger Host-Schlüssel für %@. Verbinde dich einmal in einer Terminalsitzung, damit sein Host-Schlüssel verifiziert und gespeichert wird. Ohne ihn startet das VPN nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay una clave de host de confianza para %@. Conéctate una vez en una sesión de terminal para que su clave de host se verifique y guarde. La VPN no se iniciará sin ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteelle %@ ei ole vielä luotettua isäntäavainta. Yhdistä kerran terminaali-istunnossa, jotta sen isäntäavain vahvistetaan ja tallennetaan. VPN ei käynnisty ilman sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé d'hôte de confiance pour %@ pour l'instant. Connectez-vous une fois dans une session de terminal afin que sa clé d'hôte soit vérifiée et enregistrée. Le VPN ne démarrera pas sans elle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין מפתח מארח מהימן עבור %@. התחבר פעם אחת בהפעלת מסוף כדי שמפתח המארח שלו יאומת ויישמר. ה-VPN לא יופעל בלעדיו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs megbízható hoszkulcs a következőhöz: %@. Csatlakozz egyszer egy terminálmunkamenetben, hogy a hoszkulcsa ellenőrizve és mentve legyen. A VPN nélküle nem indul el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna chiave host attendibile per %@ al momento. Connettiti una volta in una sessione terminale affinché la sua chiave host venga verificata e salvata. La VPN non si avvierà senza di essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の信頼済みホストキーはまだありません。ターミナルセッションで一度接続して、ホストキーを検証・保存してください。それがないと VPN は開始できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대한 신뢰된 호스트 키가 아직 없습니다. 터미널 세션에서 한 번 연결하여 호스트 키를 확인하고 저장하세요. 그것 없이는 VPN이 시작되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ennå ingen klarert vertsnøkkel for %@. Koble til én gang i en terminaløkt slik at vertsnøkkelen dens verifiseres og lagres. VPN-en starter ikke uten den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is nog geen vertrouwde hostsleutel voor %@. Maak eenmaal verbinding in een terminalsessie zodat de hostsleutel wordt geverifieerd en opgeslagen. De VPN start niet zonder deze sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak jeszcze zaufanego klucza hosta dla %@. Połącz się raz w sesji terminala, aby jego klucz hosta został zweryfikowany i zapisany. VPN nie uruchomi się bez niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há uma chave de host confiável para %@. Conecte-se uma vez em uma sessão de terminal para que sua chave de host seja verificada e salva. A VPN não iniciará sem ela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não existe uma chave de anfitrião fidedigna para %@. Ligue-se uma vez numa sessão de terminal para que a sua chave de anfitrião seja verificada e guardada. A VPN não iniciará sem ela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă nu există o cheie de gazdă de încredere pentru %@. Conectează-te o dată într-o sesiune de terminal pentru ca cheia sa de gazdă să fie verificată și salvată. VPN-ul nu va porni fără ea."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za %@ še ni zaupanja vrednega ključa gostitelja. Enkrat se povežite v terminalski seji, da bo njegov ključ gostitelja preverjen in shranjen. VPN se brez njega ne bo zagnal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ännu ingen betrodd värdnyckel för %@. Anslut en gång i en terminalsession så att dess värdnyckel verifieras och sparas. VPN:en startar inte utan den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для %@ ще немає довіреного ключа хоста. Підключіться один раз у сеансі термінала, щоб його ключ хоста було перевірено та збережено. Без нього VPN не запуститься."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có khóa host đáng tin cậy cho %@. Hãy kết nối một lần trong phiên terminal để khóa host của nó được xác minh và lưu lại. VPN sẽ không khởi động nếu thiếu nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无 %@ 的受信任主机密钥。请在终端会话中连接一次，以便验证并保存其主机密钥。没有它，VPN 将无法启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無 %@ 的受信任主機金鑰。請在終端機工作階段中連線一次，以便驗證並儲存其主機金鑰。沒有它，VPN 將無法啟動。"
          }
        }
      }
    },
    "No trusted SSH host key for %@. Connect to this server in a regular SSH terminal session first so its host key can be verified and saved, then start the VPN." : {
      "comment" : "VPN start error: the server's host key has not been accepted yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد مفتاح مضيف SSH موثوق لـ %@. اتصل بهذا الخادم أولاً في جلسة طرفية SSH عادية ليتم التحقق من مفتاح مضيفه وحفظه، ثم ابدأ VPN."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha cap clau d'amfitrió SSH de confiança per a %@. Connecta't primer a aquest servidor en una sessió de terminal SSH normal perquè la seva clau d'amfitrió es pugui verificar i desar, i després inicia el VPN."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro %@ není žádný důvěryhodný SSH klíč hostitele. Nejprve se k tomuto serveru připojte v běžné SSH terminálové relaci, aby bylo možné jeho klíč hostitele ověřit a uložit, poté spusťte VPN."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen betroet SSH-værtsnøgle for %@. Opret først forbindelse til denne server i en almindelig SSH-terminalsession, så dens værtsnøgle kan verificeres og gemmes, og start derefter VPN'en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein vertrauenswürdiger SSH-Host-Schlüssel für %@. Verbinde dich zuerst in einer normalen SSH-Terminalsitzung mit diesem Server, damit sein Host-Schlüssel verifiziert und gespeichert werden kann, und starte dann das VPN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay una clave de host SSH de confianza para %@. Conéctate primero a este servidor en una sesión de terminal SSH normal para que su clave de host se pueda verificar y guardar, y luego inicia la VPN."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteelle %@ ei ole luotettua SSH-isäntäavainta. Yhdistä ensin tähän palvelimeen tavallisessa SSH-terminaali-istunnossa, jotta sen isäntäavain voidaan vahvistaa ja tallentaa, ja käynnistä sitten VPN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé d'hôte SSH de confiance pour %@. Connectez-vous d'abord à ce serveur dans une session de terminal SSH normale afin que sa clé d'hôte puisse être vérifiée et enregistrée, puis démarrez le VPN."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין מפתח מארח SSH מהימן עבור %@. התחבר תחילה לשרת זה בהפעלת מסוף SSH רגילה כדי שניתן יהיה לאמת ולשמור את מפתח המארח שלו, ולאחר מכן הפעל את ה-VPN."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs megbízható SSH-hoszkulcs a következőhöz: %@. Először csatlakozz ehhez a szerverhez egy normál SSH terminálmunkamenetben, hogy a hoszkulcsa ellenőrizhető és menthető legyen, majd indítsd el a VPN-t."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna chiave host SSH attendibile per %@. Connettiti prima a questo server in una normale sessione terminale SSH affinché la sua chiave host possa essere verificata e salvata, quindi avvia la VPN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の信頼済み SSH ホストキーがありません。まず通常の SSH ターミナルセッションでこのサーバーに接続し、ホストキーを検証・保存してから VPN を開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대한 신뢰된 SSH 호스트 키가 없습니다. 먼저 일반 SSH 터미널 세션에서 이 서버에 연결하여 호스트 키를 확인하고 저장한 다음 VPN을 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen klarert SSH-vertsnøkkel for %@. Koble først til denne serveren i en vanlig SSH-terminaløkt slik at vertsnøkkelen dens kan verifiseres og lagres, og start deretter VPN-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen vertrouwde SSH-hostsleutel voor %@. Maak eerst verbinding met deze server in een gewone SSH-terminalsessie zodat de hostsleutel kan worden geverifieerd en opgeslagen, en start daarna de VPN."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak zaufanego klucza hosta SSH dla %@. Najpierw połącz się z tym serwerem w zwykłej sesji terminala SSH, aby jego klucz hosta mógł zostać zweryfikowany i zapisany, a następnie uruchom VPN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de host SSH confiável para %@. Conecte-se primeiro a este servidor em uma sessão de terminal SSH normal para que sua chave de host possa ser verificada e salva, e então inicie a VPN."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de anfitrião SSH fidedigna para %@. Ligue-se primeiro a este servidor numa sessão de terminal SSH normal para que a sua chave de anfitrião possa ser verificada e guardada e, em seguida, inicie a VPN."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există o cheie de gazdă SSH de încredere pentru %@. Conectează-te mai întâi la acest server într-o sesiune de terminal SSH obișnuită pentru ca cheia sa de gazdă să poată fi verificată și salvată, apoi pornește VPN-ul."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za %@ ni zaupanja vrednega SSH ključa gostitelja. Najprej se povežite s tem strežnikom v običajni SSH terminalski seji, da bo mogoče njegov ključ gostitelja preveriti in shraniti, nato zaženite VPN."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen betrodd SSH-värdnyckel för %@. Anslut först till den här servern i en vanlig SSH-terminalsession så att dess värdnyckel kan verifieras och sparas, och starta sedan VPN:en."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для %@ немає довіреного SSH-ключа хоста. Спочатку підключіться до цього сервера у звичайному сеансі термінала SSH, щоб його ключ хоста можна було перевірити та зберегти, потім запустіть VPN."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có khóa host SSH đáng tin cậy cho %@. Hãy kết nối đến máy chủ này trong một phiên terminal SSH thông thường trước để khóa host của nó có thể được xác minh và lưu lại, sau đó khởi động VPN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 %@ 的受信任 SSH 主机密钥。请先在常规 SSH 终端会话中连接到此服务器，以便验证并保存其主机密钥，然后再启动 VPN。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有 %@ 的受信任 SSH 主機金鑰。請先在一般 SSH 終端機工作階段中連線到此伺服器，以便驗證並儲存其主機金鑰，然後再啟動 VPN。"
          }
        }
      }
    },
