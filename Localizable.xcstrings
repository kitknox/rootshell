    "Photos are stored on this device. Tap a photo to use it as the terminal background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن الصور على هذا الجهاز. اضغط على صورة لاستخدامها كخلفية للطرفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fotos es guarden en aquest dispositiu. Toqueu una foto per utilitzar-la com a fons del terminal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky jsou uloženy v tomto zařízení. Klepnutím na fotku ji použijete jako pozadí terminálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos gemmes på denne enhed. Tryk på et foto for at bruge det som terminalbaggrund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos werden auf diesem Gerät gespeichert. Tippen Sie auf ein Foto, um es als Terminal-Hintergrund zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se guardan en este dispositivo. Toca una foto para usarla como fondo del terminal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvat tallennetaan tälle laitteelle. Napauta kuvaa käyttääksesi sitä terminaalin taustana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont stockées sur cet appareil. Touchez une photo pour l'utiliser comme arrière-plan du terminal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונות נשמרות במכשיר זה. הקש על תמונה כדי להשתמש בה כרקע המסוף."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fotók ezen az eszközön tárolódnak. Koppintson egy fotóra, hogy a terminál háttereként használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sono archiviate su questo dispositivo. Tocca una foto per usarla come sfondo del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真はこのデバイスに保存されます。写真をタップするとターミナルの背景に設定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진은 이 기기에 저장됩니다. 사진을 탭하면 터미널 배경으로 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildene lagres på denne enheten. Trykk på et bilde for å bruke det som terminalbakgrunn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto's worden op dit apparaat bewaard. Tik op een foto om deze als terminalachtergrond te gebruiken."
