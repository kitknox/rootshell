    "Approve the VPN system extension in System Settings → Login Items & Extensions to finish connecting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق على امتداد نظام VPN في إعدادات النظام → عناصر تسجيل الدخول والإضافات لإكمال الاتصال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprova l'extensió del sistema VPN a Configuració del Sistema → Elements d'inici i extensions per acabar la connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schvalte systémové rozšíření VPN v Nastavení systému → Přihlašovací položky a rozšíření a dokončete tak připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend VPN-systemudvidelsen under Systemindstillinger → Login-emner og udvidelser for at fuldføre forbindelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmige die VPN-Systemerweiterung unter Systemeinstellungen → Anmeldeobjekte & Erweiterungen, um die Verbindung abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba la extensión del sistema de la VPN en Ajustes del Sistema → Ítems de inicio y extensiones para terminar de conectar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy VPN-järjestelmälaajennus kohdassa Järjestelmäasetukset → Kirjautumiskohteet ja laajennukset viimeistelläksesi yhteyden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvez l'extension système du VPN dans Réglages Système → Ouverture et extensions pour terminer la connexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אשר את הרחבת המערכת של VPN בהגדרות המערכת → פריטי כניסה והרחבות כדי להשלים את החיבור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyd jóvá a VPN rendszerbővítményt a Rendszerbeállítások → Bejelentkezési elemek és bővítmények menüben a csatlakozás befejezéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva l'estensione di sistema della VPN in Impostazioni di Sistema → Elementi login ed estensioni per completare la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を完了するには、システム設定 → ログイン項目と機能拡張で VPN システム機能拡張を承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 완료하려면 시스템 설정 → 로그인 항목 및 확장 프로그램에서 VPN 시스템 확장을 승인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenn VPN-systemutvidelsen under Systeminnstillinger → Påloggingsobjekter og utvidelser for å fullføre tilkoblingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keur de VPN-systeemextensie goed via Systeeminstellingen → Inlogonderdelen en extensies om de verbinding te voltooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdź rozszerzenie systemowe VPN w Ustawienia systemowe → Elementy logowania i rozszerzenia, aby dokończyć łączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove a extensão de sistema da VPN em Ajustes do Sistema → Itens de início e extensões para concluir a conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove a extensão de sistema da VPN em Definições do Sistema → Itens de início e extensões para concluir a ligação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobă extensia de sistem VPN în Configurări de sistem → Elemente de conectare și extensii pentru a finaliza conectarea."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite sistemsko razširitev VPN v Sistemske nastavitve → Elementi za prijavo in razširitve, da dokončate povezovanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn VPN-systemtillägget under Systeminställningar → Inloggningsobjekt och tillägg för att slutföra anslutningen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схваліть системне розширення VPN у Системні параметри → Об'єкти входу та розширення, щоб завершити підключення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phê duyệt tiện ích mở rộng hệ thống VPN trong Cài đặt hệ thống → Mục đăng nhập và Tiện ích mở rộng để hoàn tất kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系统设置」→「登录项与扩展」中批准 VPN 系统扩展以完成连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定」→「登入項目與延伸功能」中核准 VPN 系統延伸功能以完成連線。"
          }
        }
      }
    },
