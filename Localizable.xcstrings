        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelarea VPN este disponibilă în prezent doar pe iOS și iPadOS. Setările configurate aici se vor aplica atunci când acest profil este utilizat pe acele dispozitive."
          }
