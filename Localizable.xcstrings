        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil übernimmt den Remote-Terminal-Typ normalerweise aus den Einstellungen. Überschreiben Sie ihn nur für Hosts, die einen anderen terminfo-Namen benötigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente este perfil hereda el tipo de terminal remoto de Ajustes. Cámbialo solo para los hosts que requieran un nombre de terminfo distinto."
