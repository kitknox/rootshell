          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce la frecuencia de actualización y la de las animaciones cuando el Modo de bajo consumo está activado o el dispositivo está caliente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienentää päivitysnopeutta ja animaatioiden kuvataajuutta, kun Virransäästötila on käytössä tai laite on lämmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit la fréquence de rafraîchissement et la cadence des animations lorsque le Mode économie d'énergie est activé ou que l'appareil chauffe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפחית את קצב הרענון וקצב פריימי האנימציה כאשר מצב חיסכון בצריכת חשמל פעיל או כשהמכשיר חם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csökkenti a frissítési gyakoriságot és az animációk képkockasebességét, ha az Energiatakarékos üzemmód be van kapcsolva, vagy az eszköz meleg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduce la frequenza di aggiornamento e quella delle animazioni quando il Risparmio energetico è attivo o il dispositivo è caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードがオンのとき、またはデバイスが高温のときに、リフレッシュレートとアニメーションのフレームレートを下げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드가 켜져 있거나 기기가 따뜻할 때 재생 빈도와 애니메이션 프레임 속도를 낮춥니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduserer oppdateringsfrekvensen og animasjonenes bildefrekvens når Lavstrømmodus er på eller enheten er varm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlaagt de verversingssnelheid en animatiesnelheid wanneer de Energiebesparingsmodus is ingeschakeld of het apparaat warm is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejsza częstotliwość odświeżania i liczbę klatek animacji, gdy włączony jest Tryb niskiego zużycia energii lub gdy urządzenie się nagrzewa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz a taxa de atualização e a das animações quando o Modo de Baixo Consumo está ativado ou o dispositivo está aquecido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz a taxa de atualização e a das animações quando o Modo de Baixo Consumo está ativado ou o dispositivo está quente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce frecvența de reîmprospătare și pe cea a animațiilor când Consum redus este activat sau dispozitivul este cald."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmanjša hitrost osveževanja in hitrost sličic animacij, ko je vklopljen Način nizke porabe energije ali ko se naprava segreje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sänker uppdateringsfrekvensen och animationernas bildfrekvens när Lågeffektläge är på eller enheten är varm."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знижує частоту оновлення та частоту кадрів анімацій, коли увімкнено Режим енергозбереження або пристрій нагрівається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giảm tốc độ làm mới và tốc độ khung hình hoạt ảnh khi Chế độ nguồn điện thấp được bật hoặc khi thiết bị nóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在开启低电量模式或设备发热时，降低刷新率和动画帧率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在開啟低耗電模式或裝置發熱時，降低更新率和動畫影格率。"
          }
        }
      }
    },
