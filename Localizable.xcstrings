    "Like Roam/Mosh, it survives network changes and high latency." : {
      "comment" : "Trzsz help: about line 2",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل Roam/Mosh، يتحمل تغييرات الشبكة وزمن الاستجابة العالي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Roam/Mosh, sobreviu als canvis de xarxa i l'alta latència."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podobně jako Roam/Mosh přežije změny sítě a vysokou latenci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligesom Roam/Mosh overlever den netværksændringer og høj latens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Roam/Mosh übersteht es Netzwerkwechsel und hohe Latenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como Roam/Mosh, sobrevive a cambios de red y alta latencia."
