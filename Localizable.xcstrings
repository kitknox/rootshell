        }
      }
    },
    "Keep the toolbar visible when the on-screen keyboard is dismissed. Tap the terminal to bring the keyboard back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ شريط الأدوات مرئيًا عند إخفاء لوحة المفاتيح على الشاشة. اضغط على الطرفية لإعادة إظهار لوحة المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la barra d'eines visible quan es tanca el teclat en pantalla. Toca el terminal per fer reaparèixer el teclat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechat panel nástrojů viditelný i po skrytí klávesnice na obrazovce. Klepnutím na terminál klávesnici znovu zobrazíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold værktøjslinjen synlig, når skærmtastaturet skjules. Tryk på terminalen for at få tastaturet frem igen."
