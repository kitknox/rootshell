    "Moves the clock from the info bar to the right side, making the left prompt shorter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل الساعة من شريط المعلومات إلى الجانب الأيمن، مما يجعل موجه الأوامر الأيسر أقصر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou el rellotge de la barra d’informació al costat dret, escurçant l’indicador esquerre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesune hodiny z informačního panelu na pravou stranu, čímž zkrátí levý prompt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter uret fra infobjælken til højre side, så den venstre prompt bliver kortere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Uhr von der Infoleiste nach rechts und verkürzt so den linken Prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el reloj de la barra de información al lado derecho, acortando el indicador izquierdo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtää kellon infopalkista oikealle puolelle, mikä lyhentää vasenta kehotetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace l’horloge de la barre d’infos vers la droite, raccourcissant l’invite à gauche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר את השעון מסרגל המידע לצד ימין, ומקצר את שורת הפקודה השמאלית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az órát az infósávból a jobb oldalra helyezi, rövidítve a bal oldali promptot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta l’orologio dalla barra informazioni al lato destro, accorciando il prompt a sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時計をインフォバーからプロンプトの右側に移動し、左側のプロンプトを短くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계를 정보 표시줄에서 오른쪽으로 이동하여 왼쪽 프롬프트를 짧게 만듭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter klokken fra infolinjen til høyre side, noe som gjør den venstre prompten kortere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst de klok van de infobalk naar rechts, waardoor de linker prompt korter wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi zegar z paska informacyjnego na prawą stronę, skracając lewy prompt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o relógio da barra de informações para o lado direito, encurtando o prompt à esquerda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o relógio da barra de informação para o lado direito, encurtando o prompt à esquerda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mută ceasul din bara de informații în partea dreaptă, scurtând promptul din stânga."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premakne uro z informacijske vrstice na desno stran, s čimer skrajša levi poziv."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar klockan från infofältet till höger sida, vilket gör den vänstra prompten kortare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує годинник з інформаційної панелі праворуч, скорочуючи лівий запит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển đồng hồ từ thanh thông tin sang bên phải, giúp dấu nhắc bên trái ngắn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将时钟从信息栏移至右侧，使左侧提示符更简短。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將時鐘從資訊列移至右側，使左側提示符更簡短。"
          }
        }
      }
    },
    "Moves the tab bar into the macOS title bar area to remove the extra top row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل شريط علامات التبويب إلى منطقة شريط العنوان في macOS لإزالة الصف العلوي الإضافي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou la barra de pestanyes a l'àrea de la barra de títol de macOS per eliminar la fila superior addicional."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesune panel karet do oblasti záhlaví macOS pro odstranění nadbytečného horního řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter fanebjælken ind i macOS-titelbjælkeområdet for at fjerne den ekstra øverste række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Tab-Leiste in den macOS-Titelleistenbereich, um die zusätzliche obere Zeile zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la barra de pestañas al área de la barra de título de macOS para eliminar la fila superior adicional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtää välilehtirivin macOS-otsikkopalkin alueelle ylimääräisen ylärivin poistamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la barre d'onglets dans la zone de la barre de titre macOS pour supprimer la rangée supplémentaire en haut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר את סרגל הלשוניות לאזור שורת הכותרת של macOS כדי להסיר את השורה העליונה הנוספת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fülsort a macOS címsorába helyezi, eltávolítva a felesleges felső sort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la barra delle schede nell'area della barra del titolo di macOS per eliminare la riga superiore aggiuntiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーをmacOSのタイトルバー領域に移動し、余分な上部行を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 바를 macOS 제목 표시줄 영역으로 이동하여 여분의 상단 행을 제거합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter fanelinjen inn i macOS-tittellinjen for å fjerne den ekstra øverste raden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst de tabbalk naar het macOS-titelbalkgebied om de extra bovenste rij te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi pasek kart do obszaru paska tytułu macOS, aby usunąć dodatkowy górny wiersz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a barra de abas para a área da barra de título do macOS para remover a linha extra superior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a barra de separadores para a área da barra de título do macOS para remover a fila extra no topo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mută bara de file în zona barei de titlu macOS pentru a elimina rândul suplimentar de sus."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premakne vrstico zavihkov v območje naslovne vrstice macOS, da odstrani dodatno zgornjo vrstico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar flikfältet till macOS titelrad för att ta bort den extra övre raden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує панель вкладок у область заголовка macOS, щоб прибрати додатковий верхній рядок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển thanh tab vào vùng thanh tiêu đề macOS để xóa hàng trên cùng thừa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将标签栏移入 macOS 标题栏区域以去除额外的顶部行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將標籤列移入 macOS 標題列區域以移除額外的頂部列。"
          }
        }
      }
    },
    "MPTCP is backward-compatible — if the server doesn't support it, the connection automatically falls back to regular TCP." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP متوافق مع الإصدارات السابقة — إذا لم يدعمه الخادم، يعود الاتصال تلقائيًا إلى TCP العادي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP és compatible amb versions anteriors: si el servidor no ho suporta, la connexió torna automàticament a TCP normal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP je zpětně kompatibilní — pokud server nepodporuje MPTCP, připojení automaticky přejde na běžné TCP."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP er bagudkompatibelt — hvis serveren ikke understøtter det, falder forbindelsen automatisk tilbage til almindelig TCP."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP ist abwärtskompatibel – wenn der Server es nicht unterstützt, fällt die Verbindung automatisch auf normales TCP zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP es compatible con versiones anteriores: si el servidor no lo admite, la conexión recurre automáticamente a TCP estándar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP on taaksepäin yhteensopiva — jos palvelin ei tue sitä, yhteys siirtyy automaattisesti tavalliseen TCP:hen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP est rétrocompatible — si le serveur ne le prend pas en charge, la connexion bascule automatiquement sur du TCP standard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP תואם לאחור — אם השרת אינו תומך בו, החיבור חוזר אוטומטית ל-TCP רגיל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az MPTCP visszafelé kompatibilis – ha a szerver nem támogatja, a kapcsolat automatikusan visszaáll hagyományos TCP-re."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP è retrocompatibile — se il server non lo supporta, la connessione passa automaticamente al TCP standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCPには後方互換性があり、サーバーが対応していない場合は自動的に通常のTCPにフォールバックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP는 하위 호환됩니다 — 서버가 지원하지 않으면 자동으로 일반 TCP로 대체됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP er bakoverkompatibelt – hvis tjeneren ikke støtter det, faller tilkoblingen automatisk tilbake til vanlig TCP."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP is achterwaarts compatibel — als de server het niet ondersteunt, valt de verbinding automatisch terug op gewoon TCP."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP jest wstecznie kompatybilny — jeśli serwer go nie obsługuje, połączenie automatycznie przełącza się na zwykły TCP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MPTCP é retrocompatível — se o servidor não o suportar, a conexão volta automaticamente para TCP regular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MPTCP é retrocompatível — se o servidor não o suportar, a ligação recorre automaticamente a TCP normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP este retrocompatibil — dacă serverul nu îl acceptă, conexiunea revine automat la TCP standard."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP je vzvratno združljiv — če ga strežnik ne podpira, povezava samodejno preide na običajen TCP."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP är bakåtkompatibelt — om servern inte stödjer det faller anslutningen automatiskt tillbaka till vanlig TCP."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP має зворотну сумісність — якщо сервер не підтримує його, з'єднання автоматично повертається до звичайного TCP."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP tương thích ngược — nếu máy chủ không hỗ trợ, kết nối sẽ tự động dự phòng về TCP thông thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP 向后兼容——如果服务器不支持，连接将自动回退到常规 TCP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPTCP 向下相容——如果伺服器不支援，連線將自動退回至一般 TCP。"
          }
        }
      }
    },
