          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha detectat cap clau de seguretat. Connecteu la vostra clau de seguretat mitjançant USB-C, Lightning o NFC."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebyl detekován žádný bezpečnostní klíč. Připojte svůj bezpečnostní klíč přes USB-C, Lightning nebo NFC."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen sikkerhedsnøgle registreret. Tilslut din sikkerhedsnøgle via USB-C, Lightning eller NFC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Sicherheitsschlüssel erkannt. Verbinden Sie Ihren Sicherheitsschlüssel über USB-C, Lightning oder NFC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se detectó ninguna clave de seguridad. Conecte su clave de seguridad mediante USB-C, Lightning o NFC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suojausavainta ei havaittu. Yhdistä suojausavaimesi USB-C:n, Lightningin tai NFC:n kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé de sécurité détectée. Connectez votre clé de sécurité via USB-C, Lightning ou NFC."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא זוהה מפתח אבטחה. חבר את מפתח האבטחה שלך באמצעות USB-C, Lightning או NFC."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem érzékelhető biztonsági kulcs. Csatlakoztassa biztonsági kulcsát USB-C, Lightning vagy NFC segítségével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna chiave di sicurezza rilevata. Collega la chiave di sicurezza tramite USB-C, Lightning o NFC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティキーが検出されませんでした。USB-C、Lightning、またはNFCでセキュリティキーを接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 키가 감지되지 않았습니다. USB-C, Lightning 또는 NFC로 보안 키를 연결하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen sikkerhetsnøkkel oppdaget. Koble til sikkerhetsnøkkelen din via USB-C, Lightning eller NFC."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen beveiligingssleutel gedetecteerd. Sluit uw beveiligingssleutel aan via USB-C, Lightning of NFC."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wykryto klucza bezpieczeństwa. Podłącz klucz bezpieczeństwa przez USB-C, Lightning lub NFC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de segurança detectada. Conecte sua chave de segurança via USB-C, Lightning ou NFC."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de segurança detetada. Ligue a sua chave de segurança através de USB-C, Lightning ou NFC."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu a fost detectată nicio cheie de securitate. Conectați cheia de securitate prin USB-C, Lightning sau NFC."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varnostnega ključa ni bilo mogoče zaznati. Povežite svoj varnostni ključ prek USB-C, Lightning ali NFC."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen säkerhetsnyckel upptäcktes. Anslut din säkerhetsnyckel via USB-C, Lightning eller NFC."
