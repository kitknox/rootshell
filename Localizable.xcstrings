    "The agent's saved sign-in could not be read on that host." : {
      "comment" : "Agent usage unavailable detail",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة تسجيل دخول الوكيل المحفوظ على ذلك المضيف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut llegir l'inici de sessió desat de l'agent en aquest amfitrió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené přihlášení agenta se na tom hostiteli nepodařilo přečíst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentens gemte login kunne ikke læses på den vært."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Anmeldung des Agents konnte auf diesem Host nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el inicio de sesión guardado del agente en ese host."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentin tallennettua kirjautumista ei voitu lukea kyseisellä isännällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire la connexion enregistrée de l'agent sur cet hôte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לקרוא את פרטי ההתחברות השמורים של הסוכן במארח הזה."
          }
        },
        "hu" : {
          "stringUnit" : {
