    },
    "Add the strings that should never show on screen: your name in different spellings, e-mail addresses, hostnames." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف السلاسل التي يجب ألا تظهر على الشاشة أبداً: اسمك بتهجئات مختلفة، وعناوين البريد الإلكتروني، وأسماء المضيفين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu les cadenes que no s'han de mostrar mai a la pantalla: el vostre nom en diferents grafies, adreces de correu electrònic, noms d'amfitrió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte řetězce, které se nikdy nemají objevit na obrazovce: vaše jméno v různých podobách, e-mailové adresy, názvy hostitelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj de strenge, der aldrig må vises på skærmen: dit navn i forskellige stavemåder, e-mailadresser og værtsnavne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie die Zeichenketten hinzu, die nie auf dem Bildschirm erscheinen sollen: Ihren Namen in verschiedenen Schreibweisen, E-Mail-Adressen, Hostnamen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las cadenas que nunca deben aparecer en la pantalla: tu nombre con distintas grafías, direcciones de correo electrónico, nombres de host."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää merkkijonot, joiden ei pitäisi koskaan näkyä näytöllä: nimesi eri kirjoitusasuissa, sähköpostiosoitteet, isäntänimet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les chaînes qui ne doivent jamais apparaître à l'écran : votre nom dans différentes orthographes, des adresses e-mail, des noms d'hôte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את המחרוזות שלעולם לא יוצגו על המסך: השם שלך באיותים שונים, כתובות דוא״ל, שמות מארחים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja hozzá azokat a karakterláncokat, amelyek soha nem jelenhetnek meg a képernyőn: a neve különböző írásmódokban, e-mail-címek, gazdagépnevek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le stringhe che non devono mai comparire sullo schermo: il tuo nome nelle diverse grafie, gli indirizzi e-mail, gli hostname."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面に表示したくない文字列を追加します: 表記違いを含む自分の名前、メールアドレス、ホスト名など。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면에 절대 표시되지 않아야 할 문자열을 추가하세요: 다양한 표기의 이름, 이메일 주소, 호스트명."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til strengene som aldri skal vises på skjermen: navnet ditt i ulike skrivemåter, e-postadresser, vertsnavn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de tekenreeksen toe die nooit op het scherm mogen verschijnen: uw naam in verschillende schrijfwijzen, e-mailadressen, hostnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj ciągi znaków, które nigdy nie powinny pojawiać się na ekranie: Twoje imię i nazwisko w różnych pisowniach, adresy e-mail, nazwy hostów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as strings que nunca devem aparecer na tela: seu nome em diferentes grafias, endereços de e-mail, nomes de host."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as cadeias que nunca devem aparecer no ecrã: o seu nome em diferentes grafias, endereços de e-mail, nomes de anfitrião."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă șirurile care nu trebuie să apară niciodată pe ecran: numele tău în diverse variante de scriere, adrese de e-mail, nume de gazde."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte nize, ki se na zaslonu ne smejo nikoli prikazati: svoje ime v različnih zapisih, e-poštne naslove, imena gostiteljev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till de strängar som aldrig ska visas på skärmen: ditt namn i olika stavningar, e-postadresser, värdnamn."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте рядки, які ніколи не мають з'являтися на екрані: ваше ім'я в різних написаннях, адреси електронної пошти, імена хостів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm các chuỗi không bao giờ được hiện trên màn hình: tên bạn ở các cách viết khác nhau, địa chỉ e-mail, tên máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加绝不应显示在屏幕上的字符串：您姓名的不同写法、电子邮件地址、主机名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入絕不應顯示在畫面上的字串：您姓名的各種拼寫方式、電子郵件地址、主機名稱。"
          }
        }
      }
    },
    "Add these lines to enable mouse support and pass window titles through to rootshell tab titles." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف هذه الأسطر لتمكين دعم الماوس وتمرير عناوين النوافذ إلى عناوين تبويبات rootshell."
          }
        },
        "ca" : {
          "stringUnit" : {
