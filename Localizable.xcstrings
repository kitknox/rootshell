    "Sound played when a terminal bell (\\a) is triggered. \"Haptic Only\" preserves the default vibration-only behavior." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصوت الذي يُشغَّل عند تفعيل جرس الطرفية (\\a). يحافظ خيار \"اهتزاز فقط\" على الاستجابة اللمسية بدون صوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So reproduït quan s'activa la campana del terminal (\\a). \"Només hàptic\" conserva la resposta tàctil sense so."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk přehrávaný při spuštění zvonku terminálu (\\a). „Pouze haptika“ zachovává hmatovou odezvu bez zvuku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd der afspilles, når en terminalklokke (\\a) udløses. \"Kun haptisk\" bevarer den haptiske respons uden lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton, der bei Auslösung einer Terminal-Glocke (\\a) abgespielt wird. „Nur Haptik“ erhält die haptische Rückmeldung ohne Ton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonido reproducido al activarse la campana del terminal (\\a). \"Solo háptico\" conserva la respuesta táctil sin sonido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ääni, joka toistetaan terminaalin kellon (\\a) lauetessa. \"Vain tuntopalaute\" säilyttää tuntopalautteen ilman ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son joué lorsqu'une cloche de terminal (\\a) est déclenchée. « Haptique uniquement » conserve la réponse tactile sans son."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צליל המושמע כאשר פעמון הטרמינל (\\a) מופעל. \"רטט בלבד\" שומר על תגובה הפטית ללא צליל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A terminálcsengő (\\a) aktiválásakor lejátszott hang. A „Csak tapintás“ megőrzi a haptikus visszajelzést hang nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suono riprodotto quando viene attivata la campana del terminale (\\a). \"Solo feedback aptico\" mantiene la risposta tattile senza suono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルベル（\\a）がトリガーされた時に再生される音。「触覚のみ」は音なしで触覚フィードバックを維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 벨(\\a)이 트리거될 때 재생되는 소리. \"햄틱만\"은 소리 없이 햄틱 반응을 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd som spilles når en terminalbjelle (\\a) utløses. \"Kun haptisk\" bevarer den haptiske responsen uten lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geluid dat wordt afgespeeld wanneer een terminalbel (\\a) wordt geactiveerd. \"Alleen haptisch\" behoudt de haptische respons zonder geluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk odtwarzany po wyzwoleniu dzwonka terminala (\\a). „Tylko haptyka“ zachowuje odpowiedź dotykową bez dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som reproduzido quando um sino do terminal (\\a) é acionado. \"Apenas háptico\" preserva a resposta tátil sem som."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som reproduzido quando uma campainha do terminal (\\a) é acionada. \"Apenas háptico\" preserva a resposta tátil sem som."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunetul redat când este activat clopoțelul terminalului (\\a). „Doar haptic“ păstrează răspunsul tactil fără sunet."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvok, ki se predvaja ob sprožitvi zvonca terminala (\\a). \"Samo haptično\" ohranja haptični odziv brez zvoka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljud som spelas när en terminalbjällra (\\a) utlöses. \"Endast haptisk\" bevarar den haptiska responsen utan ljud."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук, що відтворюється при спрацюванні дзвоника терміналу (\\a). \"Лише вібрація\" зберігає тактильний відгук без звуку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh phát khi chuông terminal (\\a) được kích hoạt. \"Chỉ rung\" giữ lại phản hồi xúc giác mà không có âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端铃声（\\a）触发时播放的声音。“仅触觉反馈”保留触觉响应但不发出声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端鈴聲（\\a）觸發時播放的聲音。「僅觸覺回饋」保留觸覺響應但不發出聲音。"
          }
        }
      }
    },
    "Sound used for OS notifications such as terminal events and SSH session reminders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصوت المستخدم لإشعارات نظام التشغيل مثل أحداث الطرفية وتذكيرات جلسات SSH."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So utilitzat per a les notificacions del sistema operatiu, com ara esdeveniments del terminal i recordatoris de sessions SSH."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
