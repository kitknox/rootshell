          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá dài hoặc chứa ký tự điều khiển. zsh gốc của macOS sẽ được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
