    "KCP byte counts are measured at the UDP wire level. Retransmits are shared across all KCP sessions in the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقاس عدد بايتات KCP على مستوى شبكة UDP. تتم مشاركة عمليات إعادة الإرسال بين جميع جلسات KCP في التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els recomptes de bytes de KCP es mesuren al nivell de xarxa UDP. Les retransmissions es comparteixen entre totes les sessions KCP de l'aplicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počty bajtů KCP se měří na úrovni přenosu UDP. Opakované přenosy jsou sdílené mezi všemi relacemi KCP v aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP-bytetal måles på UDP-netværksniveau. Gensendinger deles på tværs af alle KCP-sessioner i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP-Bytezahlen werden auf UDP-Übertragungsebene gemessen. Neuübertragungen werden von allen KCP-Sitzungen in der App gemeinsam genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recuentos de bytes de KCP se miden a nivel de red UDP. Las retransmisiones se comparten entre todas las sesiones KCP de la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP:n tavumäärät mitataan UDP:n siirtotasolla. Uudelleenlähetykset jaetaan sovelluksen kaikkien KCP-istuntojen kesken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nombres d'octets KCP sont mesurés au niveau de la couche UDP. Les retransmissions sont partagées entre toutes les sessions KCP de l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספירת הבايטים של KCP נמדדת ברמת התעבורה של UDP. שידורים חוזרים משותפים לכל הפעלות KCP באפליקציה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A KCP bájtszámai UDP-átviteli szinten vannak mérve. Az újraküldések meg vannak osztva az alkalmazás összes KCP-munkamenete között."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I conteggi dei byte KCP sono misurati a livello di trasmissione UDP. Le ritrasmissioni sono condivise tra tutte le sessioni KCP nell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP のバイト数は UDP のワイヤーレベルで計測されます。再送はアプリ内のすべての KCP セッションで共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP 바이트 수는 UDP 와이어 수준에서 측정됩니다. 재전송은 앱의 모든 KCP 세션에서 공유됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP-bytetellinger måles på UDP-nettverksnivå. Videresendinger deles på tvers av alle KCP-økter i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP-byteaantallen worden gemeten op UDP-netwerkniveau. Hertransmissies worden gedeeld door alle KCP-sessies in de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczby bajtów KCP są mierzone na poziomie transmisji UDP. Retransmisje są współdzielone przez wszystkie sesje KCP w aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contagens de bytes do KCP são medidas no nível de transmissão UDP. As retransmissões são compartilhadas entre todas as sessões KCP no app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contagens de bytes do KCP são medidas ao nível de transmissão UDP. As retransmissões são partilhadas por todas as sessões KCP na aplicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numărul de octeți KCP este măsurat la nivelul de transmisie UDP. Retransmisiile sunt partajate între toate sesiunile KCP din aplicație."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Števci bajtov KCP se merijo na ravni prenosa UDP. Ponovni prenosi so v skupni rabi med vsemi sejami KCP v aplikaciji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KCP-byteantal mäts på UDP-nätverksnivå. Omsändningar delas mellan alla KCP-sessioner i appen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість байтів KCP вимірюється на рівні передавання UDP. Повторні передавання спільні для всіх сеансів KCP у застосунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lượng byte KCP được đo ở mức truyền UDP. Việc truyền lại được chia sẻ giữa tất cả các phiên KCP trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
