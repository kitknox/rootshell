    "Adjusts the cell box around each glyph for the selected font. Negative values tighten spacing; positive values loosen it. Settings are saved per font." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط مربع الخلية حول كل حرف للخط المحدد. القيم السالبة تضيّق التباعد؛ القيم الموجبة توسعه. تُحفظ الإعدادات لكل خط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la caixa de cel·la al voltant de cada glif per al tipus de lletra seleccionat. Els valors negatius redueixen l'espaiat; els positius l'amplien. Els ajustos es desen per tipus de lletra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravuje rámeček buňky kolem každého glyfu pro vybraný font. Záporné hodnoty zužují rozestupy; kladné je rozšiřují. Nastavení se ukládá pro každý font zvlášť."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerer cellefeltet omkring hvert glyf for den valgte skrifttype. Negative værdier strammer mellemrum; positive værdier løsner dem. Indstillinger gemmes pr. skrifttype."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt das Zellenfeld um jedes Glyph der ausgewählten Schrift an. Negative Werte verringern den Abstand; positive Werte vergrößern ihn. Einstellungen werden pro Schrift gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la caja de celda alrededor de cada glifo para la fuente seleccionada. Los valores negativos reducen el espaciado; los positivos lo amplían. Los ajustes se guardan por fuente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säätää solulaatikkoa jokaisen kirjasinmerkin ympärillä valitulle fontille. Negatiiviset arvot tiivistävät välistystä; positiiviset arvot väljentävät sitä. Asetukset tallennetaan fonttikohtaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste la cellule autour de chaque glyphe pour la police sélectionnée. Les valeurs négatives resserrent l'espacement ; les valeurs positives le relâchent. Les réglages sont enregistrés par police."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתאים את תיבת התא סביב כל סימן עבור הגופן הנבחר. ערכים שליליים מצמצמים את המרווח; ערכים חיוביים מרחיבים אותו. ההגדרות נשמרות לכל גופן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott betűtípus minden karakterének celladobozát módosítja. A negatív értékek szűkítik a térközt; a pozitív értékek lazítják. A beállítások betűtípusonként mentődnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la cella attorno a ogni glifo per il font selezionato. Valori negativi restringono la spaziatura; valori positivi la allentano. Le impostazioni vengono salvate per ogni font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォントの各グリフを囲むセルボックスを調整します。負の値はスペースを詰め、正の値はスペースを広げます。設定はフォントごとに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폰트의 각 글리프 주위 셀 상자를 조정합니다. 음수 값은 간격을 좁히고 양수 값은 늘립니다. 설정은 폰트별로 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerer cellefeltet rundt hver glyf for den valgte skriften. Negative verdier strammer avstanden; positive verdier slakker den. Innstillingene lagres per skrift."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past het celvak rond elk teken aan voor het geselecteerde lettertype. Negatieve waarden verkleinen de afstand; positieve waarden vergroten die. Instellingen worden per lettertype bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosowuje pole komórki wokół każdego glifu dla wybranej czcionki. Wartości ujemne zacieśniają odstęp; dodatnie go rozszerzają. Ustawienia są zapisywane dla każdej czcionki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta a caixa de célula ao redor de cada glifo para a fonte selecionada. Valores negativos estreitam o espaçamento; valores positivos o ampliam. As configurações são salvas por fonte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta a caixa de célula em torno de cada glifo para o tipo de letra selecionado. Valores negativos reduzem o espaçamento; valores positivos ampliam-no. As definições são guardadas por tipo de letra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustează cutia celulei din jurul fiecărui glif pentru fontul selectat. Valorile negative strâng spațierea; valorile pozitive o lărgesc. Setările sunt salvate pentru fiecare font."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodi celico okoli vsakega glifa za izbrano pisavo. Negativne vrednosti zožijo razmik; pozitivne ga razširijo. Nastavitve se shranijo za vsako pisavo posebej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerar cellboxen runt varje glyf för det valda teckensnittet. Negativa värden minskar avståndet; positiva värden ökar det. Inställningarna sparas per teckensnitt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулює клітинку навколо кожного гліфа для вибраного шрифту. Від'ємні значення стискають інтервал; додатні розширюють. Налаштування зберігаються для кожного шрифту окремо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh ô chứa từng ký tự đối với phông chữ đã chọn. Giá trị âm thu hẹp khoảng cách; giá trị dương nới rộng. Cài đặt được lưu theo từng phông."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整所选字体中每个字形周围的单元格框。负值收紧间距,正值放宽间距。设置按字体保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整所選字型中每個字符周圍的儲存格框。負值會收緊間距,正值會放寬間距。設定會依每個字型分別儲存。"
          }
        }
      }
    },
