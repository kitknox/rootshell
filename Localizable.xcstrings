    "Preserves palette index ordering for light themes so palette-based applications display consistent colors in both light and dark modes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحافظ على ترتيب فهرس لوحة الألوان للأنساق الفاتحة بحيث تعرض التطبيقات المعتمدة على لوحة الألوان ألوانًا متسقة في الوضعين الفاتح والداكن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva l'ordre de l'índex de la paleta per als temes clars perquè les aplicacions basades en paleta mostrin colors consistents tant en mode clar com fosc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachovává pořadí indexů palety pro světlé motivy, aby aplikace využívající paletu zobrazovaly konzistentní barvy ve světlém i tmavém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarer paletteindeksrækkefølgen for lyse temaer, så palettebaserede programmer viser ensartede farver i både lys og mørk tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält die Palettenindex-Reihenfolge für helle Designs bei, damit palettenbasierte Anwendungen in hellem und dunklem Modus konsistente Farben anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el orden de indices de la paleta para temas claros, de modo que las aplicaciones basadas en paleta muestren colores consistentes en los modos claro y oscuro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sailyttaa paletin indeksijarjestyksen vaaleille teemoille, jotta palettipohjaiset sovellukset nayttavat yhtenaiset varit seka vaaleassa etta tummassa tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve l'ordre des index de la palette pour les themes clairs afin que les applications basees sur la palette affichent des couleurs coherentes en modes clair et sombre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר על סדר מפתחות לוח הצבעים עבור ערכות נושא בהירות כדי שיישומים מבוססי לוח צבעים יציגו צבעים עקביים במצב בהיר וכהה כאחד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megorizni a paletta-index sorrendet vilagos temakhoz, hogy a paletta-alapu alkalmazasok egyszeges szineket jelenitsek meg vilagos es sotet modban egyarant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva l'ordine degli indici della tavolozza per i temi chiari in modo che le applicazioni basate sulla tavolozza mostrino colori coerenti sia in modalita chiara che scura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトテーマのパレットインデックス順序を保持し、パレットベースのアプリケーションがライトモードとダークモードの両方で一貫した色を表示できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 테마의 팔레트 인덱스 순서를 유지하여 팔레트 기반 앱이 라이트 및 다크 모드 모두에서 일관된 색상을 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarer palettindeksrekkefølgen for lyse temaer slik at palettbaserte applikasjoner viser konsistente farger i både lys og mørk modus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoudt de paletindexvolgorde voor lichte thema's zodat paletgebaseerde apps consistente kleuren weergeven in zowel lichte als donkere modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje kolejnosc indeksow palety dla jasnych motywow, dzieki czemu aplikacje oparte na palecie wyswietlaja spojne kolory zarowno w trybie jasnym, jak i ciemnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva a ordenacao dos indices da paleta para temas claros, para que aplicativos baseados em paleta exibam cores consistentes nos modos claro e escuro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva a ordenacao dos indices da paleta para temas claros, de modo a que as aplicacoes baseadas em paleta apresentem cores consistentes nos modos claro e escuro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastreaza ordinea indicilor paletei pentru temele deschise, astfel incat aplicatiile bazate pe paleta sa afiseze culori consistente atat in modul deschis, cat si in cel inchis."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranja vrstni red indeksov palete za svetle teme, tako da aplikacije, ki temeljijo na paleti, prikazujejo skladne barve v svetlem in temnem nacinu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarar palettindexordningen för ljusa teman så att palettbaserade program visar konsekventa färger i både ljust och mörkt läge."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає порядок індексів палітри для світлих тем, щоб програми на основі палітри відображали узгоджені кольори у світлому та темному режимах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nguyên thứ tự chỉ mục bảng màu cho chủ đề sáng để các ứng dụng dựa trên bảng màu hiển thị màu nhất quán ở cả chế độ sáng và tối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留浅色主题的调色板索引顺序，使基于调色板的应用在浅色和深色模式下显示一致的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留淺色佈景主題的調色盤索引順序，使基於調色盤的應用程式在淺色和深色模式下顯示一致的顏色。"
          }
        }
      }
    },
