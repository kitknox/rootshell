    "Swipe down from the tab bar (one finger, two fingers, or trackpad scroll) to show live previews of your tabs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر للأسفل من شريط علامات التبويب (بإصبع واحد أو بإصبعين أو بالتمرير على لوحة التتبع) لعرض معاينات مباشرة لعلامات التبويب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca cap avall des de la barra de pestanyes (amb un dit, dos dits o desplaçament al ratolí tàctil) per mostrar previsualitzacions en directe de les pestanyes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím dolů z panelu karet (jedním prstem, dvěma prsty nebo posouváním na trackpadu) zobrazíte živé náhledy karet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg ned fra fanelinjen (med én finger, to fingre eller scroll på pegefeltet) for at se live-forhåndsvisninger af dine faner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie von der Tab-Leiste nach unten (mit einem Finger, zwei Fingern oder Trackpad-Scrollen), um Live-Vorschauen Ihrer Tabs anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia abajo desde la barra de pestañas (con un dedo, dos dedos o desplazamiento en el trackpad) para mostrar vistas previas en directo de tus pestañas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise alas välilehtipalkista (yhdellä sormella, kahdella sormella tai ohjauslevyn vierityksellä) nähdäksesi välilehtiesi reaaliaikaiset esikatselut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le bas depuis la barre d'onglets (un doigt, deux doigts ou défilement sur le trackpad) pour afficher des aperçus en direct de vos onglets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק מטה מסרגל הלשוניות (אצבע אחת, שתי אצבעות או גלילה במשטח המגע) כדי להציג תצוגות מקדימות חיות של הלשוניות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzzon lefelé a lapsávból (egy ujjal, két ujjal vagy érintőpados görgetéssel) a lapok élő előnézetének megjelenítéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso il basso dalla barra delle schede (con un dito, due dita o lo scorrimento sul trackpad) per mostrare anteprime in tempo reale delle tue schede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーから下にスワイプ（1本指、2本指、またはトラックパッドのスクロール）すると、タブのライブプレビューが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 바에서 아래로 스와이프하면(한 손가락, 두 손가락 또는 트랙패드 스크롤) 탭의 실시간 미리보기가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip ned fra fanelinjen (med én finger, to fingre eller rulling på styreflaten) for å vise direkteforhåndsvisninger av fanene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omlaag vanaf de tabbalk (met één vinger, twee vingers of scrollen op het trackpad) om livevoorbeelden van je tabs te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w dół od paska kart (jednym palcem, dwoma palcami lub przewijaniem na gładziku), aby wyświetlić podglądy kart na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para baixo a partir da barra de abas (com um dedo, dois dedos ou rolagem no trackpad) para mostrar pré-visualizações ao vivo das suas abas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para baixo a partir da barra de separadores (com um dedo, dois dedos ou deslocação no trackpad) para mostrar pré-visualizações em direto dos seus separadores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisează în jos din bara de file (cu un deget, două degete sau derulare pe trackpad) pentru a afișa previzualizări live ale filelor."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlecite navzdol iz vrstice zavihkov (z enim prstom, dvema prstoma ali drsenjem po sledilni ploščici) za prikaz živih predogledov zavihkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep nedåt från flikfältet (med ett finger, två fingrar eller scroll på styrplattan) för att visa direktförhandsvisningar av dina flikar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть вниз від панелі вкладок (одним пальцем, двома пальцями або прокруткою на трекпаді), щоб показати живі перегляди вкладок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt xuống từ thanh tab (một ngón, hai ngón hoặc cuộn trên trackpad) để hiện bản xem trước trực tiếp của các tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从标签栏向下滑动（单指、双指或触控板滚动）以显示标签页的实时预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從分頁列向下滑動（單指、雙指或觸控板捲動）以顯示分頁的即時預覽。"
          }
        }
      }
    },
    "Swipe down from the tab bar to show live previews of your tabs. Two fingers also work from above the terminal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر للأسفل من شريط علامات التبويب لعرض معاينات مباشرة لعلامات التبويب. يعمل التمرير بإصبعين أيضًا من أعلى الطرفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
