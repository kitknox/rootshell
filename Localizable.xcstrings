          }
        }
      }
    },
    "When an Apple Login Window or lock screen is detected, offer to type the saved password after confirmation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اكتشاف نافذة تسجيل دخول Apple أو شاشة قفل، اعرض كتابة كلمة المرور المحفوظة بعد التأكيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan es detecti una finestra d'inici de sessió d'Apple o una pantalla de bloqueig, ofereix escriure la contrasenya desada després de confirmar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zjištěno přihlašovací okno Apple nebo zamknutá obrazovka, nabídne po potvrzení zadání uloženého hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et Apple-loginvindue eller en låseskærm registreres, tilbydes det at skrive den gemte adgangskode efter bekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Apple-Anmeldefenster oder ein Sperrbildschirm erkannt wird, wird nach einer Bestätigung angeboten, das gespeicherte Passwort einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se detecta una ventana de inicio de sesión de Apple o una pantalla de bloqueo, se ofrece escribir la contraseña guardada tras confirmarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Applen kirjautumisikkuna tai lukitusnäyttö havaitaan, tallennetun salasanan kirjoittamista tarjotaan vahvistuksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'une fenêtre de connexion Apple ou un écran verrouillé est détecté, propose de saisir le mot de passe enregistré après confirmation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר מזוהה חלון התחברות של Apple או מסך נעילה, תוצע הקלדת הסיסמה השמורה לאחר אישור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha Apple bejelentkezési ablak vagy zárolási képernyő észlelhető, megerősítés után felajánlja a mentett jelszó beírását."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando viene rilevata una finestra di login Apple o una schermata di blocco, propone di digitare la password salvata dopo la conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple のログインウィンドウやロック画面を検出したときに、確認のうえ保存済みのパスワードの入力を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 로그인 윈도우 또는 잠금 화면이 감지되면 확인 후 저장된 비밀번호 입력을 제안합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et Apple-innloggingsvindu eller en låst skjerm oppdages, tilbys det å skrive det lagrede passordet etter bekreftelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een Apple-inlogvenster of toegangsscherm wordt gedetecteerd, wordt na bevestiging aangeboden het bewaarde wachtwoord te typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zostanie wykryte okno logowania Apple lub ekran blokady, po potwierdzeniu zaproponuje wpisanie zapisanego hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma Janela de Login da Apple ou tela bloqueada for detectada, oferece digitar a senha salva após a confirmação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma janela de início de sessão da Apple ou um ecrã bloqueado for detetado, oferece escrever a palavra-passe guardada após confirmação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este detectată o fereastră de autentificare Apple sau un ecran de blocare, oferă introducerea parolei salvate după confirmare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je zaznano Applovo prijavno okno ali zaklenjen zaslon, po potrditvi ponudi vnos shranjenega gesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ett Apple-inloggningsfönster eller en låsskärm upptäcks erbjuds det att skriva det sparade lösenordet efter bekräftelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли виявлено вікно входу Apple або замкнений екран, після підтвердження буде запропоновано ввести збережений пароль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi phát hiện Cửa sổ đăng nhập của Apple hoặc màn hình khóa, đề nghị nhập mật khẩu đã lưu sau khi xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到 Apple 登录窗口或锁定屏幕时，在确认后提示输入已保存的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到 Apple 登入視窗或鎖定畫面時，會在確認後提議輸入已儲存的密碼。"
          }
        }
      }
    },
    "When disabled, uses exec to replace the shell with the command." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التعطيل، يستخدم exec لاستبدال واجهة الأوامر بالأمر."
