    "Your kubeconfig will be stored securely in the system Keychain. It will not be synced to iCloud or other devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تخزين ملف kubeconfig الخاص بك بأمان في سلسلة مفاتيح النظام. لن تتم مزامنته مع iCloud أو الأجهزة الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vostre kubeconfig es desarà de manera segura al Keychain del sistema. No se sincronitzarà amb iCloud ni amb altres dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš kubeconfig bude bezpečně uložen v systémové Klíčence. Nebude synchronizován do iCloud ani na jiná zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kubeconfig vil blive gemt sikkert i systemets nøglering. Den vil ikke blive synkroniseret til iCloud eller andre enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Kubeconfig wird sicher im System-Schlüsselbund gespeichert. Sie wird nicht mit iCloud oder anderen Geräten synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su kubeconfig se almacenará de forma segura en el Keychain del sistema. No se sincronizará con iCloud ni con otros dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig tallennetaan turvallisesti järjestelmän Avainnippuun. Sitä ei synkronoida iCloudiin tai muihin laitteisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre kubeconfig sera stockée de manière sécurisée dans le trousseau système. Elle ne sera pas synchronisée avec iCloud ou d'autres appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
