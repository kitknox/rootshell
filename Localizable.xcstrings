        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta chave foi importada antes do suporte a PKDECRYPT chegar. Se o seu porta-chaves original tinha uma subchave de cifragem, reimporte o bloco de chave secreta para ativar `gpg -d` através do agente encaminhado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cheie a fost importată înainte ca suportul PKDECRYPT să fie disponibil. Dacă inelul dvs. de chei original avea o subcheie de criptare, reimportați blocul de cheie secretă pentru a activa `gpg -d` prin agentul redirecționat."
