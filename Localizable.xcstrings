        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 백그라운드로 전환되어도 세션이 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økter vedvarer selv når appen er i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies blijven behouden zelfs wanneer de app op de achtergrond staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje są zachowywane nawet gdy aplikacja działa w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
