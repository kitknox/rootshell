    "Add the public key below to your server's authorized_keys file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف المفتاح العام أدناه إلى ملف authorized_keys على خادمك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu la clau pública de sota al fitxer authorized_keys del vostre servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte níže uvedený veřejný klíč do souboru authorized_keys na vašem serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj den offentlige nøgle nedenfor til din servers authorized_keys-fil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie den unten stehenden öffentlichen Schlüssel zur authorized_keys-Datei Ihres Servers hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada la clave pública de abajo al archivo authorized_keys de su servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää alla oleva julkinen avain palvelimesi authorized_keys-tiedostoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez la clé publique ci-dessous au fichier authorized_keys de votre serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את המפתח הציבורי למטה לקובץ authorized_keys בשרת שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja hozzá az alábbi nyilvános kulcsot a szerver authorized_keys fájljához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere la chiave pubblica seguente al file authorized_keys del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
