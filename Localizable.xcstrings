        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la barra de herramientas fijada en la parte inferior de la pantalla mientras haya un teclado físico conectado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
