    "The ephemeral key is only valid for 60 seconds. Try connecting again." : {
      "comment" : "EC2 console recovery suggestion",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفتاح المؤقت صالح لمدة 60 ثانية فقط. حاول الاتصال مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clau efímera només és vàlida durant 60 segons. Torneu-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dočasný klíč je platný pouze 60 sekund. Zkuste se připojit znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den midlertidige nøgle er kun gyldig i 60 sekunder. Prøv at oprette forbindelse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der temporäre Schlüssel ist nur 60 Sekunden gültig. Verbindung erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
