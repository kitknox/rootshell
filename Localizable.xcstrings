    "Continuously tracks location to keep SSH connections and long-running local tasks alive in the background. Shows locations from the last 5 minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتتبع الموقع باستمرار للحفاظ على اتصالات SSH والمهام المحلية طويلة التشغيل نشطة في الخلفية. يعرض المواقع من آخر ٥ دقائق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa un seguiment continu de la ubicació per mantenir les connexions SSH i les tasques locals de llarga durada actives en segon pla. Mostra les ubicacions dels darrers 5 minuts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepřetržitě sleduje polohu, aby udrželo SSH připojení a dlouhodobé lokální úlohy aktivní na pozadí. Zobrazuje polohy za posledních 5 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporer løbende placering for at holde SSH-forbindelser og langvarige lokale opgaver i live i baggrunden. Viser placeringer fra de sidste 5 minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgt kontinuierlich den Standort, um SSH-Verbindungen und lang laufende lokale Aufgaben im Hintergrund aufrechtzuerhalten. Zeigt Standorte der letzten 5 Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastrea la ubicación continuamente para mantener activas las conexiones SSH y las tareas locales de larga duración en segundo plano. Muestra ubicaciones de los últimos 5 minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa sijaintia jatkuvasti pitääkseen SSH-yhteydet ja pitkäkestoiset paikalliset tehtävät aktiivisina taustalla. Näyttää sijainnit viimeiseltä 5 minuutilta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit la localisation en continu pour maintenir les connexions SSH et les tâches locales longues actives en arrière-plan. Affiche les positions des 5 dernières minutes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוקב אחר המיקום באופן רציף כדי לשמור על חיבורי SSH ומשימות מקומיות ארוכות טווח ברקע. מציג מיקומים מ-5 הדקות האחרונות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folyamatosan követi a helyzetet az SSH-kapcsolatok és a hosszan futó helyi feladatok háttérben tartásához. Az utolsó 5 perc helyadatait jeleníti meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia continuamente la posizione per mantenere attive le connessioni SSH e le attività locali di lunga durata in background. Mostra le posizioni degli ultimi 5 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH接続やバックグラウンドで実行中のローカルタスクを維持するために位置情報を継続的に追跡します。過去5分間の位置情報を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 연결과 장시간 실행 중인 로컬 작업을 백그라운드에서 유지하기 위해 위치를 지속적으로 추적합니다. 최근 5분간의 위치를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporer plassering kontinuerlig for å holde SSH-tilkoblinger og langvarige lokale oppgaver i live i bakgrunnen. Viser plasseringer fra de siste 5 minuttene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt continu de locatie bij om SSH-verbindingen en langlopende lokale taken op de achtergrond actief te houden. Toont locaties van de laatste 5 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciągle śledzi lokalizację, aby utrzymać połączenia SSH i długotrwałe zadania lokalne aktywne w tle. Pokazuje lokalizacje z ostatnich 5 minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastreia a localização continuamente para manter conexões SSH e tarefas locais de longa duração ativas em segundo plano. Mostra localizações dos últimos 5 minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastreia a localização continuamente para manter ligações SSH e tarefas locais de longa duração ativas em segundo plano. Mostra localizações dos últimos 5 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește continuu locația pentru a menține conexiunile SSH și sarcinile locale de lungă durată active în fundal. Afișează locațiile din ultimele 5 minute."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprekinjeno sledi lokaciji, da ohranja SSH povezave in dolgotrajne lokalne naloge aktivne v ozadju. Prikazuje lokacije zadnjih 5 minut."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårar plats kontinuerligt för att hålla SSH-anslutningar och långvariga lokala uppgifter aktiva i bakgrunden. Visar platser från de senaste 5 minuterna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безперервно відстежує місцезнаходження, щоб підтримувати SSH-з'єднання та тривалі локальні завдання у фоновому режимі. Показує місця за останні 5 хвилин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên tục theo dõi vị trí để duy trì kết nối SSH và các tác vụ cục bộ chạy dài trong nền. Hiển thị vị trí từ 5 phút gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续跟踪位置，以在后台保持 SSH 连接和长时间运行的本地任务。显示最近 5 分钟的位置记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持續追蹤位置，以在背景中保持 SSH 連線和長時間執行的本機作業。顯示最近 5 分鐘的位置記錄。"
          }
        }
      }
    },
