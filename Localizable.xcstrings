    "Removes the macOS title bar and window controls so content reaches the top edge. Close the window with ⌘W and enter full screen with the View menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل شريط عنوان macOS وعناصر التحكم في النافذة بحيث يصل المحتوى إلى الحافة العلوية. أغلق النافذة باستخدام ⌘W وادخل ملء الشاشة من قائمة عرض."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la barra de títol i els controls de finestra de macOS perquè el contingut arribi a la vora superior. Tanqueu la finestra amb ⌘W i entreu a pantalla completa des del menú Vista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní záhlaví a ovládací prvky okna macOS, takže obsah dosáhne k hornímu okraji. Okno zavřete pomocí ⌘W a na celou obrazovku přejdete v nabídce Zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner macOS-titellinjen og vinduesknapperne, så indholdet når op til den øverste kant. Luk vinduet med ⌘W, og gå til fuld skærm via menuen Visning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die macOS-Titelleiste und die Fenstersteuerung, sodass der Inhalt bis zum oberen Rand reicht. Schließen Sie das Fenster mit ⌘W und aktivieren Sie den Vollbildmodus über das Menü „Ansicht“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la barra de título y los controles de ventana de macOS para que el contenido llegue al borde superior. Cierre la ventana con ⌘W y entre en pantalla completa desde el menú Vista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa macOS-otsikkopalkin ja ikkunan hallintapainikkeet, jolloin sisältö ulottuu yläreunaan. Sulje ikkuna näppäimillä ⌘W ja siirry koko näyttöön Näkymä-valikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime la barre de titre et les commandes de fenêtre macOS afin que le contenu atteigne le bord supérieur. Fermez la fenêtre avec ⌘W et passez en plein écran depuis le menu Affichage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיר את שורת הכותרת ופקדי החלון של macOS כך שהתוכן מגיע לקצה העליון. סגור את החלון באמצעות ⌘W ועבור למסך מלא מתפריט תצוגה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a macOS címsorát és az ablakvezérlőket, így a tartalom eléri a felső szélt. Az ablakot a ⌘W billentyűkkel zárhatja be, teljes képernyőre pedig a Nézet menüből válthat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove la barra del titolo e i controlli della finestra di macOS in modo che il contenuto raggiunga il bordo superiore. Chiudi la finestra con ⌘W e passa a schermo intero dal menu Vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS のタイトルバーとウィンドウコントロールを取り除き、コンテンツを上端まで表示します。ウィンドウは ⌘W で閉じ、フルスクリーンは表示メニューから切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 제목 막대와 윈도우 컨트롤을 제거하여 콘텐츠가 상단 가장자리까지 닿게 합니다. 윈도우는 ⌘W로 닫고, 전체 화면은 보기 메뉴에서 시작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner macOS-tittellinjen og vinduskontrollene slik at innholdet når helt opp til øvre kant. Lukk vinduet med ⌘W, og gå til fullskjerm via Vis-menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert de macOS-titelbalk en vensterknoppen zodat de inhoud tot aan de bovenrand loopt. Sluit het venster met ⌘W en ga naar volledig scherm via het menu Weergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa pasek tytułu i przyciski okna systemu macOS, dzięki czemu zawartość sięga górnej krawędzi. Zamknij okno klawiszami ⌘W, a pełny ekran włącz z menu Widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove a barra de título e os controles de janela do macOS para que o conteúdo alcance a borda superior. Feche a janela com ⌘W e entre em tela cheia pelo menu Visualização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove a barra de título e os controlos de janela do macOS para que o conteúdo chegue à margem superior. Feche a janela com ⌘W e entre em ecrã inteiro através do menu Visualização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină bara de titlu și controalele ferestrei macOS, astfel încât conținutul să ajungă la marginea de sus. Închide fereastra cu ⌘W și treci în ecran complet din meniul Vizualizare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstrani naslovno vrstico in gumbe okna v sistemu macOS, tako da vsebina sega do zgornjega roba. Okno zaprite s ⌘W, celozaslonski način pa vklopite v meniju Pogled."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort macOS namnlist och fönsterkontroller så att innehållet når den övre kanten. Stäng fönstret med ⌘W och växla till helskärm via Vy-menyn."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибирає рядок заголовка та елементи керування вікном macOS, щоб вміст сягав верхнього краю. Закрийте вікно за допомогою ⌘W, а повноекранний режим увімкніть у меню «Перегляд»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loại bỏ thanh tiêu đề và các nút điều khiển cửa sổ của macOS để nội dung chạm tới mép trên. Đóng cửa sổ bằng ⌘W và vào Toàn màn hình từ menu Xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 macOS 标题栏和窗口控件，让内容延伸至顶部边缘。使用 ⌘W 关闭窗口，通过“查看”菜单进入全屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 macOS 標題列和視窗控制項目，讓內容延伸至頂部邊緣。使用 ⌘W 關閉視窗，並透過「檢視」選單進入全螢幕。"
          }
        }
      }
    },
    "Removing this host will require you to verify and trust its key again on your next connection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستحتاج إلى التحقق من مفتاح هذا المضيف والوثوق به مجدداً عند اتصالك القادم بعد إزالته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eliminar aquest amfitrió, haureu de verificar i acceptar la seva clau de nou en la propera connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrání tohoto hostitele bude vyžadovat opětovné ověření a schválení jeho klíče při dalším připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjernelse af denne vært kræver, at du verificerer og godkender dens nøgle igen ved næste forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Entfernen dieses Hosts müssen Sie seinen Schlüssel bei der nächsten Verbindung erneut verifizieren und als vertrauenswürdig einstufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar este host deberá verificar y confiar en su clave de nuevo en la próxima conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän isännän poistaminen edellyttää avaimen vahvistamista ja hyväksymistä uudelleen seuraavalla yhteyskerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de cet hôte vous obligera à vérifier et approuver à nouveau sa clé lors de votre prochaine connexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרת מארח זה תחייב אותך לאמת ולתת אמון במפתח שלו שוב בחיבור הבא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gazdagép eltávolítása után a következő csatlakozáskor ismét ellenőriznie és elfogadnia kell a kulcsát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovendo questo host sarà necessario verificare e accettare nuovamente la sua chiave alla prossima connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストを削除すると、次回接続時にホストキーの確認と信頼を再度行う必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트를 제거하면 다음 연결 시 호스트 키를 다시 확인하고 신뢰해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerning av denne verten krever at du verifiserer og stoler på nøkkelen igjen ved neste tilkobling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u deze host verwijdert, moet u de sleutel opnieuw verifiëren en vertrouwen bij uw volgende verbinding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie tego hosta będzie wymagało ponownej weryfikacji i zaufania jego kluczowi przy następnym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover este host exigirá que você verifique e confie na chave dele novamente na próxima conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover este anfitrião exigirá que verifique e confie na sua chave novamente na próxima ligação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminarea acestei gazde va necesita verificarea si acceptarea cheii sale din nou la urmatoarea conectare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob odstranitvi tega gostitelja boste morali ob naslednji povezavi ponovno preveriti in zaupati njegovemu ključu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ta bort denna värd innebär att du måste verifiera och godkänna dess nyckel igen vid nästa anslutning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалення цього хоста вимагатиме повторної перевірки та підтвердження його ключа при наступному з'єднанні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa host này sẽ yêu cầu bạn xác minh và tin tưởng khóa của nó lại trong lần kết nối tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除此主机后，下次连接时需要重新验证并信任其密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除此主機後，下次連線時需要重新驗證並信任其金鑰。"
          }
        }
      }
    },
    "Removing this key disables any active GPG forwarding using it. The key cannot be recovered without re-importing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة هذا المفتاح تعطّل أي توجيه GPG نشط يستخدمه. لا يمكن استرجاع المفتاح دون إعادة استيراده."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar aquesta clau desactiva qualsevol reenviament GPG actiu que l'utilitzi. La clau no es pot recuperar sense tornar-la a importar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrání tohoto klíče zakáže veškeré aktivní GPG přesměrování, které jej používá. Klíč nelze obnovit bez opětovného importu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjernelse af denne nøgle deaktiverer enhver aktiv GPG-videresendelse, der bruger den. Nøglen kan ikke gendannes uden at importere den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Entfernen dieses Schlüssels deaktiviert jede aktive GPG-Weiterleitung, die ihn verwendet. Der Schlüssel kann nur durch erneuten Import wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar esta clave desactiva cualquier reenvío GPG activo que la utilice. La clave no se puede recuperar sin volver a importarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän avaimen poistaminen poistaa käytöstä kaikki aktiiviset GPG-edelleenlähetykset, jotka käyttävät sitä. Avainta ei voi palauttaa ilman uudelleentuontia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de cette clé désactive toute redirection GPG active l'utilisant. La clé ne peut pas être récupérée sans une nouvelle importation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרת מפתח זה מבטלת כל העברת GPG פעילה המשתמשת בו. לא ניתן לשחזר את המפתח ללא ייבוא מחדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcs eltávolítása letiltja az azt használó összes aktív GPG továbbítást. A kulcs nem állítható helyre újraimportálás nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rimozione di questa chiave disabilita qualsiasi inoltro GPG attivo che la utilizza. La chiave non può essere recuperata senza reimportarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーを削除すると、このキーを使用しているアクティブなGPG転送が無効になります。再インポートしない限りキーを復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키를 제거하면 이를 사용하는 활성 GPG 전달이 비활성화됩니다. 다시 가져오지 않으면 키를 복구할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å fjerne denne nøkkelen deaktiverer enhver aktiv GPG-videresending som bruker den. Nøkkelen kan ikke gjenopprettes uten å importere på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verwijderen van deze sleutel schakelt elke actieve GPG-doorsturen die deze gebruikt uit. De sleutel kan niet worden hersteld zonder opnieuw te importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie tego klucza wyłącza wszelkie aktywne przekierowania GPG, które go używają. Klucza nie można odzyskać bez ponownego importu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover esta chave desativa qualquer encaminhamento GPG ativo que a use. A chave não pode ser recuperada sem reimportar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover esta chave desactiva qualquer reencaminhamento GPG activo que a utilize. A chave não pode ser recuperada sem voltar a ser importada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminarea acestei chei dezactivează orice redirecționare GPG activă care o folosește. Cheia nu poate fi recuperată fără a fi reimportată."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranitev tega ključa onemogoči vsako aktivno posredovanje GPG, ki ga uporablja. Ključa ni mogoče obnoviti brez ponovnega uvoza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ta bort denna nyckel inaktiverar all aktiv GPG-vidarebefordran som använder den. Nyckeln kan inte återställas utan att importeras på nytt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалення цього ключа вимикає будь-яку активну переадресацію GPG, що використовує його. Ключ неможливо відновити без повторного імпорту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc xóa khóa này sẽ vô hiệu hóa mọi chuyển tiếp GPG đang sử dụng nó. Không thể khôi phục khóa nếu không nhập lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此密钥将禁用任何正在使用它的 GPG 转发。除非重新导入，否则无法恢复该密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除此金鑰將停用任何正在使用它的 GPG 轉發。除非重新匯入，否則無法復原此金鑰。"
          }
        }
      }
    },
