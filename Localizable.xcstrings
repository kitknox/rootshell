        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la barra de herramientas visible cuando se oculta el teclado en pantalla. Toca el terminal para volver a mostrar el teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä työkalupalkki näkyvissä, kun näppäimistö piilotetaan. Tuo näppäimistö takaisin napauttamalla terminaalia."
