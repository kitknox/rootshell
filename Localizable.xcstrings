    "No HDR headroom at the current display brightness (SDR display, or already at maximum brightness). Lower the display brightness to free up headroom." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد مجال إضافي لـ HDR عند سطوع الشاشة الحالي (شاشة SDR، أو أنها بالفعل عند أقصى سطوع). اخفض سطوع الشاشة لتوفير مجال إضافي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha marge HDR amb la brillantor actual de la pantalla (pantalla SDR o ja al màxim de brillantor). Redueix la brillantor de la pantalla per alliberar marge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při aktuálním jasu displeje není k dispozici žádná rezerva HDR (displej SDR nebo již na maximálním jasu). Snižte jas displeje, abyste uvolnili rezervu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen HDR-margin ved den aktuelle skærmlysstyrke (SDR-skærm eller allerede ved maksimal lysstyrke). Sænk skærmlysstyrken for at frigøre margin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein HDR-Spielraum bei der aktuellen Bildschirmhelligkeit (SDR-Display oder bereits bei maximaler Helligkeit). Verringern Sie die Bildschirmhelligkeit, um Spielraum freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay margen HDR con el brillo actual de la pantalla (pantalla SDR o ya al brillo máximo). Reduce el brillo de la pantalla para liberar margen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei HDR-varaa nykyisellä näytön kirkkaudella (SDR-näyttö tai jo enimmäiskirkkaudella). Vähennä näytön kirkkautta vapauttaaksesi varaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune marge HDR à la luminosité d'écran actuelle (écran SDR ou déjà à la luminosité maximale). Réduisez la luminosité de l'écran pour libérer de la marge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין מרווח HDR ברמת הבהירות הנוכחית של המסך (מסך SDR, או שכבר בבהירות מרבית). הנמיכו את בהירות המסך כדי לפנות מרווח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs HDR-tartalék a jelenlegi kijelző-fényerőn (SDR-kijelző, vagy már a maximális fényerőn). Csökkentse a kijelző fényerejét a tartalék felszabadításához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun margine HDR con la luminosità attuale dello schermo (schermo SDR o già alla luminosità massima). Riduci la luminosità dello schermo per liberare margine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の画面の明るさではHDRの余裕がありません（SDRディスプレイ、またはすでに最大の明るさです）。画面の明るさを下げて余裕を確保してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 디스플레이 밝기에서는 HDR 여유가 없습니다(SDR 디스플레이이거나 이미 최대 밝기). 디스플레이 밝기를 낮춰 여유를 확보하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen HDR-margin ved den gjeldende skjermlysstyrken (SDR-skjerm, eller allerede ved maksimal lysstyrke). Reduser skjermlysstyrken for å frigjøre margin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen HDR-marge bij de huidige schermhelderheid (SDR-scherm of al op maximale helderheid). Verlaag de schermhelderheid om marge vrij te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak zapasu HDR przy bieżącej jasności ekranu (ekran SDR lub już maksymalna jasność). Zmniejsz jasność ekranu, aby zwolnić zapas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem margem HDR no brilho atual da tela (tela SDR ou já no brilho máximo). Reduza o brilho da tela para liberar margem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem margem HDR com o brilho atual do ecrã (ecrã SDR ou já no brilho máximo). Reduza o brilho do ecrã para libertar margem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există marjă HDR la luminozitatea actuală a ecranului (ecran SDR sau deja la luminozitate maximă). Reduceți luminozitatea ecranului pentru a elibera marjă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri trenutni svetlosti zaslona ni razpoložljive rezerve HDR (zaslon SDR ali že pri največji svetlosti). Znižajte svetlost zaslona, da sprostite rezervo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget HDR-utrymme vid den aktuella skärmljusstyrkan (SDR-skärm eller redan på maximal ljusstyrka). Sänk skärmljusstyrkan för att frigöra utrymme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає запасу HDR за поточної яскравості екрана (екран SDR або вже максимальна яскравість). Зменшіть яскравість екрана, щоб вивільнити запас."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có khoảng dự trữ HDR ở độ sáng màn hình hiện tại (màn hình SDR hoặc đã ở độ sáng tối đa). Giảm độ sáng màn hình để giải phóng khoảng dự trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前屏幕亮度下没有 HDR 余量（SDR 显示屏，或已处于最高亮度）。请降低屏幕亮度以释放余量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前螢幕亮度下沒有 HDR 餘量（SDR 顯示器，或已處於最高亮度）。請降低螢幕亮度以釋放餘量。"
          }
        }
      }
    },
