    "Profile requires a saved password or SSH key before VPN can start." : {
      "comment" : "VPN error detail: the profile has no background-usable credential",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلّب الملف الشخصي كلمة مرور محفوظة أو مفتاح SSH قبل أن تتمكّن VPN من البدء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil necessita una contrasenya desada o una clau SSH abans que la VPN es pugui iniciar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil vyžaduje uložené heslo nebo klíč SSH, než bude možné spustit VPN."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen kræver en gemt adgangskode eller SSH-nøgle, før VPN kan startes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil erfordert ein gespeichertes Passwort oder einen SSH-Schlüssel, bevor das VPN gestartet werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil requiere una contraseña guardada o una clave SSH antes de que la VPN pueda iniciarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiili vaatii tallennetun salasanan tai SSH-avaimen, ennen kuin VPN voidaan käynnistää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil nécessite un mot de passe enregistré ou une clé SSH avant que le VPN puisse démarrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרופיל דורש סיסמה שמורה או מפתח SSH לפני שניתן להפעיל את ה-VPN."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilhoz mentett jelszó vagy SSH-kulcs szükséges, mielőtt a VPN elindulhatna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo richiede una password salvata o una chiave SSH prima che la VPN possa avviarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNを開始する前に、プロファイルには保存されたパスワードまたはSSHキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN을 시작하려면 프로필에 저장된 비밀번호 또는 SSH 키가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen krever et lagret passord eller en SSH-nøkkel før VPN kan startes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het profiel vereist een opgeslagen wachtwoord of SSH-sleutel voordat de VPN kan starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil wymaga zapisanego hasła lub klucza SSH, zanim będzie można uruchomić VPN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil requer uma senha salva ou uma chave SSH antes que a VPN possa iniciar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil requer uma palavra-passe guardada ou uma chave SSH antes de a VPN poder iniciar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilul necesită o parolă salvată sau o cheie SSH înainte ca VPN-ul să poată porni."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil zahteva shranjeno geslo ali ključ SSH, preden se VPN lahko zažene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen kräver ett sparat lösenord eller en SSH-nyckel innan VPN kan startas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профіль потребує збереженого пароля або ключа SSH, перш ніж можна буде запустити VPN."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ cần có mật khẩu đã lưu hoặc khóa SSH trước khi có thể khởi động VPN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
