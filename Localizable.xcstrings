    "Key stays on this device only. Not included in backups or sync. Lost if device is reset." : {
      "comment" : "Key storage description: device only",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى المفتاح على هذا الجهاز فقط. لا يُضمّن في النسخ الاحتياطية أو المزامنة. يُفقد عند إعادة ضبط الجهاز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clau es queda només en aquest dispositiu. No s'inclou a les còpies de seguretat ni a la sincronització. Es perd si el dispositiu es restableix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč zůstane pouze na tomto zařízení. Není zahrnut v zálohách ani synchronizaci. Ztratí se při resetování zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøglen forbliver kun på denne enhed. Ikke inkluderet i sikkerhedskopier eller synkronisering. Mistes ved nulstilling af enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel bleibt nur auf diesem Gerät. Nicht in Backups oder Synchronisierung enthalten. Geht bei Geräterücksetzung verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave permanece solo en este dispositivo. No se incluye en copias de seguridad ni sincronización. Se pierde si el dispositivo se restablece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avain pysyy vain tällä laitteella. Ei sisälly varmuuskopioihin tai synkronointiin. Menetetään, jos laite nollataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé reste uniquement sur cet appareil. Non incluse dans les sauvegardes ni la synchronisation. Perdue si l'appareil est réinitialisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפתח נשאר במכשיר זה בלבד. לא כלול בגיבויים או סנכרון. יאבד אם המכשיר יאופס."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcs csak ezen az eszközön marad. Nem szerepel biztonsági mentésekben és nem szinkronizálódik. Elvész, ha az eszközt visszaállítják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave rimane solo su questo dispositivo. Non inclusa nei backup o nella sincronizzazione. Persa se il dispositivo viene ripristinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵はこのデバイスにのみ保存されます。バックアップや同期には含まれません。デバイスをリセットすると失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키가 이 기기에만 저장됩니다. 백업이나 동기화에 포함되지 않습니다. 기기를 초기화하면 잃어버립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøkkelen forblir kun på denne enheten. Ikke inkludert i sikkerhetskopier eller synkronisering. Mistes hvis enheten tilbakestilles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleutel blijft alleen op dit apparaat. Niet opgenomen in back-ups of synchronisatie. Gaat verloren bij apparaatreset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz pozostaje tylko na tym urządzeniu. Nie jest uwzględniony w kopiach zapasowych ani synchronizacji. Zostanie utracony po zresetowaniu urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave permanece apenas neste dispositivo. Não incluída em backups ou sincronização. Perdida se o dispositivo for redefinido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave permanece apenas neste dispositivo. Não incluída em cópias de segurança nem sincronização. Perdida se o dispositivo for reposto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheia rămâne doar pe acest dispozitiv. Nu este inclusă în copii de rezervă sau sincronizare. Se pierde dacă dispozitivul este resetat."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ključ ostane samo na tej napravi. Ni vključen v varnostne kopije ali sinhronizacijo. Izgubljen ob ponastavitvi naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyckeln finns bara på denna enhet. Inkluderas inte i säkerhetskopior eller synkronisering. Förloras vid enhetsåterställning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ залишається тільки на цьому пристрої. Не включається в резервні копії чи синхронізацію. Втрачається при скиданні пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa chỉ lưu trên thiết bị này. Không nằm trong bản sao lưu hoặc đồng bộ. Mất nếu thiết bị được đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥仅保存在此设备上。不包含在备份或同步中。重置设备后将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰僅保留在此裝置上。不包含在備份或同步中。重置裝置後將遺失。"
          }
        }
      }
    },
