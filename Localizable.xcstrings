    "Sidebar badges follow the \"Show Attention Badges\" switch in Coding Agents; notifications follow this policy independently of agent notifications." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع شارات الشريط الجانبي مفتاح \"إظهار شارات الانتباه\" في وكلاء البرمجة، بينما تتبع الإشعارات هذه السياسة بشكل مستقل عن إشعارات الوكلاء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els distintius de la barra lateral segueixen l'interruptor «Mostra els distintius d'atenció» dels Agents de codi; les notificacions segueixen aquesta política independentment de les notificacions d'agents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odznaky v bočním panelu se řídí přepínačem „Zobrazovat odznaky pozornosti“ v části Agenti pro kódování; oznámení se řídí tímto pravidlem nezávisle na oznámeních agentů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mærker i sidepanelet følger kontakten \"Vis opmærksomhedsmærker\" under Kodeagenter. Notifikationer følger denne politik uafhængigt af agentnotifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badges in der Seitenleiste folgen dem Schalter „Aufmerksamkeits-Abzeichen anzeigen“ unter „Coding-Agents“; Benachrichtigungen folgen dieser Regel unabhängig von Agent-Benachrichtigungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los distintivos de la barra lateral siguen el interruptor \"Mostrar distintivos de atención\" de Agentes de código; las notificaciones siguen esta política de forma independiente a las notificaciones de agentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sivupalkin merkit noudattavat Koodiagentit-osion \"Näytä huomiomerkit\" -asetusta. Ilmoitukset noudattavat tätä käytäntöä agenttien ilmoituksista riippumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pastilles de la barre latérale suivent l'option « Afficher les pastilles d'attention » dans Agents de code ; les notifications suivent cette règle indépendamment des notifications des agents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תגי סרגל הצד פועלים לפי המתג \"הצג תגי תשומת לב\" בסוכני קוד; ההתראות פועלות לפי מדיניות זו, ללא תלות בהתראות הסוכנים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az oldalsáv jelvényei a Kódügynökök között található „Figyelemjelvények megjelenítése” kapcsolót követik; az értesítésekre ez a szabály vonatkozik, az ügynökértesítésektől függetlenül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I badge nella barra laterale seguono l'opzione \"Mostra contrassegni di attenzione\" in Agenti di codice; le notifiche seguono questo criterio indipendentemente dalle notifiche degli agenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーのバッジは「コーディングエージェント」の「注目バッジを表示」スイッチに従います。通知はエージェント通知とは独立して、このポリシーに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바 배지는 코딩 에이전트의 \"주의 배지 표시\" 스위치를 따르며, 알림은 에이전트 알림과 별개로 이 정책을 따릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merker i sidepanelet følger bryteren \"Vis oppmerksomhetsmerker\" under Kodeagenter, mens varslinger følger disse reglene uavhengig av agentvarslinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zijbalkbadges volgen de schakelaar \"Aandachtsbadges tonen\" bij Codeeragents; meldingen volgen dit beleid onafhankelijk van agentmeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakietki na pasku bocznym zależą od przełącznika „Pokazuj odznaki uwagi” w sekcji Agenci kodowania; powiadomienia stosują się do tych zasad niezależnie od powiadomień agentów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os selos da barra lateral seguem a opção “Mostrar Selos de Atenção” em Agentes de Código; as notificações seguem esta política, independentemente das notificações de agentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sinais da barra lateral seguem o interruptor \"Mostrar Selos de Atenção\" em Agentes de Código; as notificações seguem esta política, independentemente das notificações de agentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insignele din bara laterală urmează comutatorul „Afișează insignele de atenție” din Agenți de cod; notificările urmează această politică independent de notificările agenților."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznake v stranski vrstici sledijo stikalu »Prikaži značke pozornosti« v razdelku Kodirni agenti; obvestila sledijo temu pravilniku neodvisno od obvestil agentov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brickor i sidofältet följer reglaget \"Visa uppmärksamhetsmärken\" i Kodagenter; aviseringar följer den här policyn oberoende av agentaviseringar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки на бічній панелі підпорядковуються перемикачу «Показувати значки уваги» в розділі «Агенти кодування»; сповіщення дотримуються цієї політики незалежно від сповіщень агентів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huy hiệu trên thanh bên tuân theo công tắc “Hiện huy hiệu chú ý” trong Tác nhân lập trình; thông báo tuân theo chính sách này, độc lập với thông báo tác nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧边栏标记遵循“编程代理”中的“显示关注标记”开关；通知则遵循此策略，与代理通知相互独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊欄標記依照「程式設計代理」中的「顯示關注標記」開關；通知則依照此原則，與代理通知互相獨立。"
          }
        }
      }
    },
