    "Show tab titles and badges under each live preview in Tab Exposé." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار عناوين علامات التبويب والشارات أسفل كل معاينة مباشرة في Exposé علامات التبويب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra els títols i els distintius de les pestanyes sota cada previsualització en directe de l'Exposé de pestanyes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat názvy karet a odznaky pod každým živým náhledem v Exposé karet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis fanetitler og mærker under hver live-forhåndsvisning i Fane-Exposé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Tab-Titel und Abzeichen unter jeder Live-Vorschau im Tab-Exposé an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los títulos y distintivos de las pestañas debajo de cada vista previa en directo del Exposé de pestañas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä välilehtien otsikot ja merkit kunkin reaaliaikaisen esikatselun alla Välilehti-Exposéssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les titres et les pastilles des onglets sous chaque aperçu en direct de l'Exposé des onglets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג כותרות לשוניות ותגים מתחת לכל תצוגה מקדימה חיה ב-Exposé לשוניות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lapcímek és jelvények megjelenítése az egyes élő előnézetek alatt a Lap-Exposéban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i titoli delle schede e i contrassegni sotto ogni anteprima in tempo reale nell'Exposé schede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブExposéで各ライブプレビューの下にタブのタイトルとバッジを表示します。"
