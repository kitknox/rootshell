    "Switching re-attaches this tmux tab's client. To view two sessions at once, open a second connection to this host." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏يعيد التبديل ربط عميل علامة تبويب tmux هذه. لعرض جلستين في وقت واحد، افتح اتصالًا ثانيًا بهذا المضيف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En canviar es torna a adjuntar el client d'aquesta pestanya de tmux. Per veure dues sessions alhora, obriu una segona connexió amb aquest amfitrió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepnutí znovu připojí klienta této karty tmux. Chcete-li zobrazit dvě relace najednou, otevřete druhé připojení k tomuto hostiteli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved skift gentilknyttes denne tmux-fanes klient. For at se to sessioner på én gang skal du åbne en anden forbindelse til denne vært."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechseln wird der Client dieses tmux-Tabs neu verbunden. Um zwei Sitzungen gleichzeitig zu sehen, öffnen Sie eine zweite Verbindung zu diesem Host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar se vuelve a conectar el cliente de esta pestaña de tmux. Para ver dos sesiones a la vez, abre una segunda conexión a este host."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtaminen liittää tämän tmux-välilehden asiakkaan uudelleen. Jos haluat tarkastella kahta istuntoa yhtä aikaa, avaa toinen yhteys tähän isäntään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement rattache le client de cet onglet tmux. Pour afficher deux sessions à la fois, ouvrez une seconde connexion à cet hôte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלפה מחברת מחדש את הלקוח של לשונית tmux זו. כדי לצפות בשתי הפעלות בו-זמנית, פתח חיבור שני למארח זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A váltás újracsatlakoztatja ennek a tmux lapnak a klienskapcsolatát. Két munkamenet egyidejű megtekintéséhez nyisson egy második kapcsolatot ehhez a gazdagéphez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiando si ricollega il client di questa scheda tmux. Per visualizzare due sessioni contemporaneamente, apri una seconda connessione a questo host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替えると、このtmuxタブのクライアントが再アタッチされます。2つのセッションを同時に表示するには、このホストへの2つ目の接続を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전환하면 이 tmux 탭의 클라이언트가 다시 연결됩니다. 두 세션을 동시에 보려면 이 호스트에 두 번째 연결을 여세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytte kobler denne tmux-fanens klient til på nytt. For å se to økter samtidig, åpne en ny tilkobling til denne verten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisselen koppelt de client van dit tmux-tabblad opnieuw. Open een tweede verbinding met deze host om twee sessies tegelijk te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełączenie ponownie podłącza klienta tej karty tmux. Aby wyświetlić dwie sesje jednocześnie, otwórz drugie połączenie z tym hostem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar reconecta o cliente desta aba do tmux. Para ver duas sessões ao mesmo tempo, abra uma segunda conexão com este host."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar reanexa o cliente deste separador tmux. Para ver duas sessões ao mesmo tempo, abra uma segunda ligação a este anfitrião."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comutarea reatașează clientul acestui tab tmux. Pentru a vizualiza două sesiuni simultan, deschideți o a doua conexiune la această gazdă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preklop ponovno priklopi odjemalca tega zavihka tmux. Za hkraten ogled dveh sej odprite drugo povezavo do tega gostitelja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid byte återansluts den här tmux-flikens klient. Öppna en andra anslutning till den här värden för att visa två sessioner samtidigt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикання повторно приєднує клієнта цієї вкладки tmux. Щоб переглядати два сеанси одночасно, відкрийте друге з'єднання до цього хоста."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc chuyển sẽ gắn lại client của tab tmux này. Để xem hai phiên cùng lúc, hãy mở một kết nối thứ hai đến host này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换会重新挂接此 tmux 标签页的客户端。若要同时查看两个会话，请再开一个到此主机的连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換會重新附加此 tmux 標籤頁的用戶端。若要同時檢視兩個工作階段，請開啟與此主機的第二個連線。"
          }
        }
      }
    },
