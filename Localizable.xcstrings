    "Once connected, type 'help' at the sftp> prompt for available commands." : {
      "comment" : "SFTP help: interactive hint",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الاتصال، اكتب 'help' في موجه sftp> للاطلاع على الأوامر المتاحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cop connectat, escriviu 'help' al símbol sftp> per veure les ordres disponibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po připojení zadejte 'help' na výzvu sftp> pro zobrazení dostupných příkazů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er forbundet, skriv 'help' ved sftp>-prompten for tilgængelige kommandoer."
          }
        },
        "de" : {
          "stringUnit" : {
