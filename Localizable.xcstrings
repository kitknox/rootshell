    "Luminous blue on dark themes, warm orange on light themes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزرق متوهّج على السمات الداكنة، وبرتقالي دافئ على السمات الفاتحة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blau lluminós en temes foscos, taronja càlid en temes clars"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zářivě modrá na tmavých motivech, teple oranžová na světlých motivech"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lysende blå på mørke temaer, varm orange på lyse temaer"
          }
        },
