    "Controls window transparency and blur. Blur uses system vibrancy effect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحكم في شفافية النافذة والضبابية. تستخدم الضبابية تأثير حيوية النظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla la transparència i el desenfocament de la finestra. El desenfocament utilitza l'efecte de vibrància del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládá průhlednost okna a rozostření. Rozostření využívá systémový efekt vibrancy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer vinduets gennemsigtighed og sløring. Sløring bruger systemets vibrancy-effekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuert Fenstertransparenz und Unschärfe. Die Unschärfe nutzt den Vibrancy-Effekt des Systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla la transparencia de la ventana y el desenfoque. El desenfoque usa el efecto de vibración del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallitsee ikkunan läpinäkyvyyttä ja sumennusta. Sumennus käyttää järjestelmän elävyysefektiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôle la transparence de la fenêtre et le flou. Le flou utilise l'effet de vibrance du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שולט בשקיפות החלון ובטשטוש. הטשטוש משתמש באפקט החיוניות של המערכת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ablak átlátszóságát és elmosását szabályozza. Az elmosás a rendszer vibrálási effektusát használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la trasparenza e la sfocatura della finestra. La sfocatura utilizza l'effetto vibrancy di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウの透過度とぼかしを制御します。ぼかしはシステムのバイブランシーエフェクトを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창 투명도와 블러를 제어합니다. 블러는 시스템 바이브런시 효과를 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer vinduets gjennomsiktighet og uskarphet. Uskarphet bruker systemets vibrancy-effekt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt venstertransparantie en vervaging. Vervaging gebruikt het systeemlevendigheidseffect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroluje przezroczystość okna i rozmycie. Rozmycie wykorzystuje systemowy efekt wibracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla a transparência e o desfoque da janela. O desfoque usa o efeito de vibrância do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla a transparência e o desfoque da janela. O desfoque utiliza o efeito de vibrância do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlează transparența ferestrei și estomparea. Estomparea folosește efectul de vibranță al sistemului."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadzoruje prosojnost okna in zameglitev. Zameglitev uporablja sistemski učinek živosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr fönstrets transparens och oskärpa. Oskärpa använder systemets vibrancy-effekt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керує прозорістю вікна та розмиттям. Розмиття використовує системний ефект вібрації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm soát độ trong suốt và làm mờ cửa sổ. Làm mờ sử dụng hiệu ứng vibrancy của hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制窗口透明度和模糊效果。模糊使用系统活力效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制視窗透明度和模糊效果。模糊使用系統動態效果。"
          }
        }
      }
    },
