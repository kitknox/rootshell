    "Turning off Save Password removes the saved password when you save." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف «حفظ كلمة المرور» يزيل كلمة المرور المحفوظة عند الحفظ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si desactiveu Desar contrasenya, la contrasenya desada s'eliminarà quan deseu."
