    "Passkey storage and authentication are managed by the system and cannot be changed in rootshell." : {
      "comment" : "SSH key security migration error for a system passkey",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتولى النظام إدارة تخزين مفتاح المرور والمصادقة، ولا يمكن تغييرهما في rootshell."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'emmagatzematge i l'autenticació de la clau d'accés els gestiona el sistema i no es poden canviar a rootshell."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládání přístupového klíče a ověřování spravuje systém a v rootshellu je nelze změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagring og autentificering af adgangsnøglen styres af systemet og kan ikke ændres i rootshell."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicherung und Authentifizierung des Passkeys werden vom System verwaltet und können in rootshell nicht geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento y la autenticación de la clave de acceso los gestiona el sistema y no se pueden cambiar en rootshell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulkuavaimen tallennusta ja todennusta hallitsee järjestelmä, eikä niitä voi muuttaa rootshellissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage et l'authentification de la clé d'accès sont gérés par le système et ne peuvent pas être modifiés dans rootshell."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחסון מפתח המעבר והאימות מנוהלים על ידי המערכת ולא ניתן לשנותם ב-rootshell."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az azonosítókulcs tárolását és hitelesítését a rendszer kezeli, és a rootshellben nem módosítható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archiviazione e l'autenticazione della passkey sono gestite dal sistema e non possono essere modificate in rootshell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスキーの保存と認証はシステムが管理しており、rootshellでは変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패스키 저장과 인증은 시스템이 관리하며 rootshell에서 변경할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagring og autentisering av passnøkkelen styres av systemet og kan ikke endres i rootshell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opslag en authenticatie van de passkey worden door het systeem beheerd en kunnen niet in rootshell worden gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowywanie i uwierzytelnianie klucza dostępu są zarządzane przez system i nie można ich zmienić w rootshell."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O armazenamento e a autenticação da chave-senha são gerenciados pelo sistema e não podem ser alterados no rootshell."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O armazenamento e a autenticação da chave de acesso são geridos pelo sistema e não podem ser alterados no rootshell."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocarea și autentificarea cheii de acces sunt gestionate de sistem și nu pot fi modificate în rootshell."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjevanje ključa za dostop in overjanje upravlja sistem in ju v rootshellu ni mogoče spremeniti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagring och autentisering av passkeyn hanteras av systemet och kan inte ändras i rootshell."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберіганням ключа доступу та автентифікацією керує система, і їх не можна змінити в rootshell."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc lưu trữ và xác thực passkey do hệ thống quản lý và không thể thay đổi trong rootshell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通行密钥的存储和认证由系统管理，无法在 rootshell 中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼金鑰的儲存與驗證由系統管理，無法在 rootshell 中變更。"
          }
        }
      }
    },
    "Passkeys are unavailable. Make sure a passkey provider is set up (iCloud Keychain, or a third-party manager like 1Password) and this device has a passcode." : {
      "comment" : "WebAuthn SSH credential error: platform passkeys unavailable",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفاتيح المرور غير متاحة. تأكد من إعداد مزود لمفاتيح المرور (سلسلة مفاتيح iCloud أو مدير خارجي مثل 1Password) ومن أن هذا الجهاز لديه رمز مرور."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus d'accés no estan disponibles. Assegureu-vos que hi hagi un proveïdor de claus d'accés configurat (iCloud Keychain o un gestor de tercers com 1Password) i que aquest dispositiu tingui un codi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístupové klíče nejsou k dispozici. Ujistěte se, že je nastaven poskytovatel přístupových klíčů (iCloud Keychain nebo správce třetí strany jako 1Password) a že má toto zařízení nastavený kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangsnøgler er ikke tilgængelige. Sørg for, at der er konfigureret en adgangsnøgleudbyder (iCloud-nøglering eller en tredjepartsmanager som 1Password), og at denne enhed har en adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passkeys sind nicht verfügbar. Stellen Sie sicher, dass ein Passkey-Anbieter eingerichtet ist (iCloud-Schlüsselbund oder ein Drittanbieter-Manager wie 1Password) und dieses Gerät einen Code hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de acceso no están disponibles. Asegúrese de que haya un proveedor de claves de acceso configurado (iCloud Keychain o un gestor de terceros como 1Password) y de que este dispositivo tenga un código."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulkuavaimet eivät ole käytettävissä. Varmista, että kulkuavaimen tarjoaja on määritetty (iCloud-avainnippu tai kolmannen osapuolen hallintaohjelma kuten 1Password) ja että tässä laitteessa on pääsykoodi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés d'accès sont indisponibles. Assurez-vous qu'un fournisseur de clés d'accès est configuré (iCloud Keychain ou un gestionnaire tiers comme 1Password) et que cet appareil dispose d'un code d'accès."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות מעבר אינם זמינים. ודא שמוגדר ספק מפתחות מעבר (מחזיק המפתחות של iCloud, או מנהל צד-שלישי כמו 1Password) ושלמכשיר הזה יש קוד גישה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az azonosítókulcsok nem érhetők el. Győződjön meg róla, hogy be van állítva egy azonosítókulcs-szolgáltató (iCloud Keychain vagy külső kezelő, például az 1Password), és hogy az eszközön be van állítva jelkód."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le passkey non sono disponibili. Assicurati che sia configurato un provider di passkey (iCloud Keychain o un gestore di terze parti come 1Password) e che questo dispositivo abbia un codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスキーを利用できません。パスキープロバイダ（iCloudキーチェーン、または1Passwordなどのサードパーティ製マネージャ）が設定されていること、およびこのデバイスにパスコードが設定されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패스키를 사용할 수 없습니다. 패스키 제공자(iCloud 키체인 또는 1Password 같은 타사 관리자)가 설정되어 있고 이 기기에 암호가 설정되어 있는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passnøkler er ikke tilgjengelige. Sørg for at en passnøkkelleverandør er konfigurert (iCloud-nøkkelring eller en tredjepartsbehandler som 1Password), og at denne enheten har en kode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passkeys zijn niet beschikbaar. Zorg ervoor dat er een passkey-provider is ingesteld (iCloud-sleutelhanger of een externe manager zoals 1Password) en dat dit apparaat een toegangscode heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze dostępu są niedostępne. Upewnij się, że skonfigurowano dostawcę kluczy dostępu (iCloud Keychain lub menedżera innej firmy, takiego jak 1Password) i że to urządzenie ma ustawiony kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves-senha não estão disponíveis. Verifique se há um provedor de chaves-senha configurado (iCloud Keychain ou um gerenciador de terceiros como o 1Password) e se este dispositivo tem um código."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de acesso não estão disponíveis. Certifique-se de que há um fornecedor de chaves de acesso configurado (iCloud Keychain ou um gestor de terceiros como o 1Password) e de que este dispositivo tem um código."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheile de acces nu sunt disponibile. Asigurați-vă că este configurat un furnizor de chei de acces (iCloud Keychain sau un manager terț precum 1Password) și că acest dispozitiv are un cod."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ključi za dostop niso na voljo. Prepričajte se, da je nastavljen ponudnik ključev za dostop (iCloud Keychain ali upravitelj drugega ponudnika, kot je 1Password) in da ima ta naprava nastavljeno kodo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passkeys är inte tillgängliga. Se till att en passkey-leverantör är konfigurerad (iCloud-nyckelring eller en tredjepartshanterare som 1Password) och att den här enheten har en lösenkod."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключі доступу недоступні. Переконайтеся, що налаштовано провайдера ключів доступу (iCloud Keychain або сторонній менеджер, наприклад 1Password) і що на цьому пристрої встановлено код."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể dùng passkey. Hãy đảm bảo đã thiết lập một nhà cung cấp passkey (Chuỗi khóa iCloud, hoặc trình quản lý bên thứ ba như 1Password) và thiết bị này đã đặt mật mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通行密钥不可用。请确认已设置通行密钥提供方（iCloud 钥匙串，或 1Password 等第三方管理器），并且此设备已设置密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼金鑰無法使用。請確認已設定密碼金鑰提供者（iCloud 鑰匙圈，或 1Password 等第三方管理程式），且此裝置已設定密碼。"
          }
        }
      }
    },
