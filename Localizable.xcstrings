          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opgeslagen aanmelding van de agent kon niet op die host worden gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać zapisanego logowania agenta na tym hoście."
