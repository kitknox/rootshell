    "Ends every window and pane in this session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنهي كل نافذة وجزء في هذه الجلسة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalitza totes les finestres i subfinestres d'aquesta sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončí každé okno a panel v této relaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslutter alle vinduer og ruder i denne session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet jedes Fenster und jeden Bereich in dieser Sitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina todas las ventanas y paneles de esta sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopettaa kaikki tämän istunnon ikkunat ja ruudut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met fin à toutes les fenêtres et à tous les panneaux de cette session."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיים כל חלון וחלונית בהפעלה זו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befejezi ennek a munkamenetnek minden ablakát és panelét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina ogni finestra e riquadro di questa sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッション内のすべてのウィンドウとペインを終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션의 모든 윈도우와 창을 종료합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutter hvert vindu og hver rute i denne økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beëindigt elk venster en deelvenster in deze sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kończy każde okno i okienko w tej sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra todas as janelas e painéis desta sessão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina todas as janelas e painéis desta sessão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încheie fiecare fereastră și panou din această sesiune."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konča vsako okno in pult v tej seji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutar varje fönster och ruta i den här sessionen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершує кожне вікно та панель у цьому сеансі."
