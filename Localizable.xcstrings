    "Single finger scrolls. Long press to click or select text. Two-finger tap for menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصبع واحد للتمرير. اضغط مطولاً للنقر أو تحديد النص. انقر بإصبعين للقائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dit per desplaçar-se. Premeu llargament per fer clic o seleccionar text. Toqueu amb dos dits per al menú."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedním prstem posouvejte. Dlouhým stiskem klikněte nebo vybírejte text. Klepnutím dvěma prsty otevřete nabídku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én finger ruller. Langt tryk for at klikke eller markere tekst. Tryk med to fingre for menu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzelner Finger scrollt. Langes Drücken zum Klicken oder Auswählen von Text. Tippen mit zwei Fingern öffnet das Menü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dedo para desplazar. Mantenga presionado para hacer clic o seleccionar texto. Toque con dos dedos para el menú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi sormi vierittää. Pitkä painallus napsauttaa tai valitsee tekstiä. Kahden sormen napautus avaa valikon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un doigt pour défiler. Appui long pour cliquer ou sélectionner du texte. Toucher à deux doigts pour le menu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אצבע אחת לגלילה. לחיצה ארוכה ללחיצה או בחירת טקסט. הקשה בשתי אצבעות לתפריט."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy ujjal görgethet. Hosszú nyomással kattinthat vagy jelölhet ki szöveget. Két ujjas koppintás a menühöz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dito per scorrere. Pressione prolungata per fare clic o selezionare il testo. Tocco con due dita per il menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1本指でスクロール。長押しでクリックまたはテキスト選択。2本指タップでメニュー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 손가락으로 스크롤합니다. 길게 눌러 클릭하거나 텍스트를 선택합니다. 두 손가락 탭으로 메뉴를 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én finger ruller. Langt trykk for å klikke eller velge tekst. Tofingertrykk for meny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén vinger scrollt. Houd ingedrukt om te klikken of tekst te selecteren. Tik met twee vingers voor het menu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden palec przewija. Długie naciśnięcie klika lub zaznacza tekst. Dotknięcie dwoma palcami otwiera menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dedo rola. Toque longo para clicar ou selecionar texto. Toque com dois dedos para o menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize com um dedo para deslocar. Prima longamente para clicar ou selecionar texto. Toque com dois dedos para o menu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un deget pentru derulare. Apăsare lungă pentru clic sau selectare text. Atingere cu două degete pentru meniu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
