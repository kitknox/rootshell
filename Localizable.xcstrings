    "Hides the status bar and iPadOS window resize handle for a distraction-free terminal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي شريط الحالة ومقبض تغيير حجم نافذة iPadOS لتجربة طرفية خالية من عوامل التشتيت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga la barra d'estat i el tirador de redimensionament de la finestra d'iPadOS per a una experiència de terminal sense distraccions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje stavový řádek a úchyt pro změnu velikosti okna v iPadOS pro nerušenou práci v terminálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler statuslinjen og iPadOS-vinduets størrelseshåndtag for en terminaloplevelse uden forstyrrelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Statusleiste und den Griff zum Ändern der Fenstergröße in iPadOS für ein ablenkungsfreies Terminal-Erlebnis aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta la barra de estado y el control de cambio de tamaño de ventana de iPadOS para una experiencia de terminal sin distracciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa tilapalkin ja iPadOSin ikkunan koonmuutoskahvan häiriöttömän päätekokemuksen takaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque la barre d'état et la poignée de redimensionnement de fenêtre d'iPadOS pour une expérience de terminal sans distraction."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את שורת המצב ואת ידית שינוי הגודל של חלון iPadOS לחוויית מסוף נטולת הסחות דעת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elrejti az állapotsávot és az iPadOS ablakátméretező fogantyúját a zavartalan terminálélmény érdekében."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde la barra di stato e la maniglia di ridimensionamento della finestra di iPadOS per un'esperienza con il terminale priva di distrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーとiPadOSのウィンドウリサイズハンドルを非表示にし、集中できるターミナル環境を提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방해 없는 터미널 환경을 위해 상태 표시줄과 iPadOS 창 크기 조절 핸들을 숨깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler statuslinjen og iPadOS-håndtaket for endring av vindusstørrelse, for en distraksjonsfri terminalopplevelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de statusbalk en de handgreep voor het wijzigen van de venstergrootte in iPadOS voor een afleidingsvrije terminalervaring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa pasek stanu i uchwyt zmiany rozmiaru okna iPadOS, zapewniając korzystanie z terminala bez rozpraszania uwagi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta a barra de status e a alça de redimensionamento de janela do iPadOS para uma experiência de terminal sem distrações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta a barra de estado e a pega de redimensionamento da janela do iPadOS para uma experiência de terminal sem distrações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde bara de stare și mânerul de redimensionare a ferestrei iPadOS pentru o experiență de terminal fără distrageri."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
