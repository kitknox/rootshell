    "Enter a hostname below, or set the profile's host first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل اسم مضيف أدناه، أو عيّن مضيف الملف الشخصي أولاً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduïu un nom d'amfitrió a sota o definiu primer l'amfitrió del perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte níže název hostitele, nebo nejprve nastavte hostitele v profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast et værtsnavn nedenfor, eller angiv først profilens vært."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie unten einen Hostnamen ein oder legen Sie zuerst den Host des Profils fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduzca un nombre de host abajo o defina primero el host del perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä isäntänimi alle tai aseta ensin profiilin isäntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nom d'hôte ci-dessous ou définissez d'abord l'hôte du profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזן שם מארח למטה, או הגדר תחילה את המארח של הפרופיל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon meg lent egy gazdagépnevet, vagy előbb állítsa be a profil gazdagépét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un hostname qui sotto oppure imposta prima l'host del profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にホスト名を入力するか、先にプロファイルのホストを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 호스트명을 입력하거나 먼저 프로필의 호스트를 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn et vertsnavn nedenfor, eller angi profilens vert først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer hieronder een hostnaam in, of stel eerst de host van het profiel in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadź poniżej nazwę hosta lub najpierw ustaw hosta w profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um nome de host abaixo ou defina primeiro o host do perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza um nome de anfitrião abaixo ou defina primeiro o anfitrião do perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți mai jos un nume de gazdă sau setați mai întâi gazda profilului."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spodaj vnesite ime gostitelja ali pa najprej nastavite gostitelja v profilu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange ett värdnamn nedan, eller ange profilens värd först."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть імʼя хоста нижче або спершу вкажіть хост у профілі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập tên máy chủ bên dưới, hoặc đặt máy chủ cho hồ sơ trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
