    "On the remote, save this to a file and run `gpg --import <file>`, then verify with `gpg --list-keys`." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الجهاز البعيد، احفظ هذا في ملف ثم نفّذ `gpg --import <file>`، ثم تحقق باستخدام `gpg --list-keys`."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al remot, deseu això en un fitxer i executeu `gpg --import <file>`, després verifiqueu-ho amb `gpg --list-keys`."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vzdáleném stroji to uložte do souboru a spusťte `gpg --import <file>`, poté ověřte pomocí `gpg --list-keys`."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem dette i en fil på fjernsystemet og kør `gpg --import <file>`, og verificér derefter med `gpg --list-keys`."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie dies auf der Gegenstelle in eine Datei und führen Sie `gpg --import <file>` aus, anschließend mit `gpg --list-keys` überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el remoto, guarde esto en un archivo y ejecute `gpg --import <file>`, luego verifique con `gpg --list-keys`."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna tämä etäkoneessa tiedostoon ja suorita `gpg --import <file>`, ja varmista sitten komennolla `gpg --list-keys`."
