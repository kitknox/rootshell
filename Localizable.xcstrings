    "Not an absolute path. The shell is launched with a minimal PATH, so a bare name may not be found." : {
      "comment" : "Local shell warning: relative command",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس مسارًا مطلقًا. تُشغَّل الصدفة باستخدام PATH محدود، لذا قد لا يُعثر على اسم مجرد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No és un camí absolut. El shell s'inicia amb un PATH mínim, així que és possible que un nom sense ruta no es trobi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není to absolutní cesta. Shell se spouští s minimální proměnnou PATH, takže samotný název nemusí být nalezen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke en absolut sti. Shellen startes med en minimal PATH, så et bart navn findes måske ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein absoluter Pfad. Die Shell wird mit einem minimalen PATH gestartet, daher wird ein bloßer Name möglicherweise nicht gefunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una ruta absoluta. La shell se inicia con un PATH mínimo, así que puede que un nombre sin ruta no se encuentre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei ole absoluuttinen polku. Komentotulkki käynnistetään minimaalisella PATH-muuttujalla, joten pelkkää nimeä ei ehkä löydy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas un chemin absolu. Le shell est lancé avec un PATH minimal : un nom seul risque de ne pas être trouvé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נתיב מוחלט. המעטפת מופעלת עם PATH מינימלי, ולכן ייתכן ששם ללא נתיב לא יימצא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem abszolút elérési út. A shell minimális PATH értékkel indul, ezért előfordulhat, hogy a puszta név nem található meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è un percorso assoluto. La shell viene avviata con un PATH minimo, quindi un nome senza percorso potrebbe non essere trovato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絶対パスではありません。シェルは最小限の PATH で起動されるため、名前だけでは見つからない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 경로가 아닙니다. 셸은 최소한의 PATH로 실행되므로 이름만으로는 찾지 못할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke en absolutt sti. Skallet startes med en minimal PATH, så et rent navn blir kanskje ikke funnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen absoluut pad. De shell wordt met een minimale PATH gestart, dus een kale naam wordt mogelijk niet gevonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie jest ścieżka bezwzględna. Powłoka jest uruchamiana z minimalną zmienną PATH, więc sama nazwa może nie zostać znaleziona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é um caminho absoluto. O shell é iniciado com um PATH mínimo, portanto um nome sem caminho pode não ser encontrado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é um caminho absoluto. A shell é iniciada com um PATH mínimo, por isso um nome isolado pode não ser encontrado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu este o cale absolută. Shell-ul este lansat cu un PATH minim, așa că este posibil ca un nume simplu să nu fie găsit."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni absolutna pot. Lupina se zažene z minimalno spremenljivko PATH, zato samo ime morda ne bo najdeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte en absolut sökväg. Skalet startas med en minimal PATH, så enbart ett namn hittas kanske inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це не абсолютний шлях. Оболонка запускається з мінімальним PATH, тому саму лише назву може бути не знайдено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phải đường dẫn tuyệt đối. Shell được khởi chạy với PATH tối thiểu, nên có thể không tìm thấy tên không kèm đường dẫn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是绝对路径。Shell 以最小的 PATH 启动，因此可能找不到不带路径的名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
