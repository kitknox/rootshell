    "VPN can't use a biometric-protected password. Save the password without per-use authentication." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لـ VPN استخدام كلمة مرور محمية بالمصادقة البيومترية. احفظ كلمة المرور دون مصادقة عند كل استخدام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VPN no pot utilitzar una contrasenya protegida amb biometria. Desa la contrasenya sense autenticació per a cada ús."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN nemůže použít heslo chráněné biometrikou. Uložte heslo bez ověření při každém použití."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN kan ikke bruge en biometrisk beskyttet adgangskode. Gem adgangskoden uden godkendelse ved hver brug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das VPN kann kein biometrisch geschütztes Passwort verwenden. Speichere das Passwort ohne Authentifizierung bei jeder Verwendung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VPN no puede usar una contraseña protegida con biometría. Guarda la contraseña sin autenticación por cada uso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN ei voi käyttää biometrisesti suojattua salasanaa. Tallenna salasana ilman erillistä tunnistautumista jokaisella käyttökerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le VPN ne peut pas utiliser un mot de passe protégé par biométrie. Enregistrez le mot de passe sans authentification à chaque utilisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-VPN אינו יכול להשתמש בסיסמה המוגנת באמצעות אימות ביומטרי. שמרו את הסיסמה ללא אימות בכל שימוש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN nem használhat biometrikusan védett jelszót. Mentse a jelszót használatonkénti hitelesítés nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VPN non può usare una password protetta da biometria. Salva la password senza autenticazione a ogni utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNは生体認証で保護されたパスワードを使用できません。使用のたびの認証なしでパスワードを保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN은 생체 인증으로 보호된 비밀번호를 사용할 수 없습니다. 사용할 때마다 인증하지 않도록 비밀번호를 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN kan ikke bruke et biometrisk beskyttet passord. Lagre passordet uten autentisering ved hver bruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De VPN kan geen biometrisch beveiligd wachtwoord gebruiken. Bewaar het wachtwoord zonder verificatie bij elk gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN nie może użyć hasła chronionego biometrią. Zapisz hasło bez uwierzytelniania przy każdym użyciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN não pode usar uma senha protegida por biometria. Salve a senha sem autenticação a cada uso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN não pode usar uma palavra-passe protegida por biometria. Guarde a palavra-passe sem autenticação a cada utilização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-ul nu poate folosi o parolă protejată biometric. Salvează parola fără autentificare la fiecare utilizare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN ne more uporabiti gesla, zaščitenega z biometrijo. Shranite geslo brez overjanja ob vsaki uporabi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN kan inte använda ett biometriskt skyddat lösenord. Spara lösenordet utan autentisering vid varje användning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN не може використовувати пароль, захищений біометрією. Збережіть пароль без автентифікації під час кожного використання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN không thể sử dụng mật khẩu được bảo vệ bằng sinh trắc học. Hãy lưu mật khẩu mà không cần xác thực mỗi lần sử dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 无法使用受生物识别保护的密码。请保存密码且不要求每次使用时进行身份验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 無法使用受生物辨識保護的密碼。請儲存密碼且不要求每次使用時進行驗證。"
          }
        }
      }
    },
