    "Pixel adjustments for cursor dimensions. 0 uses the default size." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديلات بالبكسل لأبعاد المؤشر. القيمة 0 تستخدم الحجم الافتراضي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
