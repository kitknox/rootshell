    "Key syncs across your devices via iCloud Keychain." : {
      "comment" : "Key storage description: iCloud sync",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُزامَن المفتاح عبر أجهزتك من خلال سلسلة مفاتيح iCloud."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clau se sincronitza entre els teus dispositius mitjançant el clauer d'iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč se synchronizuje mezi vašimi zařízeními přes iCloud Keychain."
