    "Configure left/right swipes to send custom sequences or switch tabs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط التمرير لليسار/اليمين لإرسال تسلسلات مخصصة أو لتبديل علامات التبويب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura els lliscaments d’esquerra/dreta perquè enviïn seqüències personalitzades o canviïn de pestanya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakonfigurujte přejetí vlevo/vpravo, aby odesílalo vlastní sekvence nebo přepínalo karty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurer venstre/højre stryg til at sende brugerdefinerede sekvenser eller skifte faner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurieren Sie Wischen nach links/rechts, um benutzerdefinierte Sequenzen zu senden oder Tabs zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura los deslizamientos izquierda/derecha para enviar secuencias personalizadas o cambiar de pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
