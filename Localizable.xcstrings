    "Shell edits are picked up with the Reload button here or by running reloadconfig in a local shell." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التقاط تعديلات الصدفة باستخدام زر إعادة التحميل هنا أو بتشغيل reloadconfig في صدفة محلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els canvis fets des del shell es recullen amb el botó Recarregar d'aquí o executant reloadconfig en un shell local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úpravy provedené v shellu se projeví tlačítkem Znovu načíst zde nebo spuštěním příkazu reloadconfig v místním shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringer fra shellen opfanges med Genindlæs-knappen her eller ved at køre reloadconfig i en lokal shell."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen in der Shell werden über die Schaltfläche „Neu laden\" hier oder durch Ausführen von reloadconfig in einer lokalen Shell übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios desde la shell se aplican con el botón Recargar aquí o ejecutando reloadconfig en una shell local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shellin muutokset huomioidaan tästä Lataa uudelleen -painikkeella tai suorittamalla reloadconfig paikallisessa shellissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications depuis le shell sont prises en compte avec le bouton Recharger ici ou en exécutant reloadconfig dans un shell local."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינויים מה-shell נקלטים באמצעות כפתור הטעינה מחדש כאן או על ידי הרצת reloadconfig במסוף מקומי."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shell-ben végzett módosításokat az itteni Újratöltés gomb vagy a reloadconfig parancs helyi shellben történő futtatása érvényesíti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche dalla shell vengono applicate con il pulsante Ricarica qui o eseguendo reloadconfig in una shell locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルでの変更は、ここの再読み込みボタンを押すか、ローカルシェルで reloadconfig を実行することで反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸에서의 변경사항은 여기의 다시 불러오기 버튼이나 로컬 셸에서 reloadconfig를 실행하여 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringer i skallet hentes med Last inn på nytt-knappen her eller ved å kjøre reloadconfig i et lokalt skall."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen vanuit de shell worden hier met de knop Herladen of door reloadconfig in een lokale shell uit te voeren opgepikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany z poziomu shella są uwzględniane za pomocą przycisku Przeładuj lub poleceniem reloadconfig w lokalnym shellu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edições do shell são aplicadas com o botão Recarregar aqui ou executando reloadconfig em um shell local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As edições a partir da shell são aplicadas com o botão Recarregar aqui ou executando reloadconfig numa shell local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificările din shell sunt preluate cu butonul Reîncarcă de aici sau rulând reloadconfig într-un shell local."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremembe iz lupine se upoštevajo z gumbom Znova naloži tukaj ali z zagonom ukaza reloadconfig v lokalni lupini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändringar från skalet fångas upp med knappen Ladda om här eller genom att köra reloadconfig i ett lokalt skal."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
