    "The provider did not issue a refresh token, so a new browser sign-in is needed roughly every 24 hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُصدر المزوّد رمز تحديث، لذا يلزم تسجيل دخول جديد عبر المتصفح كل 24 ساعة تقريباً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveïdor no ha emès cap testimoni d'actualització, de manera que cal un nou inici de sessió al navegador aproximadament cada 24 hores."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytovatel nevydal obnovovací token, takže přibližně každých 24 hodin je potřeba nové přihlášení v prohlížeči."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udbyderen udstedte ikke et fornyelsestoken, så et nyt login i browseren er nødvendigt cirka hver 24. time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter hat kein Aktualisierungstoken ausgestellt, daher ist etwa alle 24 Stunden eine erneute Anmeldung im Browser erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor no emitió un token de actualización, por lo que es necesario iniciar sesión de nuevo en el navegador aproximadamente cada 24 horas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palveluntarjoaja ei myöntänyt päivitystunnusta, joten selaimessa on kirjauduttava uudelleen sisään noin 24 tunnin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur n'a pas émis de jeton d'actualisation ; une nouvelle connexion dans le navigateur est donc nécessaire environ toutes les 24 heures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הספק לא הנפיק אסימון רענון, ולכן נדרשת התחברות חדשה בדפדפן בערך כל 24 שעות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltató nem adott ki frissítési tokent, ezért nagyjából 24 óránként új böngészős bejelentkezésre van szükség."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider non ha emesso un token di aggiornamento, quindi è necessario un nuovo accesso dal browser circa ogni 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダがリフレッシュトークンを発行しなかったため、約24時間ごとにブラウザでの再サインインが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공자가 리프레시 토큰을 발급하지 않아 약 24시간마다 브라우저에서 다시 로그인해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leverandøren utstedte ikke et oppdateringstoken, så ny innlogging i nettleseren er nødvendig omtrent hver 24. time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De provider heeft geen vernieuwingstoken uitgegeven, dus is ongeveer elke 24 uur een nieuwe aanmelding in de browser nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca nie wydał tokena odświeżania, więc nowe logowanie w przeglądarce jest potrzebne mniej więcej co 24 godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor não emitiu um token de atualização, então é necessário um novo início de sessão no navegador a cada 24 horas, aproximadamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fornecedor não emitiu um token de atualização, pelo que é necessário um novo início de sessão no navegador aproximadamente a cada 24 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furnizorul nu a emis un token de reîmprospătare, așa că este necesară o nouă autentificare în browser aproximativ la fiecare 24 de ore."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponudnik ni izdal žetona za osvežitev, zato je približno vsakih 24 ur potrebna nova prijava v brskalniku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leverantören utfärdade ingen uppdateringstoken, så en ny inloggning i webbläsaren behövs ungefär var 24:e timme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер не видав токен оновлення, тому приблизно кожні 24 години потрібно знову входити у браузері."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà cung cấp không cấp mã làm mới, vì vậy cần đăng nhập lại bằng trình duyệt khoảng mỗi 24 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
