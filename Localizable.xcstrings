          }
        }
      }
    },
    "Keeps an encrypted history of copies, pastes, and remote clipboard writes made inside the app. Turning this off deletes all history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ بسجل مشفّر لعمليات النسخ واللصق وكتابات الحافظة عن بُعد التي تتم داخل التطبيق. إيقاف هذا الخيار يحذف كل السجل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manté un historial encriptat de les còpies, enganxades i escriptures remotes al porta-retalls fetes dins l'app. Si ho desactiveu, s'esborrarà tot l'historial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovává šifrovanou historii kopírování, vkládání a vzdálených zápisů do schránky provedených v aplikaci. Vypnutím se veškerá historie odstraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarer en krypteret historik over kopieringer, indsætninger og fjernskrivninger til udklipsholderen foretaget i appen. Hvis dette slås fra, slettes al historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahrt einen verschlüsselten Verlauf von Kopier-, Einfüge- und entfernten Zwischenablage-Vorgängen innerhalb der App auf. Beim Deaktivieren wird der gesamte Verlauf gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva un historial cifrado de las copias, pegados y escrituras remotas del portapapeles realizadas dentro de la app. Al desactivarlo se elimina todo el historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilyttää salatun historian sovelluksessa tehdyistä kopioinneista, liittämisistä ja etäleikepöydän kirjoituksista. Tämän poistaminen käytöstä poistaa koko historian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve un historique chiffré des copies, des collages et des écritures du presse-papiers distant effectués dans l'app. Désactiver cette option supprime tout l'historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר היסטוריה מוצפנת של העתקות, הדבקות וכתיבות מרוחקות ללוח שבוצעו בתוך האפליקציה. כיבוי האפשרות מוחק את כל ההיסטוריה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titkosított előzményeket tart fenn az alkalmazáson belül végzett másolásokról, beillesztésekről és távoli vágólapírásokról. A kikapcsolása törli az összes előzményt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una cronologia cifrata di copie, incollamenti e scritture remote negli appunti effettuate all'interno dell'app. Se la disattivi, l'intera cronologia viene eliminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内で行ったコピー、ペースト、リモートクリップボードへの書き込みの暗号化された履歴を保持します。オフにすると、すべての履歴が削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 복사, 붙여넣기 및 원격 클립보드 쓰기 기록을 암호화하여 유지합니다. 이 기능을 끄면 모든 기록이 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholder en kryptert historikk over kopieringer, innliminger og eksterne utklippsskrivinger gjort i appen. Hvis du slår dette av, slettes all historikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart een versleutelde geschiedenis van kopieer- en plakacties en externe klembordschrijfacties binnen de app. Als je dit uitschakelt, wordt alle geschiedenis verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuje zaszyfrowaną historię kopiowań, wklejeń i zdalnych zapisów schowka wykonanych w aplikacji. Wyłączenie tej opcji powoduje usunięcie całej historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um histórico criptografado de cópias, colagens e gravações remotas na área de transferência feitas dentro do app. Desativar esta opção exclui todo o histórico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um histórico encriptado das cópias, colagens e escritas remotas na área de transferência feitas dentro da aplicação. Desativar esta opção elimina todo o histórico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează un istoric criptat al copierilor, lipirilor și scrierilor în clipboard la distanță efectuate în aplicație. Dezactivarea acestei opțiuni șterge tot istoricul."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranja šifrirano zgodovino kopiranj, lepljenj in oddaljenih zapisov v odložišče, opravljenih v aplikaciji. Če to izklopite, se izbriše vsa zgodovina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller en krypterad historik över kopieringar, inklistringar och fjärrskrivningar till urklipp som gjorts i appen. Om du stänger av detta raderas all historik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає зашифровану історію копіювань, вставлянь і віддалених записів у буфер обміну, зроблених у застосунку. Якщо це вимкнути, вся історія видаляється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ lịch sử được mã hóa của các thao tác sao chép, dán và ghi bảng nhớ tạm từ xa thực hiện trong ứng dụng. Tắt tùy chọn này sẽ xóa toàn bộ lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留在应用内进行的拷贝、粘贴和远程剪贴板写入操作的加密历史记录。关闭此选项将删除所有历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留在 App 內進行的複製、貼上，以及遠端剪貼簿寫入的加密記錄。關閉此選項將刪除所有記錄。"
          }
        }
      }
    },
    "Keeps an encrypted, device-only history of copies and pastes made inside the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ بسجل مشفّر على الجهاز فقط لعمليات النسخ واللصق التي تتم داخل التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manté un historial encriptat, només al dispositiu, de les còpies i enganxades fetes dins l'app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovává šifrovanou historii kopírování a vkládání provedených v aplikaci, uloženou pouze v zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarer en krypteret historik, kun på enheden, over kopieringer og indsætninger foretaget i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahrt einen verschlüsselten, nur auf diesem Gerät gespeicherten Verlauf von Kopier- und Einfügevorgängen innerhalb der App auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva un historial cifrado, solo en este dispositivo, de las copias y pegados realizados dentro de la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilyttää salatun, vain laitteella olevan historian sovelluksessa tehdyistä kopioinneista ja liittämisistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve un historique chiffré, uniquement sur l'appareil, des copies et des collages effectués dans l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר היסטוריה מוצפנת, במכשיר בלבד, של העתקות והדבקות שבוצעו בתוך האפליקציה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titkosított, csak az eszközön tárolt előzményeket tart fenn az alkalmazáson belül végzett másolásokról és beillesztésekről."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una cronologia cifrata, solo sul dispositivo, di copie e incollamenti effettuati all'interno dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内で行ったコピーとペーストの暗号化された履歴を、このデバイス上にのみ保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 복사하고 붙여넣은 기록을 이 기기에만 암호화하여 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholder en kryptert historikk, bare på denne enheten, over kopieringer og innliminger gjort i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart een versleutelde geschiedenis van kopieer- en plakacties binnen de app, alleen op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuje zaszyfrowaną historię kopiowań i wklejeń wykonanych w aplikacji, przechowywaną wyłącznie na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um histórico criptografado, apenas no dispositivo, de cópias e colagens feitas dentro do app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um histórico encriptado, apenas no dispositivo, das cópias e colagens feitas dentro da aplicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează un istoric criptat, doar pe dispozitiv, al copierilor și lipirilor efectuate în aplicație."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranja šifrirano zgodovino kopiranj in lepljenj, opravljenih v aplikaciji, samo na tej napravi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller en krypterad historik, endast på enheten, över kopieringar och inklistringar som gjorts i appen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає зашифровану історію копіювань і вставлянь, зроблених у застосунку, лише на цьому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ lịch sử được mã hóa, chỉ lưu trên thiết bị, của các thao tác sao chép và dán thực hiện trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留在应用内进行的拷贝和粘贴的加密历史记录，仅保存在本设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
