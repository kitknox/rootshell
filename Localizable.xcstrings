            "value" : "נשלח כ-TERM. שדה ריק יורש מהגדרות > מסוף > סוג מסוף."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM-ként kerül elküldésre. Üresen hagyva a Beállítások > Terminál > Terminál típusa értéket örökli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
