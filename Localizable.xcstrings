    "Reasoning level applies per model and can also be changed from the model picker." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق مستوى الاستدلال على كل نموذج على حدة، ويمكن تغييره أيضاً من منتقي النماذج."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nivell de raonament s'aplica per model i també es pot canviar des del selector de models."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úroveň úvahy platí pro každý model zvlášť a lze ji změnit i ve výběru modelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ræsonneringsniveauet gælder pr. model og kan også ændres i modelvælgeren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Denkstufe gilt pro Modell und kann auch in der Modellauswahl geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nivel de razonamiento se aplica por modelo y también se puede cambiar desde el selector de modelos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päättelytaso on mallikohtainen, ja sen voi vaihtaa myös mallivalitsimesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau de raisonnement s'applique par modèle et peut aussi être modifié depuis le sélecteur de modèles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רמת החשיבה חלה לכל מודל בנפרד, וניתן לשנות אותה גם מבורר המודלים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gondolkodási szint modellenként érvényes, és a modellválasztóból is módosítható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello di ragionamento si applica a ogni modello e può essere modificato anche dal selettore modelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推論レベルはモデルごとに適用され、モデル選択からも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추론 수준은 모델별로 적용되며 모델 선택기에서도 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resonneringsnivået gjelder per modell og kan også endres fra modellvelgeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het redeneerniveau geldt per model en kan ook worden gewijzigd in de modelselectie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziom rozumowania obowiązuje osobno dla każdego modelu i można go też zmienić w selektorze modeli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nível de raciocínio é definido por modelo e também pode ser alterado no seletor de modelos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nível de raciocínio aplica-se a cada modelo e também pode ser alterado no seletor de modelos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivelul de raționament se aplică pentru fiecare model și poate fi schimbat și din selectorul de modele."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raven utemeljitve velja za posamezen model in jo lahko spremenite tudi v izbirniku modelov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resonemangsnivån gäller per modell och kan även ändras i modellväljaren."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рівень міркувань застосовується окремо для кожної моделі, його також можна змінити в засобі вибору моделей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức lý luận áp dụng cho từng mô hình và cũng có thể thay đổi từ bộ chọn mô hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推理级别按模型分别设置，也可在模型选择器中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推理層級會依個別模型套用，也可從模型選擇器中變更。"
          }
        }
      }
    },
