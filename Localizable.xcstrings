    "Drag to reorder. Keys are tried from top to bottom until one succeeds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لإعادة الترتيب. يتم تجربة المفاتيح من الأعلى إلى الأسفل حتى ينجح أحدها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu per reordenar. Les claus es proven de dalt a baix fins que una funcioni."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením změňte pořadí. Klíče se zkoušejí shora dolů, dokud jeden neuspěje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at ændre rækkefølge. Nøgler prøves fra top til bund, indtil én lykkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Neuordnen ziehen. Schlüssel werden von oben nach unten versucht, bis einer erfolgreich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre para reordenar. Las claves se prueban de arriba a abajo hasta que una funcione."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä järjestääksesi uudelleen. Avaimia kokeillaan ylhäältä alas, kunnes jokin onnistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Les clés sont essayées de haut en bas jusqu'à ce qu'une réussisse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור לשינוי סדר. המפתחות ננסים מלמעלה למטה עד שאחד מצליח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza az átrendezéshez. A kulcsok fentről lefelé kerülnek kipróbálásra, amíg egy nem sikerül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascini per riordinare. Le chiavi vengono provate dall'alto verso il basso fino a quando una ha successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。キーは上から順に、成功するまで試行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서를 변경하세요. 키는 위에서 아래로 성공할 때까지 순서대로 시도됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra for å endre rekkefølge. Nøkler prøves fra topp til bunn til én lykkes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om te herordenen. Sleutels worden van boven naar beneden geprobeerd totdat er een slaagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. Klucze są próbowane od góry do dołu, aż jeden zadziała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. As chaves são tentadas de cima para baixo até que uma funcione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. As chaves são tentadas de cima para baixo até uma ter sucesso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage pentru a reordona. Cheile sunt încercate de sus în jos până când una reușește."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlecite za prerazporeditev. Ključi se preskušajo od zgoraj navzdol, dokler eden ne uspe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ändra ordning. Nycklar prövas uppifrån och ner tills en lyckas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть для зміни порядку. Ключі перебираються згори донизу, доки один не спрацює."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại. Các khóa được thử từ trên xuống dưới cho đến khi một khóa thành công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以重新排序。密钥从上到下依次尝试，直到成功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳以重新排序。金鑰從上到下依序嘗試，直到成功為止。"
          }
        }
      }
    },
