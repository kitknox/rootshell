    "Your SSH connection history and known hosts will be synced to iCloud and available on your other devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم مزامنة سجل اتصالات SSH والمضيفين الموثوقين مع iCloud وسيكونون متاحين على أجهزتك الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vostre historial de connexions SSH i els amfitrions coneguts se sincronitzaran amb iCloud i estaran disponibles als vostres altres dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše historie SSH připojení a známí hostitelé budou synchronizovány do iCloud a dostupné na vašich dalších zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din SSH-forbindelseshistorik og kendte værter vil blive synkroniseret til iCloud og tilgængelige på dine andre enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr SSH-Verbindungsverlauf und bekannte Hosts werden mit iCloud synchronisiert und auf Ihren anderen Geräten verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su historial de conexiones SSH y hosts conocidos se sincronizarán con iCloud y estarán disponibles en sus otros dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-yhteyshistoriasi ja tunnetut isännät synkronoidaan iCloudiin ja ovat käytettävissä muilla laitteillasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique de connexions SSH et vos hôtes connus seront synchronisés sur iCloud et disponibles sur vos autres appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היסטוריית חיבורי SSH והמארחים המוכרים שלך יסונכרנו ל-iCloud ויהיו זמינים במכשירים האחרים שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az SSH-kapcsolati előzmények és ismert hosztok szinkronizálódnak az iCloud-ra és elérhetők lesznek a többi eszközén."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia delle connessioni SSH e gli host conosciuti verranno sincronizzati su iCloud e saranno disponibili sugli altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH接続履歴と既知のホストがiCloudに同期され、他のデバイスで利用可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 연결 기록과 알려진 호스트가 iCloud에 동기화되어 다른 기기에서 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-tilkoblingshistorikken din og kjente verter vil bli synkronisert til iCloud og tilgjengelig på dine andre enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw SSH-verbindingsgeschiedenis en bekende hosts worden gesynchroniseerd met iCloud en zijn beschikbaar op uw andere apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja historia połączeń SSH i znane hosty zostaną zsynchronizowane z iCloud i będą dostępne na innych urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico de conexões SSH e hosts conhecidos serão sincronizados com o iCloud e estarão disponíveis nos seus outros dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu histórico de ligações SSH e anfitriões conhecidos será sincronizado com o iCloud e ficará disponível nos seus outros dispositivos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istoricul conexiunilor SSH și gazdele cunoscute vor fi sincronizate pe iCloud și disponibile pe celelalte dispozitive ale dvs."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša zgodovina SSH povezav in znani gostitelji bodo sinhronizirani z iCloud in na voljo na vaših drugih napravah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din SSH-anslutningshistorik och kända värdar synkas till iCloud och blir tillgängliga på dina andra enheter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша історія SSH-з'єднань та відомі хости синхронізуватимуться з iCloud і будуть доступні на інших ваших пристроях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử kết nối SSH và các host đã biết của bạn sẽ được đồng bộ lên iCloud và khả dụng trên các thiết bị khác của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 SSH 连接历史和已知主机将同步到 iCloud 并在其他设备上可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 SSH 連線記錄和已知主機將同步至 iCloud，並可在您的其他裝置上使用。"
          }
        }
      }
    },
