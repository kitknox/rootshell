        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para restaurar una tecla oculta en el cajón. Desliza a la izquierda sobre una tecla personalizada para eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauta piilotettu näppäin laatikkoon napauttamalla. Poista mukautettu näppäin pyyhkäisemällä vasemmalle."
          }
        },
        "fr" : {
          "stringUnit" : {
