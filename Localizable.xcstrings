    "Window transparency can cause visual artifacts with the solar background. Set transparency to %@ for optimal quality." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تتسبب شفافية النافذة في عيوب بصرية مع خلفية الطاقة الشمسية. اضبط الشفافية على %@ للحصول على أفضل جودة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transparència de la finestra pot causar artefactes visuals amb el fons solar. Establiu la transparència al %@ per a una qualitat òptima."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průhlednost okna může způsobit vizuální artefakty se solárním pozadím. Nastavte průhlednost na %@ pro optimální kvalitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinduesgennemsigtighed kan forårsage visuelle artefakter med solbaggrunden. Sæt gennemsigtigheden til %@ for optimal kvalitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstertransparenz kann bei dem Solar-Hintergrund visuelle Artefakte verursachen. Setzen Sie die Transparenz auf %@ für optimale Qualität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transparencia de ventana puede causar artefactos visuales con el fondo solar. Establezca la transparencia al %@ para una calidad óptima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikkunan läpinäkyvyys voi aiheuttaa visuaalisia häiriöitä aurinkotaustan kanssa. Aseta läpinäkyvyys %@:iin parhaan laadun saamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transparence de la fenêtre peut provoquer des artefacts visuels avec l'arrière-plan solaire. Réglez la transparence à %@ pour une qualité optimale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שקיפות חלון עלולה לגרום לעיוותים חזותיים עם רקע שמש. הגדר שקיפות ל-%@ לאיכות מיטבית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ablak átlátszóság vizuális hibákat okozhat a nap háttérrel. Állítsa az átlátszóságot %@-ra az optimális minőséghez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La trasparenza della finestra può causare artefatti visivi con lo sfondo solare. Impostare la trasparenza al %@ per una qualità ottimale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウの透過はソーラー背景で視覚的なアーティファクトを引き起こす可能性があります。最適な品質のためには透過度を%@に設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 투명도는 태양 배경에서 시각적 결함을 유발할 수 있습니다. 최적의 품질을 위해 투명도를 %@로 설정하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindusgjennomsiktighet kan forårsake visuelle artefakter med solbakgrunnen. Sett gjennomsiktigheten til %@ for optimal kvalitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venstertransparantie kan visuele artefacten veroorzaken met de zonne-achtergrond. Stel de transparantie in op %@ voor optimale kwaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przezroczystość okna może powodować artefakty wizualne z tłem słonecznym. Ustaw przezroczystość na %@ dla optymalnej jakości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transparência da janela pode causar artefatos visuais com o fundo solar. Defina a transparência para %@ para qualidade ideal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transparência da janela pode causar artefactos visuais com o fundo solar. Defina a transparência para %@ para qualidade ideal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transparența ferestrei poate cauza artefacte vizuale cu fundalul solar. Setați transparența la %@ pentru calitate optimă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosojnost okna lahko povzroči vizualne napake pri solarnem ozadju. Za optimalno kakovost nastavite prosojnost na %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fönstertransparens kan orsaka visuella artefakter med solbakgrunden. Ställ in transparens på %@ för optimal kvalitet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прозорість вікна може спричинити візуальні артефакти з фоном «сонце». Встановіть прозорість на %@ для оптимальної якості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ trong suốt cửa sổ có thể gây ra hiện tượng nhiễu hình ảnh với nền mặt trời. Đặt độ trong suốt ở mức %@ để đạt chất lượng tối ưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口透明度可能导致太阳背景出现视觉瑕疵。将透明度设为 %@ 以获得最佳质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗透明度可能導致太陽背景出現視覺瑕疵。將透明度設為 %@ 以獲得最佳品質。"
          }
        }
      }
    },
