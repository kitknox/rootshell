        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil hérite normalement du type de terminal distant depuis les Réglages. Ne le remplacez que pour les hôtes qui nécessitent un autre nom terminfo."
          }
        },
        "he" : {
