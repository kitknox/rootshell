    "Key is included in encrypted device backups but not synced to iCloud." : {
      "comment" : "Key storage description: include in backups",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضمّن المفتاح في النسخ الاحتياطية المشفرة للجهاز لكنه لا يُزامَن مع iCloud."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clau s'inclou a les còpies de seguretat xifrades del dispositiu però no se sincronitza amb iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč je zahrnut v šifrovaných zálohách zařízení, ale není synchronizován do iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøglen inkluderes i krypterede enhedssikkerhedskopier, men synkroniseres ikke til iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel wird in verschlüsselte Gerätesicherungen aufgenommen, aber nicht mit iCloud synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave se incluye en las copias de seguridad cifradas del dispositivo pero no se sincroniza con iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avain sisältyy salattuihin laitteen varmuuskopioihin, mutta sitä ei synkronoida iCloudiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé est incluse dans les sauvegardes chiffrées de l'appareil mais n'est pas synchronisée avec iCloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפתח כלול בגיבויים מוצפנים של המכשיר אך אינו מסונכרן ל-iCloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcs szerepel a titkosított eszközmentésekben, de nincs szinkronizálva az iCloudba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave è inclusa nei backup crittografati del dispositivo ma non sincronizzata con iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵は暗号化されたデバイスバックアップに含まれますが、iCloud には同期されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키가 암호화된 기기 백업에 포함되지만 iCloud에는 동기화되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøkkelen er inkludert i krypterte sikkerhetskopier av enheten, men synkroniseres ikke til iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleutel wordt opgenomen in versleutelde apparaatback-ups, maar niet gesynchroniseerd met iCloud."
          }
        },
