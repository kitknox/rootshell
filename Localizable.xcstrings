    "Enable a profile to start its port forwards in the background. Enabled tunnels auto-start when the app launches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل ملفاً شخصياً لبدء توجيه المنافذ في الخلفية. تبدأ الأنفاق المفعّلة تلقائياً عند تشغيل التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activeu un perfil per iniciar les redireccions de ports en segon pla. Els túnels activats s'inicien automàticament quan s'obre l'aplicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte profil pro spuštění přesměrování portů na pozadí. Povolené tunely se automaticky spustí při spuštění aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver en profil for at starte dens portvideresendelser i baggrunden. Aktiverede tunneler starter automatisk, når appen åbnes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie ein Profil, um seine Portweiterleitungen im Hintergrund zu starten. Aktivierte Tunnel starten automatisch beim App-Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active un perfil para iniciar sus redirecciones de puertos en segundo plano. Los túneles activados se inician automáticamente al abrir la aplicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota profiili käyttöön käynnistääksesi sen porttiohjaukset taustalla. Käyttöön otetut tunnelit käynnistyvät automaattisesti sovelluksen avautuessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez un profil pour démarrer ses transferts de port en arrière-plan. Les tunnels activés démarrent automatiquement au lancement de l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל פרופיל כדי להתחיל העברות פורטים ברקע. מנהרות מופעלות מתחילות אוטומטית כשהאפליקציה נפתחת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezzen egy profilt a porttovábbítások háttérben történő indításához. Az engedélyezett alagutak automatikusan elindulnak az alkalmazás indításakor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abiliti un profilo per avviare i port forward in background. I tunnel abilitati si avviano automaticamente all'apertura dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルを有効にして、バックグラウンドでポートフォワードを開始します。有効なトンネルはアプリ起動時に自動開始されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 활성화하여 백그라운드에서 포트 포워딩을 시작합니다. 활성화된 터널은 앱 실행 시 자동으로 시작됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver en profil for å starte portvideresendinger i bakgrunnen. Aktiverte tunneler starter automatisk når appen åpnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel een profiel in om de port forwards op de achtergrond te starten. Ingeschakelde tunnels starten automatisch wanneer de app wordt geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz profil, aby uruchomić przekierowania portów w tle. Włączone tunele uruchamiają się automatycznie przy starcie aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative um perfil para iniciar seus encaminhamentos de porta em segundo plano. Túneis ativados iniciam automaticamente quando o app é aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative um perfil para iniciar os seus reencaminhamentos de porta em segundo plano. Os túneis ativos iniciam automaticamente quando a aplicação é aberta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează un profil pentru a porni redirecționările de porturi în fundal. Tunelurile activate pornesc automat la lansarea aplicației."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogočite profil, da zažene svoja posredovanja vrat v ozadju. Omogočeni tuneli se samodejno zaženejo ob zagonu aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera en profil för att starta dess portvidarebefordringar i bakgrunden. Aktiverade tunnlar startar automatiskt när appen öppnas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть профіль, щоб запустити переспрямування портів у тлі. Увімкнені тунелі запускаються автоматично при відкритті застосунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật hồ sơ để khởi động chuyển tiếp cổng trong nền. Các đường hầm được bật sẽ tự khởi động khi ứng dụng mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用某个配置以在后台启动其端口转发。已启用的隧道会在应用启动时自动开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用設定檔以在背景啟動其連接埠轉發。已啟用的通道會在 App 啟動時自動開始。"
          }
        }
      }
    },
