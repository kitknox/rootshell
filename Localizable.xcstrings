    "No saved key matches this certificate. It certifies a %@ key with fingerprint %@. Import that key first." : {
      "comment" : "Cert import error: no matching key found",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏لا يطابق أي مفتاح محفوظ هذه الشهادة. فهي تُصادِق على مفتاح %1$@ ببصمة %2$@. استورد ذلك المفتاح أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap clau desada coincideix amb aquest certificat. Certifica una clau %1$@ amb empremta digital %2$@. Importeu primer aquesta clau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomuto certifikátu neodpovídá žádný uložený klíč. Certifikuje klíč typu %1$@ s otiskem %2$@. Nejprve tento klíč importujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen gemt nøgle matcher dette certifikat. Det certificerer en %1$@-nøgle med fingeraftrykket %2$@. Importer den nøgle først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein gespeicherter Schlüssel passt zu diesem Zertifikat. Es zertifiziert einen %1$@-Schlüssel mit dem Fingerabdruck %2$@. Importieren Sie zuerst diesen Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saved key matches this certificate. It certifies a %1$@ key with fingerprint %2$@. Import that key first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna clave guardada coincide con este certificado. Certifica una clave %1$@ con la huella digital %2$@. Importa primero esa clave."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään tallennettu avain ei vastaa tätä varmennetta. Se varmentaa %1$@-avaimen, jonka sormenjälki on %2$@. Tuo kyseinen avain ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé enregistrée ne correspond à ce certificat. Il certifie une clé %1$@ d'empreinte %2$@. Importez d'abord cette clé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף מפתח שמור אינו תואם לתעודה זו. היא מאשרת מפתח %1$@ עם טביעת אצבע %2$@. ייבא תחילה את אותו מפתח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyetlen mentett kulcs sem egyezik ezzel a tanúsítvánnyal. Egy %1$@ kulcsot hitelesít, amelynek ujjlenyomata %2$@. Először importálja azt a kulcsot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna chiave salvata corrisponde a questo certificato. Certifica una chiave %1$@ con impronta digitale %2$@. Importa prima quella chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この証明書に一致する保存済みのキーがありません。これはフィンガープリント %2$@ の %1$@ キーを証明しています。先にそのキーを読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 인증서와 일치하는 저장된 키가 없습니다. 이 인증서는 fingerprint가 %2$@인 %1$@ 키를 인증합니다. 먼저 해당 키를 가져오세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lagret nøkkel samsvarer med dette sertifikatet. Det sertifiserer en %1$@-nøkkel med fingeravtrykk %2$@. Importer den nøkkelen først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen bewaarde sleutel komt overeen met dit certificaat. Het certificeert een %1$@-sleutel met vingerafdruk %2$@. Importeer eerst die sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden zapisany klucz nie pasuje do tego certyfikatu. Certyfikuje on klucz %1$@ o odcisku %2$@. Najpierw zaimportuj ten klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave salva corresponde a este certificado. Ele certifica uma chave %1$@ com a impressão digital %2$@. Importe essa chave primeiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave guardada corresponde a este certificado. Ele certifica uma chave %1$@ com a impressão digital %2$@. Importe primeiro essa chave."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio cheie salvată nu corespunde acestui certificat. Acesta certifică o cheie %1$@ cu amprenta %2$@. Importați mai întâi acea cheie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem potrdilu ne ustreza noben shranjeni ključ. Overja ključ vrste %1$@ s prstnim odtisom %2$@. Najprej uvozite ta ključ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen sparad nyckel matchar det här certifikatet. Det certifierar en %1$@-nyckel med fingeravtrycket %2$@. Importera den nyckeln först."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоден зі збережених ключів не відповідає цьому сертифікату. Він засвідчує ключ типу %1$@ з відбитком %2$@. Спершу імпортуйте цей ключ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có khóa đã lưu nào khớp với chứng chỉ này. Nó chứng nhận một khóa %1$@ với dấu vân tay %2$@. Hãy nhập khóa đó trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已保存的密钥与此证书匹配。它认证的是一个指纹为 %2$@ 的 %1$@ 密钥。请先导入该密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有已儲存的金鑰符合此憑證。它認證的是指紋為 %2$@ 的 %1$@ 金鑰。請先匯入該金鑰。"
          }
        }
      }
    },
