    "This key will sync to all devices signed into your iCloud account. Make sure you trust all those devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم مزامنة هذا المفتاح مع جميع الأجهزة المسجلة بحساب iCloud الخاص بك. تأكد من أنك تثق بجميع تلك الأجهزة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta clau se sincronitzarà amb tots els dispositius connectats al vostre compte d'iCloud. Assegureu-vos que confieu en tots aquests dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento klíč se synchronizuje do všech zařízení přihlášených k vašemu účtu iCloud. Ujistěte se, že všem těmto zařízením důvěřujete."
