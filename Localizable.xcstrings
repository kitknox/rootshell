          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy ujjal jelölhet ki szöveget. Két ujjal görgethet. Hosszú nyomás a menühöz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dito per selezionare il testo. Due dita per scorrere. Pressione prolungata per il menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1本指でテキスト選択。2本指でスクロール。長押しでメニュー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 손가락으로 텍스트를 선택합니다. 두 손가락으로 스크롤합니다. 길게 눌러 메뉴를 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én finger velger tekst. To fingre for å rulle. Langt trykk for meny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén vinger selecteert tekst. Twee vingers om te scrollen. Houd ingedrukt voor het menu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden palec zaznacza tekst. Dwa palce do przewijania. Długie naciśnięcie otwiera menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dedo seleciona texto. Dois dedos para rolar. Toque longo para o menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dedo seleciona texto. Dois dedos para deslocar. Prima longamente para o menu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un deget pentru selectare text. Două degete pentru derulare. Apăsare lungă pentru meniu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En prst izbira besedilo. Dva prsta za drsenje. Dolg pritisk za meni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett finger markerar text. Två fingrar för att scrolla. Långtryck för meny."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виділення тексту одним пальцем. Прокрутка двома пальцями. Довге натискання для меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngón tay để chọn văn bản. Hai ngón tay để cuộn. Nhấn giữ để mở menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单指选择文本。双指滚动。长按打开菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單指選取文字。雙指捲動。長按開啟選單。"
          }
        }
      }
    },
