    "Appears on the OpenPGP key as `Name <email>` (what the remote shows when verifying signatures)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر على مفتاح OpenPGP بالشكل `Name <email>` (ما يعرضه الجهاز البعيد عند التحقق من التوقيعات)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apareix a la clau OpenPGP com a `Name <email>` (el que mostra el remot quan verifica signatures)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na klíči OpenPGP se zobrazí jako `Name <email>` (to, co ukáže vzdálený stroj při ověřování podpisů)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises på OpenPGP-nøglen som `Name <email>` (det, fjernsystemet viser, når det verificerer signaturer)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint auf dem OpenPGP-Schlüssel als `Name <email>` (das, was die Gegenstelle beim Prüfen von Signaturen anzeigt)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en la clave OpenPGP como `Name <email>` (lo que el remoto muestra al verificar firmas)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkyy OpenPGP-avaimessa muodossa `Name <email>` (mitä etäkone näyttää tarkistaessaan allekirjoituksia)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaît sur la clé OpenPGP sous la forme `Name <email>` (ce que la machine distante affiche lors de la vérification des signatures)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופיע במפתח ה-OpenPGP בתור `Name <email>` (מה שהמארח המרוחק מציג בעת אימות חתימות)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OpenPGP kulcson `Name <email>` formában jelenik meg (ezt mutatja a távoli gép az aláírások ellenőrzésekor)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare sulla chiave OpenPGP come `Name <email>` (ciò che il remoto mostra durante la verifica delle firme)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenPGPキーには`Name <email>`として表示されます(リモートが署名を検証する際に表示される内容)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenPGP 키에 `Name <email>` 형식으로 표시됩니다 (원격에서 서명을 확인할 때 보이는 내용)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises på OpenPGP-nøkkelen som `Name <email>` (det fjernverten viser ved verifisering av signaturer)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschijnt op de OpenPGP-sleutel als `Name <email>` (wat de externe host toont bij het verifiëren van handtekeningen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojawia się na kluczu OpenPGP jako `Name <email>` (to, co zdalny host wyświetla podczas weryfikacji podpisów)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece na chave OpenPGP como `Name <email>` (o que o remoto mostra ao verificar assinaturas)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece na chave OpenPGP como `Name <email>` (o que o remoto mostra ao verificar assinaturas)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apare pe cheia OpenPGP ca `Name <email>` (ceea ce afișează sistemul la distanță la verificarea semnăturilor)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ključu OpenPGP se prikaže kot `Name <email>` (kar oddaljeni gostitelj prikaže ob preverjanju podpisov)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas på OpenPGP-nyckeln som `Name <email>` (det som fjärren visar vid signaturverifiering)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відображається на ключі OpenPGP як `Name <email>` (те, що показує віддалена сторона під час перевірки підписів)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị trên khóa OpenPGP dưới dạng `Name <email>` (những gì máy từ xa hiển thị khi xác minh chữ ký)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OpenPGP 密钥上显示为 `Name <email>`（远程在验证签名时所显示的内容）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OpenPGP 金鑰上顯示為 `Name <email>`（遠端在驗證簽章時所顯示的內容）。"
          }
        }
      }
    },
