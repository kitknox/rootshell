            "value" : "~/.promptrc.toml דורס את ערכת הנושא שנבחרה למטה. הסר אותו כדי להשתמש בערכות נושא מההגדרות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ~/.promptrc.toml felülírja az alább kiválasztott témát. Távolítsa el a Beállítások témáinak használatához."
          }
        },
        "it" : {
