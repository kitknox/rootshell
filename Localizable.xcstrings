        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのホストではエージェントの保存済みサインイン情報を読み取れませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 호스트에서 에이전트의 저장된 로그인 정보를 읽을 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
