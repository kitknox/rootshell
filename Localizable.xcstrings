    "Customize the cursor and text-under-cursor colors. When disabled, the theme defaults are used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخصيص ألوان المؤشر والنص أسفل المؤشر. عند التعطيل، يتم استخدام الألوان الافتراضية للسمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalitza els colors del cursor i del text sota el cursor. Quan està desactivat, s'utilitzen els valors predeterminats del tema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobte barvy kurzoru a textu pod kurzorem. Při vypnutí se použijí výchozí hodnoty motivu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas markørens og tekst-under-markørens farver. Når deaktiveret, bruges temaets standardværdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor- und Text-unter-Cursor-Farben anpassen. Wenn deaktiviert, werden die Standardfarben des Designs verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza los colores del cursor y del texto bajo el cursor. Cuando está desactivado, se usan los colores predeterminados del tema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukauta kohdistimen ja kohdistimen alla olevan tekstin värejä. Kun pois käytöstä, käytetään teeman oletusarvoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnaliser les couleurs du curseur et du texte sous le curseur. Lorsque cette option est désactivée, les couleurs par défaut du thème sont utilisées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה אישית של צבעי הסמן והטקסט מתחת לסמן. כאשר מושבת, נעשה שימוש בברירות המחדל של ערכת הנושא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kurzor és a kurzor alatti szöveg színeinek testreszabása. Kikapcsolt állapotban a téma alapértékei érvényesek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizza i colori del cursore e del testo sotto il cursore. Se disattivato, vengono usati i colori predefiniti del tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルとカーソル下のテキストの色をカスタマイズします。無効にすると、テーマのデフォルトが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 및 커서 아래 텍스트의 색상을 사용자 지정합니다. 비활성화하면 테마 기본값이 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpass fargene for markøren og teksten under markøren. Når deaktivert, brukes temaets standardverdier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de kleuren van de cursor en de tekst onder de cursor aan. Wanneer uitgeschakeld, worden de standaardwaarden van het thema gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj kolory kursora i tekstu pod kursorem. Po wyłączeniu używane są domyślne wartości motywu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize as cores do cursor e do texto sob o cursor. Quando desativado, as cores padrão do tema são usadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize as cores do cursor e do texto sob o cursor. Quando desativado, são usadas as cores predefinidas do tema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizați culorile cursorului și ale textului de sub cursor. Când este dezactivat, se folosesc valorile implicite ale temei."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite barve kazalca in besedila pod kazalcem. Ko je onemogočeno, se uporabijo privzete vrednosti teme."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassa markörens och text-under-markörens färger. När inaktiverat används temats standardvärden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте кольори курсора та тексту під курсором. Коли вимкнено, використовуються стандартні кольори теми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chỉnh màu con trỏ và màu chữ dưới con trỏ. Khi tắt, màu mặc định của chủ đề sẽ được sử dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义光标和光标下方文本的颜色。禁用时将使用主题默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂游標和游標下方文字的顏色。停用時將使用主題預設值。"
          }
        }
      }
    },
