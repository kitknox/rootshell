    "Replace predicted cells instead of shifting content, preserving multiplexer borders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال الخلايا المتوقعة بدلاً من إزاحة المحتوى، مع الحفاظ على حدود مُعدِّد الجلسات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix les cel·les predites en lloc de desplaçar el contingut, i conserva les vores del multiplexor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradí predikované buňky místo posouvání obsahu a zachová okraje multiplexeru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatter forudsagte celler i stedet for at forskyde indholdet, så multiplexerens kanter bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt vorhergesagte Zellen, statt Inhalt zu verschieben, und erhält so die Ränder des Multiplexers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
