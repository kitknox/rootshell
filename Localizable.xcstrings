    "Launched for every new local tab. Arguments are supported, and the line is parsed by a shell, so a path containing spaces has to be quoted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغَّل مع كل علامة تبويب محلية جديدة. الوسائط مدعومة، ويُحلَّل السطر بواسطة صدفة، لذا يجب وضع أي مسار يحتوي على مسافات بين علامتي اقتباس."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'inicia per a cada nova pestanya local. S'admeten arguments i la línia s'analitza amb un shell, així que un camí amb espais s'ha d'escriure entre cometes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí se pro každou novou místní kartu. Argumenty jsou podporovány a řádek zpracovává shell, takže cestu obsahující mezery je nutné uvést v uvozovkách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startes for hver ny lokal fane. Argumenter understøttes, og linjen fortolkes af en shell, så en sti med mellemrum skal sættes i anførselstegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für jeden neuen lokalen Tab gestartet. Argumente werden unterstützt, und die Zeile wird von einer Shell ausgewertet, daher muss ein Pfad mit Leerzeichen in Anführungszeichen stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lanza en cada nueva pestaña local. Se admiten argumentos y la línea la analiza una shell, así que una ruta con espacios debe ir entre comillas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistetään jokaista uutta paikallista välilehteä varten. Argumentit ovat tuettuja, ja komentotulkki jäsentää rivin, joten välilyöntejä sisältävä polku on kirjoitettava lainausmerkkeihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancé pour chaque nouvel onglet local. Les arguments sont pris en charge et la ligne est analysée par un shell : un chemin contenant des espaces doit donc être entre guillemets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופעל עבור כל לשונית מקומית חדשה. יש תמיכה בארגומנטים, והשורה מנותחת על ידי מעטפת, ולכן נתיב שמכיל רווחים חייב להיות במירכאות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden új helyi lapnál elindul. Az argumentumok támogatottak, és a sort egy shell dolgozza fel, ezért a szóközt tartalmazó elérési utat idézőjelbe kell tenni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviato per ogni nuova scheda locale. Gli argomenti sono supportati e la riga viene interpretata da una shell, quindi un percorso che contiene spazi va racchiuso tra virgolette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいローカルタブごとに起動されます。引数を指定でき、行はシェルによって解析されるため、スペースを含むパスは引用符で囲む必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 로컬 탭마다 실행됩니다. 인수를 사용할 수 있으며 이 줄은 셸이 해석하므로 공백이 포함된 경로는 따옴표로 감싸야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startes for hver ny lokal fane. Argumenter støttes, og linjen tolkes av et skall, så en sti som inneholder mellomrom må stå i anførselstegn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gestart voor elk nieuw lokaal tabblad. Argumenten worden ondersteund en de regel wordt door een shell verwerkt, dus een pad met spaties moet tussen aanhalingstekens staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamiane dla każdej nowej karty lokalnej. Argumenty są obsługiwane, a wiersz jest przetwarzany przez powłokę, więc ścieżkę ze spacjami trzeba ująć w cudzysłów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciado a cada nova aba local. Argumentos são aceitos e a linha é interpretada por um shell, portanto um caminho com espaços precisa estar entre aspas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciado em cada novo separador local. Os argumentos são suportados e a linha é interpretada por uma shell, por isso um caminho com espaços tem de estar entre aspas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lansează pentru fiecare filă locală nouă. Argumentele sunt acceptate, iar linia este interpretată de un shell, așa că o cale care conține spații trebuie pusă între ghilimele."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zažene se za vsak nov lokalni zavihek. Argumenti so podprti, vrstico pa razčleni lupina, zato mora biti pot s presledki v narekovajih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startas för varje ny lokal flik. Argument stöds och raden tolkas av ett skal, så en sökväg som innehåller mellanslag måste stå inom citattecken."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускається для кожної нової локальної вкладки. Аргументи підтримуються, а рядок обробляє оболонка, тому шлях із пробілами потрібно взяти в лапки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được khởi chạy cho mỗi tab cục bộ mới. Hỗ trợ đối số, và dòng lệnh được một shell phân tích, nên đường dẫn có khoảng trắng phải được đặt trong dấu ngoặc kép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次新建本地标签页时启动。支持参数，且该行由 Shell 解析，因此包含空格的路径必须加引号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次新增本機分頁時啟動。支援參數，且該行由 Shell 解析，因此包含空格的路徑必須加上引號。"
          }
        }
      }
    },
