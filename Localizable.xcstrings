            "value" : "Được gửi dưới dạng TERM. Để trống sẽ kế thừa từ Cài đặt > Terminal > Loại terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作为 TERM 发送。留空则继承“设置 > 终端 > 终端类型”中的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
