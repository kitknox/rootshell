    "Returns saved connection profiles, optionally filtered by folder, tag, protocol, or name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد ملفات الاتصال الشخصية المحفوظة، مع إمكانية تصفيتها حسب المجلد أو الوسم أو البروتوكول أو الاسم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna els perfils de connexió desats, opcionalment filtrats per carpeta, etiqueta, protocol o nom."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrátí uložené profily připojení, volitelně filtrované podle složky, štítku, protokolu nebo názvu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returnerer gemte forbindelsesprofiler, eventuelt filtreret efter mappe, tag, protokol eller navn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
