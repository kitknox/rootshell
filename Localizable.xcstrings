          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en la clave OpenPGP como `Name <email>` y es lo que el remoto mostrará al verificar firmas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkyy OpenPGP-avaimessa muodossa `Name <email>` ja on se, mitä etäkone näyttää tarkistaessaan allekirjoituksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaît sur la clé OpenPGP sous la forme `Name <email>` et c'est ce que la machine distante affichera lors de la vérification des signatures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופיע במפתח ה-OpenPGP בתור `Name <email>` ומה שהמארח המרוחק יציג בעת אימות חתימות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OpenPGP kulcson `Name <email>` formában jelenik meg, és ezt mutatja majd a távoli gép az aláírások ellenőrzésekor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare sulla chiave OpenPGP come `Name <email>` ed è ciò che il remoto mostrerà durante la verifica delle firme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenPGPキーには`Name <email>`として表示され、リモートが署名を検証する際に表示される内容になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenPGP 키에 `Name <email>` 형식으로 표시되며, 원격에서 서명을 확인할 때 보이는 내용입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises på OpenPGP-nøkkelen som `Name <email>` og er det fjernverten viser ved verifisering av signaturer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschijnt op de OpenPGP-sleutel als `Name <email>` en is wat de externe host toont bij het verifiëren van handtekeningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojawia się na kluczu OpenPGP jako `Name <email>` i jest tym, co zdalny host wyświetli podczas weryfikacji podpisów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece na chave OpenPGP como `Name <email>` e é o que o remoto exibirá ao verificar assinaturas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece na chave OpenPGP como `Name <email>` e é o que o remoto irá apresentar ao verificar assinaturas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apare pe cheia OpenPGP ca `Name <email>` și este ceea ce va afișa sistemul la distanță la verificarea semnăturilor."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ključu OpenPGP se prikaže kot `Name <email>` in je tisto, kar bo oddaljeni gostitelj prikazal ob preverjanju podpisov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas på OpenPGP-nyckeln som `Name <email>` och är det som fjärren visar vid signaturverifiering."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відображається на ключі OpenPGP як `Name <email>` і саме це показуватиме віддалена сторона під час перевірки підписів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị trên khóa OpenPGP dưới dạng `Name <email>` và là những gì máy từ xa sẽ hiển thị khi xác minh chữ ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OpenPGP 密钥上显示为 `Name <email>`，也是远程在验证签名时显示的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OpenPGP 金鑰上顯示為 `Name <email>`，也是遠端在驗證簽章時顯示的內容。"
          }
        }
      }
