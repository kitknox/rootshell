    "Cloud providers enable quick connect autocomplete for your VMs and kubeconfig import for Kubernetes clusters." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح مزودو الخدمات السحابية الإكمال التلقائي للاتصال السريع بأجهزتك الافتراضية واستيراد kubeconfig لعناقيد Kubernetes."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els proveïdors de núvol permeten l'autocompleció de connexió ràpida per a les vostres VM i la importació de kubeconfig per a clústers de Kubernetes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytovatelé cloudu umožňují automatické doplňování rychlého připojení pro vaše VM a import kubeconfig pro clustery Kubernetes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud-udbydere aktiverer hurtig forbindelses-autofuldførelse for dine VM'er og kubeconfig-import for Kubernetes-klynger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud-Anbieter ermöglichen die Schnellverbindungs-Autovervollständigung für Ihre VMs und den Kubeconfig-Import für Kubernetes-Cluster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proveedores de cloud permiten el autocompletado de conexión rápida para sus VMs y la importación de kubeconfig para clústeres de Kubernetes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilvipalvelut mahdollistavat pikayhteyden automaattisen täydennyksen virtuaalikoneillesi ja kubeconfig-tuonnin Kubernetes-klustereille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fournisseurs cloud activent l'autocomplétion de connexion rapide pour vos VM et l'importation de kubeconfig pour les clusters Kubernetes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספקי ענן מאפשרים השלמה אוטומטית של חיבור מהיר למכונות הווירטואליות שלך וייבוא kubeconfig לאשכולות Kubernetes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felhőszolgáltatók lehetővé teszik a gyors csatlakozás automatikus kiegészítését a virtuális gépekhez és a kubeconfig importálását Kubernetes klaszterekhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I provider cloud abilitano il completamento automatico della connessione rapida per le VM e l'importazione di kubeconfig per i cluster Kubernetes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドプロバイダを設定すると、VMへのクイック接続の自動補完やKubernetesクラスタのkubeconfigインポートが有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 공급자를 설정하면 VM 빠른 연결 자동 완성 및 Kubernetes 클러스터 kubeconfig 가져오기를 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyleverandører aktiverer hurtigkobling med autofullføring for dine VM-er og kubeconfig-import for Kubernetes-klynger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudproviders maken automatisch aanvullen bij snel verbinden mogelijk voor uw VM's en kubeconfig-import voor Kubernetes-clusters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawcy chmury umożliwiają autouzupełnianie szybkiego połączenia dla Twoich maszyn wirtualnych oraz import kubeconfig dla klastrów Kubernetes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provedores de cloud habilitam o autocompletar de conexão rápida para suas VMs e importação de kubeconfig para clusters Kubernetes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os fornecedores de cloud permitem o preenchimento automático de ligação rápida para as suas VMs e a importação de kubeconfig para clusters Kubernetes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furnizorii cloud activează autocompletarea conexiunii rapide pentru VM-urile dvs. și importul kubeconfig pentru clusterele Kubernetes."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponudniki oblaka omogočajo samodejno dokončanje hitre povezave za vaše navidezne stroje in uvoz kubeconfig za gruče Kubernetes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molnleverantörer aktiverar snabbanslutning med autokomplettering för dina virtuella maskiner och kubeconfig-import för Kubernetes-kluster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хмарні провайдери забезпечують автодоповнення швидкого з'єднання для ваших ВМ та імпорт kubeconfig для кластерів Kubernetes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nhà cung cấp Cloud cho phép tự động hoàn thành kết nối nhanh cho máy ảo và nhập kubeconfig cho các cụm Kubernetes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云供应商支持虚拟机的快速连接自动补全和 Kubernetes 集群的 kubeconfig 导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲端供應商支援虛擬機器的快速連線自動完成和 Kubernetes 叢集的 kubeconfig 匯入。"
          }
        }
      }
    },
