    "From %@. Recent scrollback will be transferred and the original tab will close once attached." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من %@. سيتم نقل سجل التمرير الأخير، وسيتم إغلاق علامة التبويب الأصلية بمجرد الإرفاق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des de %@. Es transferirà l’historial recent i la pestanya original es tancarà un cop establerta la connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od %@. Nedávná historie výpisu se přenese a původní karta se po připojení zavře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra %@. Den seneste rullehistorik bliver overført, og det oprindelige faneblad lukker, når forbindelsen er oprettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von %@. Der jüngste Verlauf wird übertragen und der ursprüngliche Tab wird geschlossen, sobald die Verbindung hergestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde %@. Se transferirá el historial reciente y la pestaña original se cerrará una vez conectada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähteestä %@. Viimeisin vierityshistoria siirretään, ja alkuperäinen välilehti sulkeutuu, kun yhteys on muodostettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis %@. L’historique récent sera transféré et l’onglet d’origine se fermera une fois la connexion établie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאת %@. היסטוריית הגלילה האחרונה תועבר, והכרטיסייה המקורית תיסגר לאחר ההתחברות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forrás: %@. A legutóbbi visszagörgetési előzmények átkerülnek, és az eredeti lap a csatlakozás után bezárul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da %@. La cronologia recente verrà trasferita e il pannello originale si chiuderà una volta stabilita la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@から。最近のスクロールバックが転送され、接続が完了すると元のタブが閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 전송됨. 최근 스크롤백이 전송되며 연결이 완료되면 원본 탭이 닫힙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra %@. Den nyeste rullehistorikken blir overført, og den opprinnelige fanen lukkes når tilkoblingen er opprettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van %@. De recente scrollback wordt overgedragen en het oorspronkelijke tabblad wordt gesloten zodra de verbinding tot stand is gebracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z %@. Ostatnia historia przewijania zostanie przeniesiona, a pierwotna karta zamknie się po połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %@. O histórico recente será transferido e a aba original será fechada após a conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %@. O histórico recente será transferido e o separador original será fechado após a ligação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la %@. Istoricul recent va fi transferat, iar fila originală se va închide după conectare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iz %@. Nedavna zgodovina pomikanja bo prenesena, izvirni zavihek pa se bo po priklopu zaprl."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från %@. Den senaste rullningshistoriken överförs och den ursprungliga fliken stängs när anslutningen är upprättad."
