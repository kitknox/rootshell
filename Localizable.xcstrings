        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו חשבון AWS בהגדרות ← חיבורים ← ספקי ענן, ואז חזרו לכאן כדי לקשר אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
