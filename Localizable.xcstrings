    "The server will prompt for credentials, such as a one-time code. Used for 2FA/OTP and PAM logins." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب الخادم بيانات الاعتماد، مثل رمز لمرة واحدة. يُستخدم لتسجيل الدخول عبر 2FA/OTP وPAM."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor sol·licitarà credencials, com ara un codi d'un sol ús. S'utilitza per a inicis de sessió amb 2FA/OTP i PAM."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server si vyžádá přihlašovací údaje, například jednorázový kód. Používá se pro přihlášení 2FA/OTP a PAM."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren beder om legitimationsoplysninger, f.eks. en engangskode. Bruges til 2FA/OTP- og PAM-logins."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server fragt nach Anmeldedaten, etwa einem Einmalcode. Wird für 2FA/OTP- und PAM-Anmeldungen verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor solicitará credenciales, como un código de un solo uso. Se utiliza para inicios de sesión con 2FA/OTP y PAM."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin pyytää tunnistautumistietoja, kuten kertakäyttökoodia. Käytetään 2FA/OTP- ja PAM-kirjautumisissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur demandera des identifiants, comme un code à usage unique. Utilisé pour les connexions 2FA/OTP et PAM."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת יבקש אישורי כניסה, כגון קוד חד-פעמי. משמש לכניסות 2FA/OTP ו-PAM."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver hitelesítő adatokat fog kérni, például egyszer használatos kódot. 2FA/OTP és PAM bejelentkezésekhez használatos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server richiederà le credenziali, come un codice monouso. Usato per accessi 2FA/OTP e PAM."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがワンタイムコードなどの認証情報の入力を求めます。2FA/OTPおよびPAMログインに使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 일회용 코드와 같은 자격 증명을 요청합니다. 2FA/OTP 및 PAM 로그인에 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
