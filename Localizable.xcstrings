            "value" : "Wysyłane jako TERM. Puste pole dziedziczy z Ustawienia > Terminal > Typ terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado como TERM. Vazio herda de Configurações > Terminal > Tipo de Terminal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado como TERM. Se vazio, herda de Definições > Terminal > Tipo de Terminal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimis ca TERM. Dacă este gol, moștenește din Setări > Terminal > Tip de terminal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslano kot TERM. Prazno polje podeduje vrednost iz Nastavitve > Terminal > Vrsta terminala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickas som TERM. Tomt ärver från Inställningar > Terminal > Terminaltyp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилається як TERM. Порожнє поле успадковується з Налаштування > Термінал > Тип термінала."
          }
        },
        "vi" : {
          "stringUnit" : {
