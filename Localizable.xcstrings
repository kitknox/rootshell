        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם מפתח כבר קיים ב-%@, הוא יוחלף לצמיתות. המפתח הפרטי יעבור מאחסון תוכנה לחומרת ה-YubiKey שלך."
