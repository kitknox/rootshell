            "state" : "translated",
            "value" : "`{HOME}` ו-`{UID}` נפתרים בזמן ההתחברות באמצעות `id -u` / `$HOME` במארח המרוחק."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A `{HOME}` és `{UID}` értékek a csatlakozás idején a távoli gépen futtatott `id -u` / `$HOME` segítségével kerülnek feloldásra."
          }
        },
        "it" : {
          "stringUnit" : {
