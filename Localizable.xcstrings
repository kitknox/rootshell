        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor MCP permite que ferramentas de IA como Claude Code, Codex e Gemini CLI executem comandos SSH e acedam a recursos na nuvem. Novas ligações requerem a sua aprovação."
