    "Turn on Detect Coding Agents in Terminal settings to enable agent notifications." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل «اكتشاف وكلاء البرمجة» في إعدادات الطرفية لتمكين إشعارات الوكلاء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Detecta els agents de codi» als ajustos del terminal per habilitar les notificacions d'agents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte „Detekovat agenty pro kódování“ v nastavení terminálu, aby fungovala oznámení agentů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå »Registrer kodeagenter« til i terminalindstillingerne for at aktivere agentnotifikationer."
