    "Shaders always animate, even when unfocused. Highest CPU usage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المظللات تعمل دائمًا حتى عند عدم التركيز. أعلى استخدام للمعالج."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els shaders s'animen sempre, fins i tot sense el focus. Ús màxim de CPU."
