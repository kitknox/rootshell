    "FIDO2 keys require physical touch for each signing operation." : {
      "comment" : "External security-key result security explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفاتيح FIDO2 تتطلب لمساً فعلياً لكل عملية توقيع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus FIDO2 requereixen un toc físic per a cada operació de signatura."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíče FIDO2 vyžadují fyzický dotyk pro každou operaci podepisování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2-nøgler kræver fysisk berøring ved hver signeringshandling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2-Schlüssel erfordern für jeden Signiervorgang eine physische Berührung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves FIDO2 requieren contacto físico para cada operación de firma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2-avaimet vaativat fyysisen kosketuksen jokaista allekirjoitusoperaatiota varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés FIDO2 nécessitent un contact physique pour chaque opération de signature."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות FIDO2 דורשים מגע פיזי עבור כל פעולת חתימה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FIDO2-kulcsok minden aláírási művelethez fizikai érintést igényelnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi FIDO2 richiedono il tocco fisico per ogni operazione di firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2キーは署名操作ごとに物理タッチが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2 키는 각 서명 작업마다 물리적 터치가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
