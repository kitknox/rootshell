    "Optionally load keybinds from an external ghostty config file. The imported file lives at %@, can be edited in place, and your in-app customizations still take priority." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك اختياريًا تحميل اختصارات المفاتيح من ملف إعدادات Ghostty خارجي. يوجد الملف المُستورَد في %@، ويمكن تعديله في مكانه، وتظل تخصيصاتك داخل التطبيق ذات الأولوية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalment, carregueu les combinacions de tecles des d'un fitxer de configuració extern de ghostty. El fitxer importat es troba a %@, es pot editar directament, i les vostres personalitzacions dins l'aplicació mantenen la prioritat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volitelně načtěte klávesové zkratky z externího konfiguračního souboru ghostty. Importovaný soubor se nachází v %@, lze jej upravit přímo a vaše přizpůsobení v aplikaci mají i nadále přednost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlæs valgfrit tastbindinger fra en ekstern ghostty-konfigurationsfil. Den importerede fil findes i %@, kan redigeres direkte, og dine tilpasninger i appen har stadig prioritet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional können Tastenbelegungen aus einer externen Ghostty-Konfigurationsdatei geladen werden. Die importierte Datei befindet sich unter %@, kann direkt bearbeitet werden, und Ihre In-App-Anpassungen haben weiterhin Vorrang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalmente, cargue combinaciones de teclas desde un archivo de configuración externo de ghostty. El archivo importado se encuentra en %@, puede editarse directamente, y sus personalizaciones en la aplicación mantienen la prioridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa halutessasi näppäinsidokset ulkoisesta ghostty-asetustiedostosta. Tuotu tiedosto sijaitsee kohteessa %@, sitä voi muokata paikallaan, ja sovelluksen sisäiset mukautukset ovat edelleen etusijalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargez éventuellement des raccourcis clavier depuis un fichier de configuration Ghostty externe. Le fichier importé se trouve dans %@, peut être modifié sur place, et vos personnalisations dans l'app conservent la priorité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לטעון קיצורי מקשים מקובץ תצורה חיצוני של Ghostty. הקובץ המיובא נמצא ב-%@, ניתן לעריכה במקום, וההתאמות האישיות שלך באפליקציה עדיין מקבלות עדיפות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionálisan töltsön be billentyűkiosztásokat egy külső ghostty konfigurációs fájlból. Az importált fájl a következő helyen található: %@, helyben szerkeszthető, és az alkalmazáson belüli testreszabások továbbra is elsőbbséget élveznek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica opzionalmente le associazioni tasti da un file di configurazione ghostty esterno. Il file importato si trova in %@, può essere modificato direttamente e le tue personalizzazioni nell'app mantengono la priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部のGhostty設定ファイルからキーバインドを読み込むことができます。読み込まれたファイルは %@ にあり、その場で編集でき、アプリ内のカスタマイズは引き続き優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 ghostty 설정 파일에서 키 바인딩을 선택적으로 불러올 수 있습니다. 가져온 파일은 %@에 있으며, 그 자리에서 편집할 수 있고 앱 내 사용자 정의는 계속 우선합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last valgfritt tastaturbindinger fra en ekstern Ghostty-konfigurasjonsfil. Den importerte filen finnes i %@, kan redigeres på stedet, og tilpasningene dine i appen har fortsatt prioritet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laad optioneel sneltoetsen vanuit een extern Ghostty-configuratiebestand. Het geïmporteerde bestand bevindt zich in %@, kan direct worden bewerkt, en uw aanpassingen in de app blijven voorrang hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie wczytaj skróty klawiszowe z zewnętrznego pliku konfiguracyjnego ghostty. Zaimportowany plik znajduje się w %@, można go edytować w miejscu, a ustawienia w aplikacji nadal mają priorytet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalmente carregue atalhos de teclado de um arquivo de configuração ghostty externo. O arquivo importado fica em %@, pode ser editado no lugar, e suas personalizações no app continuam tendo prioridade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalmente, carregue atalhos de teclado de um ficheiro de configuração ghostty externo. O ficheiro importado encontra-se em %@, pode ser editado no local, e as suas personalizações na aplicação mantêm a prioridade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțional, încărcați asocieri de taste dintr-un fișier de configurare Ghostty extern. Fișierul importat se află la %@, poate fi editat la fața locului, iar personalizările din aplicație păstrează în continuare prioritatea."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po želji naložite bližnjice tipk iz zunanje konfiguracijske datoteke Ghostty. Uvožena datoteka se nahaja v %@, lahko jo urejate neposredno, vaše prilagoditve v aplikaciji pa ohranijo prednost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda valfritt tangentbindningar från en extern ghostty-konfigurationsfil. Den importerade filen finns i %@, kan redigeras direkt, och dina anpassningar i appen har fortfarande företräde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За бажанням завантажте прив'язки клавіш із зовнішнього файлу конфігурації ghostty. Імпортований файл знаходиться в %@, його можна редагувати на місці, а ваші налаштування в застосунку залишаються пріоритетними."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn tải phím tắt từ tệp cấu hình Ghostty bên ngoài. Tệp đã nhập nằm tại %@, có thể chỉnh sửa trực tiếp và các tùy chỉnh trong ứng dụng vẫn có mức ưu tiên cao nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选择从外部 ghostty 配置文件加载快捷键绑定。已导入的文件位于 %@，可以直接编辑，您在应用内的自定义设置仍然优先。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可選擇從外部 ghostty 設定檔載入快速鍵綁定。已匯入的檔案位於 %@,可直接編輯,您在應用程式內的自訂設定仍然優先。"
          }
        }
      }
    },
