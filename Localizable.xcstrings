    "VPN is not compatible with biometric-protected keys. Use a key without biometric auth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN غير متوافق مع المفاتيح المحمية بالمقاييس الحيوية. استخدم مفتاحاً بدون مصادقة بيومترية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VPN no és compatible amb claus protegides biomètricament. Utilitzeu una clau sense autenticació biomètrica."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN není kompatibilní s biometricky chráněnými klíči. Použijte klíč bez biometrického ověřování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN er ikke kompatibel med biometrisk beskyttede nøgler. Brug en nøgle uden biometrisk godkendelse."
