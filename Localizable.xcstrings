    "-A enables forwarding of your saved keys to the remote host" : {
      "comment" : "SSH help: agent forwarding description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A يُفعّل إعادة توجيه مفاتيحك المحفوظة إلى المضيف البعيد"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A habilita el reenviament de les vostres claus desades a l'amfitrió remot"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A povolí přesměrování uložených klíčů na vzdálený hostitel"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A aktiverer videresendelse af dine gemte nøgler til den eksterne vært"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A aktiviert die Weiterleitung Ihrer gespeicherten Schlüssel an den Remote-Host"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A habilita el reenvío de tus claves guardadas al host remoto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A mahdollistaa tallennettujen avainten välityksen etäkoneelle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A active le transfert de vos clés enregistrées vers l'hôte distant"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A מאפשר העברת המפתחות השמורים שלך למחשב המרוחק"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A engedélyezi a mentett kulcsok továbbítását a távoli gépre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A abilita l'inoltro delle chiavi salvate all'host remoto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A は保存済みの鍵をリモートホストに転送します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A는 저장된 키를 원격 호스트로 전달합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A aktiverer videresending av dine lagrede nøkler til den eksterne verten"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A schakelt het doorsturen van je opgeslagen sleutels naar de externe host in"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A włącza przekazywanie zapisanych kluczy do zdalnego hosta"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A ativa o encaminhamento das suas chaves salvas para o host remoto"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A ativa o reencaminhamento das suas chaves guardadas para o host remoto"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A activează redirecționarea cheilor salvate către hostul de la distanță"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A omogoči posredovanje vaših shranjenih ključev na oddaljeni gostitelj"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A aktiverar vidarebefordran av dina sparade nycklar till fjärrvärden"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A вмикає перенаправлення ваших збережених ключів на віддалений хост"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A cho phép chuyển tiếp các khóa đã lưu của bạn đến máy chủ từ xa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A 启用将已保存的密钥转发到远程主机"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-A 啟用將已儲存的金鑰轉發到遠端主機"
          }
        }
      }
    },
