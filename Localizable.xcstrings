        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本機匯入的 MMDB 檔案。IP 位址不會離開裝置。您可以匯入多個 ASN/國家資料庫，應用程式會合併找到的欄位。"
          }
        }
      }
    },
    "Uses netcat. May not work with strict firewalls (wrong source port)." : {
      "comment" : "Hole-punch server method description: netcat",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم netcat. قد لا يعمل مع جدران الحماية الصارمة (منفذ مصدر خاطئ)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
