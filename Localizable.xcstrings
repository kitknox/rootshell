    "Screen contents are encrypted by the VNC protocol layer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتويات الشاشة مشفّرة بواسطة طبقة بروتوكول VNC."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contingut de la pantalla es xifra a la capa del protocol VNC."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsah obrazovky je šifrován protokolovou vrstvou VNC."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmindholdet krypteres af VNC-protokollaget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildschirminhalte werden durch die VNC-Protokollschicht verschlüsselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de la pantalla se cifra en la capa del protocolo VNC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytön sisältö salataan VNC-protokollakerroksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de l'écran est chiffré par la couche de protocole VNC."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכן המסך מוצפן על ידי שכבת פרוטוקול VNC."
          }
        },
        "hu" : {
          "stringUnit" : {
