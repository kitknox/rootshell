    "Enables seamless handover between WiFi and cellular. Falls back to regular TCP when unavailable. The server must also support MPTCP." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح الانتقال السلس بين WiFi والبيانات الخلوية. يعود إلى TCP العادي عند عدم التوفر. يجب أن يدعم الخادم أيضاً MPTCP."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet una transició fluida entre WiFi i dades mòbils. Retorna a TCP normal quan no està disponible. El servidor també ha de ser compatible amb MPTCP."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje plynulý přechod mezi WiFi a mobilními daty. Přepne na běžné TCP, pokud není dostupné. Server musí také podporovat MPTCP."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muliggør problemfri skift mellem WiFi og mobildata. Falder tilbage til almindelig TCP, når det ikke er tilgængeligt. Serveren skal også understøtte MPTCP."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht nahtloses Umschalten zwischen WLAN und Mobilfunk. Fällt auf normales TCP zurück, wenn nicht verfügbar. Der Server muss ebenfalls MPTCP unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la transición fluida entre WiFi y datos móviles. Recurre a TCP estándar cuando no está disponible. El servidor también debe ser compatible con MPTCP."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahdollistaa saumattoman vaihdon WiFin ja mobiiliverkon välillä. Palaa tavalliseen TCP:hen, jos ei ole käytettävissä. Palvelimen täytyy myös tukea MPTCP:tä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet un basculement transparent entre Wi-Fi et cellulaire. Revient au TCP standard si indisponible. Le serveur doit également prendre en charge MPTCP."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר מעבר חלק בין WiFi לסלולר. חוזר ל-TCP רגיל כשלא זמין. השרת חייב לתמוך גם ב-MPTCP."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zökkenőmentes átváltást tesz lehetővé WiFi és mobilhálózat között. Nem elérhetőség esetén sima TCP-re vált vissza. A kiszolgálónak is támogatnia kell az MPTCP-t."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente il passaggio trasparente tra WiFi e rete cellulare. Utilizza TCP standard quando non disponibile. Anche il server deve supportare MPTCP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFiとモバイル通信間のシームレスな切り替えを有効にします。利用できない場合は通常のTCPにフォールバックします。サーバーもMPTCPに対応している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFi와 셀룰러 간의 원활한 전환을 지원합니다. 사용할 수 없는 경우 일반 TCP로 대체됩니다. 서버도 MPTCP를 지원해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muliggjør sømløs overgang mellom WiFi og mobilnett. Faller tilbake til vanlig TCP når utilgjengelig. Tjeneren må også støtte MPTCP."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt naadloze overdracht tussen wifi en mobiel netwerk mogelijk. Valt terug op gewone TCP indien niet beschikbaar. De server moet ook MPTCP ondersteunen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umożliwia płynne przełączanie między WiFi a siecią komórkową. W razie niedostępności wraca do zwykłego TCP. Serwer również musi obsługiwać MPTCP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite transição contínua entre WiFi e rede celular. Retorna ao TCP normal quando indisponível. O servidor também deve suportar MPTCP."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite transição contínua entre WiFi e dados móveis. Recorre a TCP normal quando indisponível. O servidor também tem de suportar MPTCP."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite trecerea fără întreruperi între WiFi și rețeaua mobilă. Revine la TCP standard când nu este disponibil. Serverul trebuie să suporte și MPTCP."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoča nemoten preklop med WiFi in mobilnim omrežjem. Ob nedostopnosti se vrne na navaden TCP. Strežnik mora prav tako podpirati MPTCP."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möjliggör sömlös övergång mellan WiFi och mobilnät. Faller tillbaka till vanlig TCP när det inte är tillgängligt. Servern måste också stödja MPTCP."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забезпечує безперебійне перемикання між Wi-Fi та мобільною мережею. За недоступності повертається до звичайного TCP. Сервер також повинен підтримувати MPTCP."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép chuyển đổi liền mạch giữa WiFi và mạng di động. Dự phòng sang TCP thông thường khi không khả dụng. Máy chủ cũng phải hỗ trợ MPTCP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 WiFi 和蜂窝网络之间的无缝切换。不可用时回退到常规 TCP。服务器也必须支持 MPTCP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用 WiFi 與行動網路之間的無縫切換。無法使用時回退到一般 TCP。伺服器也必須支援 MPTCP。"
          }
        }
      }
    },
