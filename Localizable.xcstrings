        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã bắt đầu nhập liệu. Vẫn đính kèm vào \"%1$@\"? Thao tác này sẽ gửi lệnh %2$@ đến terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已经开始输入。仍要连接到“%1$@”吗？这将向终端发送一个 %2$@ 命令。"
