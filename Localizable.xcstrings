    "Tap to restore a hidden key to the drawer. Swipe left on a custom key to delete it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لاستعادة مفتاح مخفي إلى الدرج. اسحب لليسار على مفتاح مخصص لحذفه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca per restaurar una tecla oculta al calaix. Llisca cap a l'esquerra sobre una tecla personalitzada per eliminar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím obnovíte skrytou klávesu do zásuvky. Přejetím doleva na vlastní klávesu ji smažete."
