    "Once strings are added, toggle redaction anywhere with ⌃⌘R (customizable), or from the View menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إضافة السلاسل، يمكنك تبديل الحجب من أي مكان باستخدام ⌃⌘R (قابل للتخصيص)، أو من قائمة عرض."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cop afegides les cadenes, podeu activar o desactivar l'emmascarament des de qualsevol lloc amb ⌃⌘R (personalitzable) o des del menú Visualització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile přidáte řetězce, můžete maskování kdekoli přepnout zkratkou ⌃⌘R (lze změnit) nebo v nabídce Zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når der er tilføjet strenge, kan du slå maskeringen til og fra overalt med ⌃⌘R (kan tilpasses) eller via menuen Visning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald Zeichenketten hinzugefügt wurden, können Sie die Schwärzung überall mit ⌃⌘R (anpassbar) oder über das Menü „Darstellung“ umschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez añadidas las cadenas, puedes activar o desactivar la ocultación en cualquier parte con ⌃⌘R (personalizable) o desde el menú Visualización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun merkkijonoja on lisätty, voit vaihtaa peittoa missä tahansa näppäimillä ⌃⌘R (mukautettavissa) tai Näytä-valikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois des chaînes ajoutées, activez ou désactivez le masquage n'importe où avec ⌃⌘R (personnalisable) ou depuis le menu Présentation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר הוספת מחרוזות, ניתן להפעיל ולכבות את ההסתרה מכל מקום באמצעות ⌃⌘R (ניתן להתאמה), או מתפריט \"תצוגה\"."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha már vannak hozzáadott karakterláncok, a kitakarás bárhol be- és kikapcsolható a ⌃⌘R billentyűkombinációval (testreszabható) vagy a Nézet menüből."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver aggiunto le stringhe, attiva o disattiva l'oscuramento ovunque con ⌃⌘R (personalizzabile) o dal menu Vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字列を追加すると、どこでも ⌃⌘R（変更可能）または「表示」メニューからマスクを切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자열을 추가하면 어디서나 ⌃⌘R(사용자 지정 가능)로 또는 보기 메뉴에서 가리기를 전환할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når strenger er lagt til, kan du slå sladdingen av og på hvor som helst med ⌃⌘R (kan tilpasses), eller fra Vis-menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra er tekenreeksen zijn toegevoegd, schakelt u het afschermen overal in of uit met ⌃⌘R (aanpasbaar) of via het menu Weergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dodaniu ciągów maskowanie można przełączyć w dowolnym miejscu skrótem ⌃⌘R (można go zmienić) lub z menu Widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de adicionar strings, alterne a ocultação em qualquer lugar com ⌃⌘R (personalizável) ou pelo menu Visualizar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de adicionar cadeias, pode alternar a ocultação em qualquer parte da app com ⌃⌘R (personalizável) ou a partir do menu Visualização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După adăugarea șirurilor, comută mascarea de oriunde cu ⌃⌘R (personalizabil) sau din meniul Vizualizare."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko so nizi dodani, lahko prekrivanje kjer koli preklopite z ⌃⌘R (prilagodljivo) ali iz menija Pogled."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När strängar har lagts till kan du växla maskering var som helst med ⌃⌘R (kan anpassas) eller från Visa-menyn."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли рядки додано, вмикайте та вимикайте маскування будь-де за допомогою ⌃⌘R (можна змінити) або через меню «Вигляд»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi thêm chuỗi, bạn có thể bật/tắt việc che ở bất kỳ đâu bằng ⌃⌘R (có thể tùy chỉnh), hoặc từ menu Xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加字符串后，可在任意位置使用 ⌃⌘R（可自定义）或通过“显示”菜单切换遮蔽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入字串後，即可隨時使用 ⌃⌘R（可自訂）或從「顯示方式」選單切換遮蔽。"
          }
        }
      }
    },
