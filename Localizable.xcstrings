        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel wurde auf einem anderen Gerät konfiguriert. Wählen Sie oben einen lokalen Schlüssel aus, oder verbinden Sie sich – Sie werden aufgefordert, einen gerätespezifischen Schlüssel zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave fue configurada en otro dispositivo. Seleccione una clave local arriba, o conéctese — se le pedirá que elija una clave específica del dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä avain on määritetty toisella laitteella. Valitse paikallinen avain yllä tai yhdistä — sinua pyydetään valitsemaan laitekohtainen avain."
