    "hping3 requires raw socket access to set the correct source port. Alternatives: nping (from nmap) or scapy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب hping3 الوصول إلى مقبس خام لتعيين منفذ المصدر الصحيح. البدائل: nping (من nmap) أو scapy."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hping3 requereix accés a sòcols en brut per establir el port d'origen correcte. Alternatives: nping (de nmap) o scapy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hping3 vyžaduje přístup k raw socketu pro nastavení správného zdrojového portu. Alternativy: nping (z nmap) nebo scapy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hping3 kræver raw socket-adgang for at sætte den korrekte kildeport. Alternativer: nping (fra nmap) eller scapy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hping3 benötigt Raw-Socket-Zugriff, um den korrekten Quellport zu setzen. Alternativen: nping (aus nmap) oder scapy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hping3 requiere acceso a sockets raw para establecer el puerto de origen correcto. Alternativas: nping (de nmap) o scapy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hping3 vaatii raw socket -pääsyn oikean lähdeportin asettamiseksi. Vaihtoehdot: nping (nmapista) tai scapy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
