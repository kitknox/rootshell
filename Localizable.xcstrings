    "Lower values produce more focused responses. Higher values produce more varied, creative responses." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم المنخفضة تنتج استجابات أكثر تركيزًا. القيم المرتفعة تنتج استجابات أكثر تنوعًا وإبداعًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valors més baixos produeixen respostes més enfocades. Valors més alts produeixen respostes més variades i creatives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižší hodnoty produkují více zaměřené odpovědi. Vyšší hodnoty produkují rozmanitější a kreativnější odpovědi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere værdier giver mere fokuserede svar. Højere værdier giver mere varierede, kreative svar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigere Werte erzeugen fokussiertere Antworten. Höhere Werte erzeugen vielfältigere, kreativere Antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más bajos producen respuestas más enfocadas. Los valores más altos producen respuestas más variadas y creativas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matalammat arvot tuottavat tarkemmin kohdennettuja vastauksia. Korkeammat arvot tuottavat monipuolisempia ja luovempia vastauksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs basses produisent des réponses plus ciblées. Des valeurs élevées produisent des réponses plus variées et créatives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים נמוכים מייצרים תגובות ממוקדות יותר. ערכים גבוהים מייצרים תגובות מגוונות ויצירתיות יותר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alacsonyabb értékek fókuszáltabb válaszokat eredményeznek. A magasabb értékek változatosabb, kreatívabb válaszokat produkálnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori più bassi producono risposte più mirate. Valori più alti producono risposte più varie e creative."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低い値ほど集中した応答になります。高い値ほど多様で創造的な応答になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮은 값일수록 집중된 응답을 생성합니다. 높은 값일수록 다양하고 창의적인 응답을 생성합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere verdier gir mer fokuserte svar. Høyere verdier gir mer varierte, kreative svar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagere waarden produceren meer gerichte antwoorden. Hogere waarden produceren meer gevarieerde, creatieve antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niższe wartości dają bardziej ukierunkowane odpowiedzi. Wyższe wartości dają bardziej zróżnicowane, kreatywne odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais baixos produzem respostas mais focadas. Valores mais altos produzem respostas mais variadas e criativas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais baixos produzem respostas mais focadas. Valores mais altos produzem respostas mais variadas e criativas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorile mici produc răspunsuri mai concentrate. Valorile mari produc răspunsuri mai variate și creative."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižje vrednosti ustvarijo bolj osredotočene odgovore. Višje vrednosti ustvarijo bolj raznolike, ustvarjalne odgovore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägre värden ger mer fokuserade svar. Högre värden ger mer varierade, kreativa svar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижчі значення дають більш точні відповіді. Вищі значення дають більш різноманітні та творчі відповіді."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị thấp hơn tạo ra phản hồi tập trung hơn. Giá trị cao hơn tạo ra phản hồi đa dạng và sáng tạo hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较低的值产生更集中的回答。较高的值产生更多样化、更有创意的回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較低的值會產生更集中的回應。較高的值會產生更多樣化、更有創意的回應。"
          }
        }
      }
    },
    "Lower values produce more focused responses. Higher values produce more varied, creative responses. Note: Temperature is ignored when extended thinking is enabled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم المنخفضة تنتج استجابات أكثر تركيزًا. القيم المرتفعة تنتج استجابات أكثر تنوعًا وإبداعًا. ملاحظة: يتم تجاهل درجة الحرارة عند تفعيل التفكير الموسّع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valors més baixos produeixen respostes més enfocades. Valors més alts produeixen respostes més variades i creatives. Nota: la temperatura s'ignora quan el pensament estès està activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižší hodnoty produkují více zaměřené odpovědi. Vyšší hodnoty produkují rozmanitější a kreativnější odpovědi. Poznámka: Teplota je ignorována při zapnutém rozšířeném myšlení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere værdier giver mere fokuserede svar. Højere værdier giver mere varierede, kreative svar. Bemærk: Temperatur ignoreres, når udvidet tænkning er aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigere Werte erzeugen fokussiertere Antworten. Höhere Werte erzeugen vielfältigere, kreativere Antworten. Hinweis: Die Temperatur wird ignoriert, wenn erweitertes Denken aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más bajos producen respuestas más enfocadas. Los valores más altos producen respuestas más variadas y creativas. Nota: La temperatura se ignora cuando el pensamiento extendido está activado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matalammat arvot tuottavat tarkemmin kohdennettuja vastauksia. Korkeammat arvot tuottavat monipuolisempia ja luovempia vastauksia. Huom: Temperature-arvo ohitetaan, kun laajennettu ajattelu on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs basses produisent des réponses plus ciblées. Des valeurs élevées produisent des réponses plus variées et créatives. Remarque : la température est ignorée lorsque la réflexion étendue est activée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים נמוכים מייצרים תגובות ממוקדות יותר. ערכים גבוהים מייצרים תגובות מגוונות ויצירתיות יותר. הערה: Temperature מתעלם כאשר חשיבה מורחבת מופעלת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alacsonyabb értékek fókuszáltabb válaszokat eredményeznek. A magasabb értékek változatosabb, kreatívabb válaszokat produkálnak. Megjegyzés: A hőmérséklet figyelmen kívül marad, ha a kiterjesztett gondolkodás engedélyezve van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori più bassi producono risposte più mirate. Valori più alti producono risposte più varie e creative. Nota: la temperatura viene ignorata quando il pensiero esteso è attivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低い値ほど集中した応答になります。高い値ほど多様で創造的な応答になります。注: 拡張思考が有効な場合、Temperatureは無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮은 값일수록 집중된 응답을 생성합니다. 높은 값일수록 다양하고 창의적인 응답을 생성합니다. 참고: 확장 사고가 활성화되면 Temperature가 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere verdier gir mer fokuserte svar. Høyere verdier gir mer varierte, kreative svar. Merk: Temperatur ignoreres når utvidet tenkning er aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagere waarden produceren meer gerichte antwoorden. Hogere waarden produceren meer gevarieerde, creatieve antwoorden. Opmerking: Temperature wordt genegeerd wanneer uitgebreid denken is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niższe wartości dają bardziej ukierunkowane odpowiedzi. Wyższe wartości dają bardziej zróżnicowane, kreatywne odpowiedzi. Uwaga: Temperatura jest ignorowana, gdy włączono rozszerzone myślenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais baixos produzem respostas mais focadas. Valores mais altos produzem respostas mais variadas e criativas. Nota: A temperatura é ignorada quando o pensamento estendido está ativado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais baixos produzem respostas mais focadas. Valores mais altos produzem respostas mais variadas e criativas. Nota: A temperatura é ignorada quando o pensamento alargado está ativado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorile mici produc răspunsuri mai concentrate. Valorile mari produc răspunsuri mai variate și creative. Notă: temperatura este ignorată când gândirea extinsă este activată."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižje vrednosti ustvarijo bolj osredotočene odgovore. Višje vrednosti ustvarijo bolj raznolike, ustvarjalne odgovore. Opomba: Temperatura se prezre, ko je omogočeno razširjeno razmišljanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägre värden ger mer fokuserade svar. Högre värden ger mer varierade, kreativa svar. Obs: Temperatur ignoreras när utökat tänkande är aktiverat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижчі значення дають більш точні відповіді. Вищі значення дають більш різноманітні та творчі відповіді. Примітка: температура ігнорується, коли увімкнено розширене мислення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị thấp hơn tạo ra phản hồi tập trung hơn. Giá trị cao hơn tạo ra phản hồi đa dạng và sáng tạo hơn. Lưu ý: Nhiệt độ bị bỏ qua khi bật tư duy mở rộng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较低的值产生更集中的回答。较高的值产生更多样化、更有创意的回答。注意：启用扩展思维时，温度参数会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較低的值會產生更集中的回應。較高的值會產生更多樣化、更有創意的回應。注意：啟用延伸思考時，溫度參數會被忽略。"
          }
        }
      }
    },
    "Lower values produce more focused responses. Higher values produce more varied, creative responses. OpenRouter normalizes this across different models." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم المنخفضة تنتج استجابات أكثر تركيزًا. القيم المرتفعة تنتج استجابات أكثر تنوعًا وإبداعًا. يقوم OpenRouter بتوحيد هذا عبر النماذج المختلفة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valors més baixos produeixen respostes més enfocades. Valors més alts produeixen respostes més variades i creatives. OpenRouter normalitza això entre diferents models."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižší hodnoty produkují více zaměřené odpovědi. Vyšší hodnoty produkují rozmanitější a kreativnější odpovědi. OpenRouter toto normalizuje napříč různými modely."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere værdier giver mere fokuserede svar. Højere værdier giver mere varierede, kreative svar. OpenRouter normaliserer dette på tværs af forskellige modeller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigere Werte erzeugen fokussiertere Antworten. Höhere Werte erzeugen vielfältigere, kreativere Antworten. OpenRouter normalisiert dies über verschiedene Modelle hinweg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más bajos producen respuestas más enfocadas. Los valores más altos producen respuestas más variadas y creativas. OpenRouter normaliza esto entre diferentes modelos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matalammat arvot tuottavat tarkemmin kohdennettuja vastauksia. Korkeammat arvot tuottavat monipuolisempia ja luovempia vastauksia. OpenRouter normalisoi tämän eri mallien välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs basses produisent des réponses plus ciblées. Des valeurs élevées produisent des réponses plus variées et créatives. OpenRouter normalise ce paramètre entre les différents modèles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים נמוכים מייצרים תגובות ממוקדות יותר. ערכים גבוהים מייצרים תגובות מגוונות ויצירתיות יותר. OpenRouter מנרמל זאת בין מודלים שונים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alacsonyabb értékek fókuszáltabb válaszokat eredményeznek. A magasabb értékek változatosabb, kreatívabb válaszokat produkálnak. Az OpenRouter ezt normalizálja a különböző modellek között."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori più bassi producono risposte più mirate. Valori più alti producono risposte più varie e creative. OpenRouter normalizza questo valore tra i diversi modelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低い値ほど集中した応答になります。高い値ほど多様で創造的な応答になります。OpenRouterはこの値を異なるモデル間で正規化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮은 값일수록 집중된 응답을 생성합니다. 높은 값일수록 다양하고 창의적인 응답을 생성합니다. OpenRouter는 다양한 모델에 걸쳐 이 값을 정규화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere verdier gir mer fokuserte svar. Høyere verdier gir mer varierte, kreative svar. OpenRouter normaliserer dette på tvers av ulike modeller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagere waarden produceren meer gerichte antwoorden. Hogere waarden produceren meer gevarieerde, creatieve antwoorden. OpenRouter normaliseert dit over verschillende modellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niższe wartości dają bardziej ukierunkowane odpowiedzi. Wyższe wartości dają bardziej zróżnicowane, kreatywne odpowiedzi. OpenRouter normalizuje tę wartość pomiędzy różnymi modelami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais baixos produzem respostas mais focadas. Valores mais altos produzem respostas mais variadas e criativas. O OpenRouter normaliza isso entre diferentes modelos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais baixos produzem respostas mais focadas. Valores mais altos produzem respostas mais variadas e criativas. O OpenRouter normaliza isto entre diferentes modelos."
          }
        },
        "ro" : {
          "stringUnit" : {
