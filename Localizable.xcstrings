          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có kết nối được chuyển tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有转发的连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有轉送的連線。"
          }
        }
      }
    },
    "No geolocation lookups will be performed. IP addresses will be shown without network information." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتم إجراء أي عمليات بحث عن الموقع الجغرافي. ستُعرض عناوين IP بدون معلومات الشبكة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es realitzarà cap cerca de geolocalització. Les adreces IP es mostraran sense informació de xarxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledávání geolokace nebude prováděno. IP adresy budou zobrazeny bez informací o síti."
          }
