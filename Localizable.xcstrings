    "Info Only mode requires at least WiFi Info or Network Info to be enabled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب وضع \"المعلومات فقط\" تفعيل معلومات WiFi أو معلومات الشبكة على الأقل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
