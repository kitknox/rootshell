          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래의 공개 키를 서버의 authorized_keys 파일에 추가하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til den offentlige nøkkelen nedenfor i serverens authorized_keys-fil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de onderstaande publieke sleutel toe aan het authorized_keys-bestand van uw server."
          }
        },
        "pl" : {
          "stringUnit" : {
