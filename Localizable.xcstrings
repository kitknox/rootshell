          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi từ shell sẽ được áp dụng bằng nút Tải lại tại đây hoặc chạy reloadconfig trong shell cục bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Shell 中的编辑可通过此处的重新加载按钮或在本地 shell 中运行 reloadconfig 来应用。"
