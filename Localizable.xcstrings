        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá bash /dev/udp. Nejpřenosnější, ale používá nesprávný zdrojový port (pouze IPv4)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger bash /dev/udp. Mest bærbar, men bruger forkert kildeport (kun IPv4)."
