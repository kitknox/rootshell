    "Show the active group or project switcher in the top tab bar while tabs are grouped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار مبدّل المجموعة أو المشروع النشط في شريط علامات التبويب العلوي أثناء تجميع علامات التبويب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra el selector de grup o projecte actiu a la barra de pestanyes superior mentre les pestanyes estiguin agrupades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit v horním panelu karet přepínač aktivní skupiny nebo projektu, když jsou karty seskupené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis skifteren til aktiv gruppe eller aktivt projekt i den øverste fanelinje, når faner er grupperet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Umschalter für die aktive Gruppe oder das aktive Projekt in der oberen Tab-Leiste an, solange Tabs gruppiert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el selector de grupo o proyecto activo en la barra de pestañas superior mientras las pestañas están agrupadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä aktiivisen ryhmän tai projektin vaihtaja ylävälilehtipalkissa, kun välilehdet on ryhmitelty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le sélecteur de groupe ou de projet actif dans la barre d'onglets supérieure lorsque les onglets sont groupés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג את מחליף הקבוצה או הפרויקט הפעיל בסרגל הלשוניות העליון כאשר הלשוניות מקובצות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az aktív csoport vagy projekt váltójának megjelenítése a felső lapsávon, amíg a lapok csoportosítva vannak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il selettore del gruppo o del progetto attivo nella barra delle schede superiore quando le schede sono raggruppate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブをグループ化しているときに、上部のタブバーにアクティブなグループまたはプロジェクトの切り替えを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭이 그룹화되어 있을 때 상단 탭 바에 활성 그룹 또는 프로젝트 전환기를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis veksleren for aktiv gruppe eller aktivt prosjekt i den øverste fanelinjen når faner er gruppert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de kiezer voor de actieve groep of het actieve project in de bovenste tabbalk wanneer tabbladen zijn gegroepeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje przełącznik aktywnej grupy lub projektu na górnym pasku kart, gdy karty są pogrupowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o alternador de grupo ou projeto ativo na barra de abas superior enquanto as abas estiverem agrupadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o seletor de grupo ou projeto ativo na barra de separadores superior enquanto os separadores estiverem agrupados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează comutatorul de grup sau de proiect activ în bara de file de sus, cât timp filele sunt grupate."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže preklopnik aktivne skupine ali projekta v zgornji vrstici zavihkov, ko so zavihki združeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa växlaren för aktiv grupp eller aktivt projekt i det övre flikfältet när flikarna är grupperade."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати перемикач активної групи або проєкту у верхній панелі вкладок, коли вкладки згруповано."
          }
        },
        "vi" : {
