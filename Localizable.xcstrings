    "Too long or contains a control character. Clean macOS zsh will be used." : {
      "comment" : "Local shell warning: illegal characters use fallback",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طويل جدًا أو يحتوي على حرف تحكم. سيتم استخدام zsh نظيفة من macOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massa llarg o conté un caràcter de control. S'utilitzarà la zsh neta de macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš dlouhé nebo obsahuje řídicí znak. Použije se čistý macOS zsh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For langt eller indeholder et kontroltegn. Den rene macOS-zsh bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu lang oder enthält ein Steuerzeichen. Es wird die unveränderte macOS-zsh verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado largo o contiene un carácter de control. Se usará la zsh limpia de macOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian pitkä tai sisältää ohjausmerkin. Käytetään puhdasta macOS:n zsh:ta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop long ou contient un caractère de contrôle. Le zsh macOS d'origine sera utilisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ארוך מדי או מכיל תו בקרה. תשמש zsh הנקייה של macOS."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl hosszú, vagy vezérlőkaraktert tartalmaz. A tiszta macOS zsh lesz használva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo lungo o contiene un carattere di controllo. Verrà usata la zsh pulita di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長すぎるか、制御文字が含まれています。クリーンな macOS の zsh が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 길거나 제어 문자가 포함되어 있습니다. 기본 macOS zsh가 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For langt eller inneholder et kontrolltegn. Det rene macOS-zsh brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lang of bevat een stuurteken. De schone macOS-zsh wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt długie lub zawiera znak sterujący. Zostanie użyta czysta powłoka zsh z macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longo demais ou contém um caractere de controle. O zsh limpo do macOS será usado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado longo ou contém um carácter de controlo. Será usada a zsh limpa do macOS."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea lung sau conține un caracter de control. Se va folosi zsh-ul curat din macOS."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predolgo ali vsebuje kontrolni znak. Uporabljena bo čista lupina zsh iz macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För långt eller innehåller ett kontrolltecken. Ren macOS-zsh används."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
