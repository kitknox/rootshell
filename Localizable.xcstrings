    "Port forwards stop when the app is suspended. Enable Location Diary (Auto mode) in Privacy settings, or use iPad Split View." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف توجيه المنافذ عند تعليق التطبيق. قم بتفعيل سجل المواقع (الوضع التلقائي) في إعدادات الخصوصية، أو استخدم العرض المقسّم على iPad."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les redireccions de ports s'aturen quan l'app se suspèn. Activa el Diari d'ubicació (mode Auto) als ajustos de Privadesa, o fes servir Split View a l'iPad."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesměrování portů se zastaví, když je aplikace pozastavena. Povolte Deník polohy (automatický režim) v nastavení soukromí nebo použijte iPad Split View."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portviderestillinger stopper, når appen suspenderes. Aktivér Stedsdagbog (Autotilstand) i Anonymitetsindstillinger, eller brug iPad Split View."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portweiterleitungen werden unterbrochen, wenn die App ausgesetzt wird. Aktiviere das Standorttagebuch (Automodus) in den Datenschutzeinstellungen oder verwende iPad Split View."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los reenvíos de puertos se detienen cuando la app se suspende. Activa el Diario de ubicación (modo Auto) en los ajustes de Privacidad, o usa Split View en el iPad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porttiohjaukset pysähtyvät, kun sovellus keskeytetään. Ota Sijaintipäiväkirja (automaattitila) käyttöön Tietosuoja-asetuksissa tai käytä iPadin Split View -näkymää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les redirections de ports s'arrêtent lorsque l'app est suspendue. Activez le Journal de localisation (mode Auto) dans les réglages de Confidentialité, ou utilisez le mode Split View de l'iPad."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העברות יציאות מפסיקות כשהאפליקציה מושהית. הפעל את יומן המיקומים (מצב אוטומטי) בהגדרות הפרטיות, או השתמש בתצוגה מפוצלת ב-iPad."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porttovábbítások leállnak, amikor az alkalmazás felfüggesztésre kerül. Engedélyezze a Helyszínnaplót (Automatikus mód) az Adatvédelem beállításaiban, vagy használja az iPad Split View funkciót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli inoltri di porta si interrompono quando l'app è sospesa. Attiva il Diario posizioni (modalità Auto) nelle impostazioni di Privacy oppure usa Split View su iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが一時停止するとポートフォワードが停止します。プライバシー設定で位置情報の日記（自動モード）を有効にするか、iPadのSplit Viewを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 일시 중지되면 포트 포워드가 중단됩니다. 개인정보 보호 설정에서 위치 기록(자동 모드)을 활성화하거나 iPad Split View를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portvideresendinger stopper når appen suspenderes. Aktiver Stedsdagbok (Automodus) i Personverninnstillinger, eller bruk iPad Split View."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poortweiterleidingen stoppen wanneer de app wordt onderbroken. Schakel Locatiedagboek (Automatische modus) in bij Privacy-instellingen, of gebruik iPad Split View."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekierowania portów zatrzymują się, gdy aplikacja jest wstrzymana. Włącz Dziennik lokalizacji (tryb automatyczny) w ustawieniach prywatności lub użyj trybu Split View na iPadzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os redirecionamentos de porta param quando o app é suspenso. Ative o Diário de Localização (modo Automático) nas configurações de Privacidade ou use o Split View do iPad."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os reencaminhamentos de porta param quando a app é suspensa. Ative o Diário de Localização (modo Automático) nas definições de Privacidade ou use o Split View do iPad."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redirecționările de porturi se opresc când aplicația este suspendată. Activați Jurnalul de locații (modul Automat) în setările de Confidențialitate sau folosiți Split View pe iPad."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posredovanje vrat se ustavi, ko je aplikacija zaustavljena. Omogočite Dnevnik lokacije (samodejni način) v nastavitvah zasebnosti ali uporabite iPad Split View."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portvidarebefordringar stoppas när appen pausas. Aktivera Platsdagbok (Autoläge) i Integritetsinställningar, eller använd iPad Split View."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переспрямування портів зупиняється, коли застосунок призупинено. Увімкніть Щоденник розташування (автоматичний режим) у налаштуваннях конфіденційності або використовуйте iPad Split View."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển tiếp cổng dừng khi ứng dụng bị tạm ngưng. Bật Nhật ký vị trí (chế độ Tự động) trong cài đặt Quyền riêng tư, hoặc sử dụng Split View trên iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用被挂起时端口转发会停止。请在隐私设置中启用位置日记（自动模式），或使用 iPad 分屏浏览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 暫停時連接埠轉送會中斷。請在隱私權設定中啟用「定位日記」（自動模式），或使用 iPad 分割顯示。"
          }
        }
      }
    },
