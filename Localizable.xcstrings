    "Encrypted with AES-256-GCM using a key derived via PBKDF2-HMAC-SHA256 (600,000 iterations). There is no way to recover data if you forget this password." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشفر بـ AES-256-GCM باستخدام مفتاح مشتق عبر PBKDF2-HMAC-SHA256 (600,000 تكرار). لا توجد طريقة لاستعادة البيانات إذا نسيت كلمة المرور هذه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xifrat amb AES-256-GCM mitjançant una clau derivada per PBKDF2-HMAC-SHA256 (600.000 iteracions). No hi ha manera de recuperar les dades si oblideu aquesta contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrováno pomocí AES-256-GCM s klíčem odvozeným přes PBKDF2-HMAC-SHA256 (600 000 iterací). Data nelze obnovit, pokud toto heslo zapomenete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypteret med AES-256-GCM med en nøgle afledt via PBKDF2-HMAC-SHA256 (600.000 iterationer). Der er ingen måde at gendanne data, hvis du glemmer denne adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselt mit AES-256-GCM unter Verwendung eines über PBKDF2-HMAC-SHA256 (600.000 Iterationen) abgeleiteten Schlüssels. Bei Verlust des Passworts können die Daten nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado con AES-256-GCM usando una clave derivada mediante PBKDF2-HMAC-SHA256 (600 000 iteraciones). No hay forma de recuperar los datos si olvidas esta contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salattu AES-256-GCM:llä käyttäen PBKDF2-HMAC-SHA256-avainjohdannaisella (600 000 iteraatiota). Tietoja ei voi palauttaa, jos unohdat tämän salasanan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffré avec AES-256-GCM à l'aide d'une clé dérivée par PBKDF2-HMAC-SHA256 (600 000 itérations). Il est impossible de récupérer les données si vous oubliez ce mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצפן באמצעות AES-256-GCM עם מפתח שנגזר דרך PBKDF2-HMAC-SHA256 (600,000 איטרציות). אין דרך לשחזר נתונים אם תשכח סיסמה זו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256-GCM titkosítás PBKDF2-HMAC-SHA256 származtatott kulccsal (600 000 iteráció). A jelszó elfelejtése esetén az adatok nem állíthatók vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crittografato con AES-256-GCM usando una chiave derivata tramite PBKDF2-HMAC-SHA256 (600.000 iterazioni). Non è possibile recuperare i dati se dimentichi questa password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PBKDF2-HMAC-SHA256（600,000回反復）で導出された鍵を使用してAES-256-GCMで暗号化されます。このパスワードを忘れた場合、データを復元する方法はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PBKDF2-HMAC-SHA256(600,000회 반복)으로 파생된 키를 사용하여 AES-256-GCM으로 암호화됩니다. 이 비밀번호를 잊어버리면 데이터를 복구할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryptert med AES-256-GCM med en nøkkel utledet via PBKDF2-HMAC-SHA256 (600 000 iterasjoner). Det er ingen måte å gjenopprette data hvis du glemmer dette passordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versleuteld met AES-256-GCM met een sleutel afgeleid via PBKDF2-HMAC-SHA256 (600.000 iteraties). Er is geen manier om gegevens te herstellen als u dit wachtwoord vergeet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaszyfrowane AES-256-GCM z kluczem uzyskanym przez PBKDF2-HMAC-SHA256 (600 000 iteracji). Nie ma możliwości odzyskania danych w przypadku utraty hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografado com AES-256-GCM usando uma chave derivada via PBKDF2-HMAC-SHA256 (600.000 iterações). Não há como recuperar os dados se você esquecer esta senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encriptado com AES-256-GCM utilizando uma chave derivada via PBKDF2-HMAC-SHA256 (600.000 iterações). Não é possível recuperar os dados se esquecer esta palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptat cu AES-256-GCM folosind o cheie derivată prin PBKDF2-HMAC-SHA256 (600.000 iterații). Nu există nicio modalitate de a recupera datele dacă uitați această parolă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrirano z AES-256-GCM s ključem, izpeljanim prek PBKDF2-HMAC-SHA256 (600.000 iteracij). Podatkov ni mogoče obnoviti, če pozabite geslo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterad med AES-256-GCM med en nyckel härledd via PBKDF2-HMAC-SHA256 (600 000 iterationer). Det finns inget sätt att återställa data om du glömmer detta lösenord."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зашифровано AES-256-GCM з ключем, отриманим через PBKDF2-HMAC-SHA256 (600 000 ітерацій). Відновити дані неможливо, якщо ви забудете пароль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được mã hóa bằng AES-256-GCM với khóa được tạo qua PBKDF2-HMAC-SHA256 (600.000 lần lặp). Không có cách khôi phục dữ liệu nếu bạn quên mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用通过 PBKDF2-HMAC-SHA256（600,000 次迭代）派生的密钥进行 AES-256-GCM 加密。如果忘记此密码，将无法恢复数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用透過 PBKDF2-HMAC-SHA256（600,000 次迭代）衍生的金鑰以 AES-256-GCM 加密。若您忘記此密碼，將無法恢復資料。"
          }
        }
      }
    },
