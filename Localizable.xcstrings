    "Kubeconfig files are stored securely in the system Keychain. Cluster health is checked on-demand when viewing cluster details." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزّن ملفات Kubeconfig بأمان في سلسلة مفاتيح النظام. يتم فحص سلامة المجموعة عند الطلب عند عرض تفاصيل المجموعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els fitxers Kubeconfig s'emmagatzemen de forma segura al Keychain del sistema. L'estat de salut del clúster es comprova sota demanda en visualitzar els detalls del clúster."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory Kubeconfig jsou bezpečně uloženy v systémové Klíčence. Stav clusteru se kontroluje na vyžádání při zobrazení podrobností clusteru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig-filer opbevares sikkert i systemets nøglering. Klyngesundhed kontrolleres efter behov, når klyngedetaljer vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig-Dateien werden sicher im System-Schlüsselbund gespeichert. Der Cluster-Zustand wird bei Bedarf beim Anzeigen der Clusterdetails überprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos Kubeconfig se almacenan de forma segura en el llavero del sistema. El estado de salud del clúster se verifica bajo demanda al ver los detalles del clúster."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig-tiedostot tallennetaan turvallisesti järjestelmän avainnippuun. Klusterin terveydentila tarkistetaan tarvittaessa klusterin tietoja tarkasteltaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers Kubeconfig sont stockés de manière sécurisée dans le trousseau système. L'état du cluster est vérifié à la demande lors de la consultation des détails du cluster."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבצי Kubeconfig מאוחסנים בצורה מאובטחת ב-Keychain של המערכת. תקינות האשכול נבדקת לפי דרישה בעת צפייה בפרטי האשכול."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kubeconfig fájlok biztonságosan a rendszer Keychainben vannak tárolva. A klaszter állapotát igény szerint ellenőrzi a rendszer a klaszter részleteinek megtekintésekor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file kubeconfig sono memorizzati in modo sicuro nel Portachiavi di sistema. L'integrità del cluster viene verificata su richiesta durante la visualizzazione dei dettagli del cluster."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfigファイルはシステムキーチェーンに安全に保存されます。クラスタのヘルスステータスはクラスタ詳細の表示時にオンデマンドで確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig 파일은 시스템 키체인에 안전하게 저장됩니다. cluster 상태는 cluster 세부 정보를 볼 때 확인됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig-filer lagres sikkert i systemets nøkkelring. Klyngehelse sjekkes ved behov når du viser klyngedetaljer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig-bestanden worden veilig opgeslagen in de systeemsleutelhanger. De clustergezondheid wordt op aanvraag gecontroleerd bij het bekijken van clusterdetails."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki Kubeconfig są bezpiecznie przechowywane w systemowym Keychain. Kondycja klastra jest sprawdzana na żądanie podczas przeglądania szczegółów klastra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos kubeconfig são armazenados com segurança no Keychain do sistema. A saúde do cluster é verificada sob demanda ao visualizar os detalhes do cluster."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros kubeconfig são armazenados em segurança no Porta-chaves do sistema. O estado do cluster é verificado a pedido ao visualizar os detalhes do cluster."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierele Kubeconfig sunt stocate securizat în Keychain-ul sistemului. Starea de sănătate a clusterului este verificată la cerere când vizualizați detaliile clusterului."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig datoteke so varno shranjene v sistemskem Keychainu. Stanje gruče se preverja na zahtevo ob ogledu podrobnosti gruče."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig-filer lagras säkert i systemets nyckelring. Klusterhälsa kontrolleras vid behov när klusterdetaljer visas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файли Kubeconfig надійно зберігаються в системному Keychain. Справність кластера перевіряється на вимогу при перегляді деталей кластера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp Kubeconfig được lưu trữ an toàn trong Keychain hệ thống. Tình trạng cụm được kiểm tra theo yêu cầu khi xem chi tiết cụm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig 文件安全存储在系统钥匙串中。查看集群详情时按需检查集群健康状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubeconfig 檔案安全儲存在系統鑰匙圈中。檢視叢集詳細資訊時會按需檢查叢集健康狀態。"
          }
        }
      }
    },
