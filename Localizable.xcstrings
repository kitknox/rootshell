    "\nEncrypted keys with passphrases are supported" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nالمفاتيح المشفرة بعبارات مرور مدعومة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nEs permet l'ús de claus xifrades amb frases de contrasenya"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nŠifrované klíče s heslovými frázemi jsou podporovány"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKrypterede nøgler med adgangskoder understøttes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\\nVerschlüsselte Schlüssel mit Passphrasen werden unterstützt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSe admiten claves cifradas con frases de contraseña"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSalasanalla suojatut salatut avaimet ovat tuettuja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes clés chiffrées avec des phrases de passe sont prises en charge"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nמפתחות מוצפנים עם ביטויי סיסמה נתמכים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nA jelszóval titkosított kulcsok támogatottak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSono supportate le chiavi crittografate con passphrase"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nパスフレーズ付きの暗号化キーに対応しています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n암호문이 있는 암호화된 키를 지원합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKrypterte nøkler med passord støttes"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVersleutelde sleutels met wachtwoordzinnen worden ondersteund"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nObsługiwane są zaszyfrowane klucze z hasłami"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nChaves criptografadas com frases-senha são suportadas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nChaves encriptadas com frases-passe são suportadas"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCheile criptate cu fraze de acces sunt acceptate"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nŠifrirani ključi z gesli so podprti"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKrypterade nycklar med lösenfraser stöds"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nПідтримуються зашифровані ключі з паролями"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCác khóa được mã hóa bằng cụm mật khẩu được hỗ trợ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n支持使用密码短语的加密密钥"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n支援使用密碼短語的加密金鑰"
          }
        }
      }
    },
