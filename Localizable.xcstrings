    "The specified locale will be sent as LANG to remote servers. Make sure the locale is installed on the server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إرسال اللغة المحلية المحددة كـ LANG إلى الخوادم البعيدة. تأكد من أن اللغة المحلية مثبتة على الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració regional especificada s'enviarà com a LANG als servidors remots. Assegureu-vos que la configuració regional estigui instal·lada al servidor."
          }
        },
        "cs" : {
