    "Container Shell runs /bin/sh directly in the debug pod. Host filesystem is accessible at /host." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُشغّل صدفة الحاوية /bin/sh مباشرة في حاوية التصحيح. يمكن الوصول إلى نظام ملفات المضيف عبر /host."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intèrpret d'ordres del contenidor executa /bin/sh directament al pod de depuració. El sistema de fitxers de l'amfitrió és accessible a /host."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell kontejneru spouští /bin/sh přímo v debug podu. Souborový systém hostitele je přístupný na /host."
