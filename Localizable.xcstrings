    "Runs a command on a saved profile's host over SSH and returns the output. For long-running or interactive commands, use Open Connection Profile with a command instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل أمراً على مضيف ملف شخصي محفوظ عبر SSH ويعيد الإخراج. للأوامر الطويلة أو التفاعلية، استخدم بدلاً من ذلك \"فتح ملف الاتصال الشخصي\" مع أمر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa una ordre a l'amfitrió d'un perfil desat mitjançant SSH i en retorna la sortida. Per a ordres llargues o interactives, utilitzeu «Obrir perfil de connexió» amb una ordre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí příkaz na hostiteli uloženého profilu přes SSH a vrátí výstup. Pro dlouho běžící nebo interaktivní příkazy použijte raději akci Otevřít profil připojení s příkazem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører en kommando på en gemt profils vært via SSH og returnerer outputtet. Brug i stedet Åbn forbindelsesprofil med en kommando til langvarige eller interaktive kommandoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt einen Befehl auf dem Host eines gespeicherten Profils über SSH aus und gibt die Ausgabe zurück. Verwenden Sie für lang laufende oder interaktive Befehle stattdessen „Verbindungsprofil öffnen“ mit einem Befehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un comando por SSH en el host de un perfil guardado y devuelve la salida. Para comandos interactivos o de larga duración, usa Abrir perfil de conexión con un comando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorittaa komennon tallennetun profiilin isännässä SSH:n kautta ja palauttaa tulosteen. Käytä pitkäkestoisiin tai vuorovaikutteisiin komentoihin sen sijaan Avaa yhteysprofiili -toimintoa komennon kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute une commande via SSH sur l'hôte d'un profil enregistré et renvoie la sortie. Pour les commandes longues ou interactives, utilisez plutôt Ouvrir un profil de connexion avec une commande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מריץ פקודה על המארח של פרופיל שמור דרך SSH ומחזיר את הפלט. לפקודות ארוכות או אינטראקטיביות, השתמש במקום זאת בפעולה \"פתיחת פרופיל חיבור\" עם פקודה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parancsot futtat egy mentett profil gazdagépén SSH-n keresztül, és visszaadja a kimenetet. Hosszan futó vagy interaktív parancsokhoz használja helyette a Kapcsolati profil megnyitása műveletet paranccsal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue un comando via SSH sull'host di un profilo salvato e ne restituisce l'output. Per comandi interattivi o di lunga durata, usa invece Apri profilo di connessione con un comando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたプロファイルのホスト上でSSH経由でコマンドを実行し、出力を返します。長時間実行されるコマンドや対話的なコマンドには、代わりに「接続プロファイルを開く」でコマンドを指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 프로필의 호스트에서 SSH로 명령을 실행하고 출력을 반환합니다. 오래 실행되거나 대화형인 명령에는 대신 명령을 지정한 연결 프로필 열기를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører en kommando på verten til en lagret profil over SSH og returnerer utdataen. For langvarige eller interaktive kommandoer bør du heller bruke Åpne tilkoblingsprofil med en kommando."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voert via SSH een opdracht uit op de host van een opgeslagen profiel en geeft de uitvoer terug. Gebruik voor langlopende of interactieve opdrachten in plaats daarvan Open verbindingsprofiel met een opdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia polecenie na hoście zapisanego profilu przez SSH i zwraca wynik. W przypadku długotrwałych lub interaktywnych poleceń użyj zamiast tego akcji Otwórz profil połączenia z poleceniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa um comando no host de um perfil salvo via SSH e retorna a saída. Para comandos demorados ou interativos, use Abrir Perfil de Conexão com um comando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa um comando por SSH no anfitrião de um perfil guardado e devolve a saída. Para comandos demorados ou interativos, utilize antes Abrir Perfil de Ligação com um comando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execută o comandă prin SSH pe gazda unui profil salvat și returnează rezultatul. Pentru comenzi interactive sau de lungă durată, folosește în schimb Deschide profil de conexiune cu o comandă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zažene ukaz na gostitelju shranjenega profila prek SSH in vrne izhod. Za dolgotrajne ali interaktivne ukaze raje uporabite Odpri profil povezave z ukazom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör ett kommando på en sparad profils värd via SSH och returnerar utdata. För långvariga eller interaktiva kommandon, använd Öppna anslutningsprofil med ett kommando i stället."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виконує команду на хості збереженого профілю через SSH і повертає вивід. Для тривалих або інтерактивних команд використовуйте натомість «Відкрити профіль з'єднання» з командою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy một lệnh trên host của hồ sơ đã lưu qua SSH và trả về kết quả. Với các lệnh chạy lâu hoặc có tương tác, hãy dùng Mở hồ sơ kết nối kèm một lệnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 SSH 在已保存配置的主机上运行命令并返回输出。对于长时间运行或交互式命令，请改用“打开连接配置”并附带命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 SSH 在已儲存設定檔的主機上執行指令並傳回輸出。若指令需長時間執行或為互動式，請改用「開啟連線設定檔」並指定指令。"
          }
        }
      }
    },
    "Runs as the initial remote command with a PTY, like ssh -t host command." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغَّل كأمر بعيد أولي مع PTY، مثل ssh -t host command."
