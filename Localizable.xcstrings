    "These keys fill the main toolbar row. Drag keys between Main Row and Drawer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تملأ هذه المفاتيح الصف الرئيسي لشريط الأدوات. اسحب المفاتيح بين الصف الرئيسي والدُّرج."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquestes tecles omplen la fila principal de la barra d'eines. Arrossega les tecles entre la Fila principal i el Calaix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto klávesy vyplňují hlavní řádek panelu nástrojů. Přetahujte klávesy mezi Hlavním řádkem a Zásuvkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse taster udfylder værktøjslinjens hovedrække. Træk taster mellem Hovedrække og Skuffe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Tasten füllen die Hauptzeile der Symbolleiste. Ziehe Tasten zwischen Hauptzeile und Schublade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas teclas llenan la fila principal de la barra de herramientas. Arrastra las teclas entre Fila principal y Panel lateral."
