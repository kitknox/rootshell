    "All imported profiles go into this folder. Pick \"Root\" for no folder, or create a new one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل جميع الملفات الشخصية المستوردة إلى هذا المجلد. اختر \"Root\" لعدم استخدام مجلد، أو أنشئ مجلداً جديداً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els perfils importats aniran a aquesta carpeta. Tria \"Root\" per a cap carpeta, o crea’n una de nova."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny importované profily se uloží do této složky. Vyberte „Root“ pro žádnou složku, nebo vytvořte novou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle importerede profiler placeres i denne mappe. Vælg \"Root\" for ingen mappe, eller opret en ny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle importierten Profile werden in diesem Ordner abgelegt. Wähle \"Root\" für keinen Ordner oder erstelle einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los perfiles importados irán a esta carpeta. Elige \"Root\" para no usar carpeta, o crea una nueva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tuodut profiilit menevät tähän kansioon. Valitse ”Root”, jos et halua kansiota, tai luo uusi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les profils importés iront dans ce dossier. Choisissez \"Root\" pour aucun dossier, ou créez-en un nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הפרופילים המיובאים יישמרו בתיקייה זו. בחר \"Root\" ללא תיקייה, או צור תיקייה חדשה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden importált profil ebbe a mappába kerül. Válassza a „Root” lehetőséget, ha nem szeretne mappát, vagy hozzon létre újat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i profili importati andranno in questa cartella. Scegli \"Root\" per nessuna cartella, oppure creane una nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートしたプロファイルはすべてこのフォルダに入ります。フォルダなしにする場合は「Root」を選択するか、新規フォルダを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 모든 프로파일은 이 폴더에 저장됩니다. 폴더 없이 저장하려면 \"Root\"를 선택하거나 새 폴더를 만드세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle importerte profiler legges i denne mappen. Velg \"Root\" for ingen mappe, eller opprett en ny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle geïmporteerde profielen komen in deze map. Kies \"Root\" voor geen map, of maak een nieuwe aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zaimportowane profile trafią do tego folderu. Wybierz „Root”, aby nie używać folderu, lub utwórz nowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os perfis importados vão para esta pasta. Escolha \"Root\" para nenhuma pasta, ou crie uma nova."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os perfis importados vão para esta pasta. Escolha \"Root\" para nenhuma pasta, ou crie uma nova."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate profilurile importate vor ajunge în acest dosar. Alege \"Root\" pentru niciun dosar sau creează unul nou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsi uvoženi profili gredo v to mapo. Izberite »Root« za nobeno mapo ali ustvarite novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla importerade profiler hamnar i den här mappen. Välj \"Root\" för ingen mapp, eller skapa en ny."
          }
        },
        "uk" : {
          "stringUnit" : {
