    "Authentication Services creates WebAuthn credentials using ECDSA P-256, which OpenSSH exposes as an sk-ecdsa key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنشئ Authentication Services بيانات اعتماد WebAuthn باستخدام ECDSA P-256، والتي يعرضها OpenSSH كمفتاح sk-ecdsa."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services crea credencials WebAuthn amb ECDSA P-256, que OpenSSH exposa com una clau sk-ecdsa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services vytváří přihlašovací údaje WebAuthn pomocí ECDSA P-256, které OpenSSH zpřístupňuje jako klíč sk-ecdsa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services opretter WebAuthn-legitimationsoplysninger med ECDSA P-256, som OpenSSH viser som en sk-ecdsa-nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services erstellt WebAuthn-Anmeldedaten mit ECDSA P-256, die OpenSSH als sk-ecdsa-Schlüssel bereitstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services crea credenciales WebAuthn con ECDSA P-256, que OpenSSH expone como una clave sk-ecdsa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services luo WebAuthn-tunnistetiedot ECDSA P-256:lla, jonka OpenSSH esittää sk-ecdsa-avaimena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services crée des identifiants WebAuthn avec ECDSA P-256, qu'OpenSSH expose comme une clé sk-ecdsa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services יוצר פרטי כניסה של WebAuthn באמצעות ECDSA P-256, ש-OpenSSH חושף כמפתח sk-ecdsa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Authentication Services ECDSA P-256 használatával hoz létre WebAuthn hitelesítő adatokat, amelyeket az OpenSSH sk-ecdsa kulcsként tesz elérhetővé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication Services crea credenziali WebAuthn con ECDSA P-256, che OpenSSH espone come chiave sk-ecdsa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication ServicesはECDSA P-256を使用してWebAuthn資格情報を作成し、OpenSSHはこれをsk-ecdsaキーとして扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
