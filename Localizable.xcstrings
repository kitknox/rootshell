    "Mesh path is reported by the device, not measured from this client." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبلِّغ الجهاز عن مسار الشبكة المتداخلة، ولا يُقاس من هذا العميل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El camí de la malla l'informa el dispositiu; no es mesura des d'aquest client."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestu v síti mesh hlásí zařízení, neměří se z tohoto klienta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh-stien rapporteres af enheden og måles ikke fra denne klient."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mesh-Pfad wird vom Gerät gemeldet und nicht von diesem Client gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta de malla la informa el dispositivo; no se mide desde este cliente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laite ilmoittaa mesh-reitin, eikä sitä mitata tästä asiakkaasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chemin du maillage est signalé par l'appareil, et non mesuré depuis ce client."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתיב הרשת מדווח על ידי המכשיר ואינו נמדד מלקוח זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesh-útvonalat az eszköz jelenti, nem ez a kliens méri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso mesh è segnalato dal dispositivo, non misurato da questo client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッシュ経路はデバイスから報告されるもので、このクライアントで測定したものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시 경로는 기기에서 보고한 값이며, 이 클라이언트에서 측정한 값이 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh-banen rapporteres av enheten og måles ikke fra denne klienten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het mesh-pad wordt gerapporteerd door het apparaat en niet gemeten vanaf deze client."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżka w sieci mesh jest zgłaszana przez urządzenie, a nie mierzona z tego klienta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O caminho da malha é informado pelo dispositivo, não medido a partir deste cliente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O caminho da malha é comunicado pelo dispositivo, não medido a partir deste cliente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calea în rețeaua mesh este raportată de dispozitiv, nu măsurată de la acest client."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
