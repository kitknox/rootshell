    "Controls what ⌘T does while attached to a tmux -CC session. Outside tmux it always opens a local shell." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد ما يفعله ⌘T أثناء الاتصال بجلسة tmux -CC. خارج tmux، يفتح دائمًا صدفة محلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla què fa ⌘T mentre estàs connectat a una sessió tmux -CC. Fora de tmux, sempre obre un shell local."
          }
