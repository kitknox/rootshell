        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš poskytovatel přístupových klíčů vás ověří pokaždé, když klíč podepisuje, pomocí Face ID, Touch ID, kódu zařízení nebo vlastního odemknutí poskytovatele."
