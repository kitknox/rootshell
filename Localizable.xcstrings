    "Restricts the software keyboard to ASCII layout, preventing input methods from substituting terminal characters like | and ~." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيّد لوحة المفاتيح البرمجية بتخطيط ASCII، مما يمنع أساليب الإدخال من استبدال أحرف الطرفية مثل | و ~."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringeix el teclat programari a la disposició ASCII, evitant que els mètodes d'entrada substitueixin caràcters de terminal com | i ~."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezí softwarovou klávesnici na rozložení ASCII a zabrání vstupním metodám nahrazovat terminálové znaky jako | a ~."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrænser softwaretastaturet til ASCII-layout og forhindrer inputmetoder i at erstatte terminaletegn som | og ~."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschränkt die Bildschirmtastatur auf das ASCII-Layout und verhindert, dass Eingabemethoden Terminalzeichen wie | und ~ ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe el teclado en pantalla al diseño ASCII, evitando que los métodos de entrada sustituyan caracteres de terminal como | y ~."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajoittaa näppäimistön ASCII-asetteluun ja estää syöttömenetelmiä korvaamasta terminaalimerkkejä kuten | ja ~."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restreint le clavier logiciel à la disposition ASCII, empêchant les méthodes de saisie de substituer des caractères de terminal comme | et ~."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגביל את המקלדת התוכנתית לפריסת ASCII, ומונע משיטות קלט להחליף תווי מסוף כגון | ו-~."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szoftveres billentyűzetet ASCII-elrendezésre korlátozza, megakadályozva, hogy a beviteli módszerek lecseréljék a terminálkaraktereket, például a | és ~ jeleket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la tastiera software al layout ASCII, impedendo ai metodi di input di sostituire i caratteri del terminale come | e ~."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトウェアキーボードをASCIIレイアウトに制限し、入力メソッドによる | や ~ などのターミナル文字の置換を防止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소프트웨어 키보드를 ASCII 레이아웃으로 제한하여 입력기가 | 및 ~ 같은 터미널 문자를 대체하는 것을 방지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenser programvaretastaturet til ASCII-oppsett, og forhindrer inndatametoder fra å erstatte terminaltegn som | og ~."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt het schermtoetsenbord tot de ASCII-indeling en voorkomt dat invoermethoden terminaltekens zoals | en ~ vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicza klawiaturę ekranową do układu ASCII, zapobiegając zastępowaniu znaków terminala, takich jak | i ~, przez metody wprowadzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe o teclado virtual ao layout ASCII, impedindo que os métodos de entrada substituam caracteres de terminal como | e ~."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe o teclado virtual ao esquema ASCII, impedindo que os métodos de introdução substituam caracteres de terminal como | e ~."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restricționează tastatura software la aspectul ASCII, împiedicând metodele de introducere să substituie caracterele de terminal precum | și ~."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omeji programsko tipkovnico na razporeditev ASCII in prepreči vnosnim metodam zamenjavo terminalskih znakov, kot sta | in ~."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar skärmtangentbordet till ASCII-layout och förhindrar att inmatningsmetoder ersätter terminaltecken som | och ~."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмежує програмну клавіатуру розкладкою ASCII, запобігаючи заміні термінальних символів, таких як | та ~, методами введення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hạn chế bàn phím ảo ở bố cục ASCII, ngăn phương thức nhập thay thế các ký tự terminal như | và ~."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将软件键盘限制为 ASCII 布局，防止输入法替换终端字符（如 | 和 ~）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將軟體鍵盤限制為 ASCII 佈局，防止輸入法替換終端字元（如 | 和 ~）。"
          }
        }
      }
    },
