          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze sleutel is geconfigureerd op een ander apparaat. Selecteer hierboven een lokale sleutel, of maak verbinding — u wordt gevraagd een apparaatspecifieke sleutel te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
