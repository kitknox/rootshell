        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Із %@. Недавню історію прокручування буде передано, а вихідну вкладку закрито після під’єднання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ %@. Lịch sử cuộn gần đây sẽ được chuyển và thẻ ban đầu sẽ đóng sau khi kết nối hoàn tất."
          }
