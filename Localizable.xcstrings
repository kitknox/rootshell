        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä profiili perii etäterminaalin tyypin yleensä asetuksista. Ohita se vain palvelimille, jotka vaativat eri terminfo-nimen."
