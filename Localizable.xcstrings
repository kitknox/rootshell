    "Lookups stop as soon as all supported fields are filled or there are no more databases to check." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف البحث فور ملء جميع الحقول المدعومة أو عند عدم وجود قواعد بيانات أخرى للفحص."
          }
        },
        "ca" : {
