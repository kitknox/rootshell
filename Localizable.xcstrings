    "iCloud sync uses your iCloud account to keep data synchronized across all your devices signed into the same Apple Account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم مزامنة iCloud حسابك على iCloud للحفاظ على البيانات متزامنة عبر جميع أجهزتك المسجّلة بنفس حساب Apple."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronització d'iCloud utilitza el vostre compte d'iCloud per mantenir les dades sincronitzades a tots els vostres dispositius amb el mateix compte d'Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace iCloud používá váš účet iCloud k udržování dat synchronizovaných napříč všemi zařízeními přihlášenými ke stejnému Apple účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkronisering bruger din iCloud-konto til at holde data synkroniseret på tværs af alle dine enheder, der er logget ind med den samme Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iCloud-Synchronisierung nutzt Ihr iCloud-Konto, um Daten auf allen Geräten synchron zu halten, die mit demselben Apple-Konto angemeldet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de iCloud utiliza su cuenta de iCloud para mantener los datos sincronizados en todos sus dispositivos conectados a la misma cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkronointi käyttää iCloud-tiliäsi pitääkseen tiedot synkronoituna kaikissa laitteissasi, jotka on kirjattu samalle Apple-tilille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation iCloud utilise votre compte iCloud pour maintenir les données synchronisées sur tous vos appareils connectés au même compte Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרון iCloud משתמש בחשבון ה-iCloud שלך כדי לשמור על נתונים מסונכרנים בכל המכשירים המחוברים לאותו חשבון Apple."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iCloud szinkronizálás az iCloud fiókját használja az adatok szinkronizálásához az összes, ugyanabba az Apple fiókba bejelentkezett eszközön."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione iCloud utilizza il Suo account iCloud per mantenere i dati sincronizzati su tutti i dispositivi collegati allo stesso Apple Account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期はiCloudアカウントを使用して、同じApple Accountにサインインしているすべてのデバイス間でデータを同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화는 iCloud 계정을 사용하여 동일한 Apple 계정에 로그인된 모든 기기 간에 데이터를 동기화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkronisering bruker iCloud-kontoen din til å holde data synkronisert på tvers av alle enhetene dine som er logget inn med samme Apple-konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synchronisatie gebruikt uw iCloud-account om gegevens gesynchroniseerd te houden op al uw apparaten die zijn ingelogd met hetzelfde Apple Account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja iCloud wykorzystuje Twoje konto iCloud do utrzymywania danych zsynchronizowanych na wszystkich urządzeniach zalogowanych na to samo konto Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização iCloud usa sua conta iCloud para manter os dados sincronizados em todos os seus dispositivos conectados à mesma Conta Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização iCloud utiliza a sua conta iCloud para manter os dados sincronizados em todos os seus dispositivos com sessão iniciada na mesma Conta Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea iCloud folosește contul dvs. iCloud pentru a menține datele sincronizate pe toate dispozitivele conectate la același cont Apple."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinhronizacija iCloud uporablja vaš račun iCloud za ohranjanje podatkov sinhroniziranih na vseh napravah, prijavljenih v isti Apple račun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkronisering använder ditt iCloud-konto för att hålla data synkroniserad över alla dina enheter som är inloggade på samma Apple-konto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізація iCloud використовує ваш обліковий запис iCloud для підтримки даних в актуальному стані на всіх пристроях, які ввійшли в той самий Apple Account."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ iCloud sử dụng tài khoản iCloud của bạn để giữ dữ liệu đồng bộ trên tất cả thiết bị đã đăng nhập vào cùng tài khoản Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步使用您的 iCloud 账户在所有登录同一 Apple 账户的设备间保持数据同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步使用您的 iCloud 帳號，在所有登入同一 Apple 帳號的裝置間保持資料同步。"
          }
        }
      }
    },
    "iCloud-synced keys cannot require per-operation authentication. Authentication is handled by your device lock." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن للمفاتيح المزامَنة مع iCloud أن تتطلب مصادقة لكل عملية. تتم المصادقة بواسطة قفل جهازك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus sincronitzades amb iCloud no poden requerir autenticació per operació. L'autenticació la gestiona el bloqueig del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíče synchronizované přes iCloud nemohou vyžadovat ověření pro každou operaci. Ověření zajišťuje zámek vašeho zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkroniserede nøgler kan ikke kræve godkendelse pr. handling. Godkendelse håndteres af din enhedslås."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit iCloud synchronisierte Schlüssel können keine Authentifizierung pro Vorgang erfordern. Die Authentifizierung erfolgt durch die Gerätesperre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves sincronizadas con iCloud no pueden requerir autenticación por operación. La autenticación la gestiona el bloqueo de tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudiin synkronoitujen avainten ei voi vaatia toimintokohtaista todentamista. Todentaminen hoidetaan laitteesi lukituksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés synchronisées avec iCloud ne peuvent pas exiger d'authentification par opération. L'authentification est gérée par le verrouillage de votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות מסונכרנים עם iCloud אינם יכולים לדרוש אימות לכל פעולה. האימות מטופל על ידי נעילת המכשיר שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iClouddal szinkronizált kulcsok nem igényelhetnek műveletnkénti hitelesítést. A hitelesítést az eszköz zárolása kezeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi sincronizzate con iCloud non possono richiedere l'autenticazione per ogni operazione. L'autenticazione è gestita dal blocco del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期キーは操作ごとの認証を要求できません。認証はデバイスのロックによって処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 동기화된 키는 작업별 인증을 요구할 수 없습니다. 인증은 기기 잠금으로 처리됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkroniserte nøkler kan ikke kreve godkjenning per operasjon. Godkjenning håndteres av enhetslåsen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-gesynchroniseerde sleutels kunnen geen verificatie per bewerking vereisen. Verificatie wordt afgehandeld door de vergrendeling van uw apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze synchronizowane z iCloud nie mogą wymagać uwierzytelnienia dla każdej operacji. Uwierzytelnianie jest obsługiwane przez blokadę urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaves sincronizadas com o iCloud não podem exigir autenticação por operação. A autenticação é gerenciada pelo bloqueio do seu dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves sincronizadas com o iCloud não podem exigir autenticação por operação. A autenticação é gerida pelo bloqueio do seu dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheile sincronizate cu iCloud nu pot necesita autentificare per operațiune. Autentificarea este gestionată de blocarea dispozitivului."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ključi, sinhronizirani z iCloud, ne morejo zahtevati preverjanja pristnosti za vsako operacijo. Preverjanje pristnosti se izvaja z zaklepanjem naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkroniserade nycklar kan inte kräva autentisering per åtgärd. Autentisering hanteras av enhetslåset."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключі, синхронізовані з iCloud, не можуть вимагати автентифікації для кожної операції. Автентифікацію забезпечує блокування пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khóa được đồng bộ với iCloud không thể yêu cầu xác thực theo từng thao tác. Xác thực được xử lý bởi khóa màn hình thiết bị của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步的密钥不能要求每次操作都进行验证。验证由设备锁来处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步的金鑰無法要求每次操作都進行驗證。驗證由裝置鎖定處理。"
          }
        }
      }
    },
