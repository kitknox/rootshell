    "Picker shows input sources you've enabled in system settings. Add more sources there to expand this list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض المنتقي مصادر الإدخال التي فعّلتها في إعدادات النظام. أضف المزيد من المصادر هناك لتوسيع هذه القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El selector mostra les fonts d’entrada que has activat a la configuració del sistema. Afegeix-hi més fonts per ampliar aquesta llista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběr zobrazuje zdroje vstupu, které jste povolili v nastavení systému. Přidáním dalších zdrojů tam tento seznam rozšíříte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælgeren viser de inputkilder, du har aktiveret i systemindstillingerne. Tilføj flere kilder dér for at udvide denne liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl zeigt die Eingabequellen, die du in den Systemeinstellungen aktiviert hast. Füge dort weitere Quellen hinzu, um diese Liste zu erweitern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El selector muestra las fuentes de entrada que has activado en los ajustes del sistema. Añade más fuentes ahí para ampliar esta lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsin näyttää syöttölähteet, jotka olet ottanut käyttöön järjestelmän asetuksissa. Lisää siellä uusia lähteitä laajentaaksesi tätä luetteloa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sélecteur affiche les sources de saisie que vous avez activées dans les réglages du système. Ajoutez-y d’autres sources pour étoffer cette liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבורר מציג את מקורות הקלט שהפעלת בהגדרות המערכת. הוסף שם מקורות נוספים כדי להרחיב את הרשימה הזו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A választó a rendszerbeállításokban engedélyezett beviteli forrásokat jeleníti meg. Adj hozzá ott további forrásokat a lista bővítéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il selettore mostra le sorgenti di input attivate nelle impostazioni di sistema. Aggiungine altre lì per ampliare questo elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピッカーには、システム設定で有効にした入力ソースが表示されます。このリストを増やすには、そこでソースを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택기에는 시스템 설정에서 활성화한 입력 소스가 표시됩니다. 이 목록을 늘리려면 거기에서 소스를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velgeren viser inndatakildene du har aktivert i systeminnstillingene. Legg til flere kilder der for å utvide denne listen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kiezer toont de invoerbronnen die je in de systeeminstellingen hebt ingeschakeld. Voeg daar meer bronnen toe om deze lijst uit te breiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selektor pokazuje źródła wprowadzania włączone w ustawieniach systemowych. Dodaj tam więcej źródeł, aby rozszerzyć tę listę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seletor mostra as fontes de entrada que você ativou nos ajustes do sistema. Adicione mais fontes lá para expandir esta lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seletor mostra as origens de entrada que ativou nas definições do sistema. Adicione mais origens aí para expandir esta lista."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selectorul afișează sursele de intrare pe care le-ai activat în configurările sistemului. Adaugă mai multe surse acolo pentru a extinde această listă."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbirnik prikazuje vire vnosa, ki ste jih omogočili v sistemskih nastavitvah. Tam dodajte več virov, da razširite ta seznam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljaren visar de inmatningskällor du har aktiverat i systeminställningarna. Lägg till fler källor där för att utöka den här listan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У засобі вибору показано джерела введення, які ви ввімкнули в системних параметрах. Додайте там більше джерел, щоб розширити цей список."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ chọn hiển thị các nguồn nhập bạn đã bật trong cài đặt hệ thống. Thêm nhiều nguồn ở đó để mở rộng danh sách này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择器会显示你在系统设置中已启用的输入源。在那里添加更多输入源即可扩展此列表。"
          }
        },
        "zh-Hant" : {
