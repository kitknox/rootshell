    "Rapid wing beats in flight. Turn off for calm, less distracting gliding" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خفقان سريع للأجنحة أثناء الطيران. أوقفه للحصول على انزلاق هادئ وأقل تشتيتًا"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleteig ràpid en vol. Desactiveu-ho per a un planeig tranquil i menys distret"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlé mávání křídel za letu. Vypněte pro klidné, méně rušivé klouzání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtige vingeslag under flugt. Slå fra for rolig, mindre forstyrrende svæven"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneller Flügelschlag im Flug. Ausschalten für ruhiges, weniger ablenkendes Gleiten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleteos rápidos durante el vuelo. Desactívalo para un planeo tranquilo y menos llamativo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeat siiveniskut lennon aikana. Poista käytöstä, jos haluat rauhallista, vähemmän häiritsevää liitoa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battements d'ailes rapides en vol. Désactivez pour un vol plané apaisant et moins distrayant"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכות כנף מהירות במעוף. כבה לדאייה רגועה ופחות מסיחה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyors szárnycsapások repülés közben. Kapcsolja ki a nyugodt, kevésbé zavaró siklásért"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapidi battiti d'ali in volo. Disattiva per un volo planato tranquillo e meno distraente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飛行中の素早い羽ばたき。落ち着いた、気が散りにくい滑空にするにはオフにします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비행 중 빠른 날갯짓. 차분하고 덜 산만한 활공만 원하면 끄세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raske vingeslag i flukt. Slå av for rolig, mindre forstyrrende gliding"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snelle vleugelslagen tijdens de vlucht. Schakel uit voor rustig, minder afleidend zweven"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkie uderzenia skrzydeł w locie. Wyłącz, aby uzyskać spokojny, mniej rozpraszający lot ślizgowy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batidas rápidas das asas em voo. Desligue para um planeio calmo e menos distrativo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
