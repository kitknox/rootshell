    "Overrides the entire herdr command, including the session name. Leave empty to use the default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجاوز أمر herdr بالكامل، بما في ذلك اسم الجلسة. اتركه فارغًا لاستخدام الأمر الافتراضي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix tota l'ordre d'herdr, inclòs el nom de la sessió. Deixa-ho buit per utilitzar el valor per defecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradí celý příkaz herdr včetně názvu relace. Ponechte prázdné pro použití výchozího."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilsidesætter hele herdr-kommandoen, inklusive sessionsnavnet. Lad feltet stå tomt for at bruge standarden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschreibt den gesamten herdr-Befehl, einschließlich des Sitzungsnamens. Leer lassen, um den Standard zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye todo el comando de herdr, incluido el nombre de la sesión. Déjalo vacío para usar el predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa koko herdr-komennon, myös istunnon nimen. Jätä tyhjäksi käyttääksesi oletusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace toute la commande herdr, y compris le nom de session. Laissez vide pour utiliser la valeur par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוקף את כל פקודת herdr, כולל שם ההפעלה. השאר ריק כדי להשתמש בברירת המחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felülírja a teljes herdr-parancsot, a munkamenet nevével együtt. Hagyja üresen az alapértelmezett használatához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce l'intero comando herdr, incluso il nome della sessione. Lascia vuoto per usare il valore predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション名を含め、herdrコマンド全体を上書きします。空欄にするとデフォルトを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 이름을 포함한 전체 herdr 명령어를 대체합니다. 비워 두면 기본값을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overstyrer hele herdr-kommandoen, inkludert øktnavnet. La feltet stå tomt for å bruke standarden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overschrijft de volledige herdr-opdracht, inclusief de sessienaam. Laat leeg om de standaard te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje całe polecenie herdr, łącznie z nazwą sesji. Pozostaw puste, aby użyć domyślnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui todo o comando do herdr, incluindo o nome da sessão. Deixe vazio para usar o padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui todo o comando do herdr, incluindo o nome da sessão. Deixe vazio para usar a predefinição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înlocuiește întreaga comandă herdr, inclusiv numele sesiunii. Lăsați gol pentru a folosi valoarea implicită."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadomesti celoten ukaz herdr, vključno z imenom seje. Pustite prazno za privzeto vrednost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersätter hela herdr-kommandot, inklusive sessionsnamnet. Lämna tomt för att använda standardvärdet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замінює всю команду herdr, зокрема назву сеансу. Залиште порожнім, щоб використати типову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi đè toàn bộ lệnh herdr, bao gồm cả tên phiên. Để trống để dùng giá trị mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖整条 herdr 命令，包括会话名称。留空则使用默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆寫整道 herdr 指令，包括工作階段名稱。留空則使用預設值。"
          }
        }
