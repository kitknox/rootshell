        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la barre d'outils visible lorsque le clavier à l'écran est masqué. Touchez le terminal pour faire réapparaître le clavier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאר את סרגל הכלים גלוי כאשר המקלדת שעל המסך מוסתרת. הקש על הטרמינל כדי להציג את המקלדת מחדש."
