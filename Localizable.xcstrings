    "Draws the prompt directly under the previous command's output instead of leaving a blank row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسم موجه الأوامر مباشرةً أسفل مخرجات الأمر السابق بدلاً من ترك سطر فارغ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuixa l'indicador just a sota de la sortida de l'ordre anterior en lloc de deixar una fila en blanc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí prompt přímo pod výstupem předchozího příkazu místo ponechání prázdného řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner prompten direkte under den forrige kommandos output i stedet for at efterlade en tom linje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet den Prompt direkt unter die Ausgabe des vorherigen Befehls, statt eine Leerzeile zu lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el indicador justo debajo de la salida del comando anterior en lugar de dejar una fila en blanco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtää kehotteen suoraan edellisen komennon tulosteen alle sen sijaan, että jättäisi tyhjän rivin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l'invite directement sous la sortie de la commande précédente au lieu de laisser une ligne vide."
