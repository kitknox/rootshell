    "Mod-tap keys perform one action on tap and another on hold. Choose a preset or add a custom rule." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي مفاتيح Mod-Tap إجراءً عند النقر وإجراءً آخر عند الضغط المطوّل. اختر إعدادًا مسبقًا أو أضف قاعدة مخصصة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tecles Mod-Tap realitzen una acció en tocar i una altra en mantenir premut. Trieu una configuració predefinida o afegiu una regla personalitzada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klávesy Mod-Tap provedou jednu akci při stisku a jinou při podržení. Vyberte předvolbu nebo přidejte vlastní pravidlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-tap-taster udfører én handling ved tryk og en anden ved hold. Vælg en forudindstilling, eller tilføj en brugerdefineret regel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-Tap-Tasten führen beim Antippen eine Aktion und beim Halten eine andere aus. Wählen Sie eine Vorlage oder fügen Sie eine benutzerdefinierte Regel hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas Mod-Tap realizan una acción al pulsar y otra al mantener presionado. Elija un preajuste o añada una regla personalizada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-tap-näppäimet suorittavat yhden toiminnon napautuksella ja toisen pitkällä painalluksella. Valitse esiasetus tai lisää mukautettu sääntö."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches Mod-Tap effectuent une action lors d'un appui bref et une autre lors d'un appui prolongé. Choisissez un préréglage ou ajoutez une règle personnalisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקשי Mod-tap מבצעים פעולה אחת בלחיצה ופעולה אחרת בלחיצה ארוכה. בחר הגדרה מוכנה או הוסף כלל מותאם אישית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mod-Tap billentyűk rövid nyomásra egy műveletet, hosszú nyomásra pedig másikat hajtanak végre. Válasszon egy sablont, vagy adjon hozzá egyéni szabályt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti Mod-Tap eseguono un'azione alla pressione e un'altra alla pressione prolungata. Scelga un preset o aggiunga una regola personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-Tapキーはタップで1つのアクション、長押しで別のアクションを実行します。プリセットを選択するか、カスタムルールを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-Tap 키는 탭하면 한 동작, 길게 누르면 다른 동작을 수행합니다. 프리셋을 선택하거나 사용자 정의 규칙을 추가하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-tap-taster utfører én handling ved trykk og en annen ved hold. Velg en forhåndsinnstilling eller legg til en egendefinert regel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-tap-toetsen voeren één actie uit bij tikken en een andere bij ingedrukt houden. Kies een voorinstelling of voeg een aangepaste regel toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisze Mod-Tap wykonują jedną akcję przy dotknięciu i inną przy przytrzymaniu. Wybierz preset lub dodaj własną regułę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclas mod-tap executam uma ação ao tocar e outra ao segurar. Escolha uma predefinição ou adicione uma regra personalizada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas Mod-Tap executam uma ação ao tocar e outra ao manter premido. Escolha uma predefinição ou adicione uma regra personalizada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastele Mod-Tap efectuează o acțiune la apăsare scurtă și alta la apăsare lungă. Alegeți o presetare sau adăugați o regulă personalizată."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipke Mod-Tap ob dotiku izvedejo eno dejanje, ob zadržanju pa drugo. Izberite prednastavitev ali dodajte pravilo po meri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-tap-tangenter utför en åtgärd vid tryck och en annan vid hållning. Välj en förinställning eller lägg till en egen regel."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавіші Mod-Tap виконують одну дію при натисканні та іншу при утриманні. Оберіть набір або додайте власне правило."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím Mod-tap thực hiện một hành động khi nhấn và hành động khác khi giữ. Chọn cài đặt sẵn hoặc thêm quy tắc tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-Tap 按键在点按和长按时执行不同操作。选择预设或添加自定义规则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod-Tap 按鍵在點按和長按時執行不同動作。選擇預設組態或新增自訂規則。"
          }
        }
      }
    },
