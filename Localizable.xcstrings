    "Uses bash /dev/udp. Most portable but uses wrong source port (IPv4 only)." : {
      "comment" : "Hole-punch server method description: bash UDP",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم bash /dev/udp. الأكثر قابلية للنقل لكنه يستخدم منفذ مصدر خاطئ (IPv4 فقط)."
