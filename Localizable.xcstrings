    "No locale will be sent. Remote servers will use their own default locale." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتم إرسال أي لغة محلية. ستستخدم الخوادم البعيدة إعداداتها الافتراضية."
