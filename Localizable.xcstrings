    "Ed25519 is recommended. The server's opkssh verifier must accept the chosen key type." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوصى باستخدام Ed25519. يجب أن تقبل أداة التحقق opkssh على الخادم نوع المفتاح المختار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es recomana Ed25519. El verificador opkssh del servidor ha d’acceptar el tipus de clau triat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doporučuje se Ed25519. Ověřovatel opkssh na serveru musí přijmout zvolený typ klíče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 anbefales. Serverens opkssh-verifikator skal acceptere den valgte nøgletype."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 wird empfohlen. Der opkssh-Verifizierer des Servers muss den gewählten Schlüsseltyp akzeptieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recomienda Ed25519. El verificador opkssh del servidor debe aceptar el tipo de clave elegido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519:tä suositellaan. Palvelimen opkssh-vahvistimen on hyväksyttävä valittu avaintyyppi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 est recommandé. Le vérificateur opkssh du serveur doit accepter le type de clé choisi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מומלץ להשתמש ב-Ed25519. מאמת ה-opkssh של השרת חייב לקבל את סוג המפתח שנבחר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Ed25519 ajánlott. A kiszolgáló opkssh ellenőrzőjének el kell fogadnia a választott kulcstípust."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si consiglia Ed25519. Il verificatore opkssh del server deve accettare il tipo di chiave scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 が推奨されます。サーバーの opkssh 検証ツールが選択したキータイプを受け入れる必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519를 권장합니다. 서버의 opkssh 검증기가 선택한 키 유형을 허용해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 anbefales. Serverens opkssh-verifikator må godta den valgte nøkkeltypen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 wordt aanbevolen. De opkssh-verifier van de server moet het gekozen sleuteltype accepteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalecany jest Ed25519. Weryfikator opkssh na serwerze musi akceptować wybrany typ klucza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 é recomendado. O verificador opkssh do servidor precisa aceitar o tipo de chave escolhido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomenda-se Ed25519. O verificador opkssh do servidor tem de aceitar o tipo de chave escolhido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recomandă Ed25519. Verificatorul opkssh al serverului trebuie să accepte tipul de cheie ales."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priporočljiv je Ed25519. Preverjevalnik opkssh na strežniku mora sprejeti izbrani tip ključa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 rekommenderas. Serverns opkssh-verifierare måste acceptera den valda nyckeltypen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендовано Ed25519. Верифікатор opkssh на сервері має приймати вибраний тип ключа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khuyến nghị dùng Ed25519. Trình xác minh opkssh của máy chủ phải chấp nhận loại khóa đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推荐使用 Ed25519。服务器的 opkssh 验证器必须接受所选的密钥类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
