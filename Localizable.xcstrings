    "Bookmark external folders to access them from the local shell." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف المجلدات الخارجية إلى الإشارات المرجعية للوصول إليها من الصدفة المحلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu carpetes externes als marcadors per accedir-hi des de l'intèrpret d'ordres local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte si záložky na externí složky pro přístup z lokálního shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogmærk eksterne mapper for at tilgå dem fra den lokale shell."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzen Sie Lesezeichen für externe Ordner, um von der lokalen Shell darauf zuzugreifen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque carpetas externas para acceder a ellas desde el shell local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ulkoiset kansiot kirjanmerkkeihin käyttääksesi niitä paikallisesta komentotulkista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des dossiers externes aux favoris pour y accéder depuis le shell local."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סמן תיקיות חיצוניות כסימניות כדי לגשת אליהן מהמעטפת המקומית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelöljön meg külső mappákat könyvjelzővel a helyi shellből való eléréshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere cartelle esterne ai segnalibri per accedervi dalla shell locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部フォルダをブックマークしてローカルシェルからアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 폴더를 북마크하여 로컬 셸에서 접근할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bokmerk eksterne mapper for å få tilgang til dem fra det lokale skallet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak bladwijzers van externe mappen om ze vanuit de lokale shell te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj zakładki do zewnętrznych folderów, aby uzyskać do nich dostęp z lokalnej powłoki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve pastas externas nos favoritos para acessá-las pelo shell local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione pastas externas aos marcadores para aceder a partir da shell local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați dosare externe la favorite pentru a le accesa din shell-ul local."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte zaznamke za zunanje mape, da do njih dostopate iz lokalne lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bokmärk externa mappar för att komma åt dem från det lokala skalet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте зовнішні теки до закладок, щоб мати до них доступ з локальної оболонки."
