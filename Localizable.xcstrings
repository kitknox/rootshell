        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil não tem uma configuração de Partilha de Ecrã utilizável. Pode ter sido criado por uma versão mais recente da app - edite o perfil ou atualize a app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest profil nu are o configurație de partajare ecran utilizabilă. Este posibil să fi fost creat de o versiune mai nouă a aplicației — editează profilul sau actualizează aplicația."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta profil nima uporabne konfiguracije skupne rabe zaslona. Morda ga je ustvarila novejša različica aplikacije - uredite profil ali posodobite aplikacijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här profilen har ingen användbar skärmdelningskonfiguration. Den kan ha skapats av en nyare version av appen - redigera profilen eller uppdatera appen."
          }
