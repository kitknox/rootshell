    "Backup was created but not saved to a persistent location. It will be deleted when the app closes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء النسخة الاحتياطية ولكن لم يتم حفظها في موقع دائم. سيتم حذفها عند إغلاق التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La còpia de seguretat s'ha creat però no s'ha desat en una ubicació persistent. S'eliminarà quan es tanqui l'app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záloha byla vytvořena, ale nebyla uložena na trvalé místo. Bude smazána při zavření aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopien blev oprettet, men ikke gemt på en permanent placering. Den slettes, når appen lukkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherung wurde erstellt, aber nicht an einem dauerhaften Speicherort gesichert. Sie wird beim Schließen der App gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad se creó, pero no se guardó en una ubicación permanente. Se eliminará cuando se cierre la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopio luotiin, mutta sitä ei tallennettu pysyvään sijaintiin. Se poistetaan, kun sovellus suljetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde a été créée mais pas enregistrée dans un emplacement permanent. Elle sera supprimée à la fermeture de l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגיבוי נוצר אך לא נשמר במיקום קבוע. הוא יימחק כאשר האפליקציה תיסגר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonsági mentés létrejött, de nem lett állandó helyre mentve. Az alkalmazás bezárásakor törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup è stato creato ma non salvato in una posizione permanente. Verrà eliminato alla chiusura dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは作成されましたが、永続的な場所に保存されていません。アプリを閉じると削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업이 생성되었지만 영구 위치에 저장되지 않았습니다. 앱을 종료하면 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopien ble opprettet, men ikke lagret på en permanent plassering. Den vil bli slettet når appen lukkes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-up is aangemaakt maar niet opgeslagen op een vaste locatie. Deze wordt verwijderd wanneer de app wordt gesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa została utworzona, ale nie zapisana w trwałej lokalizacji. Zostanie usunięta po zamknięciu aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup foi criado, mas não foi salvo em um local persistente. Será excluído quando o app for fechado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia de segurança foi criada, mas não foi guardada num local persistente. Será eliminada quando a app for fechada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia de rezervă a fost creată, dar nu a fost salvată într-o locație persistentă. Va fi ștearsă la închiderea aplicației."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varnostna kopija je bila ustvarjena, vendar ni bila shranjena na trajno lokacijo. Izbrisana bo, ko se aplikacija zapre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopian skapades men sparades inte på en beständig plats. Den raderas när appen stängs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервну копію створено, але не збережено в постійне місце. Вона буде видалена після закриття додатку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu đã được tạo nhưng chưa lưu vào vị trí cố định. Nó sẽ bị xóa khi ứng dụng đóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份已创建但未保存到永久位置。关闭应用后将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份已建立但尚未儲存到永久位置。App 關閉時將被刪除。"
          }
        }
      }
    },
    "Badges control sidebar dots and cards for detected work and terminal-reported progress, even when coding-agent detection is off. Notifications follow their own policy. \"Done\" markers clear when you view the tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحكّم الشارات في نقاط الشريط الجانبي والبطاقات الخاصة بالعمل المُكتشف والتقدّم الذي تُبلّغ عنه الطرفية، حتى عندما يكون اكتشاف وكلاء البرمجة مُعطّلًا. أما الإشعارات فتتبع سياستها الخاصة. وتُمسح علامات \"تم\" عند عرض علامة التبويب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els distintius controlen els punts i les targetes de la barra lateral per a la feina detectada i el progrés informat pel terminal, fins i tot quan la detecció d'agents de codi està desactivada. Les notificacions segueixen la seva pròpia política. Els marcadors de «Fet» s'esborren quan mires la pestanya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odznaky ovládají tečky a karty v bočním panelu pro zjištěnou práci a pro průběh hlášený terminálem, i když je detekce agentů pro kódování vypnutá. Oznámení se řídí vlastním pravidlem. Značky „Hotovo“ zmizí, jakmile si kartu zobrazíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mærker styrer prikker og kort i sidepanelet for registreret arbejde og for fremdrift, som terminalen rapporterer, også når registrering af kodeagenter er slået fra. Notifikationer følger deres egen politik. \"Færdig\"-markeringer forsvinder, når du åbner fanen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badges steuern die Punkte und Karten in der Seitenleiste für erkannte Arbeit und vom Terminal gemeldeten Fortschritt, auch wenn die Coding-Agent-Erkennung deaktiviert ist. Benachrichtigungen folgen ihren eigenen Regeln. „Fertig“-Markierungen verschwinden, sobald Sie den Tab ansehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los distintivos controlan los puntos y las tarjetas de la barra lateral para el trabajo detectado y el progreso que informa el terminal, incluso con la detección de agentes de código desactivada. Las notificaciones siguen su propia política. Los marcadores \"Listo\" se borran al ver la pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkit ohjaavat sivupalkin pisteitä ja kortteja, jotka koskevat havaittua työtä ja terminaalin ilmoittamaa edistymistä, vaikka koodiagenttien tunnistus olisi pois käytöstä. Ilmoituksilla on oma käytäntönsä. \"Valmis\"-merkinnät poistuvat, kun avaat välilehden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pastilles contrôlent les points et les cartes de la barre latérale pour le travail détecté et la progression signalée par le terminal, même lorsque la détection des agents de code est désactivée. Les notifications suivent leur propre règle. Les marqueurs « Terminé » disparaissent lorsque vous consultez l'onglet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התגים שולטים בנקודות ובכרטיסים שבסרגל הצד עבור עבודה שזוהתה והתקדמות שהמסוף מדווח עליה, גם כאשר זיהוי סוכני הקוד כבוי. ההתראות פועלות לפי מדיניות משלהן. סימוני \"סיום\" נמחקים כשמציגים את הלשונית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelvények az oldalsáv pontjait és kártyáit vezérlik az észlelt munka és a terminál által jelentett folyamat esetén, akkor is, ha a kódügynökök felismerése ki van kapcsolva. Az értesítésekre saját szabály vonatkozik. A „Kész” jelölések eltűnnek, amint megnyitja a lapot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I badge controllano i puntini e le card nella barra laterale relativi al lavoro rilevato e all'avanzamento segnalato dal terminale, anche quando il rilevamento degli agenti di codice è disattivato. Le notifiche seguono un criterio proprio. I contrassegni \"Completato\" scompaiono quando visualizzi la scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジは、コーディングエージェントの検出がオフのときも含めて、検出された作業とターミナルが報告する進捗についてサイドバーのドットとカードを制御します。通知は独自のポリシーに従います。「完了」マークはタブを表示すると消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배지는 코딩 에이전트 감지가 꺼져 있어도 감지된 작업과 터미널이 보고한 진행 상황에 대한 사이드바 점과 카드를 제어합니다. 알림은 별도의 정책을 따릅니다. \"완료\" 표시는 해당 탭을 열어 보면 사라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merker styrer prikker og kort i sidepanelet for oppdaget arbeid og fremdrift rapportert av terminalen, også når gjenkjenning av kodeagenter er slått av. Varslinger følger sine egne regler. \"Ferdig\"-markeringer fjernes når du viser fanen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badges bepalen de stippen en kaarten in de zijbalk voor gedetecteerd werk en voor voortgang die de terminal meldt, ook als detectie van codeeragents uit staat. Meldingen volgen hun eigen beleid. \"Klaar\"-markeringen verdwijnen zodra je het tabblad bekijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakietki sterują kropkami i kafelkami na pasku bocznym dla wykrytej pracy oraz postępu zgłaszanego przez terminal, nawet gdy wykrywanie agentów kodowania jest wyłączone. Powiadomienia mają własne zasady. Oznaczenia „Gotowe” znikają, gdy wyświetlisz kartę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os selos controlam os pontos e os cartões da barra lateral para o trabalho detectado e o progresso informado pelo terminal, mesmo quando a detecção de agentes de código está desativada. As notificações seguem a própria política. As marcas de “Concluído” são apagadas quando você vê a aba."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sinais controlam os pontos e os cartões da barra lateral para o trabalho detetado e para o progresso comunicado pelo terminal, mesmo com a deteção de agentes de código desativada. As notificações seguem a sua própria política. Os marcadores \"Concluído\" desaparecem quando abre o separador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insignele controlează punctele și cardurile din bara laterală pentru activitatea detectată și progresul raportat de terminal, chiar și când detectarea agenților de cod este dezactivată. Notificările urmează propria politică. Marcajele „Gata” dispar când vizualizezi fila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznake upravljajo pike in kartice v stranski vrstici za zaznano delo in napredek, ki ga sporoča terminal, tudi kadar je zaznavanje kodirnih agentov izklopljeno. Obvestila sledijo svojemu pravilniku. Oznake »Končano« se počistijo, ko odprete zavihek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brickor styr punkter och kort i sidofältet för identifierat arbete och för förlopp som terminalen rapporterar, även när identifiering av kodagenter är avstängd. Aviseringar följer sin egen policy. Markeringar för \"Klar\" rensas när du visar fliken."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки керують крапками та картками на бічній панелі для виявленої роботи та прогресу, про який повідомляє термінал, навіть коли виявлення агентів кодування вимкнено. Сповіщення мають власну політику. Позначки «Готово» зникають, коли ви переглядаєте вкладку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huy hiệu điều khiển các chấm và thẻ trên thanh bên cho công việc được phát hiện và tiến trình do terminal báo cáo, ngay cả khi tính năng phát hiện tác nhân lập trình đang tắt. Thông báo tuân theo chính sách riêng. Dấu “Xong” sẽ biến mất khi bạn xem tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记用于控制侧边栏中显示已检测工作和终端报告进度的圆点与卡片，即使编程代理检测已关闭也同样生效。通知则遵循各自的策略。“完成”标记会在你查看该标签页时清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標記控制側邊欄中代表偵測到的工作與終端機回報進度的圓點和卡片，即使關閉程式設計代理偵測也一樣。通知則依照其本身的原則。檢視分頁後，「完成」標示便會清除。"
          }
        }
      }
    },
