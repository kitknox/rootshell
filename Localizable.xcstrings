    "P-256 key generated inside the Secure Enclave. The private key never leaves this device and cannot be exported, backed up, or synced." : {
      "comment" : "SSH key generation: Secure Enclave footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح P-256 تم إنشاؤه داخل Secure Enclave. لا يغادر المفتاح الخاص هذا الجهاز أبداً ولا يمكن تصديره أو نسخه احتياطياً أو مزامنته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clau P-256 generada dins del Secure Enclave. La clau privada no surt mai d'aquest dispositiu i no es pot exportar, fer-ne còpia de seguretat ni sincronitzar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč P-256 vygenerovaný v Secure Enclave. Soukromý klíč nikdy neopustí toto zařízení a nelze jej exportovat, zálohovat ani synchronizovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P-256-nøgle genereret i Secure Enclave. Den private nøgle forlader aldrig denne enhed og kan ikke eksporteres, sikkerhedskopieres eller synkroniseres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Secure Enclave generierter P-256-Schlüssel. Der private Schlüssel verlässt dieses Gerät nie und kann nicht exportiert, gesichert oder synchronisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clave P-256 generada dentro del Secure Enclave. La clave privada nunca sale de este dispositivo y no se puede exportar, respaldar ni sincronizar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Enclaven sisällä luotu P-256-avain. Yksityinen avain ei koskaan poistu tältä laitteelta, eikä sitä voi viedä, varmuuskopioida tai synkronoida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé P-256 générée dans le Secure Enclave. La clé privée ne quitte jamais cet appareil et ne peut être exportée, sauvegardée ou synchronisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתח P-256 שנוצר בתוך Secure Enclave. המפתח הפרטי לעולם אינו עוזב מכשיר זה ולא ניתן לייצא, לגבות או לסנכרן אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Secure Enclave-ben generált P-256 kulcs. A privát kulcs soha nem hagyja el ezt az eszközt, és nem exportálható, nem menthető biztonsági másolatba és nem szinkronizálható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiave P-256 generata all'interno del Secure Enclave. La chiave privata non lascia mai questo dispositivo e non può essere esportata, sottoposta a backup o sincronizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Enclave内で生成されたP-256キー。秘密鍵はこのデバイスから外に出ることはなく、エクスポート、バックアップ、同期はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Enclave 내부에서 생성된 P-256 키입니다. 개인 키는 이 기기를 절대 벗어나지 않으며 내보내거나 백업하거나 동기화할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P-256-nøkkel generert inne i Secure Enclave. Privatnøkkelen forlater aldri denne enheten og kan ikke eksporteres, sikkerhetskopieres eller synkroniseres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P-256-sleutel gegenereerd in de Secure Enclave. De privésleutel verlaat dit apparaat nooit en kan niet worden geëxporteerd, in een back-up worden opgenomen of worden gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz P-256 wygenerowany w Secure Enclave. Klucz prywatny nigdy nie opuszcza tego urządzenia i nie może zostać wyeksportowany, uwzględniony w kopii zapasowej ani zsynchronizowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave P-256 gerada dentro do Secure Enclave. A chave privada nunca sai deste dispositivo e não pode ser exportada, copiada em backup ou sincronizada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave P-256 gerada dentro do Secure Enclave. A chave privada nunca sai deste dispositivo e não pode ser exportada, incluída em cópias de segurança ou sincronizada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheie P-256 generată în Secure Enclave. Cheia privată nu părăsește niciodată acest dispozitiv și nu poate fi exportată, salvată în backup sau sincronizată."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ključ P-256, ustvarjen znotraj Secure Enclave. Zasebni ključ nikoli ne zapusti te naprave in ga ni mogoče izvoziti, varnostno kopirati ali sinhronizirati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P-256-nyckel genererad inuti Secure Enclave. Den privata nyckeln lämnar aldrig den här enheten och kan inte exporteras, säkerhetskopieras eller synkroniseras."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ P-256, згенерований усередині Secure Enclave. Приватний ключ ніколи не залишає цей пристрій, і його не можна експортувати, зберегти в резервній копії чи синхронізувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa P-256 được tạo bên trong Secure Enclave. Khóa riêng tư không bao giờ rời khỏi thiết bị này và không thể được xuất, sao lưu hoặc đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Secure Enclave 中生成的 P-256 密钥。私钥永不离开此设备，无法导出、备份或同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Secure Enclave 內產生的 P-256 金鑰。私鑰永遠不會離開此裝置，且無法匯出、備份或同步。"
          }
        }
      }
    },
    "Page Down" : {
