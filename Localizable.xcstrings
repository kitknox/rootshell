    "How long to hold before the modifier activates. Lower values feel faster but may trigger on normal typing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدة الضغط المطلوبة قبل تفعيل المُعدِّل. القيم المنخفضة تبدو أسرع لكن قد تنشط أثناء الكتابة العادية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quant de temps cal mantenir premut abans que s'activi el modificador. Valors més baixos són més ràpids però poden activar-se amb l'escriptura normal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho podržet před aktivací modifikátoru. Nižší hodnoty jsou rychlejší, ale mohou se spustit při běžném psaní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor længe der skal holdes, før modifikatoren aktiveres. Lavere værdier føles hurtigere, men kan udløses ved normal skrivning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange gehalten werden muss, bevor der Modifikator aktiviert wird. Niedrigere Werte fühlen sich schneller an, können aber beim normalen Tippen ausgelöst werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo mantener presionado antes de que se active el modificador. Los valores más bajos se sienten más rápidos pero pueden activarse durante la escritura normal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka kauan painetaan ennen kuin muokkain aktivoituu. Pienemmät arvot tuntuvat nopeammilta, mutta voivat laueta normaalissa kirjoituksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée de maintien avant l'activation du modificateur. Des valeurs plus faibles paraissent plus rapides, mais peuvent se déclencher pendant la frappe normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה זמן להחזיק לפני שהמודיפייר מופעל. ערכים נמוכים מרגישים מהירים יותר אבל עלולים להפעיל בהקלדה רגילה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milyen hosszan kell nyomva tartani a módosító aktiválásához. Az alacsonyabb értékek gyorsabbnak tűnnek, de normál gépeléskor is bekapcsolhatnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo di pressione prima che il modificatore si attivi. Valori più bassi risultano più rapidi ma potrebbero attivarsi durante la digitazione normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーが有効になるまでの長押し時間。低い値ほど反応が速くなりますが、通常のタイピング中に誤動作する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수정자 키가 활성화되기까지 길게 누르는 시간입니다. 낮은 값일수록 반응이 빠르지만 일반 타이핑 중에 오작동할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge du må holde før modifikatoren aktiveres. Lavere verdier føles raskere, men kan utløses ved vanlig skriving."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang u moet vasthouden voordat de modifier wordt geactiveerd. Lagere waarden voelen sneller maar kunnen activeren bij normaal typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo trzeba przytrzymać, zanim modyfikator się aktywuje. Niższe wartości dają szybszą reakcję, ale mogą się włączać podczas normalnego pisania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo manter pressionado antes do modificador ativar. Valores menores parecem mais rápidos, mas podem disparar durante a digitação normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo de pressão antes do modificador ser ativado. Valores mais baixos parecem mais rápidos, mas podem ser acionados ao escrever normalmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp trebuie menținut înainte ca modificatorul să se activeze. Valorile mai mici par mai rapide, dar se pot declanșa în timpul tastării normale."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako dolgo je treba držati, preden se modifikator aktivira. Nižje vrednosti se zdijo hitrejše, vendar se lahko sprožijo pri običajnem tipkanju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge du måste hålla innan modifieraren aktiveras. Lägre värden känns snabbare men kan utlösas vid vanlig skrivning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як довго утримувати перед активацією модифікатора. Менші значення відчуваються швидшими, але можуть спрацьовувати під час звичайного набору."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian giữ trước khi phím bổ sung kích hoạt. Giá trị thấp hơn cảm giác nhanh hơn nhưng có thể kích hoạt khi gõ bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住多长时间后修饰键激活。较低的值感觉更快，但可能在正常打字时误触发。"
          }
        },
        "zh-Hant" : {
