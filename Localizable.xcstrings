          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM として送信されます。空の場合は設定 > ターミナル > ターミナルタイプから継承されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
