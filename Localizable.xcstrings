    "If a key already exists in %@, it will be permanently replaced. The private key will move from software storage to your YubiKey hardware." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هناك مفتاح موجود بالفعل في %@، فسيتم استبداله نهائيًا. سينتقل المفتاح الخاص من التخزين البرمجي إلى جهاز YubiKey الخاص بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ja existeix una clau a %@, serà reemplaçada permanentment. La clau privada es traslladarà de l'emmagatzematge de programari al vostre maquinari YubiKey."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud klíč v %@ již existuje, bude trvale nahrazen. Soukromý klíč bude přesunut ze softwarového úložiště na váš YubiKey."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis der allerede findes en nøgle i %@, vil den blive permanent erstattet. Den private nøgle flyttes fra softwareopbevaring til din YubiKey-hardware."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn in %@ bereits ein Schlüssel existiert, wird er dauerhaft ersetzt. Der private Schlüssel wird vom Software-Speicher auf Ihre YubiKey-Hardware verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
