        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar substitui as configurações SSH deste perfil (chaves, encaminhamentos de porta, encaminhamento de agente, opções do terminal) pelas de Compartilhamento de Tela. O nome do host é mantido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
