    "This key appears to be encrypted. The passphrase is used once to decrypt the key during import and is never stored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أن هذا المفتاح مشفّر. تُستخدم عبارة المرور مرة واحدة لفك تشفير المفتاح أثناء الاستيراد ولا يتم تخزينها أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembla que aquesta clau està xifrada. La frase de pas s'utilitza una sola vegada per desxifrar la clau durant la importació i mai no es desa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá se, že tento klíč je zašifrovaný. Heslová fráze se použije jednou k dešifrování klíče při importu a nikdy se neukládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne nøgle ser ud til at være krypteret. Adgangsfrasen bruges én gang til at dekryptere nøglen under importen og gemmes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel scheint verschlüsselt zu sein. Die Passphrase wird einmalig zum Entschlüsseln des Schlüssels beim Import verwendet und nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que esta clave está cifrada. La frase de contraseña se usa una sola vez para descifrar la clave durante la importación y nunca se almacena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä avain näyttää olevan salattu. Tunnuslausetta käytetään kerran avaimen purkamiseen tuonnin aikana, eikä sitä tallenneta koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé semble être chiffrée. La phrase secrète est utilisée une seule fois pour déchiffrer la clé lors de l'importation et n'est jamais conservée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נראה שהמפתח הזה מוצפן. ביטוי הסיסמה משמש פעם אחת לפענוח המפתח בעת הייבוא ולעולם אינו נשמר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úgy tűnik, hogy ez a kulcs titkosított. A jelmondat egyszer, az importálás során a kulcs visszafejtéséhez szolgál, és soha nem kerül tárolásra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chiave sembra essere cifrata. La passphrase viene usata una sola volta per decifrare la chiave durante l'importazione e non viene mai memorizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーは暗号化されているようです。パスフレーズは読み込み時にキーを復号するために一度だけ使用され、保存されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키는 암호화된 것으로 보입니다. 패스프레이즈는 가져오는 동안 키를 복호화하는 데 한 번만 사용되며 저장되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
