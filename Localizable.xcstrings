    "Keep the toolbar docked at the bottom of the screen while a hardware keyboard is connected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إبقاء شريط الأدوات مثبتًا في أسفل الشاشة أثناء توصيل لوحة مفاتيح خارجية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la barra d'eines fixada a la part inferior de la pantalla mentre hi hagi un teclat físic connectat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechá panel nástrojů ukotvený v dolní části obrazovky, když je připojena hardwarová klávesnice."
