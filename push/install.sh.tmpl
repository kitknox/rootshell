#!/bin/sh
# rootshell-notify installer. Downloads a release binary, verifies its
# SHA-256 against the table embedded below, and copies it into place.
# With --pair it then runs `rootshell-notify setup` to pair and install
# agent hooks. It runs nothing else.
#
# Usage: sh install.sh [--system] [--pair <bundle>] [--hooks <spec>] [--project]
#   curl -fsSL https://push.rootshell.com/install.sh | sh -s -- --pair 'rspair1....'
set -eu

VERSION="${ROOTSHELL_NOTIFY_VERSION:-@@VERSION@@}"
BASE_URL="https://push.rootshell.com/releases/${VERSION}"
FALLBACK_URL="https://github.com/kitknox/rootshell/releases/download/push%2Fv${VERSION}"

# name sha256
CHECKSUMS="
@@CHECKSUMS@@
"

usage() {
  echo "usage: install.sh [--system] [--pair <bundle>] [--hooks auto|claude-code,codex,pi,omp,hermes|none] [--project]"
}

SYSTEM=0
PAIR=""
HOOKS=""
PROJECT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --system) SYSTEM=1 ;;
    --project) PROJECT=1 ;;
    --pair) [ $# -ge 2 ] || { echo "--pair requires a value" >&2; exit 2; }; PAIR="$2"; shift ;;
    --pair=*) PAIR="${1#--pair=}" ;;
    --hooks) [ $# -ge 2 ] || { echo "--hooks requires a value" >&2; exit 2; }; HOOKS="$2"; shift ;;
    --hooks=*) HOOKS="${1#--hooks=}" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

os=$(uname -s)
arch=$(uname -m)
case "$os" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  *) echo "unsupported OS: $os" >&2; exit 1 ;;
esac
case "$arch" in
  x86_64|amd64) arch=amd64 ;;
  aarch64|arm64) arch=arm64 ;;
  armv7l|armv6l|armhf) arch=arm ;;
  *) echo "unsupported architecture: $arch" >&2; exit 1 ;;
esac
artifact="rootshell-notify_${os}_${arch}"

if [ "$SYSTEM" = 1 ]; then
  dest=/usr/local/bin
else
  dest="${HOME}/.local/bin"
fi
bin="$dest/rootshell-notify"

installed=""
if [ -x "$bin" ]; then
  installed=$("$bin" version 2>/dev/null || true)
fi

if [ "$installed" = "rootshell-notify $VERSION" ]; then
  echo "rootshell-notify $VERSION already installed at $bin"
else
  expected=$(printf '%s\n' "$CHECKSUMS" | awk -v n="$artifact" '$1 == n { print $2 }')
  if [ -z "$expected" ] && [ "$VERSION" = "@@VERSION@@" ]; then
    echo "no checksum for $artifact in this installer" >&2
    exit 1
  fi

  tmp=$(mktemp -d 2>/dev/null || mktemp -d -t rootshell)
  trap 'rm -rf "$tmp"' EXIT INT TERM

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --proto '=https' --tlsv1.2 -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "$2" "$1"
    else
      echo "need curl or wget" >&2; exit 1
    fi
  }

  echo "Downloading rootshell-notify ${VERSION} (${os}/${arch})..."
  if ! fetch "${BASE_URL}/${artifact}" "$tmp/$artifact"; then
    echo "primary download failed, trying GitHub..." >&2
    fetch "${FALLBACK_URL}/${artifact}" "$tmp/$artifact"
  fi

  if [ -z "$expected" ]; then
    # Version override: fetch the matching SHA256SUMS instead of the embedded table.
    fetch "${BASE_URL}/SHA256SUMS" "$tmp/SHA256SUMS" || fetch "${FALLBACK_URL}/SHA256SUMS" "$tmp/SHA256SUMS"
    expected=$(awk -v n="$artifact" '{ sub(/^\*/, "", $2); if ($2 == n) print $1 }' "$tmp/SHA256SUMS")
    [ -n "$expected" ] || { echo "no checksum for $artifact in SHA256SUMS" >&2; exit 1; }
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$tmp/$artifact" | awk '{ print $1 }')
  elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$tmp/$artifact" | awk '{ print $1 }')
  else
    echo "need sha256sum or shasum to verify the download" >&2; exit 1
  fi
  if [ "$actual" != "$expected" ]; then
    echo "checksum mismatch for $artifact" >&2
    echo "  expected $expected" >&2
    echo "  got      $actual" >&2
    exit 1
  fi

  if [ "$SYSTEM" = 1 ]; then
    if [ -w "$dest" ] || { [ ! -e "$dest" ] && [ -w "$(dirname "$dest")" ]; }; then
      mkdir -p "$dest"
      install -m 755 "$tmp/$artifact" "$bin"
    else
      echo "Installing to $dest with sudo..."
      sudo mkdir -p "$dest"
      sudo install -m 755 "$tmp/$artifact" "$bin"
    fi
  else
    mkdir -p "$dest"
    install -m 755 "$tmp/$artifact" "$bin"
  fi
  echo "Installed $bin"
fi

case ":$PATH:" in
  *":$dest:"*) ;;
  *) echo
     echo "Note: $dest is not on your PATH. Add it to your shell profile, e.g.:"
     echo "  export PATH=\"$dest:\$PATH\"" ;;
esac

# --pair pairs and installs hooks; --hooks alone (e.g. after an upgrade) only
# installs or refreshes the hooks for existing pairings.
if [ -n "$PAIR" ] || [ -n "$HOOKS" ]; then
  echo
  if [ -n "$PAIR" ]; then set -- setup --pair "$PAIR"; else set -- setup --no-pair; fi
  [ -n "$HOOKS" ] && set -- "$@" --hooks "$HOOKS"
  [ "$PROJECT" = 1 ] && set -- "$@" --project
  # stdin is usually the curl pipe; hand the tty to setup when there is one.
  if (exec </dev/tty) 2>/dev/null; then
    "$bin" "$@" </dev/tty
  else
    "$bin" "$@"
  fi
  exit 0
fi

echo
echo "Next steps:"
echo "  1. In rootshell: Settings > Notifications > Push Notifications > Pair a computer"
echo "  2. rootshell-notify setup --pair <bundle>    (pairs and installs agent hooks)"
echo "     or step by step: rootshell-notify pair; rootshell-notify install claude-code | codex"
