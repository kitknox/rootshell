    "VPN profile requires a saved password or SSH key before it can start in the background." : {
      "comment" : "VPN start error: profile has no background-usable credential",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلّب ملف VPN الشخصي كلمة مرور محفوظة أو مفتاح SSH قبل أن يتمكّن من البدء في الخلفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil de VPN necessita una contrasenya desada o una clau SSH abans de poder iniciar-se en segon pla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil VPN vyžaduje uložené heslo nebo klíč SSH, než se může spustit na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-profilen kræver en gemt adgangskode eller SSH-nøgle, før den kan starte i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das VPN-Profil erfordert ein gespeichertes Passwort oder einen SSH-Schlüssel, bevor es im Hintergrund gestartet werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil de VPN requiere una contraseña guardada o una clave SSH antes de poder iniciarse en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-profiili vaatii tallennetun salasanan tai SSH-avaimen, ennen kuin se voidaan käynnistää taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil VPN nécessite un mot de passe enregistré ou une clé SSH avant de pouvoir démarrer en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרופיל ה-VPN דורש סיסמה שמורה או מפתח SSH לפני שהוא יכול לפעול ברקע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN-profilhoz mentett jelszó vagy SSH-kulcs szükséges, mielőtt a háttérben elindulhatna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo VPN richiede una password salvata o una chiave SSH prima di poter essere avviato in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNプロファイルをバックグラウンドで開始する前に、保存されたパスワードまたはSSHキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 프로필을 백그라운드에서 시작하려면 저장된 비밀번호 또는 SSH 키가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-profilen krever et lagret passord eller en SSH-nøkkel før den kan starte i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het VPN-profiel vereist een opgeslagen wachtwoord of SSH-sleutel voordat het op de achtergrond kan starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil VPN wymaga zapisanego hasła lub klucza SSH, zanim będzie mógł uruchomić się w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
